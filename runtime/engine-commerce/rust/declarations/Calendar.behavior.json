    "additionalProperties": false,
    "properties": {
      "bufferMs": {
        "additionalProperties": false,
        "description": "Time kept free around each hold, which counts against capacity as the hold does.",
        "properties": {
          "after": {
            "description": "Milliseconds after a hold that no other may overlap; 0 when absent.",
            "maximum": 86400000,
            "minimum": 0,
            "type": "integer"
          },
          "before": {
            "description": "Milliseconds before a hold that no other may overlap; 0 when absent.",
            "maximum": 86400000,
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "capacity": {
        "description": "How many holds may overlap at any instant: a count, or an own integer field of the type ({ field }) whose value of at least 1 is the instance's; 1 when absent.",
