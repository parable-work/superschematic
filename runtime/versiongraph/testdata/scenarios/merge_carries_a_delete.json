{
  "name": "merge_carries_a_delete",
  "description": "A change set deletes an entity and merges back: the target writes the delete as its own row, the merge commit's patch is a DELETE, and the commit materializes without the entity.",
  "steps": [
    {"op": "sql", "statement": "INSERT INTO recipe (id, title, created_by) VALUES ($1::uuid, 'Bread', $2::uuid)", "args": [{"uuid": "Bread"}, {"uuid": "Cook"}]},
    {"op": "createPrimary", "root": "Bread", "name": "main", "as": "main"},
    {"op": "branch", "from": "main", "name": "seed", "as": "seed"},
    {"op": "save", "ref": "seed", "edits": {
      "step": {"upsert": [{"entity_key": "Bake", "position": 1, "instruction": "Bake", "timings": {}}]},
      "ingredient": {"upsert": [
        {"entity_key": "Flour", "step_key": "Bake", "quantity": "200g flour", "substitutes": {}},
        {"entity_key": "Wash", "step_key": "Bake", "quantity": "1 egg wash", "substitutes": {}}
      ]}
    }},
    {"op": "commit", "ref": "seed"},
    {"op": "merge", "source": "seed", "target": "main", "as": "c1"},
    {"op": "branch", "from": "main", "name": "no egg wash", "as": "d"},
    {"op": "save", "ref": "d", "edits": {"ingredient": {"delete": ["Wash"]}}},
    {"op": "rows", "ref": "d", "kind": "ingredient", "expect": {"rows": [{"entity_key": "Wash", "deleted_on_ref": true, "quantity": "1 egg wash"}]}},
    {"op": "commit", "ref": "d", "as": "dCommit"},
    {"op": "patches", "commit": "dCommit", "expect": {"patches": [{"kind": "ingredient", "entityKey": "Wash", "operation": "DELETE", "entityVersion": 1}]}},
    {"op": "merge", "source": "d", "target": "main", "as": "merged", "expect": {"commit": {"parent": "c1"}}},
    {"op": "compose", "ref": "main", "expect": {"contentHashOf": "merged", "tree": {
      "ingredient": [{"entity_key": "Flour"}],
      "step": [{"entity_key": "Bake"}]
    }}},
    {"op": "rows", "ref": "main", "kind": "ingredient", "expect": {"rows": [
      {"entity_key": "Flour", "deleted_on_ref": false},
      {"entity_key": "Wash", "deleted_on_ref": true, "_version": 2}
    ]}},
    {"op": "patches", "commit": "merged", "expect": {"patches": [{"kind": "ingredient", "entityKey": "Wash", "operation": "DELETE", "entityVersion": 2}]}},
    {"op": "materialize", "commit": "merged", "expect": {"contentHashOf": "merged", "tree": {
      "ingredient": [{"entity_key": "Flour"}],
      "step": [{"entity_key": "Bake"}]
    }}},
    {"op": "diff", "from": "c1", "to": "merged", "expect": {"changes": [
      {"kind": "ingredient", "entityKey": "Wash", "operation": "DELETE"}
    ]}},
    {"op": "merge", "source": "d", "target": "main", "expect": {"commit": null, "ref": {"head": "merged"}}}
  ]
}
