{
  "name": "primary_merge_only",
  "description": "A primary line takes writes only from Merge: Save, Commit, Seal and Revert on it fail, a merge commits in the same transaction with its message and tag, and the line's live rows always compose to its head.",
  "steps": [
    {"op": "sql", "statement": "INSERT INTO recipe (id, title, created_by) VALUES ($1::uuid, 'Bread', $2::uuid)", "args": [{"uuid": "Bread"}, {"uuid": "Cook"}]},
    {"op": "createPrimary", "root": "Bread", "name": "main", "as": "main"},
    {"op": "save", "ref": "main", "edits": {"step": {"upsert": [{"entity_key": "Mix", "position": 1, "instruction": "Mix", "timings": {}}]}},
      "expect": {"error": "primary_merge_only"}},
    {"op": "rows", "ref": "main", "kind": "step", "expect": {"rows": []}},
    {"op": "commit", "ref": "main", "expect": {"error": "primary_merge_only"}},
    {"op": "seal", "ref": "main", "expect": {"error": "primary_merge_only"}},

    {"op": "branch", "from": "main", "name": "mix", "as": "mix"},
    {"op": "save", "ref": "mix", "edits": {"step": {"upsert": [{"entity_key": "Mix", "position": 1, "instruction": "Mix", "timings": {}}]}}},
    {"op": "commit", "ref": "mix", "as": "mixCommit"},
    {"op": "merge", "source": "mix", "target": "main", "message": "the mix", "tag": true, "as": "c1",
      "expect": {"ref": {"version": 2, "head": "c1", "sealed": false}, "commit": {"ref": "main", "parent": null, "message": "the mix", "sequence": 1, "contentHashOf": "mixCommit"}}},
    {"op": "compose", "ref": "main", "expect": {"contentHashOf": "c1", "tree": {"step": [{"entity_key": "Mix", "instruction": "Mix"}]}}},
    {"op": "revert", "ref": "main", "toCommit": "c1", "expect": {"error": "primary_merge_only"}},
    {"op": "save", "ref": "main", "edits": {}, "expect": {"error": "primary_merge_only"}},
    {"op": "rebase", "ref": "main", "expect": {"error": "no_parent"}},

    {"op": "branch", "from": "main", "name": "rest", "as": "rest"},
    {"op": "save", "ref": "rest", "edits": {"step": {"upsert": [{"entity_key": "Rest", "position": 2, "instruction": "Rest", "timings": {}}]}}},
    {"op": "commit", "ref": "rest", "as": "restCommit"},
    {"op": "merge", "source": "rest", "target": "main", "as": "c2",
      "expect": {"commit": {"parent": "c1", "message": "", "sequence": null, "contentHashOf": "restCommit"}}},
    {"op": "compose", "ref": "main", "expect": {"contentHashOf": "c2"}},
    {"op": "history", "ref": "main", "expect": {"commits": ["c2", "c1"]}}
  ]
}
