{
  "name": "reads_refuse",
  "description": "Materialize stops at the walk ceiling, refuses a commit from a newer schema epoch and a commit whose pinned row version history no longer holds; reads of what does not exist are not found.",
  "steps": [
    {"op": "sql", "statement": "INSERT INTO recipe (id, title, created_by) VALUES ($1::uuid, 'Bread', $2::uuid)", "args": [{"uuid": "Bread"}, {"uuid": "Cook"}]},
    {"op": "createPrimary", "root": "Bread", "name": "main", "as": "main"},
    {"op": "save", "ref": "main", "edits": {"step": {"upsert": [{"entity_key": "Mix", "position": 1, "instruction": "Mix", "timings": {}}]}}},
    {"op": "commit", "ref": "main", "as": "c1"},
    {"op": "save", "ref": "main", "edits": {"utensil": {"upsert": [{"entity_key": "Whisk", "name": "whisk"}]}}},
    {"op": "commit", "ref": "main", "as": "c2"},
    {"op": "materialize", "commit": "c2", "walkCeiling": 1, "expect": {"error": "walk_ceiling"}},
    {"op": "diff", "from": "c1", "to": "c2", "walkCeiling": 1, "expect": {"error": "walk_ceiling"}},
    {"op": "materialize", "commit": "c2", "walkCeiling": 2, "expect": {"contentHashOf": "c2"}},
    {"op": "materialize", "commit": "c1", "walkCeiling": 1, "expect": {"contentHashOf": "c1"}},
    {"op": "materialize", "commit": "c1", "schemaEpoch": 0, "expect": {"error": "schema_epoch"}},
    {"op": "compose", "ref": "main", "schemaEpoch": 2, "expect": {"contentHashOf": "c2"}},
    {"op": "materialize", "commit": "id:Missing", "expect": {"error": "not_found"}},
    {"op": "compose", "ref": "id:Missing", "expect": {"error": "not_found"}},
    {"op": "history", "ref": "id:Missing", "expect": {"error": "not_found"}},
    {"op": "branch", "from": "id:Missing", "name": "nowhere", "expect": {"error": "not_found"}},
    {"op": "revert", "ref": "main", "toCommit": "id:Missing", "expect": {"error": "not_found"}},
    {"op": "sql", "statement": "DELETE FROM utensil_history WHERE id IN (SELECT id FROM utensil WHERE entity_key = $1::uuid AND ref_id = $2::uuid)", "args": [{"uuid": "Whisk"}, {"ref": "main"}]},
    {"op": "materialize", "commit": "c2", "expect": {"error": "history_missing"}},
    {"op": "materialize", "commit": "c1", "expect": {"contentHashOf": "c1"}},
    {"op": "branch", "from": "main", "name": "draft", "as": "draft", "expect": {"ref": {"base": "c2"}}},
    {"op": "compose", "ref": "draft", "expect": {"error": "history_missing"}}
  ]
}
