{
  "name": "writes_refuse",
  "description": "Writes refuse what the graph forbids: a write with no actor, a taken ref name, a merge into itself or across roots, a revert to another root's commit, a tree that breaks the graph's rules, and a resolution that matches no conflict. A discarded ref is gone, and its name is free again.",
  "steps": [
    {"op": "sql", "statement": "INSERT INTO recipe (id, title, created_by) VALUES ($1::uuid, 'Bread', $2::uuid), ($3::uuid, 'Soup', $2::uuid)", "args": [{"uuid": "Bread"}, {"uuid": "Cook"}, {"uuid": "Soup"}]},
    {"op": "createPrimary", "root": "Bread", "name": "main", "as": "main"},
    {"op": "createPrimary", "root": "Bread", "name": "main", "expect": {"error": "name_taken"}},
    {"op": "createPrimary", "root": "Soup", "name": "main", "as": "soup"},
    {"op": "createPrimary", "root": "Bread", "name": "nobody", "actor": "", "expect": {"error": "no_actor"}},
    {"op": "save", "ref": "main", "actor": "", "edits": {}, "expect": {"error": "no_actor"}},
    {"op": "branch", "from": "main", "name": "mix", "as": "mix"},
    {"op": "save", "ref": "mix", "edits": {"step": {"upsert": [{"entity_key": "Mix", "position": 1, "instruction": "Mix", "timings": {}}]}}},
    {"op": "commit", "ref": "mix"},
    {"op": "merge", "source": "mix", "target": "main", "as": "c1"},
    {"op": "branch", "from": "soup", "name": "boil", "as": "boil"},
    {"op": "save", "ref": "boil", "edits": {"step": {"upsert": [{"entity_key": "Boil", "position": 1, "instruction": "Boil", "timings": {}}]}}},
    {"op": "commit", "ref": "boil"},
    {"op": "merge", "source": "boil", "target": "soup", "as": "soup1"},

    {"op": "merge", "source": "main", "target": "main", "expect": {"error": "merge_into_itself"}},
    {"op": "merge", "source": "soup", "target": "main", "expect": {"error": "root_mismatch"}},
    {"op": "revert", "ref": "mix", "toCommit": "soup1", "expect": {"error": "root_mismatch"}},
    {"op": "branch", "from": "main", "name": "main", "expect": {"error": "name_taken"}},

    {"op": "branch", "from": "main", "name": "covers", "as": "covers"},
    {"op": "save", "ref": "covers", "edits": {"cover": {"upsert": [
      {"entity_key": "Front", "photo_url": "front.jpg"},
      {"entity_key": "Back", "photo_url": "back.jpg"}
    ]}}},
    {"op": "commit", "ref": "covers", "expect": {"error": "invalid_tree"}},
    {"op": "save", "ref": "covers", "edits": {"cover": {"delete": ["Back"]}}},
    {"op": "commit", "ref": "covers", "as": "oneCover"},

    {"op": "branch", "from": "main", "name": "orphan", "as": "orphan"},
    {"op": "save", "ref": "orphan", "edits": {"ingredient": {"upsert": [
      {"entity_key": "Salt", "step_key": "Nowhere", "quantity": "a pinch", "substitutes": {}}
    ]}}},
    {"op": "compose", "ref": "orphan", "expect": {
      "tree": {"ingredient": [{"entity_key": "Salt"}], "step": [{"entity_key": "Mix"}]},
      "findings": [{"code": "absent_parent", "kind": "ingredient", "entityKey": "Salt"}]
    }},
    {"op": "commit", "ref": "orphan", "expect": {"error": "invalid_tree"}},

    {"op": "branch", "from": "main", "name": "stale", "as": "stale"},
    {"op": "save", "ref": "stale", "edits": {"step": {"upsert": [{"entity_key": "Mix", "position": 1, "instruction": "Stir", "timings": {}}]}}},
    {"op": "commit", "ref": "stale"},
    {"op": "merge", "source": "stale", "target": "main",
      "resolutions": [{"kind": "step", "entityKey": "Mix", "path": "/instruction", "take": "theirs"}],
      "expect": {"error": "unmatched_resolution"}},
    {"op": "merge", "source": "stale", "target": "main", "version": 1, "expect": {"error": "version_conflict"}},

    {"op": "discard", "ref": "stale", "version": 1, "expect": {"error": "version_conflict"}},
    {"op": "discard", "ref": "stale"},
    {"op": "compose", "ref": "stale", "expect": {"error": "not_found"}},
    {"op": "discard", "ref": "stale", "expect": {"error": "not_found"}},
    {"op": "save", "ref": "stale", "edits": {}, "expect": {"error": "not_found"}},
    {"op": "merge", "source": "stale", "target": "main", "expect": {"error": "not_found"}},
    {"op": "branch", "from": "main", "name": "stale", "as": "again", "expect": {"ref": {"version": 1, "name": "stale"}}}
  ]
}
