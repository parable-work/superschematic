{
  "name": "@superschematic/http-runtime",
  "version": "0.0.0",
  "description": "Runtime for generated TypeScript API servers: request context, RFC 9457 problem envelope, success envelope, parameter decoding over the superscalar scalar functions, the permission gate, the service-caller verifier and credential sources, a token-bucket rate limiter, the Hono adapter, a generated router's OpenAPI routes (./openapi) and MCP endpoint (./mcp), the readers of the config fields a stack derives, a JSON-lines logger, a pg Pool over a derived database connection, the Postgres value codec, the generated repositories' runtime and a queue's enqueue and claims (./postgres), a worker's claim loop (./worker), OpenTelemetry trace export on Bun (./telemetry) and on Workers (./workers-telemetry, which imports node:async_hooks alone, under the nodejs_als compatibility flag), the provider-neutral Bucket with its GCS implementation (./gcs), the MemoryStore with its in-process store, typed channels and keys and shared rate limit, and its Redis implementation over node-redis (./redis), the identity runtime of the core user model (./identity), and for Cloudflare Workers the env and bindings of a Worker (./workers), D1's interface as SqlDatabase (./d1), SqlDatabase over bun:sqlite for stack dev (./sqlite) and the Bucket over an R2 binding (./r2), none of which imports from node:. Ships compiled ESM with declarations. Needs superscalar next to it in node_modules; see scripts/link-local-deps.mjs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "import": "./dist/identity/index.js"
    },
    "./gcs": {
      "types": "./dist/gcs.d.ts",
      "import": "./dist/gcs.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./workers": {
      "types": "./dist/workers.d.ts",
      "import": "./dist/workers.js"
    },
    "./d1": {
      "types": "./dist/d1.d.ts",
      "import": "./dist/d1.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./r2": {
      "types": "./dist/r2.d.ts",
      "import": "./dist/r2.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    },
    "./workers-telemetry": {
      "types": "./dist/workers-telemetry.d.ts",
      "import": "./dist/workers-telemetry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "link-deps": "node scripts/link-local-deps.mjs",
    "typecheck": "node scripts/link-local-deps.mjs && tsc --noEmit -p tsconfig.json",
    "build": "node scripts/link-local-deps.mjs && node ../../../scripts/build-dist.mjs tsc -p tsconfig.json",
    "test": "node scripts/link-local-deps.mjs && tsc --noEmit -p tsconfig.json && bun test src && bun run build && node scripts/identity-node-check.mjs && node scripts/workers-check.mjs && node scripts/workerd-test.mjs",
    "workers-check": "node scripts/workers-check.mjs",
    "workerd-test": "node scripts/workerd-test.mjs"
  },
