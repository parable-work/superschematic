        },
        {
          "class": "copy-table",
          "id": "copy-table:table/comment",
          "reason": "SQLite's ALTER TABLE cannot drop NOT NULL from legacy_id in comment, nor convert the elements of remind_before in task, so the step rebuilds comment and task. It copies the rows of each table it keeps into a new table, drops the old tables and renames the new ones.",
          "subject": "table/comment"
        }
