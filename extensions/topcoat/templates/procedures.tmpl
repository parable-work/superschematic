        if let Some(fields) = err.errors.as_deref() {
            field_errors("", fields, &mut errors);
        }
        if let Some(details) = err.details.as_deref()
            && let Some(parameter) = details.get("parameter").and_then(Value::as_str)
        {
            let validator = details["errors"][0]["validator"].as_str().unwrap_or("type");
            errors.push(FieldErrorRecord {
                path: details.get("path").and_then(Value::as_str).unwrap_or(parameter).to_owned(),
                validator: validator.to_owned(),
                message: details.get("reason").and_then(Value::as_str).unwrap_or_default().to_owned(),
            });
        }
        Self { status: i64::from(err.status.as_u16()), code: err.code, detail: err.message, errors }
    }
}

/// Field errors keyed by path, nested for a nested object's fields, each a
/// list of `{validator, message}`.
fn field_errors(prefix: &str, fields: &Value, out: &mut Vec<FieldErrorRecord>) {
    for (key, value) in fields.as_object().into_iter().flatten() {
        let path = if prefix.is_empty() { key.clone() } else { format!("{prefix}.{key}") };
        match value {
            Value::Array(errors) => {
                for error in errors {
                    out.push(FieldErrorRecord {
                        path: path.clone(),
                        validator: error["validator"].as_str().unwrap_or_default().to_owned(),
                        message: error["message"].as_str().unwrap_or_default().to_owned(),
                    });
                }
            }
            nested => field_errors(&path, nested, out),
        }
    }
}
