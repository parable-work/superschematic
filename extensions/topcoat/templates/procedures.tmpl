/// An argument's JSON decoded into its Rust type; a value that does not
/// decode (a UUID or a timestamp that does not parse, a value an enum does
/// not have) is the 400 the router answers.
fn decode<T: DeserializeOwned>(argument: &str, value: Value) -> Result<T, ProblemRecord> {
    serde_json::from_value(value).map_err(|_| {
        ProblemRecord::from(
            ApiError::bad_request(format!("Invalid argument {argument}: does not match the declared type"))
                .with_errors(serde_json::json!({ argument: [{"validator": "type", "message": "does not match the declared type"}] })),
        )
    })
}
