{{- end }}
{{- range .Options }}
                <option value={{ rustString .Value }} selected=(form.{{ $field.Name }}.as_deref() == Some({{ rustString .Value }}))>{{ rustString .Label }}</option>
{{- end }}
            </select>
{{- else if eq .Control "checkbox" }}
            <input id={{ rustString .ID }} name={{ rustString .JSONName }} type="checkbox"{{ .Attrs }} checked=(form.{{ .Name }}.is_some()) aria-invalid=({{ .Local }}_invalid)>
{{- else }}
            <input id={{ rustString .ID }} name={{ rustString .JSONName }} type={{ rustString .Control }}{{ .Attrs }} value=(form.{{ .Name }}.clone()) aria-invalid=({{ .Local }}_invalid)>
{{- end }}
