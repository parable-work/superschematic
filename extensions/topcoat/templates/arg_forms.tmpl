            for message in {{ .Local }}_errors {
                <p class="field-error">(message)</p>
            }
        </fieldset>
{{- else }}
        <div class="field">
            <label for={{ rustString .ID }}>{{ rustString .Label }}</label>
{{- with .Hint }}
            <p class="field-hint" id={{ rustString (printf "%s-hint" $field.ID) }}>{{ rustString . }}</p>
{{- end }}
{{- if eq .Control "select" }}
