{{- /*
The argument forms of forms.rs, which forms.tmpl renders after its input
forms: one per call in `operations` with arguments a form submits.
*/ -}}
{{- define "argForms" }}
{{- range .ArgForms }}
{{- $form := . }}

{{ doc (printf "The arguments of %s.%s, each as the browser sends it%s. %s" .Namespace .Operation (or (and .Input ", its input's fields beside them") "") (or (and .IsGet "A filter, sent by GET and read from the query.") "Sent by POST.")) }}
#[derive(Debug, Clone, Default, PartialEq)]
pub struct {{ .Name }} {
{{- range .Fields }}
    pub {{ .Name }}: {{ if .IsList }}Vec<String>{{ else }}Option<String>{{ end }},
{{- end }}
{{- if .Paged }}
    /// The page asked for (D60): the cursor of the page before, a page's
    /// `next`, and the limit, as the query sends them. No control renders
    /// them, and `page` reads them by the route's rules.
    pub cursor: Option<String>,
    pub limit: Option<String>,
{{- end }}
{{- with .Sort }}
    /// The order the page is asked for in (D60, amended), the `{{ .Param }}` query
    /// parameter as sent, which `page` reads by the route's rules: none for
    /// its defaultSort. No control renders it; a sorted list's headers set
    /// it.
    pub {{ .Field }}: Option<String>,
{{- end }}
{{- with .Input }}
    pub input: {{ .Struct.Name }},
{{- end }}
{{- if .Picks }}
    /// The texts of its search pickers (D61, amended){{ if .Input }}, its input's among them{{ end }}.
    pub finds: Finds,
{{- end }}
{{- if .OwnAction }}
    /// The picker's "Find" that submitted the form (`_action`), which
    /// `apply_action` applies.
    pub row_action: Option<String>,
{{- end }}
    /// The browser sent more than `MAX_PAIRS` pairs, past which the form
    /// read none: `parse` refuses it with the form's error.
    pub overflow: bool,
}

impl {{ .Name }} {
    /// How a page sends the form: `<form method=(Self::METHOD)>`.
    pub const METHOD: &'static str = {{ rustString .Method }};

    {{ doc4 (printf "A new form%s: each argument's declared default%s." (or (and .PathFields " of one resource, whose path arguments, which the form holds as hidden inputs, the page knows") "") (or (and .Input ", and the input's new form") "")) }}
    pub fn new({{ range $i, $f := .PathFields }}{{ if $i }}, {{ end }}{{ $f.Name }}: impl ToString{{ end }}) -> Self {
        Self {
{{- range .Fields }}
{{- if .IsPath }}
            {{ .Name }}: Some({{ .Name }}.to_string()),
{{- else }}
            {{ .Name }}: {{ .NewValue }},
{{- end }}
{{- end }}
{{- if .Paged }}
            cursor: None,
            limit: None,
{{- end }}
{{- with .Sort }}
            {{ .Field }}: None,
{{- end }}
{{- with .Input }}
            input: {{ .Struct.Name }}::new(),
{{- end }}
{{- if .Picks }}
            finds: Finds::default(),
{{- end }}
{{- if .OwnAction }}
            row_action: None,
{{- end }}
            overflow: false,
        }
    }

    {{ doc4 (printf "The form a browser sent, from its pairs: each argument's first value and a list's every value%s. `Form<%s>` decodes a %s this way." (or (and .Input ", and the input's fields by their names") "") .Name (or (and .IsGet "query") "post")) }}
    pub fn from_pairs(pairs: impl IntoIterator<Item = (String, String)>) -> Self {
        let posted = Posted::from_pairs(pairs);
        Self {
{{- range .Fields }}
{{- if .IsList }}
            {{ .Name }}: posted.get({{ rustString .JSONName }}).values({{ .Split }}),
{{- else }}
            {{ .Name }}: posted.get({{ rustString .JSONName }}).first(),
{{- end }}
{{- end }}
{{- if .Paged }}
            cursor: posted.get("cursor").first(),
            limit: posted.get("limit").first(),
{{- end }}
{{- with .Sort }}
            {{ .Field }}: posted.get({{ rustString .Param }}).first(),
{{- end }}
{{- with .Input }}
            input: {{ .Struct.Name }}::from_post(&posted),
{{- end }}
{{- if .Picks }}
            finds: Finds::from_posted(posted.get("_find")),
{{- end }}
{{- if .OwnAction }}
            row_action: posted.get("_action").text(),
{{- end }}
            overflow: posted.overflow,
        }
    }
{{- if .IsGet }}

    /// The filter the current request's query holds, so a page's form shows
    /// the filters in effect: what `Form<{{ .Name }}>` reads on GET.
    pub fn from_query(cx: &Cx) -> topcoat::Result<Self> {
        let query = uri(cx).query().unwrap_or_default();
        Ok(Form::<Self>::from_bytes(query.as_bytes())?.0)
    }
{{- end }}

    {{ doc4 (printf "The operation's arguments: each written as the JSON a request carries and decoded into its type%s, then checked as the router checks a request's (`Args::check`); else each control's errors, or the form's when the browser sent more than it reads. `check` refuses the first argument that breaks a rule." (or (and .Input (or (and .Input.Optional ", the input parsed by its form when one of its fields was sent") ", the input parsed by its form")) "")) }}
    pub fn parse(&self) -> Result<crate::api::{{ .ArgsName }}, FormErrors> {
        if self.overflow {
            return Err(overflowed());
        }
        let mut errors = FormErrors::default();
{{- range .Fields }}
        let {{ .Local }} = {{ .ReadExpr }};
{{- end }}
{{- with .Input }}
{{- if .Optional }}
        // The input is optional: absent when none of its fields was sent.
        let input = match self.input.is_sent().then(|| self.input.parse()).transpose() {
{{- else }}
        let input = match self.input.parse() {
{{- end }}
            Ok(input) => Some(input),
            Err(refused) => {
                errors.merge(refused);
                None
            }
        };
{{- end }}
{{- if .Paged }}
        let page = match self.page() {
            Ok(page) => Some(page),
            Err(err) => {
                errors.merge(FormErrors::from_api(&err));
                None
            }
        };
{{- end }}
{{- range .Fields }}
        let Some({{ .Local }}) = {{ .Local }} else {
            return Err(errors);
        };
{{- end }}
{{- if .Paged }}
        let Some(page) = page else {
            return Err(errors);
        };
{{- end }}
{{- if .Input }}
        let Some(input) = input else {
            return Err(errors);
        };
{{- end }}
        let args = crate::api::{{ .ArgsName }} {
{{- range .Fields }}
            {{ .Name }}: {{ .Local }},
{{- end }}
{{- with .Input }}
            input,
{{- end }}
{{- if .Paged }}
            page,
{{- end }}
        };
        args.check().map_err(|err| FormErrors::from_api(&err))?;
        Ok(args)
    }
{{- if .Paged }}
{{- if .Sort }}

    /// The page the form asks for, its `cursor`, `limit` and `{{ .Sort.Param }}` read by
    /// the route's rules (`PageSpec::query`, D60, amended): an absent cursor
    /// is the first page, an absent limit the route's default and an absent
    /// sort its defaultSort, which the call fills in, and a refusal is the
    /// router's 400 at the first it refuses. The cursor is still bound to
    /// its sort; the in-process call unbinds it.
{{- else }}

    /// The page the form asks for, its `cursor` and `limit` read by the
    /// route's rules (`PageSpec::query`, D60): an absent cursor is the first
    /// page and an absent limit the route's default, and a refusal is the
    /// router's 400 at either.
{{- end }}
    pub fn page(&self) -> Result<runtime::page::PageRequest, ApiError> {
        let pairs = [("cursor", &self.cursor), ("limit", &self.limit){{ with .Sort }}, ({{ rustString .Param }}, &self.{{ .Field }}){{ end }}]
            .into_iter()
            .filter_map(|(name, value)| value.clone().map(|value| (name.to_owned(), value)))
            .collect();
        crate::api::{{ .ArgsName }}::PAGE.query(&QueryValues::new(pairs))
    }
{{- if .Sort }}

    /// The pairs the form holds as a query sends them, in control order:
    /// each argument's values as sent, then the sort and `limit` when sent,
    /// never `cursor`. A page links the next page and the first with them,
    /// so each keeps the filter, the order and the limit.
{{- else }}

    /// The pairs the form holds as a query sends them, in control order:
    /// each argument's values as sent, then `limit` when sent, never
    /// `cursor`. A page links the next page and the first with them, so each
    /// keeps the filter and the limit.
{{- end }}
    pub fn query_pairs(&self) -> Vec<(String, String)> {
        let mut pairs = Vec::new();
{{- range .QueryFields }}
{{- if .IsList }}
        pairs.extend(self.{{ .Name }}.iter().map(|value| ({{ rustString .JSONName }}.to_owned(), value.clone())));
{{- else }}
        if let Some(value) = &self.{{ .Name }} {
            pairs.push(({{ rustString .JSONName }}.to_owned(), value.clone()));
        }
{{- end }}
{{- end }}
{{- with .Sort }}
        if let Some(sort) = &self.{{ .Field }} {
            pairs.push(({{ rustString .Param }}.to_owned(), sort.clone()));
        }
{{- end }}
        if let Some(limit) = &self.limit {
            pairs.push(("limit".to_owned(), limit.clone()));
        }
        pairs
    }
{{- end }}
{{ if .ServiceOnly }}
    {{ doc4 (printf "Parses the form, then calls the operation in-process as `service`, a service this process acts for (`operations::as_service(service).%s`): its route admits only a service caller (@requireService), so the form has no `submit` (D37, amended). Call it only where the page acts as that service, never just because a reader sent the form: the call carries the service's authority, and the page's caller is the end user it forwards when the route asks for one. A refusal is the status a page answers with and the errors it renders the form again with: 422 and `parse`'s errors, or the route's status (401, 403, 404, 409, ...) and the operation's errors (`Refusal::from_api`)." .Call) }}
    pub async fn submit_as(&self, cx: &Cx, service: &crate::api::runtime::ServiceCaller) -> Result<{{ .Output }}, Refusal> {
{{- else }}
    {{ doc4 (printf "Parses the form, then calls the operation in-process (`operations::%s`). A refusal is the status a page answers with and the errors it renders the form again with: 422 and `parse`'s errors, or the route's status (401, 403, 404, 409, ...) and the operation's errors (`Refusal::from_api`)." .Call) }}
    pub async fn submit(&self, cx: &Cx) -> Result<{{ .Output }}, Refusal> {
{{- end }}
{{- if .Paged }}
        // A cursor or a limit the route refuses is its 400, as the router
        // answers it.
        self.page().map_err(|err| Refusal::from_api(&err))?;
{{- end }}
        let args = self.parse()?;
{{- if .ServiceOnly }}
        operations::as_service(service).{{ .Call }}(cx, args).await.map_err(|err| Refusal::from_api(&err))
{{- else }}
        operations::{{ .Call }}(cx, args).await.map_err(|err| Refusal::from_api(&err))
{{- end }}
    }
{{- if .Acts }}
{{- if and .InputActs .Picks }}

    /// Applies the button that submitted the form to its input
    /// (`{{ .Input.Struct.Name }}::apply_action`), a picker's "Find", an argument's or the
    /// input's, recorded as pressed (D61, amended): true when one did, and
    /// the page renders the form again without calling the operation.
{{- else if .InputActs }}

    /// Applies the row button that submitted the form to its input's rows
    /// (`{{ .Input.Struct.Name }}::apply_action`): true when a row button
    /// submitted it, and the page renders the form again without calling
    /// the operation.
{{- end }}
{{- if .InputActs }}
    pub fn apply_action(&mut self) -> bool {
{{- if .Picks }}
        if let Some(name) = self.input.row_action.as_deref().and_then(|action| action.strip_prefix("find:")) {
            self.finds.pressed = Some(name.to_owned());
        }
{{- end }}
        self.input.apply_action()
    }
{{- else }}

    /// Applies the picker's "Find" that submitted the form, `row_action`,
    /// `find:` and its name, which it records as pressed (D61, amended):
    /// true when one did, and the page renders the form again with what its
    /// text finds, without calling the operation.
    pub fn apply_action(&mut self) -> bool {
        let Some(action) = self.row_action.take() else {
            return false;
        };
        if let Some(name) = action.strip_prefix("find:") {
            self.finds.pressed = Some(name.to_owned());
        }
        true
    }
{{- end }}
{{- end }}

    {{ doc4 (printf "Whether the component shows the errors at `path`: at an argument's control%s. A path argument's are the form's own." (or (and .Input " or the input's") "")) }}
{{- if not .ShownArgs }}
    fn shows({{ if not .Input }}_{{ end }}path: &[Segment]) -> bool {
{{- with .Input }}
        {{ .Struct.Name }}::shows(path)
{{- else }}
        false
{{- end }}
    }
{{- else }}
    fn shows(path: &[Segment]) -> bool {
        match path {
            [Segment::Key(key), rest @ ..] => match key.as_str() {
{{- range .Fields }}
{{- if not .IsPath }}
{{- if or .IsList (eq .Control "textarea") }}
                {{ rustString .JSONName }} => shows_all(rest),
{{- else }}
                {{ rustString .JSONName }} => rest.is_empty(),
{{- end }}
{{- end }}
{{- end }}
{{- with .Input }}
                _ => {{ .Struct.Name }}::shows(path),
{{- else }}
                _ => false,
{{- end }}
            },
            _ => false,
        }
    }
{{- end }}
}

impl<'de> Deserialize<'de> for {{ .Name }} {
    /// Reads the pairs a browser sends, as Topcoat's `Form` hands them, by
    /// `from_pairs`.
    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
        Vec::<(String, String)>::deserialize(deserializer).map(Self::from_pairs)
    }
}

{{ doc (printf "The controls of `%s`: each argument's, with its label, its value as sent, the attributes its rules give it and its errors, a path argument's a hidden input%s. `choices` turns a text or number control the app names into a select." .Name (or (and .Input "; then the input's fields") "")) }}
#[component]
pub async fn {{ .Component }}(
    #[default] form: {{ .Name }},
    #[default] errors: FormErrors,
    #[default] choices: Choices,
) -> topcoat::Result<impl View> {
    let form_errors = errors.unshown({{ .Name }}::shows);
{{- if not .Choosable }}
    let _ = choices;
{{- end }}
{{- if not .UsesForm }}
    let _ = form;
{{- end }}
    Ok(view! {
{{- if .Hidden }}
        // The button Enter presses, ahead of every {{ if .Rows }}row button{{ if .Picks }} and "Find"{{ end }}{{ else }}"Find"{{ end }}: it submits
        // the form{{ if not .IsGet }} without an `_action`{{ end }}.
        <button type="submit" class="ss-submit" hidden=(true)></button>
{{- end }}
        for message in form_errors {
            <p class="form-error">(message)</p>
        }
{{- if .Body }}
{{ .Body }}
{{- end }}
    })
}
{{- end }}
{{- end }}
