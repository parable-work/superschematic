            }
        </fieldset>
{{- else if eq .Control "repeated" }}
        <fieldset class="field">
            <legend>{{ rustString .Label }}</legend>
{{- with .Hint }}
            <p class="field-hint">{{ rustString . }}</p>
{{- end }}
            for value in form.{{ .Name }}.clone() {
                <input name={{ rustString .JSONName }} type={{ rustString .Type }}{{ .Attrs }} aria-label={{ rustString .Label }} value=(value) aria-invalid=({{ .Local }}_invalid)>
            }
