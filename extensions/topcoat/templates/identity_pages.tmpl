/// The trail of the identity page at `path` after the index, each step's
/// label and link, the last the page itself, a user by their name and a
/// role by its; none for a path that is no identity page's.
pub async fn trail(cx: &Cx, path: &str) -> Option<Vec<(String, Option<String>)>> {
    let rest = path.strip_prefix(PREFIX)?.strip_prefix('/')?;
    let words: Vec<&str> = rest.split('/').collect();
    let step = |label: &str, href: Option<&str>| (label.to_owned(), href.map(str::to_owned));
    let steps = match words.as_slice() {
        ["sign-in"] => vec![step("Sign in", None)],
        ["sign-out"] => vec![step("Sign out", None)],
{{- if $signUp }}
        ["sign-up"] => vec![step("Sign up", None)],
{{- end }}
        ["account"] => vec![step("Account", None)],
        ["users"] => vec![step("Users", None)],
        ["users", "new"] => vec![step("Users", Some(USERS)), step("New user", None)],
        ["users", id, ..] => {
            let id = decode(id);
            let label = match user_of(cx, &id).await {
                Ok(found) => user_label(found),
                Err(_) => format!("User {id}"),
            };
            vec![step("Users", Some(USERS)), (label, Some(user_href(&id)))]
        }
        ["roles"] => vec![step("Roles", None)],
        ["roles", "new"] => vec![step("Roles", Some(ROLES)), step("New role", None)],
        ["roles", id, after @ ..] => {
            let id = decode(id);
            let label = match role_of(cx, &id).await {
                Ok(role) => role.name.clone(),
                Err(_) => format!("Role {id}"),
            };
            let mut steps = vec![step("Roles", Some(ROLES)), (label, Some(role_href(&id)))];
            if let ["delete"] = after {
                steps.push(step("Delete", None));
            }
            steps
        }
        _ => return None,
    };
    Some(steps)
}

/// The identity runtime's service the API authenticates with, which every
/// page calls; the 500 of an app that does not host the API.
fn service(cx: &Cx) -> Result<&Service, Refusal> {
    match crate::setup(cx) {
        Ok(setup) => Ok(setup.implementations.authenticator.service().as_ref()),
        Err(err) => Err(Refusal::from_api(&err)),
    }
}

/// The page's caller as the identity runtime signed them in: none when no
/// one is, or when the app's `PageAuthenticator` gives a caller another
/// authenticator made. A session the runtime refuses is its refusal: 401,
/// whose response clears the cookie, or 403 `cross_origin`.
async fn signed_in(cx: &Cx) -> Result<Option<IdentityPrincipal>, ApiError> {
    let caller = crate::caller(cx).await.map_err(ApiError::clone)?;
    Ok(caller.as_ref().and_then(IdentityPrincipal::from_principal))
}

/// The caller of a page that needs one, or its refusal: 401 when no one is
/// signed in.
async fn needs_caller(cx: &Cx) -> Result<IdentityPrincipal, Refusal> {
    match signed_in(cx).await {
        Ok(Some(caller)) => Ok(caller),
        Ok(None) => Err(Refusal::from_api(&ApiError::unauthorized("Authentication required"))),
        Err(err) => Err(Refusal::from_api(&err)),
    }
}

/// Whether the caller holds the administration permission `name`
/// (`users.read`, ...) under the service's prefix, by the rule its calls
/// check it with.
fn may(service: &Service, caller: &IdentityPrincipal, name: &str) -> bool {
    service.permits(&caller.permissions, &[service.permission(name)])
}

/// The refusal of a page whose form the caller may not post, as the
/// service words it: 403.
fn allowed(service: &Service, caller: &IdentityPrincipal, name: &str) -> Result<(), Refusal> {
    if may(service, caller, name) {
        Ok(())
    } else {
        Err(Refusal::from_api(&ApiError::forbidden("Insufficient permissions")))
    }
}

/// A refusal of the service's as a form shows it (`Refusal::from_api`),
/// but for one that names permissions (`details.permissions`): a role's
/// that are malformed (422), or that the caller does not hold and so may
/// not give (403). Its message lists them, at the control `at`.
fn refusal_of(err: &ApiError, at: &str) -> Refusal {
    let named: Vec<&str> = err
        .details
        .as_deref()
        .and_then(|details| details.get("permissions"))
        .and_then(Value::as_array)
        .into_iter()
        .flatten()
        .filter_map(Value::as_str)
        .collect();
    if named.is_empty() {
        return Refusal::from_api(err);
    }
    let mut errors = FormErrors::default();
    errors.add(at, format!("{}: {}", err.message, named.join(", ")));
    Refusal { status: err.status, errors }
}

/// Whether a refusal renders on its own, in place of its page's form: a
/// caller who is not signed in (401), a user or role that is not there
/// (404), and a 403 that is not a form's (a permission the caller lacks,
/// a cross-origin post). Any other renders the form again.
fn alone(refusal: &Refusal) -> bool {
    matches!(refusal.status.as_u16(), 401 | 404) || refusal.status == StatusCode::FORBIDDEN && refusal.errors.fields.is_empty()
}

/// What a form shows above its controls: its own messages, then those of
/// a name it has no control for, each after the name.
fn unshown(errors: &FormErrors, shown: &[&str]) -> Vec<String> {
    let mut out = errors.form.clone();
    for (name, messages) in &errors.fields {
        if !shown.contains(&name.as_str()) {
            out.extend(messages.iter().map(|message| format!("{name}: {message}")));
        }
    }
    out
}

/// Adds `name is required`, as the service words it, for a control left
/// empty.
fn require(errors: &mut FormErrors, name: &str, value: &str) {
    if value.is_empty() {
        errors.add(name, format!("{name} is required"));
    }
}

/// Adds the refusal of a new password: required, and as the runtime's rule
/// (`check_password`) has it.
fn require_password(errors: &mut FormErrors, name: &str, password: &str) {
    if password.is_empty() {
        errors.add(name, format!("{name} is required"));
    } else if let Err(reason) = identity::check_password(password) {
        errors.add(name, reason);
    }
}

/// The 422 of a form's errors, or nothing.
fn parsed(errors: FormErrors) -> Result<(), Refusal> {
    if errors.is_empty() { Ok(()) } else { Err(Refusal::from(errors)) }
}

/// Where a sign-in goes on to: `next` when it is a path of this site, `/`
/// then anything but a second `/`, with no `\` or control character, which
/// a browser could read as another host; else the index.
fn local_next(next: &str) -> String {
    let local = next.starts_with('/')
        && !next.starts_with("//")
        && !next.chars().any(|c| c == '\\' || c.is_control());
    if local { next.to_owned() } else { PREFIX.to_owned() }
}

/// Appends a `Set-Cookie` to the page's response, which a redirect carries
/// too.
fn set_cookie(cx: &Cx, cookie: &str) {
    if let Ok(value) = HeaderValue::from_str(cookie) {
        response_headers(cx).append(SET_COOKIE, value);
    }
}

/// Sets the cookie of a session a sign-in or a sign-up issued, as the
/// runtime's login route sets it.
fn keep(cx: &Cx, service: &Service, issued: &IssuedSession) {
    let config = service.config();
    set_cookie(cx, &config.session_cookie(&issued.token, config.session_ttl()));
}

fn user_href(id: &str) -> String {
    format!("{USERS}/{}", encode(id))
}

fn role_href(id: &str) -> String {
    format!("{ROLES}/{}", encode(id))
}

/// A user as a heading names them: their name, else their login.
fn user_label(user: &IdentityUser) -> String {
    if user.name.trim().is_empty() { user.login.clone() } else { user.name.clone() }
}

/// The user with the id, as the caller may read them. The request keeps
/// it (`#[memoize]`), so the page and the trail ask once.
#[memoize(as_ref)]
async fn user_of(cx: &Cx, id: &str) -> Result<IdentityUser, Refusal> {
    let caller = needs_caller(cx).await?;
    service(cx)?.get_user(&caller, id).await.map_err(|err| Refusal::from_api(&err))
}

/// Every role, as the caller may read them. The request keeps them
/// (`#[memoize]`).
#[memoize(as_ref)]
async fn roles_of(cx: &Cx) -> Result<Vec<IdentityRole>, Refusal> {
    let caller = needs_caller(cx).await?;
    service(cx)?.list_roles(&caller).await.map_err(|err| Refusal::from_api(&err))
}

/// The role with the id among every role the caller may read; 404 for
/// none.
async fn role_of<'a>(cx: &'a Cx, id: &str) -> Result<&'a IdentityRole, Refusal> {
    let roles = roles_of(cx).await.map_err(Refusal::clone)?;
    roles
        .iter()
        .find(|role| role.id == id)
        .ok_or_else(|| Refusal::from_api(&ApiError::not_found("Role not found")))
}

/// A text control, its label, and its messages.
#[component]
async fn text_field(
    id: &'static str,
    name: &'static str,
    label: &'static str,
    autocomplete: &'static str,
    required: bool,
    value: String,
    errors: Vec<String>,
) -> topcoat::Result<impl View> {
    let invalid = (!errors.is_empty()).then_some("true");
    Ok(view! {
        <div class="field">
            <label for=(id)>(label)</label>
            <input id=(id) name=(name) type="text" value=(value) autocomplete=(autocomplete) required=(required) aria-invalid=(invalid)>
            for message in errors {
                <p class="field-error">(message)</p>
            }
        </div>
    })
}

/// A password control, its label, and its messages. It takes no value, so
/// a password sent is never rendered again.
#[component]
async fn password_field(
    id: &'static str,
    name: &'static str,
    label: &'static str,
    autocomplete: &'static str,
    errors: Vec<String>,
) -> topcoat::Result<impl View> {
    let invalid = (!errors.is_empty()).then_some("true");
    Ok(view! {
        <div class="field">
            <label for=(id)>(label)</label>
            <input id=(id) name=(name) type="password" autocomplete=(autocomplete) required=(true) aria-invalid=(invalid)>
            for message in errors {
                <p class="field-error">(message)</p>
            }
        </div>
    })
}

/// The messages above a form's controls.
#[component]
async fn form_errors(messages: Vec<String>) -> topcoat::Result<impl View> {
    Ok(view! {
        for message in messages {
            <p class="form-error">(message)</p>
        }
    })
}

