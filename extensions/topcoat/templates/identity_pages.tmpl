/// Every user, and whether the caller may add one.
async fn users(cx: &Cx) -> Result<(Vec<IdentityUser>, bool), Refusal> {
    let caller = needs_caller(cx).await?;
    let service = service(cx)?;
    let users = service.list_users(&caller).await.map_err(|err| Refusal::from_api(&err))?;
    Ok((users, may(service, &caller, identity::PERMISSION_USERS_WRITE)))
}

/// The state of a user, as the pages word it.
fn state_of(disabled: bool) -> &'static str {
    if disabled { "Disabled" } else { "Active" }
}

/// The users as a table: a row per user, its login linked to their page.
#[component]
async fn users_list(users: Vec<IdentityUser>, writes: bool) -> topcoat::Result<impl View> {
    let rows: Vec<(String, String, String, String, &'static str)> = users
        .into_iter()
        .map(|user| {
            let roles: Vec<String> = user.roles.into_iter().map(|role| role.name).collect();
            (user_href(&user.id), user.login, user.name, roles.join(", "), state_of(user.disabled))
        })
        .collect();
    Ok(view! {
        <h1>"Users"</h1>
        if writes {
            <p class="ss-actions"><a class="ss-new" href=(NEW_USER)>"New user"</a></p>
        }
        if rows.is_empty() {
            <p class="ss-empty">"There are no users."</p>
        } else {
            <table class="ss-table" data-type="User">
                <caption>"Users"</caption>
                <thead>
                    <tr>
                        <th scope="col" data-field="login">"Login"</th>
                        <th scope="col" data-field="name">"Name"</th>
                        <th scope="col" data-field="roles">"Roles"</th>
                        <th scope="col" data-field="state">"State"</th>
                    </tr>
                </thead>
                <tbody>
                    for (href, login, name, roles, state) in rows {
                        <tr>
                            <th scope="row" data-field="login"><a href=(href)>(login)</a></th>
                            <td data-field="name">(name)</td>
                            <td data-field="roles">(roles)</td>
                            <td data-field="state">(state)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    })
}

/// The new-user form as a browser sends it.
#[derive(Clone, Default, Deserialize)]
#[serde(default)]
pub struct NewUserForm {
    pub login: String,
    pub name: String,
    pub password: String,
}

/// The page that adds a user, for a caller who may.
#[page({{ rustString (printf "%s/users/new" $p) }})]
pub async fn identity_new_user_page(cx: &Cx) -> topcoat::Result<impl View> {
    let admitted = may_write(cx, identity::PERMISSION_USERS_WRITE).await;
    Ok(view! {
        match admitted {
            Err(refusal) => refused(refusal: refusal, next: NEW_USER),
            Ok(()) => new_user_form(login: String::new(), name: String::new(), errors: FormErrors::default()),
        }
    })
}

/// Adds the user, then goes to their page (303); a refusal renders the
/// form again with its status, a taken login's 409 its message.
#[page(POST {{ rustString (printf "%s/users/new" $p) }})]
pub async fn identity_create_user_page(cx: &Cx, Form(form): Form<NewUserForm>) -> topcoat::Result<impl View> {
    let refusal = match create_user(cx, &form).await {
        Ok(user) => return Err(see_other(user_href(&user.id)).into()),
        Err(refusal) => refusal,
    };
    Ok(view! {
        if alone(&refusal) {
            refused(refusal: refusal, next: NEW_USER)
        } else {
            (refusal.status)
            new_user_form(login: form.login, name: form.name, errors: refusal.errors)
        }
    })
}

/// Whether the caller may post a form that needs the administration
/// permission `name`: 401 for no one signed in, 403 without it.
async fn may_write(cx: &Cx, name: &str) -> Result<(), Refusal> {
    let caller = needs_caller(cx).await?;
    allowed(service(cx)?, &caller, name)
}

async fn create_user(cx: &Cx, form: &NewUserForm) -> Result<IdentityUser, Refusal> {
    let caller = needs_caller(cx).await?;
    let mut errors = FormErrors::default();
    require(&mut errors, "login", &form.login);
    require_password(&mut errors, "password", &form.password);
    parsed(errors)?;
    let input = CreateUserInput { login: form.login.clone(), name: form.name.clone(), password: form.password.clone() };
    service(cx)?.create_user(&caller, &input).await.map_err(|err| Refusal::from_api(&err))
}

/// The new-user form, the login and the name as sent and never the
/// password.
#[component]
async fn new_user_form(login: String, name: String, errors: FormErrors) -> topcoat::Result<impl View> {
    let messages = unshown(&errors, &["login", "name", "password"]);
    Ok(view! {
        <h1>"New user"</h1>
        <form method="post" action=(NEW_USER) class="ss-form">
            form_errors(messages: messages)
            text_field(id: "identity-new-user-login", name: "login", label: "Login", autocomplete: "off", required: true, value: login, errors: errors.of("login"))
            text_field(id: "identity-new-user-name", name: "name", label: "Name", autocomplete: "off", required: false, value: name, errors: errors.of("name"))
            password_field(id: "identity-new-user-password", name: "password", label: "Password", autocomplete: "new-password", errors: errors.of("password"))
            <button type="submit">"Add the user"</button>
        </form>
    })
}

/// A user's page as the caller may see it: the user, the roles the caller
/// may grant them, and whether the caller may change the user and their
/// roles.
#[derive(Clone)]
struct UserPage {
    user: IdentityUser,
    grantable: Vec<IdentityRole>,
    writes_users: bool,
    writes_roles: bool,
}

/// A form of a user's page that was refused, by its name (`access`,
/// `password`, `grant`, `revoke`), and its errors.
#[derive(Clone, Default)]
struct Failed {
    form: &'static str,
    errors: FormErrors,
}

impl Failed {
    /// The errors of the form `name`: none unless it was the one refused.
    fn of(&self, name: &str) -> FormErrors {
        if self.form == name { self.errors.clone() } else { FormErrors::default() }
    }
}

async fn user_page(cx: &Cx, id: &str) -> Result<UserPage, Refusal> {
    let user = user_of(cx, id).await.map_err(Refusal::clone)?.clone();
    let caller = needs_caller(cx).await?;
    let service = service(cx)?;
    let writes_roles = may(service, &caller, identity::PERMISSION_ROLES_WRITE);
    let grantable = match roles_of(cx).await {
        Ok(roles) if writes_roles => {
            roles.iter().filter(|role| !user.roles.iter().any(|held| held.id == role.id)).cloned().collect()
        }
        _ => Vec::new(),
    };
    Ok(UserPage { user, grantable, writes_users: may(service, &caller, identity::PERMISSION_USERS_WRITE), writes_roles })
}

/// A user's page: their login, name, state and roles, and for a caller who
/// may, the forms that disable or enable them, set their password, and
/// grant or revoke a role.
#[page({{ rustString (printf "%s/users/{user_id}" $p) }})]
pub async fn identity_user_page(cx: &Cx) -> topcoat::Result<impl View> {
    let id = path_param::<UserId>(cx).to_owned();
    let found = user_page(cx, &id).await;
    Ok(view! {
        match found {
            Err(refusal) => refused(refusal: refusal, next: user_href(&id)),
            Ok(page) => user_details(page: page, failed: Failed::default()),
        }
    })
}

/// A user's page again after a post that was refused, with its status
/// and the refusal at its form; or a refusal alone.
type UserShown = Result<(StatusCode, UserPage, Failed), Refusal>;

/// What a post to a user's page answers: 303 back to the page once the
/// service is done; else its refusal alone (`alone`), or the page again
/// with the refusal at the form `form`, with its status (`user_answer`).
async fn user_posted(cx: &Cx, id: &str, form: &'static str, sent: Result<(), Refusal>) -> topcoat::Result<UserShown> {
    let refusal = match sent {
        Ok(()) => return Err(see_other(user_href(id)).into()),
        Err(refusal) => refusal,
    };
    if alone(&refusal) {
        return Ok(Err(refusal));
    }
    Ok(user_page(cx, id).await.map(|page| (refusal.status, page, Failed { form, errors: refusal.errors })))
}

/// A post's answer that renders: the user's page again, or a refusal
/// alone.
#[component]
async fn user_answer(id: String, shown: UserShown) -> topcoat::Result<impl View> {
    Ok(view! {
        match shown {
            Err(refusal) => refused(refusal: refusal, next: user_href(&id)),
            Ok((status, page, failed)) => {
                (status)
                user_details(page: page, failed: failed)
            },
        }
    })
}

/// Disables the user, which ends their sessions, then goes back to their
/// page (303).
#[page(POST {{ rustString (printf "%s/users/{user_id}/disable" $p) }})]
pub async fn identity_disable_user_page(cx: &Cx) -> topcoat::Result<impl View> {
    let id = path_param::<UserId>(cx).to_owned();
    let sent = set_disabled(cx, &id, true).await;
    let shown = user_posted(cx, &id, "access", sent).await?;
    Ok(view! { user_answer(id: id, shown: shown) })
}

/// Enables the user, then goes back to their page (303).
#[page(POST {{ rustString (printf "%s/users/{user_id}/enable" $p) }})]
pub async fn identity_enable_user_page(cx: &Cx) -> topcoat::Result<impl View> {
    let id = path_param::<UserId>(cx).to_owned();
    let sent = set_disabled(cx, &id, false).await;
    let shown = user_posted(cx, &id, "access", sent).await?;
    Ok(view! { user_answer(id: id, shown: shown) })
}

async fn set_disabled(cx: &Cx, id: &str, disabled: bool) -> Result<(), Refusal> {
    let caller = needs_caller(cx).await?;
    let service = service(cx)?;
    let done = if disabled { service.disable_user(&caller, id).await } else { service.enable_user(&caller, id).await };
    done.map(drop).map_err(|err| Refusal::from_api(&err))
}

/// The set-password form as a browser sends it.
#[derive(Clone, Default, Deserialize)]
#[serde(default)]
pub struct SetPasswordForm {
    pub password: String,
}

/// Sets the user's password, which ends their sessions, then goes back to
/// their page (303).
#[page(POST {{ rustString (printf "%s/users/{user_id}/password" $p) }})]
pub async fn identity_set_password_page(cx: &Cx, Form(form): Form<SetPasswordForm>) -> topcoat::Result<impl View> {
    let id = path_param::<UserId>(cx).to_owned();
    let sent = set_password(cx, &id, &form).await;
    let shown = user_posted(cx, &id, "password", sent).await?;
    Ok(view! { user_answer(id: id, shown: shown) })
}

async fn set_password(cx: &Cx, id: &str, form: &SetPasswordForm) -> Result<(), Refusal> {
    let caller = needs_caller(cx).await?;
    let mut errors = FormErrors::default();
    require_password(&mut errors, "password", &form.password);
    parsed(errors)?;
    let input = SetPasswordInput { password: form.password.clone() };
    service(cx)?.set_user_password(&caller, id, &input).await.map_err(|err| Refusal::from_api(&err))
}

/// The grant and revoke forms as a browser sends them: the role's id.
#[derive(Clone, Default, Deserialize)]
#[serde(default)]
pub struct RoleChoiceForm {
    pub role: String,
}

/// Grants the user the role, then goes back to their page (303); a role
/// whose permissions the caller does not hold is refused (403) at the
/// form.
#[page(POST {{ rustString (printf "%s/users/{user_id}/grant" $p) }})]
pub async fn identity_grant_role_page(cx: &Cx, Form(form): Form<RoleChoiceForm>) -> topcoat::Result<impl View> {
    let id = path_param::<UserId>(cx).to_owned();
    let sent = grant(cx, &id, &form.role, true).await;
    let shown = user_posted(cx, &id, "grant", sent).await?;
    Ok(view! { user_answer(id: id, shown: shown) })
}

/// Revokes the role from the user, then goes back to their page (303).
#[page(POST {{ rustString (printf "%s/users/{user_id}/revoke" $p) }})]
pub async fn identity_revoke_role_page(cx: &Cx, Form(form): Form<RoleChoiceForm>) -> topcoat::Result<impl View> {
    let id = path_param::<UserId>(cx).to_owned();
    let sent = grant(cx, &id, &form.role, false).await;
    let shown = user_posted(cx, &id, "revoke", sent).await?;
    Ok(view! { user_answer(id: id, shown: shown) })
}

/// Grants the user the role, or revokes it.
async fn grant(cx: &Cx, id: &str, role: &str, grant: bool) -> Result<(), Refusal> {
    let caller = needs_caller(cx).await?;
    let mut errors = FormErrors::default();
    require(&mut errors, "role", role);
    parsed(errors)?;
    let service = service(cx)?;
    let done = if grant { service.grant_role(&caller, id, role).await } else { service.revoke_role(&caller, id, role).await };
    done.map(drop).map_err(|err| refusal_of(&err, "role"))
}

/// A user's page: their details, their roles with a revoke button each,
/// the grant form, and the forms that disable or enable them and set their
/// password, each for a caller who may.
#[component]
async fn user_details(page: UserPage, failed: Failed) -> topcoat::Result<impl View> {
    let UserPage { user, grantable, writes_users, writes_roles } = page;
    let href = user_href(&user.id);
    let heading = user_label(&user);
    let state = state_of(user.disabled);
    let (toggle, toggle_label) =
        if user.disabled { (format!("{href}/enable"), "Enable the user") } else { (format!("{href}/disable"), "Disable the user") };
    let held: Vec<(String, String)> = user.roles.iter().map(|role| (role.id.clone(), role.name.clone())).collect();
    let grantable: Vec<(String, String)> = grantable.into_iter().map(|role| (role.id, role.name)).collect();
    let (access, password, granting, revoking) = (failed.of("access"), failed.of("password"), failed.of("grant"), failed.of("revoke"));
    let (access_messages, password_messages) = (unshown(&access, &[]), unshown(&password, &["password"]));
    let (grant_messages, revoke_messages) = (unshown(&granting, &["role"]), unshown(&revoking, &[]));
    Ok(view! {
        <h1>(heading)</h1>
        <div class="ss-detail" data-type="User" role="group" aria-label="User">
            <dl>
                <div data-field="login">
                    <dt>"Login"</dt>
                    <dd>(user.login)</dd>
                </div>
                <div data-field="name">
                    <dt>"Name"</dt>
                    <dd>(user.name)</dd>
                </div>
                <div data-field="state">
                    <dt>"State"</dt>
                    <dd>(state)</dd>
                </div>
            </dl>
        </div>
        <section class="ss-section" aria-labelledby="identity-user-roles">
            <h2 id="identity-user-roles">"Roles"</h2>
            form_errors(messages: revoke_messages)
            if held.is_empty() {
                <p class="ss-empty">"The user has no roles."</p>
            } else {
                <ul class="ss-roles">
                    for (id, name) in held {
                        <li>
                            (name.clone())
                            if writes_roles {
                                <form method="post" action=(format!("{href}/revoke")) class="ss-action" data-action="revoke">
                                    <input type="hidden" name="role" value=(id)>
                                    <button type="submit" aria-label=(format!("Revoke {name}"))>"Revoke"</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }
            if writes_roles && !grantable.is_empty() {
                <form method="post" action=(format!("{href}/grant")) class="ss-form" data-action="grant">
                    form_errors(messages: grant_messages)
                    <div class="field">
                        <label for="identity-user-grant-role">"Role"</label>
                        <select id="identity-user-grant-role" name="role" required=(true) aria-invalid=(granting.invalid("role"))>
                            for (id, name) in grantable {
                                <option value=(id)>(name)</option>
                            }
                        </select>
                        for message in granting.of("role") {
                            <p class="field-error">(message)</p>
                        }
                    </div>
                    <button type="submit">"Grant the role"</button>
                </form>
            }
        </section>
        if writes_users {
            <section class="ss-section" aria-labelledby="identity-user-access">
                <h2 id="identity-user-access">"Access"</h2>
                <form method="post" action=(toggle) class="ss-action" data-action="access">
                    form_errors(messages: access_messages)
                    <button type="submit">(toggle_label)</button>
                </form>
                <form method="post" action=(format!("{href}/password")) class="ss-form" data-action="password">
                    <p>"Setting the password signs the user out of every session."</p>
                    form_errors(messages: password_messages)
                    password_field(id: "identity-user-password", name: "password", label: "New password", autocomplete: "new-password", errors: password.of("password"))
                    <button type="submit">"Set the password"</button>
                </form>
            </section>
        }
    })
}

/// The roles, each linked to its page, and a link to add one for a caller
