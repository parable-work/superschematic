                </div>
            </dl>
        </div>
        <section class="ss-section" aria-labelledby="identity-account-password">
            <h2 id="identity-account-password">"Change password"</h2>
            <p>"Changing your password signs you out of every other session."</p>
            <form method="post" action=(ACCOUNT) class="ss-form">
                form_errors(messages: messages)
                password_field(id: "identity-account-current", name: "current", label: "Current password", autocomplete: "current-password", errors: errors.of("current"))
                password_field(id: "identity-account-password", name: "password", label: "New password", autocomplete: "new-password", errors: errors.of("password"))
