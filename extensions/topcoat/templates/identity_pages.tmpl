#[derive(Clone, Default, Deserialize)]
#[serde(default)]
pub struct ChangePasswordForm {
    pub current: String,
    pub password: String,
}

/// The caller's account: their login, name and roles, and the form that
/// changes their password.
#[page({{ rustString (printf "%s/account" $p) }})]
pub async fn identity_account_page(cx: &Cx) -> topcoat::Result<impl View> {
    let found = me(cx).await;
    Ok(view! {
        match found {
            Err(refusal) => refused(refusal: refusal, next: ACCOUNT),
            Ok(me) => account_view(me: me, errors: FormErrors::default()),
        }
    })
}

/// Changes the caller's password once their current one verifies, which
/// ends their other sessions, then goes back to the account (303); a
/// refusal renders the account again with its status, a wrong current
/// password's 401 its message.
#[page(POST {{ rustString (printf "%s/account" $p) }})]
pub async fn identity_change_password_page(cx: &Cx, Form(form): Form<ChangePasswordForm>) -> topcoat::Result<impl View> {
    let refusal = match change_password(cx, &form).await {
        Ok(()) => return Err(see_other(ACCOUNT).into()),
        Err(refusal) => refusal,
    };
    let shown = match me(cx).await {
        Ok(me) if !matches!(refusal.status.as_u16(), 403 | 404) => Ok((me, refusal)),
        Ok(_) => Err(refusal),
        Err(other) => Err(other),
    };
    Ok(view! {
        match shown {
            Err(refusal) => refused(refusal: refusal, next: ACCOUNT),
            Ok((me, refusal)) => {
                (refusal.status)
                account_view(me: me, errors: refusal.errors)
            },
        }
    })
}

/// The caller's user, roles and permissions (`me`).
async fn me(cx: &Cx) -> Result<CurrentUser, Refusal> {
    let caller = needs_caller(cx).await?;
    Ok(service(cx)?.me(&caller))
}

async fn change_password(cx: &Cx, form: &ChangePasswordForm) -> Result<(), Refusal> {
    let caller = needs_caller(cx).await?;
    let mut errors = FormErrors::default();
    require(&mut errors, "current", &form.current);
    require_password(&mut errors, "password", &form.password);
    parsed(errors)?;
    let input = ChangePasswordInput { current: form.current.clone(), password: form.password.clone() };
    service(cx)?.change_password(&caller, &input).await.map_err(|err| Refusal::from_api(&err))
}

/// The account: the caller's login, name and roles, and the change-password
/// form, which never renders a password sent.
#[component]
async fn account_view(me: CurrentUser, errors: FormErrors) -> topcoat::Result<impl View> {
