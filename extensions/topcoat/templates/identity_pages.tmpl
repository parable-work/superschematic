    pub login: String,
    pub password: String,
    pub next: String,
}

/// The sign-in page: the login, the password and the page to go on to,
/// which its query's `next` names.
#[page({{ rustString (printf "%s/sign-in" $p) }})]
pub async fn identity_sign_in_page(Form(form): Form<SignInForm>) -> topcoat::Result<impl View> {
    Ok(view! { sign_in_form(login: form.login, next: form.next, errors: FormErrors::default()) })
}

/// Signs the user in with a cookie session, then goes on to `next`, a path
/// of this site, else the index (303); a refusal renders the form again
/// with its status, a wrong login or password's 401 its message.
#[page(POST {{ rustString (printf "%s/sign-in" $p) }})]
pub async fn identity_signing_in_page(cx: &Cx, Form(form): Form<SignInForm>) -> topcoat::Result<impl View> {
    let refusal = match sign_in_with(cx, &form).await {
        Ok(()) => return Err(see_other(local_next(&form.next)).into()),
        Err(refusal) => refusal,
    };
    Ok(view! {
        (refusal.status)
        sign_in_form(login: form.login, next: form.next, errors: refusal.errors)
    })
}

async fn sign_in_with(cx: &Cx, form: &SignInForm) -> Result<(), Refusal> {
    let mut errors = FormErrors::default();
    require(&mut errors, "login", &form.login);
    require(&mut errors, "password", &form.password);
    parsed(errors)?;
    let service = service(cx)?;
    let input = LoginInput {
        login: form.login.clone(),
        password: form.password.clone(),
        session: Transport::Cookie.as_str().to_owned(),
    };
    service.check_cookie_login(parts(cx), &input.session).map_err(|err| Refusal::from_api(&err))?;
    let issued = service.login(&input).await.map_err(|err| Refusal::from_api(&err))?;
    keep(cx, service, &issued);
    Ok(())
}

/// The sign-in form, the login as sent and never the password.
#[component]
async fn sign_in_form(login: String, next: String, errors: FormErrors) -> topcoat::Result<impl View> {
    let messages = unshown(&errors, &["login", "password"]);
    Ok(view! {
        <h1>"Sign in"</h1>
        <form method="post" action=(SIGN_IN_PAGE) class="ss-form">
            form_errors(messages: messages)
            <input type="hidden" name="next" value=(next)>
            text_field(id: "identity-sign-in-login", name: "login", label: "Login", autocomplete: "username", required: true, value: login, errors: errors.of("login"))
            password_field(id: "identity-sign-in-password", name: "password", label: "Password", autocomplete: "current-password", errors: errors.of("password"))
            <button type="submit">"Sign in"</button>
        </form>
{{- if $signUp }}
        <p class="ss-actions"><a class="ss-sign-up" href=(SIGN_UP)>"Sign up"</a></p>
{{- end }}
    })
}

/// Signs the caller out: ends their session and clears its cookie, then
/// goes to the index (303). A caller who is not signed in, or whose
/// session has ended, has the cookie cleared too.
#[page(POST {{ rustString (printf "%s/sign-out" $p) }})]
pub async fn identity_sign_out_page(cx: &Cx) -> topcoat::Result<impl View> {
    let refusal = match sign_out(cx).await {
        Ok(()) => return Err(see_other(PREFIX).into()),
        Err(refusal) => refusal,
    };
    Ok(view! { refused(refusal: refusal, next: PREFIX) })
}

async fn sign_out(cx: &Cx) -> Result<(), Refusal> {
    let service = service(cx)?;
    match signed_in(cx).await {
        Ok(Some(caller)) => service.logout(&caller).await.map_err(|err| Refusal::from_api(&err))?,
        Ok(None) => {}
        Err(err) if err.status == StatusCode::UNAUTHORIZED => {}
        Err(err) => return Err(Refusal::from_api(&err)),
    }
    set_cookie(cx, &service.config().clear_cookie());
    Ok(())
}
