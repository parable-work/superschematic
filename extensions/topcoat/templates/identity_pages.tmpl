/// The users, each linked to their page, and a link to add one for a
/// caller who may.
#[page({{ rustString (printf "%s/users" $p) }})]
pub async fn identity_users_page(cx: &Cx) -> topcoat::Result<impl View> {
    let listed = users(cx).await;
    Ok(view! {
