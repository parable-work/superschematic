/// A role's form as a browser sends it: its name, and its permissions, a
/// row of text each.
#[derive(Clone, Default, Deserialize)]
#[serde(default)]
pub struct RoleForm {
    pub name: String,
    pub permissions: String,
}

impl RoleForm {
    /// The form of a role as it is.
    fn of(role: &IdentityRole) -> Self {
        RoleForm { name: role.name.clone(), permissions: role.permissions.join("\n") }
    }

    /// The role's input: its name, required (422), and each row of the
    /// permissions that holds text, trimmed.
    fn parse(&self) -> Result<RoleInput, Refusal> {
        let mut errors = FormErrors::default();
        require(&mut errors, "name", &self.name);
        parsed(errors)?;
        let permissions = self.permissions.lines().map(str::trim).filter(|line| !line.is_empty()).map(str::to_owned).collect();
        Ok(RoleInput { name: self.name.clone(), permissions })
    }
}

/// The page that adds a role, for a caller who may.
#[page({{ rustString (printf "%s/roles/new" $p) }})]
pub async fn identity_new_role_page(cx: &Cx) -> topcoat::Result<impl View> {
    let admitted = may_write(cx, identity::PERMISSION_ROLES_WRITE).await;
    Ok(view! {
        match admitted {
            Err(refusal) => refused(refusal: refusal, next: NEW_ROLE),
            Ok(()) => role_form(heading: "New role".to_owned(), action: NEW_ROLE.to_owned(), form: RoleForm::default(), errors: FormErrors::default(), delete: None),
        }
    })
}

/// Adds the role, then goes to the roles (303); a refusal renders the form
/// again with its status: a taken name's 409, and a permission that is
/// malformed (422) or that the caller does not hold (403), at the
/// permissions.
#[page(POST {{ rustString (printf "%s/roles/new" $p) }})]
pub async fn identity_create_role_page(cx: &Cx, Form(form): Form<RoleForm>) -> topcoat::Result<impl View> {
    let refusal = match create_role(cx, &form).await {
        Ok(()) => return Err(see_other(ROLES).into()),
        Err(refusal) => refusal,
    };
    Ok(view! {
        if alone(&refusal) {
            refused(refusal: refusal, next: NEW_ROLE)
        } else {
            (refusal.status)
            role_form(heading: "New role".to_owned(), action: NEW_ROLE.to_owned(), form: form, errors: refusal.errors, delete: None)
        }
    })
}

async fn create_role(cx: &Cx, form: &RoleForm) -> Result<(), Refusal> {
    let caller = needs_caller(cx).await?;
    let input = form.parse()?;
    service(cx)?.create_role(&caller, &input).await.map(drop).map_err(|err| refusal_of(&err, "permissions"))
}

/// A role's page: for a caller who may change roles, its form and a link
/// to delete it; for one who may read them, its name and permissions.
#[page({{ rustString (printf "%s/roles/{role_id}" $p) }})]
pub async fn identity_role_page(cx: &Cx) -> topcoat::Result<impl View> {
    let id = path_param::<RoleId>(cx).to_owned();
    let found = role_page(cx, &id).await;
    let href = role_href(&id);
    Ok(view! {
        match found {
            Err(refusal) => refused(refusal: refusal, next: href),
            Ok((role, true)) => role_form(heading: role.name.clone(), action: href.clone(), form: RoleForm::of(&role), errors: FormErrors::default(), delete: Some(format!("{href}/delete"))),
            Ok((role, false)) => role_detail(role: role),
        }
    })
}

/// The role with the id, and whether the caller may change it.
async fn role_page(cx: &Cx, id: &str) -> Result<(IdentityRole, bool), Refusal> {
    let role = role_of(cx, id).await?.clone();
    let caller = needs_caller(cx).await?;
    Ok((role, may(service(cx)?, &caller, identity::PERMISSION_ROLES_WRITE)))
}

/// Rewrites the role's name and permissions, then goes to the roles (303);
/// a refusal renders the form again with its status, as adding one does.
#[page(POST {{ rustString (printf "%s/roles/{role_id}" $p) }})]
pub async fn identity_update_role_page(cx: &Cx, Form(form): Form<RoleForm>) -> topcoat::Result<impl View> {
    let id = path_param::<RoleId>(cx).to_owned();
    let refusal = match update_role(cx, &id, &form).await {
        Ok(()) => return Err(see_other(ROLES).into()),
        Err(refusal) => refusal,
    };
    let href = role_href(&id);
    let heading = match role_of(cx, &id).await {
        Ok(role) => role.name.clone(),
        Err(_) => format!("Role {id}"),
    };
    Ok(view! {
        if alone(&refusal) {
            refused(refusal: refusal, next: href)
        } else {
            (refusal.status)
            role_form(heading: heading, action: href.clone(), form: form, errors: refusal.errors, delete: Some(format!("{href}/delete")))
        }
    })
}

async fn update_role(cx: &Cx, id: &str, form: &RoleForm) -> Result<(), Refusal> {
    let caller = needs_caller(cx).await?;
    let input = form.parse()?;
    service(cx)?.update_role(&caller, id, &input).await.map(drop).map_err(|err| refusal_of(&err, "permissions"))
}

/// A role's name and permissions, for a caller who may not change it.
#[component]
async fn role_detail(role: IdentityRole) -> topcoat::Result<impl View> {
    let IdentityRole { name, permissions, .. } = role;
    let permissions = if permissions.is_empty() { "None".to_owned() } else { permissions.join(", ") };
    Ok(view! {
        <h1>(name.clone())</h1>
        <div class="ss-detail" data-type="Role" role="group" aria-label=(name)>
            <dl>
                <div data-field="permissions">
                    <dt>"Permissions"</dt>
                    <dd>(permissions)</dd>
                </div>
            </dl>
        </div>
    })
}

/// A role's form: its name, and its permissions as rows of text in one
/// control; with `delete`, the link to the page that deletes it.
#[component]
async fn role_form(heading: String, action: String, form: RoleForm, errors: FormErrors, delete: Option<String>) -> topcoat::Result<impl View> {
    let messages = unshown(&errors, &["name", "permissions"]);
    let permissions_errors = errors.of("permissions");
    let invalid = (!permissions_errors.is_empty()).then_some("true");
    Ok(view! {
        <h1>(heading)</h1>
        <form method="post" action=(action) class="ss-form">
            form_errors(messages: messages)
            text_field(id: "identity-role-name", name: "name", label: "Name", autocomplete: "off", required: true, value: form.name, errors: errors.of("name"))
            <div class="field">
                <label for="identity-role-permissions">"Permissions, one a row"</label>
                <textarea id="identity-role-permissions" name="permissions" rows="6" aria-invalid=(invalid)>(form.permissions)</textarea>
                for message in permissions_errors {
                    <p class="field-error">(message)</p>
                }
            </div>
            <button type="submit">"Save the role"</button>
        </form>
        if let Some(delete) = delete {
            <p class="ss-actions"><a class="ss-delete" href=(delete)>"Delete"</a></p>
        }
    })
}

/// The page that deletes a role, for a caller who may: what it holds, and
/// the form that confirms.
#[page({{ rustString (printf "%s/roles/{role_id}/delete" $p) }})]
pub async fn identity_delete_role_page(cx: &Cx) -> topcoat::Result<impl View> {
    let id = path_param::<RoleId>(cx).to_owned();
    let found = deletable(cx, &id).await;
    Ok(view! {
        match found {
            Err(refusal) => refused(refusal: refusal, next: role_href(&id)),
            Ok(role) => delete_role_form(role: role, errors: FormErrors::default()),
        }
    })
}

/// Deletes the role and its grants, then goes to the roles (303); a
/// refusal renders the page again with its status.
#[page(POST {{ rustString (printf "%s/roles/{role_id}/delete" $p) }})]
pub async fn identity_destroy_role_page(cx: &Cx) -> topcoat::Result<impl View> {
    let id = path_param::<RoleId>(cx).to_owned();
    let refusal = match destroy_role(cx, &id).await {
        Ok(()) => return Err(see_other(ROLES).into()),
        Err(refusal) => refusal,
    };
    let shown = if alone(&refusal) { Err(refusal) } else { deletable(cx, &id).await.map(|role| (role, refusal)) };
    Ok(view! {
        match shown {
            Err(refusal) => refused(refusal: refusal, next: role_href(&id)),
            Ok((role, refusal)) => {
                (refusal.status)
                delete_role_form(role: role, errors: refusal.errors)
            },
        }
    })
}

/// The role with the id, when the caller may delete it.
async fn deletable(cx: &Cx, id: &str) -> Result<IdentityRole, Refusal> {
    let role = role_of(cx, id).await?.clone();
    may_write(cx, identity::PERMISSION_ROLES_WRITE).await?;
    Ok(role)
}

async fn destroy_role(cx: &Cx, id: &str) -> Result<(), Refusal> {
    let caller = needs_caller(cx).await?;
    service(cx)?.delete_role(&caller, id).await.map_err(|err| Refusal::from_api(&err))
}

/// The confirmation of a role's deletion.
#[component]
async fn delete_role_form(role: IdentityRole, errors: FormErrors) -> topcoat::Result<impl View> {
    let href = role_href(&role.id);
    let messages = unshown(&errors, &[]);
    Ok(view! {
        <h1>"Delete the role"</h1>
        <p class="ss-confirm">(format!("Delete the role {}? Every user who holds it loses it. It cannot be undone.", role.name))</p>
        <form method="post" action=(format!("{href}/delete")) class="ss-form" data-action="delete">
            form_errors(messages: messages)
            <button type="submit">"Delete the role"</button>
        </form>
        <p><a class="ss-back" href=(href)>"Keep the role"</a></p>
    })
}
