/// The trail of the engine's page at `path` after the index, each step's
/// label and link, the last the page itself: the types, a type by its
/// plural, an instance by its type's title field, else by its noun and id,
/// and an operation's page by its name in words. None for a path that is
/// no engine page's.
pub async fn trail(cx: &Cx, path: &str) -> Option<Vec<(String, Option<String>)>> {
    let rest = path.strip_prefix(ENGINE)?;
    if !rest.is_empty() && !rest.starts_with('/') {
        return None;
    }
    let segments: Vec<String> = rest.split('/').filter(|segment| !segment.is_empty()).map(decode).collect();
    let mut steps = vec![("Engine".to_owned(), Some(ENGINE.to_owned()))];
    let Some(schema) = segments.first() else {
        return Some(steps);
    };
    let display = described(cx, schema).await.ok().map_or_else(|| TypeDisplay::of(schema, &Value::Null), |describe| TypeDisplay::of(schema, describe));
    steps.push((display.plural.clone(), Some(type_href(schema))));
    match &segments[1..] {
        [] => {}
        [operations, operation] if operations.as_str() == "operations" => steps.push((words(operation), None)),
        [id, rest @ ..] => {
            let label = match instance(cx, schema, id).await {
                Ok(record) => display.item_label(record),
                Err(_) => format!("{} {id}", display.noun),
            };
            steps.push((label, Some(instance_href(schema, id))));
            if let [operations, operation] = rest
                && operations.as_str() == "operations"
            {
                steps.push((words(operation), None));
            }
        }
    }
    Some(steps)
}

/// The path of a type's list.
pub fn type_href(schema: &str) -> String {
    format!("{ENGINE}/{}", encode(schema))
}

/// The path of an instance's page.
pub fn instance_href(schema: &str, id: &str) -> String {
    format!("{}/{}", type_href(schema), encode(id))
}

/// The path an operation's form is sent to: under its instance's page, or
/// its type's list for a schema-scope one.
pub fn operation_href(schema: &str, id: Option<&str>, operation: &str) -> String {
    let base = id.map_or_else(|| type_href(schema), |id| instance_href(schema, id));
    format!("{base}/operations/{}", encode(operation))
}

/// A type as its pages name it, from its describe document's `display`:
/// its noun and plural (its name without them), its title field and its
/// summary columns, each an own field's key or a behavior's qualified
/// field (`Stock.available`).
struct TypeDisplay {
    noun: String,
    plural: String,
    title_field: Option<String>,
    summary: Vec<String>,
}

impl TypeDisplay {
    fn of(schema: &str, describe: &Value) -> TypeDisplay {
        let display = &describe["display"];
        let text = |key: &str| display[key].as_str().filter(|text| !text.is_empty()).map(str::to_owned);
        TypeDisplay {
            noun: text("noun").unwrap_or_else(|| schema.to_owned()),
            plural: text("plural").unwrap_or_else(|| schema.to_owned()),
            title_field: text("titleField"),
            summary: display["summaryFields"].as_array().into_iter().flatten().filter_map(Value::as_str).map(str::to_owned).collect(),
        }
    }

    /// An instance's name: its title field's text, else the noun and its id.
    fn item_label(&self, record: &InstanceRecord) -> String {
        self.title_field
            .as_deref()
            .and_then(|field| field_value(record, field))
            .and_then(Value::as_str)
            .filter(|title| !title.is_empty())
            .map_or_else(|| format!("{} {}", self.noun, record.id), str::to_owned)
    }
}

/// A field of `record`: an own field by its key, a behavior's by its
/// qualified name (`Stock.available`), as the read returns them (D16).
fn field_value<'r>(record: &'r InstanceRecord, field: &str) -> Option<&'r Value> {
    if let Some(value) = record.data.get(field) {
        return Some(value);
    }
    let (behavior, name) = field.split_once('.')?;
    record.behavior_field(behavior, name)
}

/// A field's label: an own field's title in the describe document, else
/// its name in words, a behavior's field's without the behavior.
fn field_label(describe: &Value, field: &str) -> String {
    let own = describe["fields"].as_array().into_iter().flatten().find(|own| own["name"] == field);
    match own.and_then(|own| own["title"].as_str()) {
        Some(title) => title.to_owned(),
        None if own.is_none() => words(field.split_once('.').map_or(field, |(_, name)| name)),
        None => words(field),
    }
}

/// A name in words, as a label: `commentCount` is "Comment count",
/// `list_comments` "List comments".
fn words(name: &str) -> String {
    let mut out = String::with_capacity(name.len() + 4);
    let mut prev: Option<char> = None;
    for c in name.chars() {
        match c {
            '_' | '-' | ' ' => {
                if !out.is_empty() && !out.ends_with(' ') {
                    out.push(' ');
                }
            }
            c if out.is_empty() => out.extend(c.to_uppercase()),
            c if c.is_uppercase() && prev.is_some_and(|prev| prev.is_lowercase() || prev.is_ascii_digit()) => {
                out.push(' ');
                out.extend(c.to_lowercase());
            }
            c => out.push(c),
        }
        prev = Some(c);
    }
    out.trim_end().to_owned()
}

/// A value as text in a cell: a string as it is, a boolean "Yes" or "No",
/// null nothing, and any other value its JSON.
fn text(value: &Value) -> String {
    match value {
        Value::Null => String::new(),
        Value::Bool(true) => "Yes".to_owned(),
        Value::Bool(false) => "No".to_owned(),
        Value::String(text) => text.clone(),
        other => other.to_string(),
    }
}

/// A value as a page shows it: a list of objects as a table, a column per
/// member, any other list or object as its JSON, and anything else as text.
#[derive(Debug, Clone, PartialEq)]
enum Shown {
    Text(String),
    Table(Vec<String>, Vec<Vec<String>>),
    Json(String),
}

fn shown(value: &Value) -> Shown {
    match value {
        Value::Array(items) if !items.is_empty() && items.iter().all(Value::is_object) => {
            let mut columns: Vec<String> = Vec::new();
            for key in items.iter().filter_map(Value::as_object).flat_map(|item| item.keys()) {
                if !columns.contains(key) {
                    columns.push(key.clone());
                }
            }
            let rows = items.iter().map(|item| columns.iter().map(|key| text(&item[key.as_str()])).collect()).collect();
            Shown::Table(columns, rows)
        }
        Value::Array(_) | Value::Object(_) => Shown::Json(serde_json::to_string_pretty(value).unwrap_or_default()),
        _ => Shown::Text(text(value)),
    }
}

/// A field shown: its key, its label and its value.
type Field = (String, String, Shown);

/// The values a detail lists, each in a `<div>` with its `data-field`.
#[component]
async fn fields_view(fields: Vec<Field>, #[default] label: Option<String>) -> topcoat::Result<impl View> {
    Ok(view! {
        <div class="ss-detail" role="group" aria-label=(label)>
            <dl>
                for (key, label, value) in fields {
                    <div data-field=(key)>
                        <dt>(label)</dt>
                        <dd>shown_view(shown: value)</dd>
                    </div>
                }
            </dl>
        </div>
    }
    .boxed())
}

#[component]
async fn shown_view(shown: Shown) -> topcoat::Result<impl View> {
    Ok(view! {
        match shown {
            Shown::Text(text) => (text),
            Shown::Json(json) => <pre class="ss-json">(json)</pre>,
            Shown::Table(columns, rows) => {
                <table class="ss-table">
                    <thead>
                        <tr>
                            for column in columns {
                                let label = words(&column);
                                <th scope="col" data-field=(column)>(label)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        for row in rows {
                            <tr>
                                for cell in row {
                                    <td>(cell)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            },
        }
    }
    .boxed())
}

/// An operation's result: an object as the list of its members, any other
/// value on its own.
#[component]
async fn result_view(result: Value) -> topcoat::Result<impl View> {
    let members: Option<Vec<Field>> =
        result.as_object().map(|object| object.iter().map(|(key, value)| (key.clone(), words(key), shown(value))).collect());
    let whole = shown(&result);
    Ok(view! {
        <section class="ss-result" aria-label="Result">
            match members {
                Some(members) => fields_view(fields: members),
                None => shown_view(shown: whole),
            }
        </section>
    }
    .boxed())
}

/// An operation the caller is offered on a type or its instances, from the
/// type's describe document: its name, its behavior, whether it is the
/// type's (schema scope) rather than an instance's, whether it writes, its
/// description and its parameters' JSON Schema. A panel that shows one of
/// its behavior's operations itself renders its form with
/// `operation_form`.
#[derive(Debug, Clone, PartialEq)]
pub struct EngineOperation {
    pub name: String,
    pub behavior: String,
    pub schema_scope: bool,
    pub writes: bool,
    pub description: Option<String>,
    pub params: Value,
}

/// The operations of a type the caller is offered, in the describe
/// document's order: each the deployment does not hide and the policy
/// allows the caller.
pub async fn operations(cx: &Cx, describe: &Value) -> Vec<EngineOperation> {
    let Ok(offered) = offered(cx).await else {
        return Vec::new();
    };
    describe["operations"]
        .as_array()
        .into_iter()
        .flatten()
        .filter(|operation| operation["tool"].as_str().is_some_and(|tool| offered.contains(tool)))
        .filter_map(|operation| {
            Some(EngineOperation {
                name: operation["name"].as_str()?.to_owned(),
                behavior: operation["behavior"].as_str()?.to_owned(),
                schema_scope: operation["scope"] == "schema",
                writes: operation["writes"].as_bool().unwrap_or(true),
                description: operation["description"].as_str().filter(|text| !text.is_empty()).map(str::to_owned),
                params: operation["params"]["properties"]["params"].clone(),
            })
        })
        .collect()
}

/// What a parameter's control takes: text, a whole number, a number, one
/// of a list of values (an enum's, or a boolean's Yes and No), or any JSON.
#[derive(Debug, Clone, PartialEq)]
enum Kind {
    Text,
    Integer,
    Number,
    /// Each choice's value in the form, its label and the JSON it stands for.
    Choice(Vec<(String, String, Value)>),
    Json,
}

/// The kind of a parameter's JSON Schema: a string, an integer, a number,
/// a boolean or an enum, null aside, gets its control; any other schema is
/// JSON.
fn kind_of(schema: &Value) -> Kind {
    if let Some(values) = schema["enum"].as_array() {
        let choices = values
            .iter()
            .map(|value| match value.as_str() {
                Some(text) => (text.to_owned(), words(text), value.clone()),
                None => (value.to_string(), text(value), value.clone()),
            })
            .collect();
        return Kind::Choice(choices);
    }
    let types: Vec<&str> = match &schema["type"] {
        Value::String(kind) => vec![kind.as_str()],
        Value::Array(kinds) => kinds.iter().filter_map(Value::as_str).filter(|kind| *kind != "null").collect(),
        _ => Vec::new(),
    };
    match types.as_slice() {
        ["string"] => Kind::Text,
        ["integer"] => Kind::Integer,
        ["number"] => Kind::Number,
        ["boolean"] => Kind::Choice(vec![
            ("true".to_owned(), "Yes".to_owned(), Value::Bool(true)),
            ("false".to_owned(), "No".to_owned(), Value::Bool(false)),
        ]),
        _ => Kind::Json,
    }
}

/// One control of an operation's form, as sent or new, with its errors.
#[derive(Debug, Clone, PartialEq)]
struct Control {
    id: String,
    name: String,
    label: String,
    hint: Option<String>,
    kind: Kind,
    required: bool,
    /// A text's least and most characters, a number's bounds.
    min: Option<String>,
    max: Option<String>,
    value: String,
    errors: Vec<String>,
    /// Whether it is a hidden input that holds `value`, a value the form's
    /// page fills in, rather than a control the reader fills in.
    hidden: bool,
}

/// The name of the one control of an operation whose parameters are not an
/// object of properties: their whole JSON.
const WHOLE: &str = "params";

/// The value sent for a control.
fn sent_value<'p>(pairs: &'p [(String, String)], name: &str) -> Option<&'p str> {
    pairs.iter().find(|(key, _)| key == name).map(|(_, value)| value.as_str())
}

/// The required properties of an object schema.
fn required_of(schema: &Value) -> Vec<&str> {
    schema["required"].as_array().into_iter().flatten().filter_map(Value::as_str).collect()
}

/// The controls of an operation's form: one per property of its parameters,
/// or one JSON control for parameters that are not an object of properties,
/// none for an operation without parameters. Each holds what was sent, and
/// its errors.
fn controls_of(prefix: &str, operation: &EngineOperation, pairs: &[(String, String)], errors: &FormErrors) -> Vec<Control> {
    let id = |name: &str| format!("{prefix}-{}-{}", operation.name, name);
    let Some(properties) = operation.params["properties"].as_object() else {
        if operation.params.is_null() {
            return Vec::new();
        }
        return vec![Control {
            id: id(WHOLE),
            name: WHOLE.to_owned(),
            label: "Parameters".to_owned(),
            hint: Some("The parameters as JSON".to_owned()),
            kind: Kind::Json,
            required: false,
            min: None,
            max: None,
            value: sent_value(pairs, WHOLE).unwrap_or_default().to_owned(),
            errors: errors.of(WHOLE),
            hidden: false,
        }];
    };
    let required = required_of(&operation.params);
    let bound = |value: &Value| value.as_number().map(ToString::to_string);
    properties
        .iter()
        .map(|(name, schema)| {
            let kind = kind_of(schema);
            let (min, max) = match kind {
                Kind::Text => (bound(&schema["minLength"]), bound(&schema["maxLength"])),
                Kind::Integer | Kind::Number => (bound(&schema["minimum"]), bound(&schema["maximum"])),
                _ => (None, None),
            };
            Control {
                id: id(name),
                name: name.clone(),
                label: schema["title"].as_str().map_or_else(|| words(name), str::to_owned),
                hint: schema["description"].as_str().filter(|text| !text.is_empty()).map(str::to_owned),
                kind,
                required: required.contains(&name.as_str()),
                min,
                max,
                value: sent_value(pairs, name).unwrap_or_default().to_owned(),
                errors: errors.of(name),
                hidden: false,
            }
        })
        .collect()
}

/// An operation's parameters from its form's pairs, each property's control
/// read by its kind and a blank one left out; the errors at their controls
/// (422) for a required one left blank, or a value its kind does not read.
/// The engine checks the rest against the schema.
fn params_of(operation: &EngineOperation, pairs: &[(String, String)]) -> Result<Value, FormErrors> {
    let mut errors = FormErrors::default();
    let Some(properties) = operation.params["properties"].as_object() else {
        let sent = sent_value(pairs, WHOLE).unwrap_or_default().trim();
        if operation.params.is_null() || sent.is_empty() {
            return Ok(Value::Object(Map::new()));
        }
        return serde_json::from_str(sent).map_err(|err| {
            errors.fields.entry(WHOLE.to_owned()).or_default().push(format!("Enter JSON: {err}"));
            errors
        });
    };
    let required = required_of(&operation.params);
    let mut params = Map::new();
    for (name, schema) in properties {
        let sent = sent_value(pairs, name).unwrap_or_default();
        let kind = kind_of(schema);
        if sent.trim().is_empty() {
            if required.contains(&name.as_str()) {
                let message = if matches!(kind, Kind::Choice(_)) { "Choose one" } else { "Enter a value" };
                errors.fields.entry(name.clone()).or_default().push(message.to_owned());
            }
            continue;
        }
        let read = match &kind {
            Kind::Text => Ok(Value::String(sent.to_owned())),
            Kind::Integer => sent.trim().parse::<i64>().map(Value::from).map_err(|_| "Enter a whole number".to_owned()),
            Kind::Number => sent
                .trim()
                .parse::<f64>()
                .ok()
                .and_then(serde_json::Number::from_f64)
                .map(Value::Number)
                .ok_or_else(|| "Enter a number".to_owned()),
            Kind::Choice(choices) => choices
                .iter()
                .find(|(value, _, _)| value == sent)
                .map(|(_, _, value)| value.clone())
                .ok_or_else(|| "Choose one of the options".to_owned()),
            Kind::Json => serde_json::from_str(sent).map_err(|err| format!("Enter JSON: {err}")),
        };
        match read {
            Ok(value) => {
                params.insert(name.clone(), value);
            }
            Err(message) => errors.fields.entry(name.clone()).or_default().push(message),
        }
    }
    if errors.is_empty() { Ok(Value::Object(params)) } else { Err(errors) }
}

/// An operation's form that was sent: the operation, the pairs, and what
/// the engine answered, its result or its refusal, which the page renders
/// with the form as sent.
#[derive(Debug, Clone, PartialEq)]
struct Sent {
    operation: String,
    pairs: Vec<(String, String)>,
    outcome: Result<Value, Refusal>,
}

/// An operation's form as a page renders it: where it is sent, by POST for
/// one that writes and GET for a read, its controls, the instance's seq
/// for a write to one, the messages no control shows, and a read's result.
#[derive(Debug, Clone, PartialEq)]
struct FormShown {
    action: String,
    post: bool,
    operation: String,
    label: String,
    hint: Option<String>,
    seq: Option<i64>,
    controls: Vec<Control>,
    errors: Vec<String>,
    result: Option<Value>,
}

/// The form of `operation`, on the instance `id` of `schema` at `seq` or on
/// the type, new, or as `sent` when it is the form that was sent.
fn form_of(prefix: &str, schema: &str, id: Option<&str>, seq: Option<i64>, operation: &EngineOperation, sent: Option<&Sent>) -> FormShown {
    let sent = sent.filter(|sent| sent.operation == operation.name);
    let errors = sent.and_then(|sent| sent.outcome.as_ref().err()).map(|refusal| refusal.errors.clone()).unwrap_or_default();
    let pairs = sent.map(|sent| sent.pairs.as_slice()).unwrap_or_default();
    let controls = controls_of(prefix, operation, pairs, &errors);
    let mut messages = errors.form.clone();
    for (name, list) in &errors.fields {
        if !controls.iter().any(|control| &control.name == name) {
            messages.extend(list.iter().map(|message| format!("{name}: {message}")));
        }
    }
    FormShown {
        action: operation_href(schema, id, &operation.name),
        post: operation.writes,
        operation: operation.name.clone(),
        label: words(&operation.name),
        hint: operation.description.clone(),
        seq: if operation.writes && id.is_some() { seq } else { None },
        controls,
        errors: messages,
        result: sent.filter(|_| !operation.writes).and_then(|sent| sent.outcome.as_ref().ok()).cloned(),
    }
}

/// The form of an operation the caller is offered, new: a panel calls it
/// for an operation of its behavior that it shows as the generic form
/// does. `id` and `seq` are the instance's, none for a schema-scope
/// operation, and a form without `seq` writes with no check of it.
/// `values` fill in controls by their parameter's name, and the controls
/// `hidden` names are hidden inputs that hold their value, a ref's name or
/// a commit, say, which the reader does not change.
#[component]
pub async fn operation_form(
    schema: String,
    id: Option<String>,
    seq: Option<i64>,
    operation: EngineOperation,
    #[default] values: Vec<(String, String)>,
    #[default] hidden: Vec<String>,
) -> topcoat::Result<impl View> {
    let mut form = form_of("engine-panel", &schema, id.as_deref(), seq, &operation, None);
    for control in &mut form.controls {
        if let Some(value) = sent_value(&values, &control.name) {
            control.value = value.to_owned();
        }
        control.hidden = hidden.contains(&control.name);
    }
    Ok(view! { form_view(form: form) })
}

#[component]
async fn form_view(form: FormShown) -> topcoat::Result<impl View> {
    let FormShown { action, post, operation, label, hint, seq, controls, errors, result } = form;
    let method = if post { "post" } else { "get" };
    Ok(view! {
        <div class="ss-operation" data-operation=(operation)>
            <h3>(label.clone())</h3>
            if let Some(hint) = hint {
                <p class="ss-hint">(hint)</p>
            }
            <form method=(method) action=(action) class="ss-form">
                for message in errors {
                    <p class="form-error">(message)</p>
                }
                if let Some(seq) = seq {
                    <input type="hidden" name=(SEQ) value=(seq.to_string())>
                }
                for control in controls {
                    control_view(control: control)
                }
                <button type="submit">(label)</button>
            </form>
            if let Some(result) = result {
                result_view(result: result)
            }
        </div>
    }
    .boxed())
}

#[component]
async fn control_view(control: Control) -> topcoat::Result<impl View> {
    let Control { id, name, label, hint, kind, required, min, max, value, errors, hidden } = control;
    if hidden {
        return Ok(view! { <input type="hidden" name=(name) value=(value)> }.boxed());
    }
    let invalid = (!errors.is_empty()).then_some("true");
    // A choice's blank option is selected when no choice is the value held.
    let blank = match &kind {
        Kind::Choice(choices) => !choices.iter().any(|(choice, _, _)| *choice == value),
        _ => false,
    };
    Ok(view! {
        <div class="field">
            <label for=(id.clone())>(label)</label>
            match kind {
                Kind::Text => <input id=(id) name=(name) type="text" required=(required) minlength=(min) maxlength=(max) value=(value) aria-invalid=(invalid)>,
                Kind::Integer => <input id=(id) name=(name) type="number" step="1" required=(required) min=(min) max=(max) value=(value) aria-invalid=(invalid)>,
                Kind::Number => <input id=(id) name=(name) type="number" step="any" required=(required) min=(min) max=(max) value=(value) aria-invalid=(invalid)>,
                Kind::Choice(choices) => {
                    <select id=(id) name=(name) required=(required) aria-invalid=(invalid)>
                        <option value="" selected=(blank)>""</option>
                        for (choice, shown, _) in choices {
                            let selected = choice == value;
                            <option value=(choice) selected=(selected)>(shown)</option>
                        }
                    </select>
                },
                Kind::Json => <textarea id=(id) name=(name) rows="4" spellcheck="false" required=(required) aria-invalid=(invalid)>(value)</textarea>,
            }
            if let Some(hint) = hint {
                <p class="field-hint">(hint)</p>
            }
            for message in errors {
                <p class="field-error">(message)</p>
            }
        </div>
    }
    .boxed())
}

/// Runs an operation of `schema`, an instance's (`id`) or the type's, from
/// its form's pairs, as the page's caller: its result, and whether it
/// writes. An operation the caller is not offered is 404, a write sent by
/// GET 405, and a form its kinds do not read 422 at its controls, before
/// the engine is called. A write to an instance names the seq its page was
/// read at.
async fn run(cx: &Cx, schema: &str, id: Option<&str>, name: &str, pairs: &[(String, String)], post: bool) -> Result<(bool, Value), Refusal> {
    let describe = described(cx, schema).await.map_err(Refusal::clone)?;
    let Some(operation) = operations(cx, describe)
        .await
        .into_iter()
        .find(|operation| operation.name == name && operation.schema_scope == id.is_none())
    else {
        return Err(refusal(StatusCode::NOT_FOUND, "There is no such operation"));
    };
    if operation.writes && !post {
        return Err(refusal(StatusCode::METHOD_NOT_ALLOWED, format!("{} writes, so its form posts", words(name))));
    }
    let params = params_of(&operation, pairs).map_err(Refusal::from)?;
    let writes = operation.writes;
    let (schema, name) = (schema.to_owned(), operation.name);
    let result = match id {
        Some(id) => {
            let id = id.to_owned();
            let expected_seq = sent_value(pairs, SEQ).and_then(|seq| seq.parse::<i64>().ok()).filter(|_| writes);
            call(cx, move |engine, principal| {
                let options = WriteOptions { namespace: Some(NAMESPACE), expected_seq, preconditions: None };
                engine.instances().operate(principal, &schema, &id, &name, &params, options).map(|outcome| outcome.result)
            })
            .await?
        }
        None => call(cx, move |engine, principal| engine.instances().invoke_schema(principal, &schema, &name, &params, Some(NAMESPACE))).await?,
    };
    Ok((writes, result))
}

/// A sent form's refusal that renders on its own, in place of the page: a
/// refused caller (401, 403), an instance or operation that is not there
/// (404), a write sent by GET (405).
fn alone(sent: &Sent) -> Option<Refusal> {
    sent.outcome.as_ref().err().filter(|refusal| matches!(refusal.status.as_u16(), 401 | 403 | 404 | 405)).cloned()
}

/// The types the caller may read, each by its plural, a link to its list.
#[page({{ rustString $path }})]
pub async fn engine_index_page(cx: &Cx) -> topcoat::Result<impl View> {
    let next = current(cx);
    let types = match readable(cx).await {
        Err(refusal) => Err(refusal.clone()),
        Ok(names) => {
            let mut types = Vec::new();
            for name in names {
                let (label, hint) = match described(cx, name).await {
                    Ok(describe) => (TypeDisplay::of(name, describe).plural, describe["description"].as_str().map(str::to_owned)),
                    Err(_) => (name.clone(), None),
                };
                types.push((type_href(name), label, hint));
            }
            Ok(types)
        }
    };
    Ok(view! {
        match types {
            Err(refusal) => refused(refusal: refusal, next: next),
            Ok(types) => {
                <h1>"Engine"</h1>
                if types.is_empty() {
                    <p class="ss-empty">"There is no type here you may read."</p>
                } else {
                    <ul class="ss-index">
                        for (href, label, hint) in types {
                            <li>
                                <a href=(href)>(label)</a>
                                if let Some(hint) = hint {
                                    <p class="ss-hint">(hint)</p>
                                }
                            </li>
                        }
                    </ul>
                }
            },
        }
    })
}

/// A type's instances, a page at a time (the query's `limit` and `cursor`),
