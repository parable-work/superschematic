/// A section of an instance's page: a behavior's own panel, or the generic
/// one.
enum Section<'a> {
    Panel(BoxView<'a>),
    Generic(GenericPanel),
}

/// The generic panel of a behavior: its name, its description, its fields
/// as the read returns them (D16), and the forms of its operations.
struct GenericPanel {
    name: String,
    description: Option<String>,
    fields: Vec<Field>,
    forms: Vec<FormShown>,
}

#[component]
async fn generic_panel(panel: GenericPanel) -> topcoat::Result<impl View> {
    let GenericPanel { name, description, fields, forms } = panel;
    Ok(view! {
        <section class="ss-panel" data-behavior=(name.clone())>
            <h2>(name)</h2>
            if let Some(description) = description {
                <p class="ss-hint">(description)</p>
            }
            if !fields.is_empty() {
                fields_view(fields: fields)
            }
            for form in forms {
                form_view(form: form)
            }
        </section>
    }
    .boxed())
}

/// Whether the panel of `behavior`, one of `engine_panels`' own, shows
/// `operation` itself, so the instance's page leaves it out of the
/// operations no panel shows: those a core panel (Workflow, Approvals,
/// Branches) names in `engine_panels::core_shows`, and a commerce panel in
/// `engine_panels::commerce_shows`. The others are listed.
fn panel_shows(behavior: &str, operation: &str) -> bool {
    crate::engine_panels::core_shows(behavior, operation) || crate::engine_panels::commerce_shows(behavior, operation)
}

/// An instance's page: its title, its own fields, then a section per
/// behavior in the type's order, the behavior's panel or the generic one,
/// then the operations no panel shows: those of a behavior with a panel of
/// its own that the panel does not render (`panel_shows`). A form that was
/// sent renders as sent, with its errors and its status or its result,
/// where its form is, else before the sections, since a panel renders its
/// own forms new.
#[component]
async fn engine_instance(cx: &Cx, schema: String, id: String, sent: Option<Sent>) -> topcoat::Result<impl View> {
    let next = current(cx);
    let found = match (described(cx, &schema).await, instance(cx, &schema, &id).await) {
        (Ok(describe), Ok(record)) => Ok((describe.clone(), record.clone())),
        (Err(refusal), _) | (_, Err(refusal)) => Err(refusal.clone()),
    };
    let shown = match found {
        Err(refusal) => Err(refusal),
        Ok((describe, record)) => {
            let display = TypeDisplay::of(&schema, &describe);
            let heading = display.item_label(&record);
            let operations = operations(cx, &describe).await;
            let mut own: Vec<String> =
                describe["fields"].as_array().into_iter().flatten().filter_map(|field| field["name"].as_str()).map(str::to_owned).collect();
            own.extend(record.data.keys().filter(|key| !own.contains(key)).cloned().collect::<Vec<_>>());
            let fields: Vec<Field> = own
                .iter()
                .map(|field| (field.clone(), field_label(&describe, field), shown(record.data.get(field).unwrap_or(&Value::Null))))
                .collect();
            let mut sent_alone = sent.as_ref().and_then(|sent| operations.iter().find(|operation| operation.name == sent.operation && !operation.schema_scope));
            let mut sections = Vec::new();
            let mut others = Vec::new();
            for behavior in describe["behaviors"].as_array().into_iter().flatten() {
                let name = behavior["name"].as_str().unwrap_or_default().to_owned();
                if let Some(panel) = crate::engine_panels::panel(cx, &name, &describe, &record).await {
                    sections.push(Section::Panel(panel));
                    for operation in operations
                        .iter()
                        .filter(|operation| operation.behavior == name && !operation.schema_scope && !panel_shows(&name, &operation.name))
                    {
                        if sent_alone.is_some_and(|alone| alone.name == operation.name) {
                            sent_alone = None;
                        }
                        others.push(form_of("engine", &schema, Some(&id), Some(record.seq), operation, sent.as_ref()));
                    }
                    continue;
                }
                let held = record.behaviors.get(&name).and_then(Value::as_object);
                let mut declared: Vec<String> =
                    behavior["fields"].as_array().into_iter().flatten().filter_map(|field| field["name"].as_str()).map(str::to_owned).collect();
                declared.extend(held.into_iter().flat_map(|held| held.keys()).filter(|key| !declared.contains(key)).cloned().collect::<Vec<_>>());
                let fields = declared
                    .iter()
                    .map(|field| (format!("{name}.{field}"), words(field), shown(held.and_then(|held| held.get(field)).unwrap_or(&Value::Null))))
                    .collect();
                let forms = operations
                    .iter()
                    .filter(|operation| operation.behavior == name && !operation.schema_scope)
                    .map(|operation| {
                        if sent_alone.is_some_and(|alone| alone.name == operation.name) {
                            sent_alone = None;
                        }
                        form_of("engine", &schema, Some(&id), Some(record.seq), operation, sent.as_ref())
                    })
                    .collect();
                let description = behavior["summary"].as_str().or_else(|| behavior["description"].as_str()).map(str::to_owned);
                sections.push(Section::Generic(GenericPanel { name, description, fields, forms }));
            }
            let top = sent_alone.map(|operation| form_of("engine-sent", &schema, Some(&id), Some(record.seq), operation, sent.as_ref()));
            let status = sent.as_ref().and_then(|sent| sent.outcome.as_ref().err()).map(|refusal| refusal.status);
            Ok((status, heading, top, fields, sections, others))
        }
    };
    Ok(view! {
        match shown {
            Err(refusal) => refused(refusal: refusal, next: next),
            Ok((status, heading, top, fields, sections, others)) => {
                if let Some(status) = status {
                    (status)
                }
                <h1>(heading.clone())</h1>
                if let Some(form) = top {
                    <section class="ss-sent" aria-label="Sent">
                        form_view(form: form)
                    </section>
                }
                fields_view(fields: fields, label: Some(heading))
                for section in sections {
                    match section {
                        Section::Panel(panel) => (panel),
                        Section::Generic(panel) => generic_panel(panel: panel),
                    }
                }
                if !others.is_empty() {
                    <section class="ss-operations" aria-label="Operations">
                        <h2>"Operations"</h2>
                        for form in others {
                            form_view(form: form)
                        }
                    </section>
                }
            },
        }
    })
}
