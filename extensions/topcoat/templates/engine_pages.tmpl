/// A row of a list: its instance's page, its title, and its summary
/// cells, each by its field.
type Row = (String, String, Vec<(String, String)>);

/// A list's own query: its `limit` and its `cursor`, from the page's.
fn list_query(query: &str) -> Result<(Option<i64>, Option<String>), Refusal> {
    let pairs = Form::<Vec<(String, String)>>::from_bytes(query.as_bytes()).map(|form| form.0).unwrap_or_default();
    let limit = match sent_value(&pairs, "limit").filter(|limit| !limit.is_empty()) {
        None => None,
        Some(limit) => Some(
            limit
                .parse::<i64>()
                .map_err(|_| refusal(StatusCode::BAD_REQUEST, format!("The limit is a whole number of instances, from 1 to {MAX_PAGE_SIZE}")))?,
        ),
    };
    Ok((limit, sent_value(&pairs, "cursor").filter(|cursor| !cursor.is_empty()).map(str::to_owned)))
}

/// The sizes a list's size form offers, the one shown marked: its own and
/// the one the query sent.
fn page_sizes(sent: Option<i64>) -> Vec<(i64, bool)> {
    let mut sizes: Vec<i64> = PAGE_SIZES.iter().copied().chain(sent.filter(|size| (1..=MAX_PAGE_SIZE).contains(size))).collect();
    sizes.sort_unstable();
    sizes.dedup();
    let shown = sent.unwrap_or(DEFAULT_PAGE_SIZE);
    sizes.into_iter().map(|size| (size, size == shown)).collect()
}

/// A type's list: a table of a page of its instances, each by its title
/// (else its id), a link to its page, and the type's summary columns; after
/// it the links to the next page and, on a later one, to the first and to
/// the one before, which the query's `back` keeps, beside the size form
/// (D44, amended); then the type's operations. A form that was sent
/// renders as sent, with its errors and its status or its result, and the
/// list from its first page.
#[component]
async fn engine_list(cx: &Cx, schema: String, sent: Option<Sent>) -> topcoat::Result<impl View> {
    let next = current(cx);
    // A sent form's query is its parameters, not the list's.
    let query = if sent.is_some() { String::new() } else { uri(cx).query().unwrap_or_default().to_owned() };
    let describe = described(cx, &schema).await.map_err(Refusal::clone);
    let listed = match (&describe, list_query(&query)) {
        (Err(refusal), _) => Err(refusal.clone()),
        (_, Err(refusal)) => Err(refusal),
        (Ok(_), Ok((limit, cursor))) => {
            let (from, at) = (schema.clone(), cursor.clone());
            call(cx, move |engine, principal| {
                let options = ListOptions { namespace: Some(NAMESPACE), limit, cursor: at.as_deref(), ..ListOptions::default() };
                engine.instances().list(principal, &from, options)
            })
            .await
            .map(|page| (limit, cursor, page))
        }
    };
    let shown = match (describe, listed) {
        (Err(refusal), _) | (_, Err(refusal)) => Err(refusal),
        (Ok(describe), Ok((limit, cursor, page))) => {
            let display = TypeDisplay::of(&schema, describe);
            let first_key = display.title_field.clone().unwrap_or_else(|| "id".to_owned());
            let first_label = display.title_field.as_deref().map_or_else(|| "Id".to_owned(), |field| field_label(describe, field));
            let columns: Vec<(String, String)> = display
                .summary
                .iter()
                .filter(|field| Some(field.as_str()) != display.title_field.as_deref())
                .map(|field| (field.clone(), field_label(describe, field)))
                .collect();
            let rows: Vec<Row> = page
                .items
                .iter()
                .map(|record| {
                    let title = display
                        .title_field
                        .as_deref()
                        .and_then(|field| field_value(record, field))
                        .map(text)
                        .filter(|title| !title.is_empty())
                        .unwrap_or_else(|| record.id.clone());
                    let cells = columns.iter().map(|(field, _)| (field.clone(), field_value(record, field).map(text).unwrap_or_default())).collect();
                    (instance_href(&schema, &record.id), title, cells)
                })
                .collect();
            // The links of the page: the first page's while a cursor was
            // sent, the page before's while `back` knows it, and the next
            // page's while one follows, its `back` this one's with the
            // current cursor after it, each with the query's limit.
            let pairs: Vec<(String, String)> = limit.map(|limit| vec![("limit".to_owned(), limit.to_string())]).unwrap_or_default();
            let first_page = cursor.is_some().then(|| pager_query(&pairs, None, None));
            let back = Back::read(&query, cursor.is_some());
            let prev_page = cursor
                .as_ref()
                .and(back.pop())
                .map(|(earlier, back)| pager_query(&pairs, earlier.as_deref(), back.as_deref()));
            let next_back = cursor.as_deref().map(|cursor| back.push(cursor));
            let next_page = page.next.as_deref().map(|next| pager_query(&pairs, Some(next), next_back.as_deref()));
            let operations = operations(cx, describe).await;
            let forms: Vec<FormShown> = operations
                .iter()
                .filter(|operation| operation.schema_scope)
                .map(|operation| form_of("engine", &schema, None, None, operation, sent.as_ref()))
                .collect();
            let status = sent.as_ref().and_then(|sent| sent.outcome.as_ref().err()).map(|refusal| refusal.status);
            Ok((display.plural, (first_key, first_label), columns, rows, (first_page, prev_page, next_page, page_sizes(limit)), forms, status))
        }
    };
    let base = type_href(&schema);
    Ok(view! {
        match shown {
            Err(refusal) => refused(refusal: refusal, next: next),
            Ok((plural, (first_key, first_label), columns, rows, (first_page, prev_page, next_page, sizes), forms, status)) => {
                if let Some(status) = status {
                    (status)
                }
                <h1>(plural)</h1>
                if rows.is_empty() {
                    <p class="ss-empty">"There are none here."</p>
                } else {
                    <table class="ss-table" data-type=(schema)>
                        <thead>
                            <tr>
                                <th scope="col" data-field=(first_key.clone())>(first_label)</th>
                                for (field, label) in columns {
                                    <th scope="col" data-field=(field)>(label)</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            for (href, title, cells) in rows {
                                <tr>
                                    <td data-field=(first_key.clone())><a href=(href)>(title)</a></td>
                                    for (field, cell) in cells {
                                        <td data-field=(field)>(cell)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                pager(base: base, first: first_page, prev: prev_page, next: next_page, sizes: sizes)
                if !forms.is_empty() {
                    <section class="ss-operations" aria-label="Operations">
                        <h2>"Operations"</h2>
                        for form in forms {
                            form_view(form: form)
                        }
                    </section>
                }
            },
        }
    })
}

