/// The page's caller as the engine's principal, mapped as `engine::routes`
/// maps a request's: its subject, its permissions and its claims. No caller
/// is 401, and an authenticator's refusal is its own.
async fn principal(cx: &Cx) -> Result<Principal, Refusal> {
    match crate::caller(cx).await {
        Ok(Some(caller)) => {
            Ok(Principal::new(caller.subject.clone(), caller.permissions.clone()).with_claims(caller.claims.clone()))
        }
        Ok(None) => Err(refusal(StatusCode::UNAUTHORIZED, "Sign in to use the engine")),
        Err(err) => Err(Refusal::from_api(err)),
    }
}

/// Calls the engine as the page's caller (`principal`), on the blocking
/// pool, since the engine is synchronous: what `f` returns, or its refusal
/// as a page shows it (`refusal_of`).
async fn call<T, F>(cx: &Cx, f: F) -> Result<T, Refusal>
where
    T: Send + 'static,
    F: FnOnce(&Engine, &Principal) -> Result<T, Error> + Send + 'static,
{
    let principal = principal(cx).await?;
    let engine = Arc::clone(&crate::setup(cx).map_err(|err| Refusal::from_api(&err))?.engine);
    match tokio::task::spawn_blocking(move || f(&engine, &principal)).await {
        Ok(done) => done.map_err(|err| refusal_of(&err)),
        Err(_) => Err(failed()),
    }
}

/// A refusal with `status` and one message, the form's.
fn refusal(status: StatusCode, message: impl Into<String>) -> Refusal {
    Refusal { status, errors: FormErrors { form: vec![message.into()], ..FormErrors::default() } }
}

/// The refusal of a call the engine failed, not refused: 500, which says
/// nothing of the failure.
fn failed() -> Refusal {
    refusal(StatusCode::INTERNAL_SERVER_ERROR, "The engine failed to answer")
}

/// What the engine refused, as a page shows it: an operation's parameters
/// each at its control (422); a behavior's veto as its code and reason
/// (`approvals_missing: ...`), and a stale seq, as the form's message (409);
/// any other refusal with the engine's status and message. An error that
/// is no refusal is `failed`.
fn refusal_of(err: &Error) -> Refusal {
    let Some(rejected) = err.engine() else {
        return failed();
    };
    match rejected.kind() {
        EngineErrorKind::OperationParams { issues } => {
            let mut errors = FormErrors::default();
            for issue in issues {
                match control_of(&issue.path) {
                    Some(name) => errors.fields.entry(name).or_default().push(issue.message.clone()),
                    None => errors.form.push(issue.message.clone()),
                }
            }
            Refusal { status: StatusCode::UNPROCESSABLE_ENTITY, errors }
        }
        EngineErrorKind::BehaviorVeto { reason, veto_code, .. } => {
            let message = match veto_code {
                Some(code) => format!("{code}: {reason}"),
                None => reason.clone(),
            };
            refusal(StatusCode::CONFLICT, message)
        }
        _ if rejected.code() == EngineErrorCode::SeqMismatch => refusal(StatusCode::CONFLICT, rejected.message()),
        _ => refusal(StatusCode::from_u16(rejected.status()).unwrap_or(StatusCode::INTERNAL_SERVER_ERROR), rejected.message()),
    }
}

/// The control a parameter's issue is at, the first step of its JSON
/// pointer; none for the parameters as a whole.
fn control_of(pointer: &str) -> Option<String> {
    let first = pointer.strip_prefix('/')?.split('/').next()?;
    (!first.is_empty()).then(|| first.replace("~1", "/").replace("~0", "~"))
}

/// The types the caller may read, by name (`capabilities`). The request
/// keeps them (`#[memoize]`), so the nav and the index ask once.
#[memoize(as_ref)]
async fn readable(cx: &Cx) -> Result<Vec<String>, Refusal> {
    call(cx, |engine, principal| {
        let target = SchemaTarget { namespace: Some(NAMESPACE) };
        Ok(engine.schemas().capabilities(principal, target)?.into_iter().map(|schema| schema.name).collect())
    })
    .await
}

/// A type's describe document: its display, its fields, its behaviors'
/// fields and configs, and its operations with their parameters' JSON
/// Schema. The request keeps it, so the trail and the page read it once.
#[memoize(as_ref)]
async fn described(cx: &Cx, schema: &str) -> Result<Value, Refusal> {
    let schema = schema.to_owned();
    call(cx, move |engine, principal| {
        engine.tools().describe(principal, &schema, ToolTarget { namespace: Some(NAMESPACE), filter: None })
    })
    .await
}

/// An instance as the engine reads it, its own fields in `data` and its
/// behaviors' under their names; 404 when there is none with the id. The
/// request keeps it, so the trail and the page read it once.
#[memoize(as_ref)]
async fn instance(cx: &Cx, schema: &str, id: &str) -> Result<InstanceRecord, Refusal> {
    let (schema, id) = (schema.to_owned(), id.to_owned());
    call(cx, move |engine, principal| {
