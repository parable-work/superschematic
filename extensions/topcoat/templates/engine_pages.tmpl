/// Runs an operation of a type from its form, then goes back to the type's
/// list (303) after a write; a refusal, or a read's result, renders the
/// list with the form as sent.
#[page(POST {{ rustString (print $path "/{engine_schema}/operations/{engine_op}") }})]
pub async fn engine_type_operation_page(cx: &Cx, Form(pairs): Form<Vec<(String, String)>>) -> topcoat::Result<impl View> {
