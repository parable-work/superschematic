/// Runs a read-only operation of a type from its form's query, then renders
/// the type's list with its result.
#[page({{ rustString (print $path "/{engine_schema}/operations/{engine_op}") }})]
pub async fn engine_type_read_page(cx: &Cx, Form(pairs): Form<Vec<(String, String)>>) -> topcoat::Result<impl View> {
