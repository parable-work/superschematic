/// A form's errors as a refusal, for a page that fills the form itself: a
/// list's or an item's arguments beside its path's.
fn form_refusal(errors: &FormErrors, status: StatusCode) -> ApiError {
    let mut messages = errors.form.clone();
    for (name, list) in &errors.fields {
        messages.extend(list.iter().map(|message| format!("{name}: {message}")));
