/// Adds the layer that applies, to each page's request, the traffic
/// controls (@rateLimit, @bodyLimit, @timeout) of the operation the page is
/// for and of the options operations its references call (D61).
/// `{{ .SetupMethod }}` calls it.
pub(crate) fn route_controls(router: RouterBuilder) -> RouterBuilder {
    router.layer(PageControls {
        controls: vec![
{{- range .Pages.Controls }}
            Controls::default(){{ range .ControlCalls }}{{ . }}{{ end }},
{{- end }}
        ],
        pages: vec![
{{- range .Pages.Controlled }}
            (Method::{{ .Method }}, {{ rustString .Path }}, {{ .OwnExpr }}, {{ .CalledExpr }}),
{{- end }}
        ],
    })
}

/// The traffic controls of an operation's route, which a page that calls
/// it meets as the route's request does (`RouteControls`, D35): the rate
/// limit, the body limit, read before the page decodes its form, then the
/// timeout around the page. The page's in-process call checks the caller
/// and the arguments.
#[derive(Default)]
struct Controls {
    /// The operation's limiter for the pages, at its route's rate, which
    /// counts each client by its IP address as Topcoat reads it
    /// (`client_ip`). The JSON API's route and a procedure keep their own,
    /// as two replicas would.
    rate_limit: Option<RateLimiter>,
    /// The limit in bytes, and the Topcoat layer that lets the page read
    /// its form up to it.
    body_limit: Option<(usize, BodyLimit)>,
    timeout: Option<Duration>,
}

impl Controls {
{{- if .Pages.ControlsUse "rate_limit" }}
    /// `@rateLimit({ requestsPerMinute })`.
    fn rate_limit(mut self, requests_per_minute: u32) -> Self {
        self.rate_limit = Some(RateLimiter::per_minute(requests_per_minute));
        self
    }
{{- end }}
{{- if .Pages.ControlsUse "body_limit" }}

    /// `@bodyLimit({ megabytes })`, in mebibytes as the route counts them.
    fn body_limit_megabytes(mut self, megabytes: usize) -> Self {
        let bytes = megabytes.saturating_mul(1024 * 1024);
        self.body_limit = Some((bytes, BodyLimit::max(bytes)));
        self
    }
{{- end }}
{{- if .Pages.ControlsUse "timeout" }}

    /// `@timeout({ seconds })`.
    fn timeout_seconds(mut self, seconds: u64) -> Self {
        self.timeout = Some(Duration::from_secs(seconds));
        self
    }
{{- end }}
}

/// The controls of each operation a page calls whose route has one, which
/// every page that calls the operation shares, and each page that meets
/// one, by its method and the path it is registered at: the place of its
/// operation's controls, none when its route has none, and those of the
/// options operations its references call (D61).
struct PageControls {
    controls: Vec<Controls>,
    pages: Vec<(Method, &'static str, Option<usize>, &'static [usize])>,
}

impl PageControls {
    /// The controls the page the request is for meets, a HEAD's those of
    /// its GET: its operation's, and those of the operations its references
    /// call; none for a page that meets none.
    fn of(&self, cx: &Cx) -> Option<(Option<&Controls>, Vec<&Controls>)> {
        let path = try_endpoint(cx)?.path().as_str();
        let method = if *method(cx) == Method::HEAD { Method::GET } else { method(cx).clone() };
        let &(_, _, own, called) = self.pages.iter().find(|(on, at, _, _)| *on == method && *at == path)?;
        Some((own.map(|own| &self.controls[own]), called.iter().map(|&at| &self.controls[at]).collect()))
    }
}

impl Layer for PageControls {
    fn path(&self) -> Option<&Path> {
        Some(Path::new(PREFIX))
    }

    fn handle<'a>(&'a self, cx: &'a Cx, body: Body, next: Next<'a>) -> LayerFuture<'a> {
        Box::pin(async move {
            let Some((own, called)) = self.of(cx) else {
                return next.run(cx, body).await;
            };
            // Each operation's limiter counts the request, the page's own
            // first, as each route would count its call; the page's own
            // operation bounds its body, which no other call carries; and
            // the tightest timeout covers the page.
            let every = || own.into_iter().chain(called.iter().copied());
            for limiter in every().filter_map(|controls| controls.rate_limit.as_ref()) {
                let client = client_ip(cx).map_or_else(|| "unknown".to_owned(), |ip| ip.to_string());
                if let Err(retry_after) = limiter.take(&client) {
                    let mut response = control_refusal(&ApiError::too_many_requests("Too Many Requests"));
                    response.headers_mut().insert(header::RETRY_AFTER, retry_after.into());
                    return Ok(response);
                }
            }
            // The body is read up to the limit before the page decodes its
            // form: one that declares more, or sends more, is refused.
            let (body, extractor_limit) = match own.and_then(|controls| controls.body_limit.as_ref()) {
                Some((limit, extractor_limit)) => {
                    let too_large = || ApiError::payload_too_large("Request body exceeds the accepted size");
                    let declared = headers(cx)
                        .get(header::CONTENT_LENGTH)
                        .and_then(|value| value.to_str().ok())
                        .and_then(|value| value.parse::<u64>().ok());
                    if declared.is_some_and(|length| length > *limit as u64) {
                        return Ok(control_refusal(&too_large()));
                    }
                    match to_bytes(body, *limit).await {
                        Ok(bytes) => (Body::from(bytes), Some(extractor_limit)),
                        Err(err) if err.is::<ContentTooLargeError>() => return Ok(control_refusal(&too_large())),
                        Err(_) => return Ok(control_refusal(&ApiError::bad_request("The request body could not be read"))),
                    }
                }
                None => (body, None),
            };
            let page = async move {
                match extractor_limit {
                    Some(layer) => layer.handle(cx, body, next).await,
                    None => next.run(cx, body).await,
                }
            };
            match every().filter_map(|controls| controls.timeout).min() {
                Some(timeout) => match tokio::time::timeout(timeout, page).await {
                    Ok(response) => response,
                    Err(_) => Ok(control_refusal(&ApiError::gateway_timeout("Gateway Timeout"))),
                },
                None => page.await,
            }
        })
    }
}

/// A route control's refusal as the pages show a refusal: its status, and
/// a section with its heading and its message. The page did not run, so no
/// layout frames it.
fn control_refusal(err: &ApiError) -> Response {
    let message = err.message.replace('&', "&amp;").replace('<', "&lt;").replace('>', "&gt;");
    let html = format!(
        r#"<section class="ss-refusal" data-status="{}"><h1>{}</h1><p>{message}</p></section>"#,
        err.status.as_str(),
        heading(err.status),
    );
    let mut response = Response::new(Body::from(html));
    *response.status_mut() = err.status;
    response.headers_mut().insert(header::CONTENT_TYPE, HeaderValue::from_static("text/html; charset=utf-8"));
    response
}
{{- end }}
