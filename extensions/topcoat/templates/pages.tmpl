/// What a refusal says: its form's messages, then each control's after its
/// name.
fn messages(refusal: &Refusal) -> Vec<String> {
    let mut out = refusal.errors.form.clone();
    for (name, list) in &refusal.errors.fields {
        out.extend(list.iter().map(|message| format!("{name}: {message}")));
    }
    out
}

/// A refusal in place of the page: its status, what it says, and for a
/// caller who is not signed in (401) a link to the app's sign-in page that
/// comes back to `next`.
#[component]
async fn refused(cx: &Cx, refusal: Refusal, #[into] next: String) -> topcoat::Result<impl View> {
    let status = refusal.status;
    let sign_in = if status == StatusCode::UNAUTHORIZED { Settings::of(cx).sign_in_href(&next) } else { None };
    let messages = messages(&refusal);
    Ok(view! {
        (status)
        <section class="ss-refusal" data-status=(status.as_str().to_owned())>
            <h1>(heading(status))</h1>
            for message in messages {
                <p>(message)</p>
            }
            if let Some(href) = sign_in {
                <p><a class="ss-sign-in" href=(href)>"Sign in"</a></p>
            }
        </section>
    })
}

/// The heading of a refusal by its status.
fn heading(status: StatusCode) -> &'static str {
    match status.as_u16() {
        401 => "Sign in to see this page",
        403 => "Not allowed",
        404 => "Not found",
        413 => "Too large",
        429 => "Too many requests",
        504 => "Timed out",
        _ => "Refused",
    }
}

/// A link of the nav and the index: a resource's list.
struct Link {
    href: &'static str,
    label: &'static str,
}

/// The resources no item holds whose list the caller may use (`can_*`),
/// and whether a guard refused a caller who is not signed in (401), whom
/// signing in may admit. The request keeps it (`#[memoize]`), so the nav
/// and the index ask each guard once.
#[memoize]
async fn listed(cx: &Cx) -> (Vec<Link>, bool) {
{{- if .Pages.Top }}
    let mut links = Vec::new();
    let mut signed_out = false;
{{- range .Pages.Top }}
    let link = Link { href: {{ rustString .Path }}, label: {{ rustString .Plural }} };
    admit(operations::can_{{ .List.Snake }}(cx).await.map_err(|err| err.status), link, &mut links, &mut signed_out);
{{- end }}
    (links, signed_out)
{{- else }}
    let _ = cx;
    (Vec::new(), false)
{{- end }}
}
{{- if .Pages.Top }}

/// Adds `link` when its guard admitted the caller, else notes whether it
/// refused a caller who is not signed in.
fn admit<T>(admitted: Result<T, StatusCode>, link: Link, links: &mut Vec<Link>, signed_out: &mut bool) {
    match admitted {
        Ok(_) => links.push(link),
        Err(status) => *signed_out |= status == StatusCode::UNAUTHORIZED,
    }
}
{{- end }}

/// A collection in the trail: its key, its words in a path, its labels,
/// which of its pages exist, whether an item has a title, whether a
/// reference names an item by its route's value, and the collections under
/// its items.
struct Node {
{{- if .Pages.Uses "itemTitle" }}
    key: &'static str,
    titled: bool,
{{- end }}
{{- if .Pages.Uses "trailReference" }}
    reference: Option<&'static str>,
{{- end }}
    words: &'static [&'static str],
    plural: &'static str,
    noun: &'static str,
    list: bool,
    detail: bool,
    create: Option<&'static str>,
    edit: bool,
    delete: bool,
    actions: &'static [(&'static str, &'static str)],
    children: &'static [Node],
}

/// Each collection with a page, and each on the way to one.
const TREE: &[Node] = {{ .Pages.Tree }};

/// A step of the trail: its label, its link (none for a page that does not
/// exist and for the page itself), whether it is the page itself, for an
/// item whose type has a title the collection's key and the route's values
/// to read it with, and for an item a reference names the collection's key
/// and the route's value.
struct Crumb {
    label: String,
    href: Option<String>,
    current: bool,
{{- if .Pages.Uses "itemTitle" }}
    item: Option<(&'static str, Vec<String>)>,
{{- end }}
{{- if .Pages.Uses "trailReference" }}
    reference: Option<(&'static str, String)>,
{{- end }}
}

/// The trail from the index to the page at `path`: the index, then each
/// collection's list, each item by its noun and id and the page under it,
/// a link where a page shows it; the last is the page itself. Where two
/// collections' words begin the rest of the path, the one with more words
/// is its collection (`widgets/archived`, not an item of `widgets`), and a
/// collection under an item is read before the item's own pages.
fn trail(path: &str, title: &str) -> Vec<Crumb> {
    let crumb = |label: String, href: Option<String>| Crumb { label, href, current: false{{ if .Pages.Uses "itemTitle" }}, item: None{{ end }}{{ if .Pages.Uses "trailReference" }}, reference: None{{ end }} };
    let mut crumbs = vec![crumb(title.to_owned(), Some(PREFIX.to_owned()))];
    let segments: Vec<&str> =
        path.strip_prefix(PREFIX).unwrap_or_default().split('/').filter(|segment| !segment.is_empty()).collect();
    let mut nodes = TREE;
    let mut base = PREFIX.to_owned();
{{- if .Pages.Uses "itemTitle" }}
    let mut ids = Vec::new();
{{- end }}
    let mut at = 0;
    while let Some(node) =
        nodes.iter().filter(|node| segments[at..].starts_with(node.words)).max_by_key(|node| node.words.len())
    {
        for word in node.words {
            base.push('/');
            base.push_str(word);
        }
        at += node.words.len();
        crumbs.push(crumb(node.plural.to_owned(), node.list.then(|| base.clone())));
        let Some(&item) = segments.get(at) else {
            break;
        };
        if let (Some(label), "new") = (node.create, item) {
            crumbs.push(crumb(label.to_owned(), None));
            break;
        }
        base.push('/');
        base.push_str(item);
{{- if .Pages.Uses "itemTitle" }}
        ids.push(decode(item));
{{- end }}
{{- if or (.Pages.Uses "itemTitle") (.Pages.Uses "trailReference") }}
        crumbs.push(Crumb {
{{- if .Pages.Uses "itemTitle" }}
            item: node.titled.then(|| (node.key, ids.clone())),
{{- end }}
{{- if .Pages.Uses "trailReference" }}
            reference: node.reference.map(|key| (key, decode(item))),
{{- end }}
            ..crumb(item_label(node.noun, decode(item)), node.detail.then(|| base.clone()))
        });
{{- else }}
        crumbs.push(crumb(item_label(node.noun, decode(item)), node.detail.then(|| base.clone())));
{{- end }}
        at += 1;
        let Some(&page) = segments.get(at) else {
            break;
        };
        nodes = node.children;
        if nodes.iter().any(|child| segments[at..].starts_with(child.words)) {
            continue;
        }
        let label = match page {
            "edit" if node.edit => Some("Edit"),
            "delete" if node.delete => Some("Delete"),
            _ => node.actions.iter().find(|(verb, _)| *verb == page).map(|(_, label)| *label),
        };
        if let Some(label) = label {
            crumbs.push(crumb(label.to_owned(), None));
        }
        break;
    }
    if let Some(last) = crumbs.last_mut() {
        last.href = None;
        last.current = true;
    }
    crumbs
}

/// An item in the trail without a title: its noun and id, or its id alone
/// for a collection without pages, whose items no type names.
fn item_label(noun: &str, id: String) -> String {
    if noun.is_empty() { id } else { format!("{noun} {id}") }
}
{{- if .Pages.Uses "itemTitle" }}

/// The title of the item of the collection `key` at the route's `ids`, its
/// title field's value, for the trail; none when it is empty or the caller
/// may not read the item. The item's detail is the page's own call, which
/// the request keeps.
async fn item_title(cx: &Cx, key: &str, ids: &[String]) -> Option<String> {
    match (key, ids) {
{{- range .Pages.Resources }}
{{- if .TitleExpr }}
        ({{ rustString .Key }}, [{{ join .ItemParams ", " }}]) => match call_{{ .Detail.Snake }}(cx{{ passAfter .ItemParams "" }}).await {
            Ok(item) => {{ .TitleExpr }},
            Err(_) => None,
        },
{{- end }}
{{- end }}
        _ => None,
    }
    .filter(|title| !title.trim().is_empty())
}
{{- end }}
{{- if .Pages.Uses "trailReference" }}

/// The label of the item that the route's `value` at a step of the trail,
/// the collection `key`'s, refers to (D61), when its title does not name it:
/// the label of the target every operation's parameter there refers to
/// (D44, amended). None when no item has the value, its label is blank, or
/// the call is refused or fails.
async fn item_reference(cx: &Cx, key: &str, value: &str) -> Option<String> {
    match key {
{{- range .Pages.Trails }}
        {{ rustString .Key }} => references::{{ .Fn }}(cx, value).await,
{{- end }}
        _ => None,
    }
}
{{- end }}

/// Every page under `{{ .Pages.Prefix }}`: the site's title, a nav of each resource the
/// caller may list, the current one marked (`aria-current`), the one whose
/// path is the longest the page's begins with, the trail from the index to
/// the page, an item by its title, then the page in `<main>`.
#[layout({{ rustString .Pages.Prefix }})]
pub async fn pages_layout(cx: &Cx, slot: Slot<'_>) -> topcoat::Result<impl View> {
    let title = Settings::of(cx).site_title();
    let path = uri(cx).path().to_owned();
    let (links, _) = listed(cx).await;
    // The resource the page is at or under: the link with the longest path,
    // so a list whose path extends another's (`widgets/archived`) is the
    // current one on its own pages.
    let at = |href: &str| path.strip_prefix(href).is_some_and(|rest| rest.is_empty() || rest.starts_with('/'));
    let under = links.iter().map(|link| link.href).filter(|href| at(href)).max_by_key(|href| href.len());
    let nav: Vec<(&'static str, &'static str, Option<&'static str>)> = links
        .iter()
        .map(|link| {
            let current = match under {
                Some(href) if href == link.href && path == href => Some("page"),
                Some(href) if href == link.href => Some("true"),
                _ => None,
            };
            (link.href, link.label, current)
        })
        .collect();
{{- if and (.Pages.Uses "itemTitle") (.Pages.Uses "trailReference") }}
    // An item's step is named by its title, else by what its route's value
    // refers to, else by its noun and id.
    let mut crumbs = trail(&path, &title);
    for crumb in &mut crumbs {
        let titled = match &crumb.item {
            Some((key, ids)) => item_title(cx, key, ids).await,
            None => None,
        };
        if let Some(title) = titled {
            crumb.label = title;
        } else if let Some((key, value)) = &crumb.reference
            && let Some(label) = item_reference(cx, key, value).await
        {
            crumb.label = label;
        }
    }
{{- else if .Pages.Uses "itemTitle" }}
    let mut crumbs = trail(&path, &title);
    for crumb in &mut crumbs {
        if let Some((key, ids)) = &crumb.item
            && let Some(title) = item_title(cx, key, ids).await
        {
            crumb.label = title;
        }
    }
{{- else if .Pages.Uses "trailReference" }}
    // An item's step is named by what its route's value refers to, else by
    // its noun and id.
    let mut crumbs = trail(&path, &title);
    for crumb in &mut crumbs {
        if let Some((key, value)) = &crumb.reference
            && let Some(label) = item_reference(cx, key, value).await
        {
            crumb.label = label;
        }
    }
{{- else }}
    let crumbs = trail(&path, &title);
{{- end }}
    let crumbs: Vec<(String, Option<String>, bool)> =
        crumbs.into_iter().map(|crumb| (crumb.label, crumb.href, crumb.current)).collect();
    Ok(view! {
        <div class="ss-pages">
            <header class="ss-header"><a href=(PREFIX)>(title)</a></header>
            if !nav.is_empty() {
                <nav class="ss-nav" aria-label="Resources">
                    <ul>
                        for (href, label, current) in nav {
                            <li><a href=(href) aria-current=(current)>(label)</a></li>
                        }
                    </ul>
                </nav>
            }
            <nav class="ss-trail" aria-label="Breadcrumb">
                <ol>
                    for (label, href, current) in crumbs {
                        <li>
                            if let Some(href) = href {
                                <a href=(href)>(label)</a>
                            } else {
                                <span aria-current=(current.then_some("page"))>(label)</span>
                            }
                        </li>
                    }
                </ol>
            </nav>
            <main class="ss-main">(slot)</main>
        </div>
    })
}

/// The index: a link to each resource the caller may list, and a link to
/// sign in when a guard refused a caller who is not signed in.
#[page({{ rustString .Pages.Prefix }})]
pub async fn pages_index_page(cx: &Cx) -> topcoat::Result<impl View> {
    let settings = Settings::of(cx);
    let (links, signed_out) = listed(cx).await;
    let sign_in = if *signed_out { settings.sign_in_href(&current(cx)) } else { None };
    Ok(view! {
        <h1>(settings.site_title())</h1>
        if links.is_empty() {
            <p class="ss-empty">"There is nothing here you may list."</p>
        } else {
            <ul class="ss-index">
                for link in links {
                    <li><a href=(link.href)>(link.label)</a></li>
                }
            </ul>
        }
        if let Some(href) = sign_in {
            <p><a class="ss-sign-in" href=(href)>"Sign in"</a></p>
        }
    })
}
