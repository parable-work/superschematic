{{ doc (printf "One of the %s: its detail%s%s%s%s%s, each when the caller may.%s" $r.PluralLower (or (and $r.Update ", a link to edit it") "") (or (and $r.Delete ", a link to delete it") "") (or (and $r.Actions ", a form per action") "") (or (and $r.Sections ", the sections under it") "") "" (or (and $r.Actions " A refused action renders its form again as sent, with its errors.") "")) }}
#[component]
async fn {{ $r.Ident }}_item(
    cx: &Cx,
{{- range $r.ItemParams }}
    {{ . }}: String,
{{- end }}
{{- range $r.Actions }}
    #[default] {{ .Field }}: Option<({{ .ArgForm.Name }}, FormErrors)>,
{{- end }}
) -> topcoat::Result<impl View> {
    let href = {{ $r.Ident }}_item_href({{ pass $r.ItemParams "&" }}).unwrap_or_else(|| PREFIX.to_owned());
    let found = call_{{ .Snake }}(cx{{ passAfter .Params "&" }}).await.map(|item| {
        let record = {{ $r.DetailRecord }}::from(item);
        ({{ $r.HeadingExpr }}, record)
    });
{{- with $r.Update }}
    let edits = operations::can_{{ .Snake }}(cx).await.is_ok();
{{- end }}
{{- with $r.Delete }}
    let deletes = operations::can_{{ .Snake }}(cx).await.is_ok();
{{- end }}
{{- range $r.Actions }}
    let {{ .Field }} = match {{ .Field }} {
        Some(sent) => Some(sent),
        None => operations::can_{{ .Snake }}(cx).await.is_ok().then(|| ({{ .NewFormOwned }}, FormErrors::default())),
    };
{{- end }}
    Ok(view! {
