{{- if or $r.Update $r.Delete }}
                if {{ if and $r.Update $r.Delete }}edits || deletes{{ else if $r.Update }}edits{{ else }}deletes{{ end }} {
                    <p class="ss-actions">
{{- if $r.Update }}
