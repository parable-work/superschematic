/// The fields of `{{ .Name }}`, each with its label, its value as sent,
/// the attributes the input type's rules give it and its errors; a nested
/// object's in a fieldset, and a list's rows with their buttons. `form` is
/// a new form when the page passes none, and `choices` turns a text or
/// number field the app names into a select.
#[component]
pub async fn {{ .Component }}(
    #[default({{ .Name }}::new())] form: {{ .Name }},
    #[default] errors: FormErrors,
    #[default] choices: Choices,
) -> topcoat::Result<impl View> {
    let form_errors = errors.unshown({{ .Name }}::shows);
{{- if not .Choosable }}
    let _ = choices;
{{- end }}
{{- if not .Visible }}
    let _ = form;
{{- end }}
    Ok(view! {
{{- if .Rows }}
        // The button Enter presses, ahead of every row button: it submits
        // the form without an `_action`.
        <button type="submit" class="ss-submit" hidden=(true)></button>
{{- end }}
        for message in form_errors {
            <p class="form-error">(message)</p>
        }
{{- if .Body }}
{{ .Body }}
{{- end }}
    })
}
{{- end }}
