/// Why a form was refused: each control's messages, and the form's own.
#[derive(Debug, Clone, Default, PartialEq)]
pub struct FormErrors {
    /// Each control's messages, by its name in the form: `email`,
    /// `guest.name`, `rooms[0].adults`.
    pub fields: Vec<(String, Vec<String>)>,
    /// Messages about the form as a whole.
    pub form: Vec<String>,
}

impl FormErrors {
    pub fn is_empty(&self) -> bool {
        self.fields.is_empty() && self.form.is_empty()
    }

    /// The control's messages.
    pub fn of(&self, field: &str) -> Vec<String> {
        self.fields
            .iter()
            .filter(|(name, _)| name == field)
            .flat_map(|(_, messages)| messages.iter().cloned())
            .collect()
    }

    /// The messages of a control and of the values under it, each of
    /// those after its place: a JSON value's member (`vip: expected a
    /// string`), a group's item.
    pub fn under(&self, field: &str) -> Vec<String> {
        let mut out = Vec::new();
        for (name, messages) in &self.fields {
            if name == field {
                out.extend(messages.iter().cloned());
            } else if let Some(place) = place_under(name, field) {
                out.extend(messages.iter().map(|message| format!("{place}: {message}")));
            }
        }
        out
    }

    /// A control's `aria-invalid`: "true" when it, or a value under it, has
    /// a message.
    pub fn invalid(&self, field: &str) -> Option<&'static str> {
        self.fields
            .iter()
            .any(|(name, _)| name == field || place_under(name, field).is_some())
            .then_some("true")
    }

    pub fn add(&mut self, field: &str, message: impl Into<String>) {
        match self.fields.iter_mut().find(|(name, _)| name == field) {
            Some((_, messages)) => messages.push(message.into()),
            None => self.fields.push((field.to_owned(), vec![message.into()])),
        }
    }

    /// The errors of an operation's refusal: its field errors (its `errors`
    /// member, nested for a nested object's fields, and a refused
    /// parameter's, which the router's 400 names in its `details`) when it
    /// has them, else its detail, so a form shows what the operation refused
    /// as it shows what `parse` refused.
    pub fn from_api(err: &ApiError) -> Self {
        let mut errors = Self::default();
        if let Some(fields) = err.errors.as_deref() {
            errors.read("", fields);
        }
        if let Some(details) = err.details.as_deref() {
            errors.read_parameter(details);
        }
        if errors.is_empty() {
            errors.form.push(err.message.clone());
        }
        errors
    }

    /// Reads a refused parameter's errors from the router's 400 details
    /// (`{parameter, path?, reason, errors?}`), at the parameter: each
    /// broken rule's message, else the reason.
    fn read_parameter(&mut self, details: &Value) {
        let Some(parameter) = details.get("parameter").and_then(Value::as_str) else {
            return;
        };
        let messages: Vec<&str> = details["errors"]
            .as_array()
            .into_iter()
            .flatten()
            .filter_map(|error| error.get("message").and_then(Value::as_str))
            .collect();
        if messages.is_empty()
            && let Some(reason) = details.get("reason").and_then(Value::as_str)
        {
            self.add(parameter, reason);
        }
        for message in messages {
            self.add(parameter, message);
        }
    }

    /// Reads field errors keyed by path, nested for a nested object's
    /// fields (`{"rooms[0]": {"adults": [...]}}`), each a list of
    /// `{validator, message}`.
    fn read(&mut self, prefix: &str, fields: &Value) {
        for (key, value) in fields.as_object().into_iter().flatten() {
            let field = if prefix.is_empty() { key.clone() } else { format!("{prefix}.{key}") };
            match value {
                Value::Array(messages) => {
                    for message in messages {
                        if let Some(text) = message.get("message").and_then(Value::as_str) {
                            self.add(&field, text);
                        }
                    }
                }
                nested => self.read(&field, nested),
            }
        }
    }

    /// The form's own messages, and those of a place the component shows
    /// no control for (an `@uiHidden` field, a hidden path argument, a key
    /// the form does not declare), each after its name.
    fn unshown(&self, shows: fn(&[Segment]) -> bool) -> Vec<String> {
        let mut out = self.form.clone();
        for (name, messages) in &self.fields {
            if !segments(name).is_some_and(|path| shows(&path)) {
                out.extend(messages.iter().map(|message| format!("{name}: {message}")));
            }
        }
        out
    }
{{- if .FormsUse "argsInput" }}

    /// Adds an embedded input form's errors to its argument form's.
    fn merge(&mut self, refused: FormErrors) {
        for (field, messages) in refused.fields {
            for message in messages {
                self.add(&field, message);
            }
        }
        self.form.extend(refused.form);
    }
{{- end }}
}

/// Where `name` is under `field`: `vip` of `labels.vip`, `[1]` of
/// `tags[1]`.
fn place_under<'a>(name: &'a str, field: &str) -> Option<&'a str> {
    let rest = name.strip_prefix(field)?;
    rest.strip_prefix('.').or_else(|| rest.starts_with('[').then_some(rest))
}

impl From<ParseError> for FormErrors {
    fn from(err: ParseError) -> Self {
        let mut errors = Self::default();
        if let ParseError::Invalid(fields) = &err {
            for (field, messages) in fields.flatten() {
                for message in messages {
                    errors.add(&field, message.message);
                }
            }
        }
        if errors.is_empty() {
            errors.form.push(err.to_string());
        }
        errors
    }
}

/// Options the app supplies for a form's text and number controls, each
/// of which then renders as a `<select>`. An input type does not say which
/// values an id may take (a product's, a room's), so the page that renders
/// the form says, per field.
///
/// A field is named by its path with the rows' indexes left out,
/// `rooms.roomId` for every room's, or by its control's name,
/// `rooms[0].roomId` for one row's, which wins.
#[derive(Debug, Clone, Default, PartialEq)]
pub struct Choices {
    fields: Vec<(String, Vec<Choice>)>,
}

/// One option: the value a form sends and the label it shows.
#[derive(Debug, Clone, PartialEq)]
pub struct Choice {
    pub value: String,
    pub label: String,
}

impl Choices {
    pub fn new() -> Self {
        Self::default()
    }

    /// These choices with `field`'s options, each a value and its label,
    /// in order.
    #[must_use]
    pub fn with<V: Into<String>, L: Into<String>>(
        mut self,
        field: impl Into<String>,
        options: impl IntoIterator<Item = (V, L)>,
    ) -> Self {
        let options = options
            .into_iter()
            .map(|(value, label)| Choice { value: value.into(), label: label.into() })
            .collect();
        self.fields.push((field.into(), options));
        self
    }

    /// The options of the control named `name`, else of its `path`.
    pub fn of(&self, name: &str, path: &str) -> Option<&[Choice]> {
        self.find(name).or_else(|| self.find(path))
    }

    fn find(&self, field: &str) -> Option<&[Choice]> {
        self.fields
            .iter()
            .rev()
            .find(|(name, _)| name == field)
            .map(|(_, options)| options.as_slice())
    }
}
{{- if .FormsUse "choosable" }}

/// A select's options: each choice, selected when it is the value held,
/// and the value held when no choice is it, so a form renders as sent.
fn choice_options(options: &[Choice], held: Option<&str>) -> Vec<(String, String, bool)> {
    let mut out: Vec<_> = options
        .iter()
        .map(|option| (option.value.clone(), option.label.clone(), held == Some(option.value.as_str())))
        .collect();
    if let Some(held) = held
        && !options.iter().any(|option| option.value == held)
    {
        out.push((held.to_owned(), held.to_owned(), true));
    }
    out
}

/// The `<select>` the app's choices make of a text or number control when
/// they name it (`Choices::of`): a blank option, selected when no choice
/// is, then each choice (`choice_options`).
#[component]
async fn choice_select(
    #[into] id: String,
    #[into] name: String,
    required: bool,
    invalid: Option<&'static str>,
    options: Vec<(String, String, bool)>,
) -> topcoat::Result<impl View> {
    let blank = !options.iter().any(|(_, _, selected)| *selected);
    Ok(view! {
        <select id=(id) name=(name) required=(required) aria-invalid=(invalid)>
            <option value="" selected=(blank)>""</option>
            for (value, label, selected) in options {
                <option value=(value) selected=(selected)>(label)</option>
            }
        </select>
    })
}
{{- end }}

/// A step of a control's name: a field's key, or a row's index.
#[derive(Debug, Clone, PartialEq)]
enum Segment {
    Key(String),
    Index(usize),
}

/// The most steps a name a form reads has.
const MAX_DEPTH: usize = 32;

/// A control's name as its steps, `rooms[0].roomId` as `rooms`, `0` and
/// `roomId`; None for a name no control has.
fn segments(name: &str) -> Option<Vec<Segment>> {
    let mut path = Vec::new();
    let mut rest = name;
    loop {
        let end = rest.find(['.', '[']).unwrap_or(rest.len());
        if end == 0 {
            return None;
        }
        path.push(Segment::Key(rest[..end].to_owned()));
        rest = &rest[end..];
        while let Some(index) = rest.strip_prefix('[') {
            let (digits, after) = index.split_once(']')?;
            path.push(Segment::Index(digits.parse().ok()?));
            rest = after;
        }
        if path.len() > MAX_DEPTH {
            return None;
        }
        if rest.is_empty() {
            return Some(path);
        }
        rest = rest.strip_prefix('.')?;
    }
}

/// The pairs a form posts, as a tree of their names: `rooms[0].roomId` is
/// the value of key `roomId` of row 0 of key `rooms`. A name no control
/// has is left out.
#[derive(Debug, Default)]
struct Posted {
    values: Vec<String>,
    keys: BTreeMap<String, Posted>,
    rows: BTreeMap<usize, Posted>,
}

/// What a name holds when nothing was posted under it.
static NOTHING: Posted = Posted { values: Vec::new(), keys: BTreeMap::new(), rows: BTreeMap::new() };

impl Posted {
    fn from_pairs(pairs: impl IntoIterator<Item = (String, String)>) -> Self {
        let mut root = Self::default();
        for (name, value) in pairs {
            let Some(path) = segments(&name) else {
                continue;
            };
            let mut node = &mut root;
            for segment in path {
                node = match segment {
                    Segment::Key(key) => node.keys.entry(key).or_default(),
                    Segment::Index(index) => node.rows.entry(index).or_default(),
                };
            }
            node.values.push(value);
        }
        root
    }

    /// What was posted under `key`.
    fn get(&self, key: &str) -> &Posted {
        self.keys.get(key).unwrap_or(&NOTHING)
    }
{{- if .FormsUse "postedText" }}

    /// The last value posted at this name, unless it is empty, as a browser
    /// sends a blank control: an input form's value, which a checkbox row
    /// sends after its hidden input.
    fn text(&self) -> Option<String> {
        self.values.last().filter(|value| !value.is_empty()).cloned()
    }
{{- end }}
{{- if .FormsUse "first" }}

    /// The first value posted at this name, unless it is empty: an
    /// argument's, as the router reads a parameter sent twice.
    fn first(&self) -> Option<String> {
        self.values.first().filter(|value| !value.is_empty()).cloned()
    }
{{- end }}
{{- if .FormsUse "values" }}

    /// Each value posted at this name that is not empty: a group's checked
    /// members, a list argument's values. A query list's (`split`) are each
    /// split on commas, as the router splits one.
    fn values(&self, split: bool) -> Vec<String> {
        let values = self.values.iter().filter(|value| !value.is_empty());
        if !split {
            return values.cloned().collect();
        }
        values
            .flat_map(|value| value.split(','))
            .map(str::trim)
            .filter(|item| !item.is_empty())
            .map(str::to_owned)
            .collect()
    }
{{- end }}
{{- if .FormsUse "postedRows" }}

    /// Each row posted under this name, in the order of their indexes.
    fn rows(&self) -> impl Iterator<Item = &Posted> {
        self.rows.values()
    }
{{- end }}
}
{{- if .FormsUse "read" }}

/// What one control sent, read as the input's JSON: nothing, a value, or
/// the message of a value it cannot be.
type Read = Result<Option<Value>, &'static str>;
{{- end }}
{{- if .FormsUse "put" }}

/// Puts a control's value at `key`, or its message at its control.
fn put(json: &mut Map<String, Value>, errors: &mut FormErrors, key: &str, name: &str, read: Read) {
    match read {
        Ok(Some(value)) => {
            json.insert(key.to_owned(), value);
        }
        Ok(None) => {}
        Err(message) => errors.add(name, message),
    }
}
{{- end }}
{{- if .FormsUse "list" }}

/// Puts a list at `key`: always when the input requires it, else when it
/// holds an item.
fn put_list(json: &mut Map<String, Value>, key: &str, items: Vec<Value>, required: bool) {
    if required || !items.is_empty() {
        json.insert(key.to_owned(), Value::Array(items));
    }
}
{{- end }}
{{- if .FormsUse "valueRows" }}

/// A row of a list of values: its value, or null for a row that sent none,
/// which the input's rules refuse at the row, as a list holds no null; a
/// value the row cannot be is its message.
fn row(errors: &mut FormErrors, name: &str, read: Read) -> Value {
    match read {
        Ok(value) => value.unwrap_or(Value::Null),
        Err(message) => {
            errors.add(name, message);
            Value::Null
        }
    }
}
{{- end }}
{{- if .FormsUse "text" }}

/// A text control's value as sent, when it sent one.
fn text(value: Option<&str>) -> Read {
    Ok(value.map(Value::from))
}
{{- end }}
{{- if .FormsUse "boolean" }}

/// A checkbox: true when the browser sent it, which it does when checked.
fn boolean(value: Option<&str>) -> Read {
    Ok(Some(Value::from(value.is_some())))
}
{{- end }}
{{- if .FormsUse "flag" }}

/// A filter's optional flag: true when its checkbox is sent, which it is
/// when checked, and absent when not, so it filters nothing.
fn flag(value: Option<&str>) -> Read {
    Ok(value.map(|_| Value::Bool(true)))
}
{{- end }}
{{- if .FormsUse "integer" }}

/// A whole number, refused when it is not one.
fn integer(value: Option<&str>) -> Read {
    match value {
        None => Ok(None),
        Some(text) => text.trim().parse::<i64>().map(|number| Some(Value::from(number))).map_err(|_| "must be a whole number"),
    }
}
{{- end }}
{{- if .FormsUse "number" }}

/// A number, refused when it is not one.
fn number(value: Option<&str>) -> Read {
    match value.map(|text| text.trim().parse::<f64>()) {
        None => Ok(None),
        Some(Ok(number)) if number.is_finite() => Ok(Some(Value::from(number))),
        Some(_) => Err("must be a number"),
    }
}
{{- end }}
{{- if .FormsUse "date_time" }}

/// A date and time from a `datetime-local` control, which carries no
/// offset, read as UTC: `2026-10-09T14:30` is `2026-10-09T14:30:00Z`. A
/// value with an offset, which an app may set, keeps it.
fn date_time(value: Option<&str>) -> Read {
    match value.map(str::trim) {
        None => Ok(None),
        Some(text) => utc_date_time(text).map(|text| Some(Value::from(text))).ok_or("must be a date and time"),
    }
}

/// `YYYY-MM-DDTHH:MM`, with seconds and a fraction or not, as the API
/// reads it: in UTC unless it ends in an offset (`Z`, `+01:00`). None for
/// any other text, or a date or a time that does not exist.
fn utc_date_time(text: &str) -> Option<String> {
    let (date, rest) = text.split_once('T')?;
    let (clock, offset) = rest.split_at(rest.find(['Z', '+', '-']).unwrap_or(rest.len()));
    let (d, c, o) = (date.as_bytes(), clock.as_bytes(), offset.as_bytes());
    let year = digits(d, 0..4).filter(|year| *year >= 1000)?;
    let month = digits(d, 5..7).filter(|month| (1..=12).contains(month))?;
    digits(d, 8..10).filter(|day| (1..=days_in_month(year, month)).contains(day))?;
    digits(c, 0..2).filter(|hour| *hour < 24)?;
    digits(c, 3..5).filter(|minute| *minute < 60)?;
    let seconds = match c.len() {
        5 => ":00",
        8.. if c[5] == b':'
            && digits(c, 6..8).is_some_and(|second| second < 60)
            && (c.len() == 8 || (c[8] == b'.' && c.len() > 9 && c[9..].iter().all(u8::is_ascii_digit))) =>
        {
            ""
        }
        _ => return None,
    };
    let offset_ok = match o {
        [] | [b'Z'] => true,
        [b'+' | b'-', ..] => {
            o.len() == 6
                && o[3] == b':'
                && digits(o, 1..3).is_some_and(|hour| hour < 24)
                && digits(o, 4..6).is_some_and(|minute| minute < 60)
        }
        _ => false,
    };
    let zone = if offset.is_empty() { "Z" } else { offset };
    (d.len() == 10 && d[4] == b'-' && d[7] == b'-' && c[2] == b':' && offset_ok)
        .then(|| format!("{date}T{clock}{seconds}{zone}"))
}

/// The number the ASCII digits at `range` spell, when they are all digits.
fn digits(bytes: &[u8], range: std::ops::Range<usize>) -> Option<u32> {
    let digits = bytes.get(range)?;
    digits
        .iter()
        .all(u8::is_ascii_digit)
        .then(|| digits.iter().fold(0, |number, digit| number * 10 + u32::from(digit - b'0')))
}

fn days_in_month(year: u32, month: u32) -> u32 {
    match month {
        2 if year.is_multiple_of(4) && (!year.is_multiple_of(100) || year.is_multiple_of(400)) => 29,
        2 => 28,
        4 | 6 | 9 | 11 => 30,
        _ => 31,
    }
}
{{- end }}
{{- if .FormsUse "localDateTime" }}

/// A date and time as a `datetime-local` control shows it: a UTC value
/// without its `Z`.
fn local_date_time(value: Option<&str>) -> Option<&str> {
    value.map(|value| value.strip_suffix('Z').or_else(|| value.strip_suffix("+00:00")).unwrap_or(value))
}
{{- end }}
{{- if .FormsUse "json_text" }}

/// A JSON value, from its text.
fn json_text(value: Option<&str>) -> Read {
    match value {
        None => Ok(None),
        Some(text) => serde_json::from_str(text).map(Some).map_err(|_| "must be JSON"),
    }
}
{{- end }}
{{- if .FormsUse "checked" }}

/// Whether a group's checkbox for `value` is checked.
fn checked(values: &[String], value: &str) -> bool {
    values.iter().any(|sent| sent == value)
}
{{- end }}
{{- if .FormsUse "rows" }}

/// A list's bounds: a row button adds no row past `max`, the list's
/// listMax, and removes none at `min`, its listMin.
#[derive(Clone, Copy)]
struct Bounds {
    min: usize,
    max: Option<usize>,
}

/// Applies a row action to `rows` at `path`: adds a row (`new`) when
/// `path` is the list, or removes the row it names, within `bounds`; a
/// path into a row is the row's (`act`). True when it did.
fn act_on_rows<T>(
    rows: &mut Vec<T>,
    path: &[Segment],
    add: bool,
    bounds: Bounds,
    new: impl FnOnce() -> T,
    act: impl FnOnce(&mut T, &[Segment], bool) -> bool,
) -> bool {
    match path {
        [] if add => {
            let room = bounds.max.is_none_or(|max| rows.len() < max);
            if room {
                rows.push(new());
            }
            room
        }
        [Segment::Index(index)] if !add => {
            let removable = *index < rows.len() && rows.len() > bounds.min;
            if removable {
                rows.remove(*index);
            }
            removable
        }
        [Segment::Index(index), rest @ ..] => rows.get_mut(*index).is_some_and(|row| act(row, rest, add)),
        _ => false,
    }
}
{{- end }}
{{- if .FormsUse "noRows" }}

/// The row action of a row that holds no list.
fn no_rows<T>(_row: &mut T, _path: &[Segment], _add: bool) -> bool {
    false
}
{{- end }}
{{- if .FormsUse "showsAll" }}

/// A JSON value or a group shows the errors at it and under it.
fn shows_all(_path: &[Segment]) -> bool {
    true
}
{{- end }}
{{- if .FormsUse "showsRow" }}

/// A list of values shows its errors and each row's.
fn shows_row(path: &[Segment]) -> bool {
    matches!(path, [] | [Segment::Index(_)])
}
{{- end }}
{{- if .FormsUse "showsRows" }}

/// A list of objects shows its errors, each row's, and what each row's
/// struct shows.
fn shows_rows(path: &[Segment], shows: fn(&[Segment]) -> bool) -> bool {
    match path {
        [] => true,
        [Segment::Index(_), rest @ ..] => shows(rest),
        _ => false,
    }
}
{{- end }}
{{- if .FormsUse "argsSingle" }}

/// A single argument: its value read as the JSON a request carries,
/// absent when none was sent, then decoded into the argument's type.
/// `None` when refused, with the field's error.
fn single<T: DeserializeOwned>(errors: &mut FormErrors, key: &str, read: Read) -> Option<T> {
    match read {
        Ok(value) => decode(errors, key, value.unwrap_or(Value::Null)),
        Err(message) => {
            errors.add(key, message);
            None
        }
    }
}
{{- end }}
{{- if .FormsUse "argsList" }}

/// A list argument: absent when no value was sent, else each value read
/// by `read`, then decoded into the argument's type. `None` when refused,
/// with the field's error.
fn list<T: DeserializeOwned>(errors: &mut FormErrors, key: &str, values: &[String], read: fn(Option<&str>) -> Read) -> Option<T> {
    if values.is_empty() {
        return decode(errors, key, Value::Null);
    }
    let mut items = Vec::with_capacity(values.len());
    for value in values {
        match read(Some(value)) {
            Ok(Some(json)) => items.push(json),
            Ok(None) => {}
            Err(message) => {
                errors.add(key, message);
                return None;
            }
        }
    }
    decode(errors, key, Value::Array(items))
}
{{- end }}
{{- if .FormsUse "args" }}

/// An argument's JSON decoded into its type, as the router decodes a
/// request's. A value that does not decode, or a required one that is
/// absent, is the field's error.
fn decode<T: DeserializeOwned>(errors: &mut FormErrors, key: &str, json: Value) -> Option<T> {
    let absent = json.is_null();
    match serde_json::from_value(json) {
        Ok(value) => Some(value),
        Err(_) => {
            if errors.of(key).is_empty() {
                errors.add(key, if absent { "is required" } else { "does not match the declared type" });
            }
            None
        }
    }
}
{{- end }}
{{- range .FormStructs }}

/// The form of `{{ .TypeName }}`, each field as the browser sends it.
#[derive(Debug, Clone, Default, PartialEq)]
pub struct {{ .Name }} {
{{- range .Fields }}
    pub {{ .Name }}: {{ .RustType }},
{{- end }}
{{- if and .Input .Rows }}
    /// The row button that submitted the form (`_action`), which
    /// `apply_action` applies.
    pub row_action: Option<String>,
{{- end }}
}

impl {{ .Name }} {
    /// A new form: each field's `@default`, a required nested object's new
    /// form, and each list's first rows: its listMin, or one when the
    /// input requires the list. An optional nested object starts empty.
    pub fn new() -> Self {
        Self {
{{- range .Fields }}
            {{ .Name }}: {{ .New }},
{{- end }}
{{- if and .Input .Rows }}
            row_action: None,
{{- end }}
        }
    }
{{- if .Input }}

    /// The form a browser posted, from its pairs: each control read by its
    /// name, a list's rows in the order of their indexes.
    /// `Form<{{ .Name }}>` decodes a post this way.
    pub fn from_pairs(pairs: impl IntoIterator<Item = (String, String)>) -> Self {
        Self::from_post(&Posted::from_pairs(pairs))
    }

    /// The form as posted: its fields, and the row button pressed.
    fn from_post(posted: &Posted) -> Self {
{{- if .Rows }}
        Self { row_action: posted.get("_action").text(), ..Self::from_posted(posted) }
{{- else }}
        Self::from_posted(posted)
{{- end }}
    }

    /// The input: each field read as the input type's JSON, then parsed by
    /// the type's rules with undeclared keys refused; else each control's
    /// errors.
    pub fn parse(&self) -> Result<types::{{ .TypeName }}, FormErrors> {
        let mut errors = FormErrors::default();
        let json = self.write("", &mut errors);
        if !errors.is_empty() {
            return Err(errors);
        }
        {{ .Parse }}(Value::Object(json), UnknownFields::Refuse).map_err(FormErrors::from)
    }
{{- if .Rows }}

    /// Applies the row button that submitted the form, `row_action`: `add:`
    /// and a list's name adds a row to it unless it holds its listMax, and
    /// `remove:` and a row's name removes the row unless its list holds no
    /// more than its listMin; the other rows keep their values, numbered
    /// again. True when a row button submitted the form, whether or not
    /// the list's bounds let it act: the page renders the form again and
    /// does not call the operation.
    pub fn apply_action(&mut self) -> bool {
        let Some(action) = self.row_action.take() else {
            return false;
        };
        let (add, name) = match action.split_once(':') {
            Some(("add", name)) => (true, name),
            Some(("remove", name)) => (false, name),
            _ => return true,
        };
        if let Some(path) = segments(name) {
            self.act(&path, add);
        }
        true
    }
{{- end }}
{{- end }}

    /// The form as posted under `posted`.
    fn from_posted({{ if not .Fields }}_{{ end }}posted: &Posted) -> Self {
        Self {
{{- range .Fields }}
{{- if .IsValue }}
            {{ .Name }}: posted.get({{ rustString .JSONName }}).text(),
{{- else if .IsObject }}
            {{ .Name }}: {{ .Child.Name }}::from_posted(posted.get({{ rustString .JSONName }})),
{{- else if .IsObjectRows }}
            {{ .Name }}: posted.get({{ rustString .JSONName }}).rows().map({{ .Child.Name }}::from_posted).collect(),
{{- else if .IsValueRows }}
            {{ .Name }}: posted.get({{ rustString .JSONName }}).rows().map(Posted::text).collect(),
{{- else if .IsGroup }}
            {{ .Name }}: posted.get({{ rustString .JSONName }}).values(false),
{{- end }}
{{- end }}
{{- if and .Input .Rows }}
            row_action: None,
{{- end }}
        }
    }

    /// Each field as the input type's JSON, its controls named under `at`;
    /// a value a control cannot hold is an error at the control.
{{- if .Fields }}
    fn write(&self, {{ if not .WritesErrors }}_{{ end }}at: &str, {{ if not .WritesErrors }}_{{ end }}errors: &mut FormErrors) -> Map<String, Value> {
        let mut json = Map::new();
{{- range .Fields }}
{{- if .IsValue }}
        put(&mut json, errors, {{ rustString .JSONName }}, &format!("{at}{{ escapeBraces .JSONName }}"), {{ .Read }}(self.{{ .Name }}.as_deref()));
{{- else if .IsObject }}
{{- if .Required }}
        json.insert({{ rustString .JSONName }}.to_owned(), Value::Object(self.{{ .Name }}.write(&format!("{at}{{ escapeBraces .JSONName }}."), errors)));
{{- else }}
        if self.{{ .Name }}.is_sent() {
            json.insert({{ rustString .JSONName }}.to_owned(), Value::Object(self.{{ .Name }}.write(&format!("{at}{{ escapeBraces .JSONName }}."), errors)));
        }
{{- end }}
{{- else if .IsObjectRows }}
        let rows: Vec<Value> = self
            .{{ .Name }}
            .iter()
            .enumerate()
            .map(|(index, row)| Value::Object(row.write(&format!("{at}{{ escapeBraces .JSONName }}[{index}]."), errors)))
            .collect();
        put_list(&mut json, {{ rustString .JSONName }}, rows, {{ .Required }});
{{- else if .IsValueRows }}
        let rows: Vec<Value> = self
            .{{ .Name }}
            .iter()
            .enumerate()
            .map(|(index, value)| row(errors, &format!("{at}{{ escapeBraces .JSONName }}[{index}]"), {{ .Read }}(value.as_deref())))
            .collect();
        put_list(&mut json, {{ rustString .JSONName }}, rows, {{ .Required }});
{{- else if .IsGroup }}
        put_list(&mut json, {{ rustString .JSONName }}, self.{{ .Name }}.iter().map(|value| Value::from(value.as_str())).collect(), {{ .Required }});
{{- end }}
{{- end }}
        json
    }
{{- else }}
    fn write(&self, _at: &str, _errors: &mut FormErrors) -> Map<String, Value> {
        Map::new()
    }
{{- end }}
{{- if .Sent }}

    /// Whether a field was sent: an optional nested object is part of the
    /// input only then.
    fn is_sent(&self) -> bool {
{{- if .Fields }}
        {{ .SentExpr }}
{{- else }}
        false
{{- end }}
    }
{{- end }}
{{- if .Shown }}

    /// Whether the component shows the errors at `path`: at a control, a
    /// nested object's or a list's fieldset, or a row.
    fn shows(path: &[Segment]) -> bool {
{{- if .Visible }}
        match path {
            [] => true,
            [Segment::Key(key), rest @ ..] => match key.as_str() {
{{- range .Fields }}
{{- if not .Hidden }}
{{- if .IsObject }}
                {{ rustString .JSONName }} => {{ .Child.Name }}::shows(rest),
{{- else if .IsObjectRows }}
                {{ rustString .JSONName }} => shows_rows(rest, {{ .Child.Name }}::shows),
{{- else if .IsValueRows }}
                {{ rustString .JSONName }} => shows_row(rest),
{{- else if or .IsGroup (eq .Control "textarea") }}
                {{ rustString .JSONName }} => shows_all(rest),
{{- else }}
                {{ rustString .JSONName }} => rest.is_empty(),
{{- end }}
{{- end }}
{{- end }}
                _ => false,
            },
            _ => false,
        }
{{- else }}
        path.is_empty()
{{- end }}
    }
{{- end }}
{{- if .Rows }}

    /// Applies a row action at `path`: adds a row to the list there, or
    /// removes the row there, within the list's bounds. True when it did.
    fn act(&mut self, path: &[Segment], add: bool) -> bool {
        let [Segment::Key(key), rest @ ..] = path else {
            return false;
        };
        match key.as_str() {
{{- range .Fields }}
{{- if .IsObjectRows }}
            {{ rustString .JSONName }} => act_on_rows(&mut self.{{ .Name }}, rest, add, {{ .Bounds }}, {{ .Child.Name }}::new, {{ if .Child.Rows }}{{ .Child.Name }}::act{{ else }}no_rows{{ end }}),
{{- else if .IsValueRows }}
            {{ rustString .JSONName }} => act_on_rows(&mut self.{{ .Name }}, rest, add, {{ .Bounds }}, || None, no_rows),
{{- else if and .IsObject .Child.Rows }}
            {{ rustString .JSONName }} => self.{{ .Name }}.act(rest, add),
{{- end }}
{{- end }}
            _ => false,
        }
    }
{{- end }}
}
