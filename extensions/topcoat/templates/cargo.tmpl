# Code generated by superschematic topcoat. DO NOT EDIT.
[package]
name = "{{ .CrateName }}"
version = "0.1.0"
edition = "2024"
rust-version = "1.99.0"
description = "Topcoat pages, guards and records over the {{ .SchemaName }} API"
license = "UNLICENSED"
{{- if .Identity }}

# The identity store's SQL client (D50), the API crate's features{{ if .IdentityHosted }}, and
# those of each hosted crate a reference calls whose API has one too{{ end }}.
[features]
identity-postgres = ["{{ .APICrate }}/identity-postgres"{{ range .IdentityHosted }}, "{{ .Crate }}/identity-postgres"{{ end }}]
identity-sqlite = ["{{ .APICrate }}/identity-sqlite"{{ range .IdentityHosted }}, "{{ .Crate }}/identity-sqlite"{{ end }}]
{{- end }}

[dependencies]
{{ .APICrate }} = { path = "{{ .APIDepPath }}" }
{{- range .UsedHosted }}
# The Topcoat crate of {{ .Service }}, which an app hosts beside this one: a
# reference calls its options in-process (D61, amended).
{{ .Crate }} = { path = "{{ .Path }}" }
{{- end }}
{{- if .HasAuth }}
async-trait = "0.1.89"
{{- end }}
{{- if or .HasForms .Procedures .References }}
serde = { version = "1.0.228", features = ["derive"] }
{{- end }}
{{- if or .HasRecords .HasForms }}
serde_json = "1.0.149"
{{- end }}
{{- if .ControlledPages }}
# The timeout of a page's or a procedure's route controls{{ if .EnginePages }}, and the
# blocking pool the engine's pages call the engine on{{ end }}.
tokio = { version = "1.52.2", features = [{{ if .EnginePages }}"rt", {{ end }}"time"] }
{{- else if .ControlledProcedures }}
# The timeout of a procedure's route controls{{ if .EnginePages }}, and the blocking
# pool the engine's pages call the engine on{{ end }}.
tokio = { version = "1.52.2", features = [{{ if .EnginePages }}"rt", {{ end }}"time"] }
{{- else if .ControlledPicks }}
# The timeout of a picker's route controls{{ if .EnginePages }}, and the blocking pool
# the engine's pages call the engine on{{ end }}.
tokio = { version = "1.52.2", features = [{{ if .EnginePages }}"rt", {{ end }}"time"] }
{{- else if .EnginePages }}
# The blocking pool the engine's pages call the engine on.
tokio = { version = "1.52.2", features = ["rt"] }
{{- end }}
topcoat = { version = "0.10", features = ["tower"] }
{{- with .Engine }}
# The engine of {{ .Database }} (D58), in-process on SQLite: its routes as an
# axum router, the behaviors it runs, and the engine document of the
# database's Rust types.
{{ .EngineCrate }} = { path = "{{ .EnginePath }}", default-features = false, features = ["axum", "sqlite"] }
{{ .BehaviorsCrate }} = { path = "{{ .BehaviorsPath }}", default-features = false, features = ["sqlite"] }
{{ .TypesCrate }} = { path = "{{ .TypesPath }}" }
axum = { version = "0.8.9", default-features = false }
{{- if not (or $.HasRecords $.HasForms) }}
serde_json = "1.0.149"
{{- end }}
{{- end }}
{{- if .WritesMoney }}
# Each currency's minor units, by which views.rs formats an amount and
# forms.rs reads a decimal one.
{{- if .ScalarPath }}
{{ .ScalarCrate }} = { path = "{{ .ScalarPath }}" }
{{- else }}
{{ .ScalarCrate }} = "0.1.0"
{{- end }}
{{- end }}
