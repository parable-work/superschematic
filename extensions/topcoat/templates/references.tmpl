{{- end }}
}

/// The rate limit and the timeout a picker's shard meets: its options
/// operation's limiter, which counts each client by its address as Topcoat
/// reads it (`client_key`), the key the route reads too, and the timeout
/// around the shard. A refusal is the route's 429, with `Retry-After`, or
/// its 504, as a page's is.
struct PickControls {
    path: &'static Path,
    rate_limit: Option<Arc<RateLimiter>>,
    timeout: Option<Duration>,
}

impl Layer for PickControls {
    fn path(&self) -> Option<&Path> {
        Some(self.path)
    }

    fn handle<'a>(&'a self, cx: &'a Cx, body: Body, next: Next<'a>) -> LayerFuture<'a> {
        Box::pin(async move {
            if let Some(limiter) = &self.rate_limit
                && let Err(retry_after) = limiter.take(&crate::client_key(cx))
            {
                let mut response = pick_refusal(&ApiError::too_many_requests("Too Many Requests"));
                response.headers_mut().insert(header::RETRY_AFTER, retry_after.into());
                return Ok(response);
            }
            match self.timeout {
                Some(timeout) => match tokio::time::timeout(timeout, next.run(cx, body)).await {
                    Ok(response) => response,
                    Err(_) => Ok(pick_refusal(&ApiError::gateway_timeout("Gateway Timeout"))),
                },
                None => next.run(cx, body).await,
            }
        })
    }
}

/// A route control's refusal as a picker's shard answers it: its status,
/// and its message in the place of the picker.
fn pick_refusal(err: &ApiError) -> Response {
    let message = err.message.replace('&', "&amp;").replace('<', "&lt;").replace('>', "&gt;");
    let html = format!(r#"<p class="field-error" data-status="{}">{message}</p>"#, err.status.as_str());
    let mut response = Response::new(Body::from(html));
    *response.status_mut() = err.status;
    response.headers_mut().insert(header::CONTENT_TYPE, HeaderValue::from_static("text/html; charset=utf-8"));
    response
}
{{- end }}
