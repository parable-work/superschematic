{{ doc (printf "The labels of the values `%s`s show that refer to an item, by their paths, under `choices`, the app's, which win where they name the field: %s. One lookup a target, for every record's values; a value no item has, or that the caller may not list, shows as it is." .Record .SitesText) }}
pub async fn {{ .Fn }}(cx: &Cx, records: &[{{ .Record }}], choices: Choices) -> Choices {
    let json: Vec<Value> = records.iter().map({{ .Record }}::to_wire).collect();
    let mut found = Choices::new();
{{- range .Groups }}
    let sites = unnamed(&choices, &[{{ range $i, $s := .Sites }}{{ if $i }}, {{ end }}({{ rustString $s.Path }}, {{ $s.KeysExpr }}){{ end }}]);
    if !sites.is_empty() {
        let labels = {{ .Source.Base }}_target_labels(cx, &values_at(&json, &sites)).await;
        for (path, _) in sites {
            found = found.with(path, pairs(&labels));
        }
    }
{{- end }}
    choices.or(found)
}
