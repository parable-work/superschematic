{
  "version": 1,
  "stack": "ShopBootstrap",
  "environment": "acme-staging",
  "target": "gcp",
  "provisioner": "pulumi",
  "values": {
    "project": "acme-staging",
    "region": "us-east1"
  },
  "deployables": [],
  "resources": {
    "resources": [
      {
        "id": "builder",
        "type": "gcp:serviceaccount/account:Account",
        "properties": {
          "accountId": "shop-builder",
          "displayName": "Shop builder",
          "project": "acme-staging"
        },
        "phase": "infrastructure",
        "owners": [
          "bootstrap"
        ]
      },
      {
        "id": "builder.repository",
        "type": "gcp:artifactregistry/repositoryIamMember:RepositoryIamMember",
        "properties": {
          "location": "us-east1",
          "member": {
            "$output": {
              "resource": "builder",
              "name": "member"
            }
          },
          "project": "acme-staging",
          "repository": {
            "$output": {
              "resource": "repository",
              "name": "name"
            }
          },
          "role": "roles/artifactregistry.writer"
        },
        "dependsOn": [
          "builder",
          "repository"
        ],
        "phase": "infrastructure",
        "owners": [
          "bootstrap"
        ]
      },
      {
        "id": "builder.role.logging-logWriter",
        "type": "gcp:projects/iAMMember:IAMMember",
        "properties": {
          "member": {
            "$output": {
              "resource": "builder",
              "name": "member"
            }
          },
          "project": "acme-staging",
          "role": "roles/logging.logWriter"
        },
        "dependsOn": [
          "builder"
        ],
        "phase": "infrastructure",
        "owners": [
          "bootstrap"
        ]
      },
      {
        "id": "builder.state",
        "type": "gcp:storage/bucketIAMMember:BucketIAMMember",
        "properties": {
          "bucket": "acme-staging-superschematic-state",
          "condition": {
            "expression": "resource.name.startsWith(\"projects/_/buckets/acme-staging-superschematic-state/objects/superschematic/builds/\")",
            "title": "Objects under superschematic/builds/"
          },
          "member": {
            "$output": {
              "resource": "builder",
              "name": "member"
            }
          },
          "role": "roles/storage.objectViewer"
        },
        "dependsOn": [
          "builder"
        ],
        "phase": "infrastructure",
        "owners": [
          "bootstrap"
        ]
      },
      {
        "id": "deployer",
        "type": "gcp:serviceaccount/account:Account",
        "properties": {
          "accountId": "shop-deployer",
          "displayName": "Shop deployer",
          "project": "acme-staging"
