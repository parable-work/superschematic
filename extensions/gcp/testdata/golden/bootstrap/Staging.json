          "project": "acme-staging",
          "workloadIdentityPoolId": "shop-github"
        },
        "phase": "infrastructure",
        "owners": [
          "bootstrap"
        ]
      },
      {
        "id": "github.provider",
        "type": "gcp:iam/workloadIdentityPoolProvider:WorkloadIdentityPoolProvider",
        "properties": {
          "attributeCondition": "assertion.repository == 'acme/shop'",
          "attributeMapping": {
            "attribute.ref": "assertion.ref",
            "attribute.repository": "assertion.repository",
            "google.subject": "assertion.sub"
          },
          "displayName": "GitHub",
          "oidc": {
            "issuerUri": "https://token.actions.githubusercontent.com"
          },
          "project": "acme-staging",
          "workloadIdentityPoolId": {
            "$output": {
              "resource": "github",
              "name": "workloadIdentityPoolId"
