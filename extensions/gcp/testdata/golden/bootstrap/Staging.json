            "$concat": [
              "principalSet://iam.googleapis.com/",
              {
                "$output": {
                  "resource": "github",
                  "name": "name"
                }
              },
              "/attribute.repository/acme/shop"
            ]
          },
          "role": "roles/iam.workloadIdentityUser",
          "serviceAccountId": {
            "$output": {
              "resource": "deployer",
              "name": "name"
