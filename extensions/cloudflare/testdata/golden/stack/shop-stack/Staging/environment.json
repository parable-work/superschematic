{
  "version": 1,
  "stack": "shop-stack",
  "environment": "Staging",
  "target": "fake",
  "provisioner": "fake",
  "values": {
    "project": "acme-staging",
    "region": "us-east1"
  },
  "domain": "staging.acme.dev",
  "dns": {
    "platform": "cloudflare",
    "values": {
      "zone": "acme.dev",
      "zoneId": "0123456789abcdef0123456789abcdef"
    },
    "credentials": [
      {
        "secret": "shop-stack-cloudflare-dns-acme_dev",
        "env": "CLOUDFLARE_API_TOKEN",
        "description": "a Cloudflare API token with the DNS Edit permission on zone acme.dev, and no other"
      }
    ],
    "records": [
      {
        "name": "shop-api.staging.acme.dev",
        "type": "CNAME",
        "value": {
          "$output": {
            "resource": "shop-api.route",
            "name": "target"
          }
        },
        "deployable": "shop-api"
      }
    ]
  },
  "deployables": [
    {
      "name": "Orders",
      "kind": "server",
      "declared": true,
      "platform": "fake.run",
      "services": [
        {
          "name": "shop-orders",
          "kind": "API"
        }
      ],
      "calls": [
        {
          "name": "shop-api",
          "kind": "API"
        }
      ],
      "language": "GO",
      "resourceName": "orders",
      "address": {
        "$output": {
          "resource": "Orders.service",
          "name": "url"
        }
      },
      "bindings": [
        {
          "field": "FULFILLMENT_REGION",
          "source": "literal",
          "value": "us"
        },
        {
          "field": "MAX_LINE_ITEMS",
          "source": "literal",
          "value": "50",
          "default": true
        },
        {
          "field": "SHOP_API_SERVICE",
          "source": "derived",
          "value": {
            "credential": {
              "audience": {
                "$output": {
                  "resource": "shop-api.service",
                  "name": "url"
                }
              },
              "source": "google-id-token"
            },
            "url": {
              "$output": {
                "resource": "shop-api.service",
                "name": "url"
              }
            }
          },
          "edge": "http:Orders->shop-api"
        },
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "cloudSql": {
              "database": {
                "$output": {
                  "resource": "shop-db.database.shop-db",
                  "name": "name"
                }
              },
              "instance": {
                "$output": {
                  "resource": "shop-db.instance",
                  "name": "connectionName"
                }
              },
              "user": {
                "$output": {
                  "resource": "Orders.account",
                  "name": "email"
                }
              }
            }
          },
          "edge": "sql:Orders->shop-db"
        },
        {
          "field": "STRIPE_KEY",
          "source": "secret",
          "secret": "PaymentsSecrets.STRIPE_KEY"
        }
      ]
    },
    {
      "name": "shop-api",
      "kind": "server",
      "platform": "fake.run",
      "services": [
        {
          "name": "shop-api",
          "kind": "API"
        }
      ],
      "language": "GO",
      "exposed": true,
      "resourceName": "shop-api",
      "address": {
        "$output": {
          "resource": "shop-api.service",
          "name": "url"
        }
      },
      "bindings": [
        {
          "field": "LOG_LEVEL",
          "source": "literal",
          "value": "info",
          "default": true
        },
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "cloudSql": {
              "database": {
                "$output": {
                  "resource": "shop-db.database.shop-db",
                  "name": "name"
                }
              },
              "instance": {
                "$output": {
                  "resource": "shop-db.instance",
                  "name": "connectionName"
                }
              },
              "user": {
                "$output": {
                  "resource": "shop-api.account",
                  "name": "email"
                }
              }
            }
          },
          "edge": "sql:shop-api->shop-db"
        },
        {
          "field": "STRIPE_KEY",
          "source": "secret",
          "secret": "PaymentsSecrets.STRIPE_KEY"
        }
      ]
    },
    {
      "name": "shop-db",
      "kind": "database",
      "platform": "fake.sql",
      "services": [
        {
          "name": "shop-db",
          "kind": "DB"
        }
      ],
      "dialect": "postgres",
      "resourceName": "shop-db",
      "address": {
        "$output": {
          "resource": "shop-db.instance",
          "name": "connectionName"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "http:Orders->shop-api",
      "kind": "http",
      "from": "Orders",
      "to": "shop-api",
      "service": {
        "name": "shop-api",
        "kind": "API"
      },
      "connector": "fake.run-run",
      "field": "SHOP_API_SERVICE"
    },
    {
      "id": "sql:Orders->shop-db",
      "kind": "sql",
      "from": "Orders",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "fake.run-sql",
      "field": "SHOP_DB_DATABASE"
    },
    {
      "id": "sql:shop-api->shop-db",
      "kind": "sql",
      "from": "shop-api",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "fake.run-sql",
      "field": "SHOP_DB_DATABASE"
    }
  ],
  "secrets": [
    {
      "id": "PaymentsSecrets.STRIPE_KEY",
      "type": "PaymentsSecrets",
      "field": "STRIPE_KEY",
      "readers": [
        "Orders",
        "shop-api"
      ]
    }
  ],
  "resources": {
    "resources": [
      {
        "id": "Orders.account",
        "type": "fake:iam/account:Account",
        "properties": {
          "name": "orders"
        },
        "phase": "infrastructure",
        "owners": [
          "Orders"
        ]
      },
      {
        "id": "Orders.invokes.shop-api",
        "type": "fake:iam/grant:Grant",
        "properties": {
          "member": {
            "$output": {
              "resource": "Orders.account",
              "name": "email"
            }
          },
          "resource": {
            "$output": {
              "resource": "shop-api.service",
              "name": "id"
            }
          },
          "role": "run.invoker"
        },
        "dependsOn": [
          "Orders.account",
          "shop-api.service"
        ],
        "phase": "rollout",
        "owners": [
          "http:Orders->shop-api"
        ]
      },
      {
        "id": "Orders.reads.PaymentsSecrets.STRIPE_KEY",
        "type": "fake:iam/grant:Grant",
        "properties": {
          "member": {
            "$output": {
              "resource": "Orders.account",
              "name": "email"
            }
          },
          "resource": {
            "$output": {
              "resource": "secret.PaymentsSecrets.STRIPE_KEY",
              "name": "id"
            }
          },
          "role": "secret.accessor"
        },
        "dependsOn": [
          "Orders.account",
          "secret.PaymentsSecrets.STRIPE_KEY"
        ],
        "phase": "infrastructure",
        "owners": [
          "Orders"
        ]
      },
      {
        "id": "Orders.service",
        "type": "fake:run/service:Service",
        "properties": {
          "account": {
            "$output": {
              "resource": "Orders.account",
              "name": "email"
            }
          },
          "env": [
            {
              "name": "FULFILLMENT_REGION",
              "value": "us"
            },
            {
              "name": "MAX_LINE_ITEMS",
              "value": "50"
            },
            {
              "name": "SHOP_API_SERVICE_CREDENTIAL_AUDIENCE",
              "value": {
                "$output": {
                  "resource": "shop-api.service",
                  "name": "url"
                }
              }
            },
            {
              "name": "SHOP_API_SERVICE_CREDENTIAL_SOURCE",
              "value": "google-id-token"
            },
            {
              "name": "SHOP_API_SERVICE_URL",
              "value": {
                "$output": {
                  "resource": "shop-api.service",
                  "name": "url"
                }
              }
            },
            {
              "name": "SHOP_DB_DATABASE_CLOUD_SQL_DATABASE",
              "value": {
                "$output": {
                  "resource": "shop-db.database.shop-db",
                  "name": "name"
                }
              }
            },
            {
              "name": "SHOP_DB_DATABASE_CLOUD_SQL_INSTANCE",
              "value": {
                "$output": {
                  "resource": "shop-db.instance",
                  "name": "connectionName"
                }
              }
            },
            {
              "name": "SHOP_DB_DATABASE_CLOUD_SQL_USER",
              "value": {
                "$output": {
                  "resource": "Orders.account",
                  "name": "email"
                }
              }
            },
            {
              "name": "STRIPE_KEY",
              "secret": {
                "$output": {
                  "resource": "secret.PaymentsSecrets.STRIPE_KEY",
                  "name": "id"
                }
              }
            }
          ],
          "image": "orders",
          "language": "go",
          "name": "orders",
          "public": false
        },
        "dependsOn": [
          "Orders.account",
          "secret.PaymentsSecrets.STRIPE_KEY",
          "shop-api.service",
          "shop-db.database.shop-db",
          "shop-db.instance"
        ],
        "phase": "rollout",
        "owners": [
          "Orders"
        ]
      },
      {
        "id": "Orders.sql.shop-db",
        "type": "fake:iam/grant:Grant",
        "properties": {
          "member": {
            "$output": {
              "resource": "Orders.account",
              "name": "email"
            }
          },
          "resource": {
            "$output": {
              "resource": "shop-db.instance",
              "name": "id"
            }
          },
          "role": "sql.client"
        },
        "dependsOn": [
          "Orders.account",
          "shop-db.instance"
        ],
        "phase": "infrastructure",
        "owners": [
          "sql:Orders->shop-db"
        ]
      },
      {
        "id": "dns.shop-api.cname",
        "type": "cloudflare:index/dnsRecord:DnsRecord",
        "properties": {
          "content": {
            "$output": {
              "resource": "shop-api.route",
              "name": "target"
            }
          },
          "name": "shop-api.staging.acme.dev",
          "proxied": false,
          "ttl": 300,
          "type": "CNAME",
          "zoneId": "0123456789abcdef0123456789abcdef"
        },
        "dependsOn": [
          "shop-api.route"
        ],
        "phase": "exposure",
        "owners": [
          "dns"
        ]
      },
      {
        "id": "secret.PaymentsSecrets.STRIPE_KEY",
        "type": "fake:secrets/secret:Secret",
        "properties": {
          "name": "PaymentsSecrets.STRIPE_KEY"
        },
        "phase": "infrastructure",
        "owners": [
          "Orders",
          "shop-api"
        ]
      },
      {
        "id": "shop-api.account",
        "type": "fake:iam/account:Account",
        "properties": {
          "name": "shop-api"
        },
        "phase": "infrastructure",
        "owners": [
          "shop-api"
        ]
      },
      {
        "id": "shop-api.reads.PaymentsSecrets.STRIPE_KEY",
        "type": "fake:iam/grant:Grant",
        "properties": {
          "member": {
            "$output": {
              "resource": "shop-api.account",
              "name": "email"
            }
          },
          "resource": {
            "$output": {
              "resource": "secret.PaymentsSecrets.STRIPE_KEY",
              "name": "id"
            }
          },
          "role": "secret.accessor"
        },
        "dependsOn": [
          "secret.PaymentsSecrets.STRIPE_KEY",
          "shop-api.account"
        ],
        "phase": "infrastructure",
        "owners": [
          "shop-api"
        ]
      },
      {
        "id": "shop-api.route",
        "type": "fake:run/route:Route",
        "properties": {
          "host": "shop-api.staging.acme.dev",
          "service": {
            "$output": {
              "resource": "shop-api.service",
              "name": "id"
            }
          }
        },
        "dependsOn": [
          "shop-api.service"
        ],
        "phase": "exposure",
        "owners": [
          "shop-api"
        ]
      },
      {
        "id": "shop-api.service",
        "type": "fake:run/service:Service",
        "properties": {
          "account": {
            "$output": {
              "resource": "shop-api.account",
              "name": "email"
            }
          },
          "env": [
            {
              "name": "LOG_LEVEL",
              "value": "info"
            },
            {
              "name": "SHOP_DB_DATABASE_CLOUD_SQL_DATABASE",
              "value": {
                "$output": {
                  "resource": "shop-db.database.shop-db",
                  "name": "name"
                }
              }
            },
            {
              "name": "SHOP_DB_DATABASE_CLOUD_SQL_INSTANCE",
              "value": {
                "$output": {
                  "resource": "shop-db.instance",
                  "name": "connectionName"
                }
              }
            },
            {
              "name": "SHOP_DB_DATABASE_CLOUD_SQL_USER",
              "value": {
                "$output": {
                  "resource": "shop-api.account",
                  "name": "email"
                }
              }
            },
            {
              "name": "STRIPE_KEY",
              "secret": {
                "$output": {
                  "resource": "secret.PaymentsSecrets.STRIPE_KEY",
                  "name": "id"
                }
              }
            }
          ],
          "image": "shop-api",
          "language": "go",
          "name": "shop-api",
          "public": true
        },
        "dependsOn": [
          "secret.PaymentsSecrets.STRIPE_KEY",
          "shop-api.account",
          "shop-db.database.shop-db",
          "shop-db.instance"
        ],
        "phase": "rollout",
        "owners": [
          "shop-api"
        ]
      },
      {
        "id": "shop-api.sql.shop-db",
        "type": "fake:iam/grant:Grant",
        "properties": {
          "member": {
            "$output": {
              "resource": "shop-api.account",
              "name": "email"
            }
          },
          "resource": {
            "$output": {
              "resource": "shop-db.instance",
              "name": "id"
            }
          },
          "role": "sql.client"
        },
        "dependsOn": [
          "shop-api.account",
          "shop-db.instance"
        ],
        "phase": "infrastructure",
        "owners": [
          "sql:shop-api->shop-db"
        ]
      },
      {
        "id": "shop-db.database.shop-db",
        "type": "fake:sql/database:Database",
        "properties": {
          "instance": {
            "$output": {
              "resource": "shop-db.instance",
              "name": "name"
            }
          },
          "name": "shop_db"
        },
        "dependsOn": [
          "shop-db.instance"
        ],
        "phase": "infrastructure",
        "owners": [
          "shop-db"
        ]
      },
      {
        "id": "shop-db.instance",
        "type": "fake:sql/instance:Instance",
        "properties": {
          "dialect": "postgres",
          "highAvailability": false,
          "name": "shop-db",
          "tier": "small"
        },
        "phase": "infrastructure",
        "owners": [
          "shop-db"
        ]
      }
    ]
  },
  "deployOrder": [
    {
      "step": "infrastructure",
      "resources": [
        "Orders.account",
        "Orders.reads.PaymentsSecrets.STRIPE_KEY",
        "Orders.sql.shop-db",
        "secret.PaymentsSecrets.STRIPE_KEY",
        "shop-api.account",
        "shop-api.reads.PaymentsSecrets.STRIPE_KEY",
        "shop-api.sql.shop-db",
        "shop-db.database.shop-db",
        "shop-db.instance"
      ]
    },
    {
      "step": "migrate",
      "migration": "expand",
      "deployables": [
        "shop-db"
      ]
    },
    {
      "step": "rollout",
      "wave": 1,
      "deployables": [
        "shop-api"
      ],
      "resources": [
        "Orders.invokes.shop-api",
        "shop-api.service"
      ]
    },
    {
      "step": "rollout",
      "wave": 2,
      "deployables": [
        "Orders"
      ],
      "resources": [
        "Orders.service"
      ]
    },
    {
      "step": "migrate",
      "migration": "contract",
      "deployables": [
        "shop-db"
      ]
    },
    {
      "step": "exposure",
      "resources": [
        "dns.shop-api.cname",
        "shop-api.route"
      ]
    }
  ]
}
