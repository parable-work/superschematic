{
  "version": 1,
  "stack": "storefront-stack",
  "environment": "Staging",
  "target": "cloudflare",
  "provisioner": "pulumi",
  "values": {
    "accountId": "0123456789abcdef0123456789abcdef",
    "workersSubdomain": "acme"
  },
  "deployables": [
    {
      "name": "shop-storefront",
      "kind": "server",
      "platform": "cloudflare.workers",
      "services": [
        {
          "name": "shop-storefront",
          "kind": "API"
        }
      ],
      "language": "TYPESCRIPT",
      "artifact": "bundle",
      "exposed": true,
      "resourceName": "shop-storefront",
      "address": "https://shop-storefront",
      "publicAddress": "https://shop-storefront.acme.workers.dev"
    }
  ],
  "resources": {
    "resources": [
      {
        "id": "shop-storefront.deployment",
        "type": "cloudflare:index/workersDeployment:WorkersDeployment",
        "properties": {
          "accountId": "0123456789abcdef0123456789abcdef",
          "scriptName": {
            "$output": {
              "resource": "shop-storefront.worker",
              "name": "name"
            }
          },
          "strategy": "percentage",
          "versions": [
            {
              "percentage": 100,
              "versionId": {
                "$output": {
                  "resource": "shop-storefront.version",
                  "name": "id"
                }
              }
            }
          ]
        },
        "dependsOn": [
          "shop-storefront.version",
          "shop-storefront.worker"
        ],
        "phase": "rollout",
        "owners": [
          "shop-storefront"
        ]
      },
      {
        "id": "shop-storefront.version",
        "type": "cloudflare:index/workerVersion:WorkerVersion",
        "properties": {
          "accountId": "0123456789abcdef0123456789abcdef",
          "compatibilityDate": "2026-09-15",
          "mainModule": "main.js",
          "modules": [
            {
              "contentFile": "artifacts/shop-storefront/{bundle-digest}/main.js",
              "contentSha256": "{bundle-sha256:main.js}",
              "contentType": "application/javascript+module",
              "name": "main.js"
            },
            {
              "contentFile": "artifacts/shop-storefront/{bundle-digest}/main.js.map",
              "contentSha256": "{bundle-sha256:main.js.map}",
              "contentType": "application/source-map",
              "name": "main.js.map"
            },
            {
              "contentFile": "artifacts/shop-storefront/{bundle-digest}/superscalar_wasm_bg.wasm",
              "contentSha256": "{bundle-sha256:superscalar_wasm_bg.wasm}",
              "contentType": "application/wasm",
              "name": "superscalar_wasm_bg.wasm"
            }
          ],
          "workerId": {
            "$output": {
              "resource": "shop-storefront.worker",
              "name": "id"
            }
          }
        },
        "dependsOn": [
          "shop-storefront.worker"
        ],
        "phase": "rollout",
        "owners": [
          "shop-storefront"
        ]
      },
      {
        "id": "shop-storefront.worker",
        "type": "cloudflare:index/worker:Worker",
        "properties": {
          "accountId": "0123456789abcdef0123456789abcdef",
          "name": "shop-storefront",
          "observability": {
            "enabled": true,
            "logs": {
              "enabled": true,
              "invocationLogs": true
            }
          },
          "subdomain": {
            "enabled": true,
            "previewsEnabled": false
          }
        },
        "phase": "infrastructure",
        "owners": [
          "shop-storefront"
        ]
      }
    ]
  },
  "deployOrder": [
    {
      "step": "infrastructure",
      "resources": [
        "shop-storefront.worker"
      ]
    },
    {
      "step": "rollout",
      "wave": 1,
      "deployables": [
        "shop-storefront"
      ],
      "resources": [
        "shop-storefront.deployment",
        "shop-storefront.version"
      ]
    }
  ]
}
