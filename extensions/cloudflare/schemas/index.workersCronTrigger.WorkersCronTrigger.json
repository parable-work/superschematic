    "schedules",
    "scriptName"
  ],
  "types": {
    "cloudflare:index/WorkersCronTriggerSchedule:WorkersCronTriggerSchedule": {
      "type": "object",
      "properties": {
        "createdOn": {
          "type": "string"
        },
        "cron": {
          "type": "string"
        },
        "modifiedOn": {
          "type": "string"
        }
      },
      "required": [
