      "type": "string"
    },
    "schedules": {
      "type": "array",
      "items": {
        "$ref": "#/types/cloudflare:index/WorkersCronTriggerSchedule:WorkersCronTriggerSchedule"
      }
    },
    "scriptName": {
      "type": "string"
    }
  },
  "requiredInputs": [
