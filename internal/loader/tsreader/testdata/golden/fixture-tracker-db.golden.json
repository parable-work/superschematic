{
  "name": "fixture-tracker-db",
  "kind": "DB",
  "scalars": {
    "Generic.Int64": {
      "name": "Generic.Int64",
      "languagePrimitive": "number",
      "typeMappings": {
        "sql": "BIGINT"
      }
    },
    "Identity.Name": {
      "name": "Identity.Name",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "VARCHAR(80)"
      }
    },
    "Identity.Slug": {
      "name": "Identity.Slug",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "CITEXT"
      }
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    },
    "Temporal.Date": {
      "name": "Temporal.Date",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "DATE"
      }
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "TIMESTAMPTZ"
      }
    }
  },
  "types": {
    "Comment": {
      "name": "Comment",
      "owner": "src/tracker.schema.ts",
      "comment": "A comment on an issue. A delete removes the row.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "issue",
          "typeRef": {
            "name": "Issue"
          },
          "required": true,
          "relation": {
            "type": "Issue",
            "onDelete": "CASCADE"
          }
        },
        {
          "name": "body",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "validateMinLength": 1
        },
        {
          "name": "createdAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "required": true
        }
      ]
    },
    "Issue": {
      "name": "Issue",
      "owner": "src/tracker.schema.ts",
      "comment": "An issue of a team. Its writes record who made them, a delete keeps the\nrow, deletedAt stamped, and its title and body are searched.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "team",
          "typeRef": {
            "name": "Team"
          },
          "required": true,
          "relation": {
            "type": "Team",
            "onDelete": "RESTRICT"
          }
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "validateMinLength": 1,
          "validateMaxLength": 200,
          "searchField": true
        },
        {
          "name": "body",
          "typeRef": {
            "name": "string"
          },
          "searchField": true
        },
        {
          "name": "status",
          "typeRef": {
            "name": "IssueStatus"
          },
          "required": true,
          "default": "open"
        },
        {
          "name": "priority",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true,
          "default": "0"
        },
        {
          "name": "estimate",
          "typeRef": {
            "name": "number"
          }
        },
        {
          "name": "dueOn",
          "typeRef": {
            "name": "Temporal.Date"
          }
        },
        {
          "name": "assignee",
          "typeRef": {
            "name": "Member"
          },
          "relation": {
            "type": "Member",
            "onDelete": "SET NULL"
          }
        },
        {
          "name": "createdAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "required": true
        },
        {
          "name": "createdBy",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "updatedAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          }
        },
        {
          "name": "updatedBy",
          "typeRef": {
            "name": "Identity.UUID"
          }
        },
        {
          "name": "deletedAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          }
        },
        {
          "name": "deletedBy",
          "typeRef": {
            "name": "Identity.UUID"
          }
        },
        {
          "name": "comments",
          "typeRef": {
            "name": "Comment",
            "isArray": true
          },
          "required": true,
          "hasMany": true
        }
      ],
      "indexes": [
        {
          "keys": [
            "team"
          ]
        }
      ]
    },
    "Member": {
      "name": "Member",
      "owner": "src/tracker.schema.ts",
      "comment": "A person an issue is assigned to.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "Identity.Name"
          },
          "required": true
        }
      ]
    },
    "Note": {
      "name": "Note",
      "owner": "src/tracker.schema.ts",
      "comment": "A person's own note on an issue. The row names who it is for, and one\nother person it is shared with; the API's row rule reads both.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "issue",
          "typeRef": {
            "name": "Issue"
          },
          "required": true,
          "relation": {
            "type": "Issue",
            "onDelete": "CASCADE"
          }
        },
        {
          "name": "owner",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "sharedWith",
          "typeRef": {
            "name": "Identity.UUID"
          }
        },
        {
          "name": "text",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "validateMinLength": 1
        },
        {
          "name": "createdAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "required": true
        },
        {
          "name": "createdBy",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        }
      ]
    },
    "Team": {
      "name": "Team",
      "owner": "src/tracker.schema.ts",
      "comment": "A team, which owns issues. Its key is unique: a second team of one key\nis a conflict.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "key",
          "typeRef": {
            "name": "Identity.Slug"
          },
          "required": true,
          "unique": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "Identity.Name"
          },
          "required": true
        },
        {
          "name": "issues",
          "typeRef": {
            "name": "Issue",
            "isArray": true
          },
          "required": true,
          "hasMany": true
        }
      ]
    }
  },
  "enums": {
    "IssueStatus": {
      "name": "IssueStatus",
      "owner": "fixture-tracker-db",
      "comment": "Where an issue stands.",
      "values": [
        {
          "name": "Open",
          "serializedAs": "open"
        },
        {
          "name": "Started",
          "serializedAs": "started"
        },
        {
          "name": "Done",
          "serializedAs": "done"
        }
      ]
    }
  }
}
