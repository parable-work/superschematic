{
  "name": "fixture-fenced-db",
  "kind": "DB",
  "scalars": {
    "Generic.Int64": {
      "name": "Generic.Int64",
      "languagePrimitive": "number",
      "typeMappings": {
        "sql": "BIGINT"
      }
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "TIMESTAMPTZ"
      }
    }
  },
  "types": {
    "Courier": {
      "name": "Courier",
      "owner": "src/dispatch.schema.ts",
      "comment": "Who carries a delivery. It has no fence: a write of it advances nothing.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "string"
          },
          "required": true
        }
      ]
    },
    "Delivery": {
      "name": "Delivery",
      "owner": "src/dispatch.schema.ts",
      "comment": "A delivery two parties write, neither waiting on the other. The planner\nwrites the address and the courier, a relation, covered as the key it\nstores, and advances planVersion; the courier's device writes attempts\nand proof, and advances runVersion. A write of one party's fields leaves\nthe other's counter as it was, so neither fails the other's compare.\nNo fence covers note or updatedAt: a write of them alone advances\nneither counter. The courier is nullable, set and cleared by the\nplanner's writes alone: its delete action is RESTRICT, so a courier a\ndelivery names is not deleted. A SET NULL would have the database clear\nthe column itself, an update that advances no fence, and the build\nrefuses a fence that covers such a relation.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "address",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "courier",
          "typeRef": {
            "name": "Courier"
          },
          "relation": {
            "type": "Courier",
            "onDelete": "RESTRICT"
          }
        },
        {
          "name": "planVersion",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true,
          "default": "0"
        },
        {
          "name": "attempts",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true,
          "default": "0"
        },
        {
          "name": "proof",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "runVersion",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true,
          "default": "0"
        },
        {
          "name": "note",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "updatedAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "required": true
        }
      ],
      "fences": [
        {
          "field": "planVersion",
          "covers": [
            "address",
            "courier"
          ]
        },
        {
          "field": "runVersion",
          "covers": [
            "attempts",
            "proof"
          ]
        }
      ]
    },
    "Depot": {
      "name": "Depot",
      "owner": "src/dispatch.schema.ts",
      "comment": "A depot parcels wait in. A delete sets deletedAt, which the fence\ncovers, so the delete advances revision as a rename does; a write of\ncapacity alone does not.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "capacity",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        },
        {
          "name": "revision",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true,
          "default": "0"
        },
        {
          "name": "deletedAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          }
        }
      ],
      "fences": [
        {
          "field": "revision",
          "covers": [
            "name",
            "deletedAt"
          ]
        }
      ]
    },
    "Parcel": {
      "name": "Parcel",
      "owner": "src/dispatch.schema.ts",
      "comment": "A parcel at the desk. Its one fence lists no covers, so every update of\na row advances version by one, whatever it writes: a writer that read\nversion 4 writes where version is 4, and knows no other write came\nbetween. An upsert by trackingCode updates a row the same way.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "trackingCode",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "unique": true
        },
        {
          "name": "weightGrams",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        },
        {
          "name": "note",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "version",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true,
          "default": "0"
        }
      ],
      "fences": [
        {
          "field": "version"
        }
      ]
    }
  }
}
