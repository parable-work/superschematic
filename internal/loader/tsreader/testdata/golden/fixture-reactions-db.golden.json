{
  "name": "fixture-reactions-db",
  "kind": "DB",
  "scalars": {
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    }
  },
  "types": {
    "Project": {
      "name": "Project",
      "owner": "src/projects.schema.ts",
      "comment": "A project (D103): its status is a Workflow, which its tasks move. It is\ndone once every task is done with success, and failed once one fails. The\nrules hear Task's writes through task.project, whoever makes them.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Reactions",
          "implements": true,
          "config": {
            "rules": [
              {
                "then": {
                  "transition": "done"
                },
                "when": {
                  "allTerminal": {
                    "link": "project",
                    "outcomes": [
                      "success"
                    ],
                    "schema": "Task"
                  }
                }
              },
              {
                "then": {
                  "transition": "failed"
                },
                "when": {
                  "anyTerminal": {
                    "link": "project",
                    "outcomes": [
                      "failure"
                    ],
                    "schema": "Task"
                  }
                }
              }
            ]
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "outcomes": {
              "cancelled": "neutral",
              "done": "success",
              "failed": "failure"
            },
            "states": [
              "planned",
              "active",
              "done",
              "failed",
              "cancelled"
            ],
            "transitions": [
              {
                "from": "planned",
                "to": "active"
              },
              {
                "from": "planned",
                "to": "cancelled"
              },
              {
                "from": "active",
                "to": "done"
              },
              {
                "from": "active",
                "to": "failed"
              },
              {
                "from": "active",
                "to": "cancelled"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "string"
          },
          "required": true
        }
      ]
    },
    "Task": {
      "name": "Task",
      "owner": "src/projects.schema.ts",
      "comment": "A task of a project (D103): a task that starts moves its project to\nactive, and one marked urgent starts.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Reactions",
          "implements": true,
          "config": {
            "rules": [
              {
                "then": {
                  "link": "project",
                  "transition": "active"
                },
                "when": {
                  "enters": "doing"
                }
              },
              {
                "then": {
                  "transition": "doing"
                },
                "when": {
                  "changes": {
                    "field": "priority",
                    "to": "urgent"
                  }
                }
              }
            ]
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "outcomes": {
              "done": "success",
              "dropped": "neutral",
              "failed": "failure"
            },
            "states": [
              "todo",
              "doing",
              "done",
              "failed",
              "dropped"
            ],
            "transitions": [
              {
                "from": "todo",
                "to": "doing"
              },
              {
                "from": "todo",
                "to": "dropped"
              },
              {
                "from": "doing",
                "to": "done"
              },
              {
                "from": "doing",
                "to": "failed"
              },
              {
                "from": "doing",
                "to": "dropped"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "priority",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "project",
          "typeRef": {
            "name": "Project"
          },
          "required": true,
          "relation": {
            "type": "Project"
          }
        }
      ]
    }
  }
}
