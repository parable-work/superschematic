{
  "name": "fixture-schedules-db",
  "kind": "DB",
  "scalars": {
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    }
  },
  "types": {
    "Problem": {
      "name": "Problem",
      "owner": "src/problems.schema.ts",
      "comment": "A record of work an agent wakes on (D104). The agent sets wake-ups on it:\nafter a delay, at an interval, or on a cron line in a time zone, a minute\nto thirty days apart, at most ten a record, one live name each. Each wake\nreaches the app's handler, which tells the agent and reports told,\nresumed, held or missed; a missed one is tried again five minutes on. A\nrecord that is done or dropped finishes its wake-ups.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Schedules",
          "implements": true,
          "config": {
            "endOn": {
              "enters": [
                "done",
                "dropped"
              ]
            },
            "kinds": [
              "after",
              "every",
              "cron"
            ],
            "max": 10,
            "maxMs": 2592000000,
            "minMs": 60000,
            "outcomes": [
              "told",
              "resumed",
              "held",
              "missed"
            ],
            "permission": "problems.schedule",
            "retry": {
              "afterMs": 300000,
              "outcome": "missed"
            },
            "timeZone": "America/New_York"
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "states": [
              "open",
              "working",
              "done",
              "dropped"
            ],
            "transitions": [
              {
                "from": "open",
                "to": "working"
              },
              {
                "from": "working",
                "to": "done"
              },
              {
                "from": "working",
                "to": "open"
              },
              {
                "from": "open",
                "to": "dropped"
              },
              {
                "from": "working",
                "to": "dropped"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        }
      ]
    }
  }
}
