{
  "name": "fixture-timers-db",
  "kind": "DB",
  "scalars": {
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "TIMESTAMPTZ"
      }
    }
  },
  "types": {
    "Invoice": {
      "name": "Invoice",
      "owner": "src/tickets.schema.ts",
      "comment": "An invoice with two Workflows, whose Timers names the one it reads:\nan issued invoice unpaid for thirty days is overdue.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Timers",
          "implements": true,
          "config": {
            "deadlines": {
              "overdue": {
                "afterMs": 2592000000,
                "start": {
                  "create": true
                },
                "then": {
                  "transition": "overdue"
                },
                "until": {
                  "leaves": "unpaid"
                }
              }
            },
            "status": "payment"
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "states": [
              "draft",
              "issued",
              "void"
            ],
            "transitions": [
              {
                "from": "draft",
                "to": "issued"
              },
              {
                "from": "issued",
                "to": "void"
              }
            ]
          }
        },
        {
          "name": "Workflow",
          "field": "payment",
          "config": {
            "states": [
              "unpaid",
              "overdue",
              "paid"
            ],
            "transitions": [
              {
                "from": "unpaid",
                "to": "overdue"
              },
              {
                "from": "unpaid",
                "to": "paid"
              },
              {
                "from": "overdue",
                "to": "paid"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "number",
          "typeRef": {
            "name": "string"
          },
          "required": true
        }
      ]
    },
    "Ticket": {
      "name": "Ticket",
      "owner": "src/tickets.schema.ts",
      "comment": "A support ticket (D103): its status is a Workflow, and Timers holds it to\nits SLA. The first answer is due 1.5 seconds after the create, and a\nticket still open then escalates; one left waiting on its customer an\nhour closes; and a reminder falls due a day before a visit.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Timers",
          "implements": true,
          "config": {
            "deadlines": {
              "idle": {
                "afterMs": 3600000,
                "start": {
                  "enters": "waiting"
                },
                "then": {
                  "transition": "closed"
                }
              },
              "remind": {
                "afterMs": -86400000,
                "start": {
                  "field": "visitAt"
                }
              },
              "respond": {
                "afterMs": 1500,
                "start": {
                  "create": true
                },
                "then": {
                  "transition": "escalated"
                },
                "until": {
                  "leaves": "open"
                }
              }
            },
            "permission": "tickets.timers"
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "states": [
              "open",
              "waiting",
              "escalated",
              "closed"
            ],
            "transitions": [
              {
                "from": "open",
                "to": "waiting"
              },
              {
                "from": "waiting",
                "to": "open"
              },
              {
                "from": "open",
                "to": "escalated"
              },
              {
                "from": "open",
                "to": "closed"
              },
              {
                "from": "waiting",
                "to": "closed"
              },
              {
                "from": "escalated",
                "to": "closed"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "visitAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          }
        }
      ]
    }
  }
}
