{
  "name": "fixture-seed-rows-db",
  "kind": "DB",
  "scalars": {
    "Generic.Int64": {
      "name": "Generic.Int64",
      "languagePrimitive": "number",
      "typeMappings": {
        "sql": "BIGINT"
      }
    },
    "Generic.JSON": {
      "name": "Generic.JSON",
      "languagePrimitive": "object",
      "typeMappings": {
        "json_schema": "any",
        "sql": "JSONB"
      }
    },
    "Identity.Slug": {
      "name": "Identity.Slug",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "CITEXT"
      }
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "TIMESTAMPTZ"
      }
    },
    "Temporal.Time": {
      "name": "Temporal.Time",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "TIME"
      }
    }
  },
  "types": {
    "Region": {
      "name": "Region",
      "owner": "src/seeds.schema.ts",
      "comment": "A region, keyed by the code each row gives as the table's key.",
      "role": "DBTable",
      "fields": [
        {
          "name": "code",
          "typeRef": {
            "name": "Identity.Slug"
          },
          "required": true,
          "key": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "string"
          },
          "required": true
        }
      ],
      "seedRows": {
        "rows": [
          {
            "code": "eu",
            "name": "Europe"
          },
          {
            "code": "us",
            "name": "United States"
          }
        ]
      }
    },
    "Reminder": {
      "name": "Reminder",
      "owner": "src/seeds.schema.ts",
      "comment": "A reminder's lead time for a member, or for everyone: a row of no\nmember is the default each member without one of their own takes. No\nunique constraint holds the rows, so the seed names the fields that\nidentify one, a null member among them.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "member",
          "typeRef": {
            "name": "Identity.UUID"
          }
        },
        {
          "name": "kind",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "default": "*"
        },
        {
          "name": "leadMinutes",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        },
        {
          "name": "quietStart",
          "typeRef": {
            "name": "Temporal.Time"
          }
        }
      ],
      "seedRows": {
        "key": [
          "member",
          "kind"
        ],
        "rows": [
          {
            "kind": "*",
            "leadMinutes": 30,
            "member": null,
            "quietStart": "22:00"
          },
          {
            "kind": "deadline",
            "leadMinutes": 120,
            "member": null
          }
        ]
      }
    },
    "Tier": {
      "name": "Tier",
      "owner": "src/seeds.schema.ts",
      "comment": "A tier a workspace subscribes to. The rows are keyed by slug, the\nunique field every row gives; each holds text, a number, a boolean, a\nlist, JSON and a null, and leaves its key and createdAt to their\ncolumns' defaults.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "slug",
          "typeRef": {
            "name": "Identity.Slug"
          },
          "required": true,
          "unique": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "seats",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        },
        {
          "name": "listed",
          "typeRef": {
            "name": "boolean"
          },
          "required": true
        },
        {
          "name": "features",
          "typeRef": {
            "name": "string",
            "isArray": true
          },
          "required": true
        },
        {
          "name": "limits",
          "typeRef": {
            "name": "Generic.JSON"
          }
        },
        {
          "name": "note",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "createdAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "required": true,
          "default": "now"
        }
      ],
      "seedRows": {
        "rows": [
          {
            "features": [
              "inbox"
            ],
            "listed": true,
            "seats": 1,
            "slug": "free",
            "title": "Free"
          },
          {
            "features": [
              "inbox",
              "calendar"
            ],
            "limits": {
              "exports": true,
              "storageGb": 50
            },
            "listed": true,
            "seats": 10,
            "slug": "team",
            "title": "Team"
          },
          {
            "features": [],
            "listed": false,
            "note": null,
            "seats": 0,
            "slug": "internal",
            "title": "Staff's own"
          }
        ]
      }
    }
  }
}
