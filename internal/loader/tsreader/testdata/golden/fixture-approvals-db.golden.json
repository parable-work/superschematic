{
  "name": "fixture-approvals-db",
  "kind": "DB",
  "scalars": {
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    }
  },
  "types": {
    "Task": {
      "name": "Task",
      "owner": "src/tasks.schema.ts",
      "comment": "A task a person plans and its owner proves (D104). Its plan is approved\nbefore it is proved, and that approval survives later edits of the plan;\nits proof is approved against the version its reviewer read, and a change\nof the proof clears that approval. While it is planned only its creator\nedits the plan, and while it is working only its reviewer does; it enters\nproving only with a proof. Its owner stays who its create named, and\nurgent and attempts only go up, unless the caller holds tasks.admin.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Constants",
          "implements": true,
          "config": {
            "fields": [
              "owner"
            ],
            "oneWay": {
              "attempts": "up",
              "urgent": "up"
            },
            "permission": "tasks.admin"
          }
        },
        {
          "name": "StateRules",
          "implements": true,
          "config": {
            "states": {
              "planned": {
                "by": [
                  "createdBy"
                ],
                "frozen": [
                  "plan"
                ]
              },
              "proving": {
                "required": [
                  "proof"
                ]
              },
              "working": {
                "by": [
                  "reviewer"
                ],
                "frozen": [
                  "plan"
                ]
              }
            }
          }
        },
        {
          "name": "Approvals",
          "implements": true,
          "config": {
            "gates": {
              "done": {
                "count": 1,
                "permission": "tasks.review",
                "pinned": true,
                "resetOn": [
                  "proof"
                ]
              },
              "proving": {
                "count": 1,
                "permission": "tasks.review",
                "resetOn": []
              }
            }
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "states": [
              "planned",
              "working",
              "proving",
              "done",
              "cancelled"
            ],
            "transitions": [
              {
                "by": [
                  "owner"
                ],
                "from": "planned",
                "to": "working"
              },
              {
                "by": [
                  "owner"
                ],
                "from": "working",
                "to": "proving"
              },
              {
                "from": "proving",
                "to": "working"
              },
              {
                "from": "proving",
                "to": "done"
              },
              {
                "from": "planned",
                "to": "cancelled"
              },
              {
                "from": "working",
                "to": "cancelled"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "owner",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "reviewer",
          "typeRef": {
            "name": "Identity.UUID"
          }
        },
        {
          "name": "plan",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "proof",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "urgent",
          "typeRef": {
            "name": "boolean"
          },
          "required": true
        },
        {
          "name": "attempts",
          "typeRef": {
            "name": "number"
          },
          "required": true
        },
        {
          "name": "createdBy",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        }
      ]
    }
  }
}
