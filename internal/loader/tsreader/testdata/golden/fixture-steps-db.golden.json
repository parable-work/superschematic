{
  "name": "fixture-steps-db",
  "kind": "DB",
  "scalars": {
    "Generic.Int64": {
      "name": "Generic.Int64",
      "languagePrimitive": "number",
      "typeMappings": {
        "sql": "BIGINT"
      }
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    }
  },
  "types": {
    "Batch": {
      "name": "Batch",
      "owner": "src/steps.schema.ts",
      "comment": "A batch of steps (D104's step 4): running until every step is done, which\nits rollup done gates, or failed. It counts its steps, counts them by\nstatus and sums their estimates, each computed at a read of the batch\nfrom the steps that point at it, the rows its steps field lists.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Rollups",
          "implements": true,
          "config": {
            "rollups": {
              "anyFailed": {
                "function": "any",
                "link": "batch",
                "outcomes": [
                  "failure"
                ],
                "schema": "Step"
              },
              "byStatus": {
                "field": "status",
                "function": "countBy",
                "link": "batch",
                "schema": "Step"
              },
              "done": {
                "function": "all",
                "gatedStates": [
                  "done"
                ],
                "link": "batch",
                "outcomes": [
                  "success"
                ],
                "schema": "Step"
              },
              "estimate": {
                "field": "estimate",
                "function": "sum",
                "link": "batch",
                "schema": "Step"
              },
              "steps": {
                "function": "count",
                "link": "batch",
                "schema": "Step"
              }
            }
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "outcomes": {
              "failed": "failure"
            },
            "states": [
              "running",
              "done",
              "failed"
            ],
            "transitions": [
              {
                "from": "running",
                "to": "done"
              },
              {
                "from": "running",
                "to": "failed"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "steps",
          "typeRef": {
            "name": "Step",
            "isArray": true
          },
          "required": true,
          "hasMany": true
        }
      ]
    },
    "Step": {
      "name": "Step",
      "owner": "src/steps.schema.ts",
      "comment": "One step of a batch (D104's step 4): blocked by the steps it comes after,\nwhich hold up its start and its finish until each is done, a step that\nfailed blocking until it is removed.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Dependencies",
          "implements": true,
          "config": {
            "gatedStates": [
              "doing",
              "done"
            ]
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "outcomes": {
              "failed": "failure"
            },
            "states": [
              "todo",
              "doing",
              "done",
              "failed"
            ],
            "transitions": [
              {
                "from": "todo",
                "to": "doing"
              },
              {
                "from": "doing",
                "to": "done"
              },
              {
                "from": "doing",
                "to": "failed"
              },
              {
                "from": "todo",
                "to": "failed"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "estimate",
          "typeRef": {
            "name": "Generic.Int64"
          }
        },
        {
          "name": "batch",
          "typeRef": {
            "name": "Batch"
          },
          "required": true,
          "relation": {
            "type": "Batch"
          }
        }
      ]
    }
  }
}
