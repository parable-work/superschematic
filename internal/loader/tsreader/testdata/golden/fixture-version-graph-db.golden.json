{
  "name": "fixture-version-graph-db",
  "kind": "DB",
  "scalars": {
    "Generic.Int64": {
      "name": "Generic.Int64",
      "languagePrimitive": "number",
      "typeMappings": {
        "sql": "BIGINT"
      }
    },
    "Generic.JSON": {
      "name": "Generic.JSON",
      "languagePrimitive": "object",
      "typeMappings": {
        "sql": "JSONB"
      }
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "TIMESTAMPTZ"
      }
    }
  },
  "types": {
    "Cover": {
      "name": "Cover",
      "owner": "src/recipe.schema.ts",
      "comment": "The recipe's cover photo: at most one per ref.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "recipe",
          "typeRef": {
            "name": "Recipe"
          },
          "required": true,
          "relation": {
            "type": "Recipe"
          }
        },
        {
          "name": "photoUrl",
          "typeRef": {
            "name": "string"
          },
          "required": true
        }
      ],
      "versioned": true,
      "graphMember": {
        "graph": "Recipe",
        "singleton": true
      }
    },
    "Ingredient": {
      "name": "Ingredient",
      "owner": "src/recipe.schema.ts",
      "comment": "An ingredient one step uses.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "recipe",
          "typeRef": {
            "name": "Recipe"
          },
          "required": true,
          "relation": {
            "type": "Recipe"
          }
        },
        {
          "name": "stepKey",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "quantity",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "substitutes",
          "typeRef": {
            "name": "Generic.JSON"
          },
          "required": true,
          "jsonField": true,
          "conflictUnit": "jsonSchema"
        }
      ],
      "versioned": true,
      "versionedConfig": {
        "retentionDays": 365
      },
      "graphMember": {
        "graph": "Recipe",
        "parent": {
          "key": "stepKey",
          "of": "Step"
        }
      }
    },
    "Note": {
      "name": "Note",
      "owner": "src/recipe.schema.ts",
      "comment": "A cook's note, threaded under another note.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "recipe",
          "typeRef": {
            "name": "Recipe"
          },
          "required": true,
          "relation": {
            "type": "Recipe"
          }
        },
        {
          "name": "replyTo",
          "typeRef": {
            "name": "Identity.UUID"
          }
        },
        {
          "name": "body",
          "typeRef": {
            "name": "string"
          },
          "required": true
        }
      ],
      "versioned": true,
      "graphMember": {
        "graph": "Recipe",
        "parent": {
          "key": "replyTo",
          "of": "Note"
        }
      }
    },
    "Recipe": {
      "name": "Recipe",
      "owner": "src/recipe.schema.ts",
      "comment": "A recipe: the stable identity its steps and ingredients are versioned under.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "createdAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "required": true
        },
        {
          "name": "createdBy",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        }
      ],
      "versionGraph": {
        "schemaEpoch": 1
      }
    },
    "Step": {
      "name": "Step",
      "owner": "src/recipe.schema.ts",
      "comment": "One step of a recipe, ordered by position; updatedBy names its row's writer.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "recipe",
          "typeRef": {
            "name": "Recipe"
          },
          "required": true,
          "relation": {
            "type": "Recipe"
          }
        },
        {
          "name": "position",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        },
        {
          "name": "instruction",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "timings",
          "typeRef": {
            "name": "Generic.JSON"
          },
          "required": true,
          "conflictUnit": "keyed"
        },
        {
          "name": "scratch",
          "typeRef": {
            "name": "string"
          },
          "conflictUnit": "excluded"
        },
        {
          "name": "createdAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "required": true
        },
        {
          "name": "createdBy",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "updatedAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "required": true
        },
        {
          "name": "updatedBy",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        }
      ],
      "versioned": true,
      "versionedConfig": {
        "retentionDays": 365,
        "exclude": [
          "scratch"
        ]
      },
      "graphMember": {
        "graph": "Recipe",
        "order": "position"
      }
    },
    "Utensil": {
      "name": "Utensil",
      "owner": "src/recipe.schema.ts",
      "comment": "A utensil the recipe needs, keyed by a plain UUID rather than an\nAutoGenerate one.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true
        },
        {
          "name": "recipe",
          "typeRef": {
            "name": "Recipe"
          },
          "required": true,
          "relation": {
            "type": "Recipe"
          }
        },
        {
          "name": "name",
          "typeRef": {
            "name": "string"
          },
          "required": true
        }
      ],
      "versioned": true,
      "graphMember": {
        "graph": "Recipe"
      }
    }
  }
}
