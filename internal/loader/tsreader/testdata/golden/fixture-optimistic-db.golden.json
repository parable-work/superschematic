{
  "name": "fixture-optimistic-db",
  "kind": "DB",
  "scalars": {
    "Generic.Int64": {
      "name": "Generic.Int64",
      "languagePrimitive": "number",
      "typeMappings": {
        "sql": "BIGINT"
      }
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "TIMESTAMPTZ"
      }
    }
  },
  "types": {
    "Shelf": {
      "name": "Shelf",
      "owner": "src/pantry.schema.ts",
      "comment": "A shelf of the pantry. A delete sets deletedAt.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "label",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "createdAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "required": true
        },
        {
          "name": "createdBy",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "updatedAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "required": true
        },
        {
          "name": "updatedBy",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "deletedAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          }
        },
        {
          "name": "deletedBy",
          "typeRef": {
            "name": "Identity.UUID"
          }
        }
      ],
      "optimistic": true
    },
    "Stock": {
      "name": "Stock",
      "owner": "src/pantry.schema.ts",
      "comment": "How much of one ingredient a shelf holds. A delete removes the row.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "shelf",
          "typeRef": {
            "name": "Shelf"
          },
          "required": true,
          "relation": {
            "type": "Shelf"
          }
        },
        {
          "name": "ingredient",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "quantity",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        }
      ],
      "optimistic": true
    }
  }
}
