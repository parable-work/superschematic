{
  "name": "fixture-variant-field-db",
  "kind": "DB",
  "scalars": {
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    }
  },
  "types": {
    "Check": {
      "name": "Check",
      "owner": "src/steps.schema.ts",
      "comment": "One check a verify step ran.",
      "role": "DBTable",
      "fields": [
        {
          "name": "name",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "ok",
          "typeRef": {
            "name": "boolean"
          },
          "required": true
        }
      ],
      "jsonField": true
    },
    "ReviewResult": {
      "name": "ReviewResult",
      "owner": "src/steps.schema.ts",
      "comment": "A review step's result: its verdict, and the reviewer's notes.",
      "role": "DBTable",
      "fields": [
        {
          "name": "verdict",
          "typeRef": {
            "name": "Verdict"
          },
          "required": true
        },
        {
          "name": "notes",
          "typeRef": {
            "name": "string"
          },
          "validateMaxLength": 200
        }
      ],
      "jsonField": true
    },
    "Step": {
      "name": "Step",
      "owner": "src/steps.schema.ts",
      "comment": "One step of a run.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "kind",
          "typeRef": {
            "name": "StepKind"
          },
          "required": true
        },
        {
          "name": "result",
          "typeRef": {
            "name": "StepResult"
          }
        }
      ]
    },
    "VerifyResult": {
      "name": "VerifyResult",
      "owner": "src/steps.schema.ts",
      "comment": "A verify step's result: whether it passed, and the checks it ran.",
      "role": "DBTable",
      "fields": [
        {
          "name": "passed",
          "typeRef": {
            "name": "boolean"
          },
          "required": true
        },
        {
          "name": "checks",
          "typeRef": {
            "name": "Check",
            "isArray": true
          }
        }
      ],
      "jsonField": true
    }
  },
  "enums": {
    "StepKind": {
      "name": "StepKind",
      "owner": "fixture-variant-field-db",
      "comment": "What a step does, which picks the shape of its result.",
      "values": [
        {
          "name": "Verify",
          "serializedAs": "verify"
        },
        {
          "name": "Review",
          "serializedAs": "review"
        },
        {
          "name": "Note",
          "serializedAs": "note"
        }
      ]
    },
    "Verdict": {
      "name": "Verdict",
      "owner": "fixture-variant-field-db",
      "comment": "How a review ended.",
      "values": [
        {
          "name": "Approved",
          "serializedAs": "approved"
        },
        {
          "name": "ChangesRequested",
          "serializedAs": "changes_requested"
        }
      ]
    }
  },
  "unions": {
    "StepResult": {
      "name": "StepResult",
      "comment": "A step's result in the shape its kind gives it (D149): a VerifyResult\nwhile the step's kind is verify, a ReviewResult while it is review, and\nnone while it is note.",
      "types": [
        "VerifyResult",
        "ReviewResult"
      ],
      "by": "kind",
      "arms": {
        "review": "ReviewResult",
        "verify": "VerifyResult"
      }
    }
  }
}
