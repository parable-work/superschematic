{
  "name": "fixture-agents-db",
  "kind": "DB",
  "scalars": {
    "Generic.Int64": {
      "name": "Generic.Int64",
      "languagePrimitive": "number",
      "typeMappings": {
        "sql": "BIGINT"
      }
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    }
  },
  "types": {
    "Account": {
      "name": "Account",
      "owner": "src/accounts.schema.ts",
      "comment": "An account an agent runs on (D104): forty questions an hour and a million\ntokens over any day, each charged to its workspace too. The provider's own\ncount of its tokens, read every few minutes, replaces what the account\ncounted until the provider's period rolls over (observe, for callers who\nhold accounts.observe). Usage that takes it past a cap moves it out, until\na person moves it back.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Budget",
          "implements": true,
          "config": {
            "escalate": {
              "from": [
                "open"
              ],
              "transition": "out"
            },
            "limitPermission": "accounts.limits",
            "meters": {
              "questions": {
                "limit": 40,
                "reset": "hourly",
                "scope": "workspace"
              },
              "tokens": {
                "limit": 1000000,
                "reset": "daily",
                "scope": "workspace",
                "window": "rolling"
              }
            },
            "observePermission": "accounts.observe"
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "states": [
              "open",
              "out"
            ],
            "transitions": [
              {
                "from": "open",
                "to": "out"
              },
              {
                "from": "out",
                "to": "open"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "workspace",
          "typeRef": {
            "name": "Workspace"
          },
          "required": true,
          "relation": {
            "type": "Workspace"
          }
        }
      ]
    },
    "Job": {
      "name": "Job",
      "owner": "src/jobs.schema.ts",
      "comment": "A job a worker takes (D104). The worker leases it with a fencing token and\npresents the token with every write while it holds it, so a process whose\nlease lapsed cannot write after another took the job. A lease the worker\nstops renewing expires when its deadline falls due and moves the job back\nto queued; the third expiry fails it. A timeout waits a minute before the\njob runs again, twice as long after each next one up to ten minutes, and\nthen moves it from waiting back to queued; a build failure is retried once\nper revision; a job that has failed for half an hour gives up; and at most\nfour attempts start in an hour. Its revision is not named version, which a\ntable that composes behaviors keeps its own version in (_version).",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Lease",
          "implements": true,
          "config": {
            "escalate": {
              "from": [
                "running"
              ],
              "transition": "failed"
            },
            "maxExpiries": 3,
            "onExpiry": {
              "from": [
                "running"
              ],
              "transition": "queued"
            },
            "overridePermission": "jobs.override",
            "requireToken": true
          }
        },
        {
          "name": "Retries",
          "implements": true,
          "config": {
            "classes": {
              "build": {
                "attempts": 1
              },
              "rejected": "terminal",
              "timeout": {
                "attempts": 5,
                "backoff": {
                  "firstMs": 60000,
                  "maxMs": 600000
                }
              }
            },
            "exhaustedState": "failed",
            "giveUpAfterMs": 1800000,
            "keyField": "revision",
            "retryInto": [
              "running"
            ],
            "then": {
              "from": [
                "waiting"
              ],
              "transition": "queued"
            },
            "totalAttempts": 6,
            "window": {
              "attempts": 4,
              "ms": 3600000
            }
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "states": [
              "queued",
              "running",
              "waiting",
              "done",
              "failed"
            ],
            "transitions": [
              {
                "from": "queued",
                "to": "running"
              },
              {
                "from": "running",
                "to": "waiting"
              },
              {
                "from": "waiting",
                "to": "queued"
              },
              {
                "from": "running",
                "to": "queued"
              },
              {
                "from": "running",
                "to": "done"
              },
              {
                "from": "queued",
                "to": "failed"
              },
              {
                "from": "running",
                "to": "failed"
              },
              {
                "from": "waiting",
                "to": "failed"
              },
              {
                "from": "failed",
                "to": "queued"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "revision",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        }
      ]
    },
    "Session": {
      "name": "Session",
      "owner": "src/sessions.schema.ts",
      "comment": "A session a device opens for an agent (D104). Only the device's principal\nbeats it, and it stays live three minutes after its last beat, and fifteen\nwhile its agent is in a turn, counted from the later of the beat and the\nturn's start. A session not beaten in time is missed: it moves to missing,\nand the leases its device holds on jobs are expired, but for one the device\nrenewed since its last beat. Its next beat brings it back to idle.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Presence",
          "implements": true,
          "config": {
            "onBeat": {
              "from": [
                "missing"
              ],
              "transition": "idle"
            },
            "onMissed": {
              "from": [
                "idle",
                "turn"
              ],
              "transition": "missing"
            },
            "principalField": "device",
            "releaseLeases": [
              "Job"
            ],
            "ttlByState": {
              "turn": 900000
            },
            "ttlMs": 180000
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "states": [
              "idle",
              "turn",
              "missing",
              "closed"
            ],
            "transitions": [
              {
                "from": "idle",
                "to": "turn"
              },
              {
                "from": "turn",
                "to": "idle"
              },
              {
                "from": "idle",
                "to": "missing"
              },
              {
                "from": "turn",
                "to": "missing"
              },
              {
                "from": "missing",
                "to": "idle"
              },
              {
                "from": "idle",
                "to": "closed"
              },
              {
                "from": "turn",
                "to": "closed"
              },
              {
                "from": "missing",
                "to": "closed"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "device",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "agent",
          "typeRef": {
            "name": "string"
          },
          "required": true
        }
      ]
    },
    "Workspace": {
      "name": "Workspace",
      "owner": "src/accounts.schema.ts",
      "comment": "A workspace whose accounts' usage rolls up into its own caps (D104): sixty\nquestions an hour, and two million tokens over any day.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Budget",
          "implements": true,
          "config": {
            "meters": {
              "questions": {
                "limit": 60,
                "reset": "hourly"
              },
              "tokens": {
                "limit": 2000000,
                "reset": "daily",
                "window": "rolling"
              }
            }
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "string"
          },
          "required": true
        }
      ]
    }
  }
}
