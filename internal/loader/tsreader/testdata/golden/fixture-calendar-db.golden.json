{
  "name": "fixture-calendar-db",
  "kind": "DB",
  "scalars": {
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "TIMESTAMPTZ"
      }
    }
  },
  "types": {
    "Booking": {
      "name": "Booking",
      "owner": "src/desks.schema.ts",
      "comment": "A booking that holds a slot of its desk while it waits (D70, D103's step\n4): entering held takes the slot through the contract Supply the desk\nimplements, booked commits it, expired and cancelled let it go.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Holds",
          "implements": true,
          "config": {
            "commitOn": [
              "booked"
            ],
            "holds": {
              "slot": {
                "interval": {
                  "end": "slotEnd",
                  "start": "slotStart"
                },
                "link": "desk"
              }
            },
            "releaseOn": [
              "expired",
              "cancelled"
            ],
            "takeOn": [
              "held"
            ]
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "initial": "draft",
            "states": [
              "draft",
              "held",
              "booked",
              "expired",
              "cancelled"
            ],
            "transitions": [
              {
                "from": "draft",
                "to": "held"
              },
              {
                "from": "held",
                "to": "booked"
              },
              {
                "from": "held",
                "to": "expired"
              },
              {
                "from": "held",
                "to": "cancelled"
              },
              {
                "from": "draft",
                "to": "cancelled"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "slotStart",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "required": true
        },
        {
          "name": "slotEnd",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "required": true
        },
        {
          "name": "desk",
          "typeRef": {
            "name": "Desk"
          },
          "relation": {
            "type": "Desk"
          }
        }
      ]
    },
    "Desk": {
      "name": "Desk",
      "owner": "src/desks.schema.ts",
      "comment": "A desk whose time Calendar opens (D70, D103's step 4): weekday hours in\nEurope/London, one booking at a time, a quarter-hour grid, holds of a\nquarter of an hour to two hours, and its own hours and closures set by a\ncaller holding desk.manage. Its record of each booking it holds, its\nclosures and its own settings are sub-tables of the row.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Calendar",
          "implements": true,
          "config": {
            "capacity": 1,
            "hours": {
              "fri": [
                [
                  "09:00",
                  "17:30"
                ]
              ],
              "mon": [
                [
                  "09:00",
                  "17:30"
                ]
              ],
              "thu": [
                [
                  "09:00",
                  "17:30"
                ]
              ],
              "tue": [
                [
                  "09:00",
                  "17:30"
                ]
              ],
              "wed": [
                [
                  "09:00",
                  "17:30"
                ]
              ]
            },
            "maxMs": 7200000,
            "minMs": 900000,
            "permission": "desk.manage",
            "slotMs": 900000,
            "timeZone": "Europe/London"
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        }
      ]
    }
  }
}
