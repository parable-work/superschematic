{
  "name": "fixture-workflow-db",
  "kind": "DB",
  "scalars": {
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "TIMESTAMPTZ"
      }
    }
  },
  "types": {
    "Order": {
      "name": "Order",
      "owner": "src/orders.schema.ts",
      "comment": "An order a customer places, which moves from draft through paid to\nshipped. It stays a table: its status is a Workflow, whose fields are\nits columns (D103), which an index names as it names its own.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "initial": "draft",
            "states": [
              "draft",
              "paid",
              "shipped"
            ],
            "transitions": [
              {
                "from": "draft",
                "to": "paid"
              },
              {
                "from": "paid",
                "permission": "orders.ship",
                "to": "shipped"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "placedAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          }
        }
      ],
      "indexes": [
        {
          "keys": [
            "status",
            "placedAt"
          ]
        }
      ]
    },
    "Shipment": {
      "name": "Shipment",
      "owner": "src/orders.schema.ts",
      "comment": "A shipment of goods, which is packed and sent while its payment settles\napart: two Workflows, one on each of two fields.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "states": [
              "pending",
              "packed",
              "sent"
            ],
            "transitions": [
              {
                "from": "pending",
                "to": "packed"
              },
              {
                "from": "packed",
                "to": "sent"
              }
            ]
          }
        },
        {
          "name": "Workflow",
          "field": "paymentStatus",
          "config": {
            "outcomes": {
              "refunded": "failure"
            },
            "states": [
              "unpaid",
              "paid",
              "refunded"
            ],
            "transitions": [
              {
                "from": "unpaid",
                "to": "paid"
              },
              {
                "from": "paid",
                "permission": "payments.refund",
                "to": "refunded"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "reference",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "unique": true
        }
      ]
    }
  }
}
