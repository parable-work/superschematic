{
  "name": "fixture-seats-db",
  "kind": "DB",
  "scalars": {
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    }
  },
  "types": {
    "Problem": {
      "name": "Problem",
      "owner": "src/problems.schema.ts",
      "comment": "A record of work (D104). It has one accountable person, whom the next to\ntake the seat displaces; any number of responsible agents, the record's\nown agent always among them; and at most five handles, which any caller\nmay claim and only the agent that claimed one, or a person who may\nrelease another's, releases. Only a responsible subject starts and\nsubmits the record, only the accountable person closes it or sends it\nback, and in review only the accountable person edits its title.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Seats",
          "implements": true,
          "config": {
            "seats": {
              "accountable": {
                "assign": "problems.assign",
                "max": 1,
                "onFull": "displace",
                "take": "problems.own"
              },
              "handles": {
                "assign": "problems.release",
                "max": 5
              },
              "responsible": {
                "assign": "problems.assign",
                "fromField": "agent",
                "take": "problems.work"
              }
            }
          }
        },
        {
          "name": "StateRules",
          "implements": true,
          "config": {
            "states": {
              "review": {
                "by": [
                  "seat:accountable"
                ],
                "frozen": [
                  "title"
                ]
              }
            }
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "overridePermission": "problems.override",
            "states": [
              "open",
              "working",
              "review",
              "done"
            ],
            "transitions": [
              {
                "by": [
                  "seat:responsible"
                ],
                "from": "open",
                "to": "working"
              },
              {
                "by": [
                  "seat:responsible"
                ],
                "from": "working",
                "to": "review"
              },
              {
                "by": [
                  "seat:accountable"
                ],
                "from": "review",
                "to": "done"
              },
              {
                "by": [
                  "seat:accountable"
                ],
                "from": "review",
                "to": "working"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "agent",
          "typeRef": {
            "name": "Identity.UUID"
          }
        }
      ]
    },
    "Sandbox": {
      "name": "Sandbox",
      "owner": "src/sandboxes.schema.ts",
      "comment": "A sandbox a provider runs (D104). Its status follows the state the\nprovider reports, through observe, each step a transition its Workflow\nallows as the observer, so a stop needs sandboxes.stop of the observer\ntoo; when no report has reached it for five minutes its status moves to\nunreachable, and any report brings it back.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "states": [
              "pending",
              "starting",
              "running",
              "stopping",
              "stopped",
              "failed",
              "unreachable"
            ],
            "transitions": [
              {
                "from": "pending",
                "to": "starting"
              },
              {
                "from": "starting",
                "to": "running"
              },
              {
                "from": "running",
                "permission": "sandboxes.stop",
                "to": "stopping"
              },
              {
                "from": "stopping",
                "to": "stopped"
              },
              {
                "from": "stopped",
                "to": "starting"
              },
              {
                "from": "pending",
                "to": "failed"
              },
              {
                "from": "starting",
                "to": "failed"
              },
              {
                "from": "running",
                "to": "failed"
              },
              {
                "from": "stopping",
                "to": "failed"
              },
              {
                "from": "pending",
                "to": "unreachable"
              },
              {
                "from": "starting",
                "to": "unreachable"
              },
              {
                "from": "running",
                "to": "unreachable"
              },
              {
                "from": "stopping",
                "to": "unreachable"
              },
              {
                "from": "stopped",
                "to": "unreachable"
              },
              {
                "from": "unreachable",
                "to": "pending"
              },
              {
                "from": "unreachable",
                "to": "starting"
              },
              {
                "from": "unreachable",
                "to": "running"
              },
              {
                "from": "unreachable",
                "to": "stopping"
              },
              {
                "from": "unreachable",
                "to": "stopped"
              },
              {
                "from": "unreachable",
                "to": "failed"
              }
            ]
          }
        },
        {
          "name": "Reconcile",
          "field": "observed",
          "config": {
            "observePermission": "sandboxes.observe",
            "staleAfterMs": 300000,
            "status": "status",
            "unreachable": "unreachable"
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "string"
          },
          "required": true
        }
      ]
    }
  }
}
