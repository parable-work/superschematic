{
  "name": "fixture-workflow-principals-db",
  "kind": "DB",
  "scalars": {
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    }
  },
  "types": {
    "Question": {
      "name": "Question",
      "owner": "src/questions.schema.ts",
      "comment": "A question one person asks another (D104). Only the person it is asked of\nanswers it, only its asker withdraws it, and closing an answered one needs\nquestions.close beside being one of the two; a caller who holds\nquestions.moderate makes any of these moves for them, the move's own\npermission still needed. Answering again changes nothing, so a caller\nwhose answer was lost may retry.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "overridePermission": "questions.moderate",
            "repeat": "unchanged",
            "states": [
              "open",
              "answered",
              "withdrawn",
              "closed"
            ],
            "transitions": [
              {
                "by": [
                  "askedOf"
                ],
                "from": "open",
                "to": "answered"
              },
              {
                "by": [
                  "createdBy"
                ],
                "from": "open",
                "to": "withdrawn"
              },
              {
                "by": [
                  "askedOf",
                  "createdBy"
                ],
                "from": "answered",
                "permission": "questions.close",
                "to": "closed"
              },
              {
                "from": "answered",
                "to": "open"
              }
            ]
          }
        },
        {
          "name": "Workflow",
          "field": "review",
          "config": {
            "states": [
              "pending",
              "reviewed"
            ],
            "transitions": [
              {
                "from": "pending",
                "to": "reviewed"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "prompt",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "askedOf",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "createdBy",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        }
      ]
    }
  }
}
