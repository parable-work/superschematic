{
  "name": "fixture-pool-db",
  "kind": "DB",
  "scalars": {
    "Generic.Int64": {
      "name": "Generic.Int64",
      "languagePrimitive": "number",
      "typeMappings": {
        "sql": "BIGINT"
      }
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    }
  },
  "types": {
    "Account": {
      "name": "Account",
      "owner": "src/accounts.schema.ts",
      "comment": "An account a person's agents run their turns on (D104): their accounts at\ntwo vendors, and paid keys. A turn picks the same vendor's open accounts,\nthen its near ones, then the others by rank, a key last; an account a\nprovider refuses is out until the time it names, thirty minutes when it\nnames none, and comes back only when a check of its usage made after that\ntime finds room, rechecked every two minutes until one does. Its tokens\nare metered by the hour, and an account with none left counts as out\nuntil the hour rolls over, or until the provider's own figure lapses.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Pool",
          "implements": true,
          "config": {
            "order": "rank",
            "outForMs": 1800000,
            "permission": "accounts.pool",
            "recheckAfterMs": 120000
          }
        },
        {
          "name": "Budget",
          "implements": true,
          "config": {
            "meters": {
              "tokens": {
                "limit": 1000,
                "reset": "hourly"
              }
            },
            "observePermission": "accounts.observe"
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "owner",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "vendor",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "kind",
          "typeRef": {
            "name": "AccountKind"
          },
          "required": true
        },
        {
          "name": "rank",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        }
      ]
    }
  },
  "enums": {
    "AccountKind": {
      "name": "AccountKind",
      "owner": "fixture-pool-db",
      "comment": "Whether an account is a person's account at a vendor or a paid key.",
      "values": [
        {
          "name": "Account",
          "serializedAs": "account"
        },
        {
          "name": "Key",
          "serializedAs": "key"
        }
      ]
    }
  }
}
