{
  "name": "fixture-blueprint-db",
  "kind": "DB",
  "scalars": {
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    }
  },
  "types": {
    "Batch": {
      "name": "Batch",
      "owner": "src/batches.schema.ts",
      "comment": "A batch of jobs (D149): its create stamps a job per step of its template,\neach blocked by the jobs of the steps it comes after, and audit only for\na batch whose flags include audit, its report then waiting on index.\nEvery job copies the batch's topic. The batch holds no state of the\nstamp: a read lists its children, the jobs that point at it.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Blueprint",
          "implements": true,
          "config": {
            "copyFields": [
              "topic"
            ],
            "keyField": "step",
            "parentLink": "batch",
            "schema": "Job",
            "steps": {
              "audit": {
                "after": [
                  "index"
                ],
                "data": {
                  "title": "Audit the index"
                },
                "when": {
                  "field": "flags",
                  "includes": "audit"
                }
              },
              "fetch": {
                "data": {
                  "title": "Fetch the sources"
                }
              },
              "index": {
                "after": [
                  "fetch"
                ],
                "data": {
                  "title": "Index what was fetched"
                }
              },
              "report": {
                "after": [
                  "audit"
                ],
                "data": {
                  "title": "Report what was indexed"
                }
              }
            }
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "outcomes": {
              "failed": "failure"
            },
            "states": [
              "running",
              "done",
              "failed"
            ],
            "transitions": [
              {
                "from": "running",
                "to": "done"
              },
              {
                "from": "running",
                "to": "failed"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "topic",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "flags",
          "typeRef": {
            "name": "string",
            "isArray": true
          }
        },
        {
          "name": "jobs",
          "typeRef": {
            "name": "Job",
            "isArray": true
          },
          "required": true,
          "hasMany": true
        }
      ]
    },
    "Job": {
      "name": "Job",
      "owner": "src/batches.schema.ts",
      "comment": "One job of a batch (D149): the step it was stamped as and its topic stay\nas the stamp set them, and it waits to run, and to finish, until the\njobs of the steps before it are done.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Constants",
          "implements": true,
          "config": {
            "fields": [
              "step",
              "topic"
            ]
          }
        },
        {
          "name": "Dependencies",
          "implements": true,
          "config": {
            "gatedStates": [
              "running",
              "done"
            ]
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "outcomes": {
              "failed": "failure"
            },
            "states": [
              "queued",
              "running",
              "done",
              "failed"
            ],
            "transitions": [
              {
                "from": "queued",
                "to": "running"
              },
              {
                "from": "running",
                "to": "done"
              },
              {
                "from": "running",
                "to": "failed"
              },
              {
                "from": "queued",
                "to": "failed"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "step",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "topic",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "batch",
          "typeRef": {
            "name": "Batch"
          },
          "required": true,
          "relation": {
            "type": "Batch"
          }
        }
      ]
    }
  }
}
