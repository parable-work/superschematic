{
  "name": "fixture-payments-db",
  "kind": "DB",
  "scalars": {
    "Generic.Int64": {
      "name": "Generic.Int64",
      "languagePrimitive": "number",
      "typeMappings": {
        "sql": "BIGINT"
      }
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    }
  },
  "types": {
    "Order": {
      "name": "Order",
      "owner": "src/orders.schema.ts",
      "comment": "An order that takes payments (D70, D103's step 4): what it owes is its\ntotal in GBP minor units, placed waits until it is paid, a cancelled\norder voids what is authorized, a refund drawn directly needs\npayments.refund, and the provider's adapter lists its actions and\nrecords its events holding payments.record. Its attempts, actions and\nrefunds are sub-tables of the row, and the provider events a table\nkept for the table as a whole.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Payments",
          "implements": true,
          "config": {
            "amount": {
              "field": "totalCents"
            },
            "currency": "GBP",
            "record": {
              "permission": "payments.record"
            },
            "refunds": {
              "permission": "payments.refund"
            },
            "require": {
              "placed": "paid"
            },
            "voidOn": [
              "cancelled"
            ]
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "initial": "cart",
            "states": [
              "cart",
              "held",
              "placed",
              "cancelled"
            ],
            "transitions": [
              {
                "from": "cart",
                "to": "held"
              },
              {
                "from": "held",
                "to": "placed"
              },
              {
                "from": "cart",
                "to": "cancelled"
              },
              {
                "from": "held",
                "to": "cancelled"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "totalCents",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        }
      ]
    },
    "Refund": {
      "name": "Refund",
      "owner": "src/orders.schema.ts",
      "comment": "A refund of an order that needs a go-ahead (D70): entering approved asks\nthe order its relation points at for its amount, through the order's\nrefundFor, once per approval; the provider's outcome, recorded on the\norder, settles it here through settleRefundFor, which turns its state\nrefunded.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Payments",
          "implements": true,
          "config": {
            "amount": {
              "field": "amountCents"
            },
            "currency": "GBP",
            "issueOn": [
              "approved"
            ],
            "record": {
              "permission": "payments.record"
            },
            "refundOf": {
              "link": "order"
            }
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "initial": "requested",
            "states": [
              "requested",
              "approved",
              "issued"
            ],
            "transitions": [
              {
                "from": "requested",
                "to": "approved"
              },
              {
                "from": "approved",
                "to": "issued"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "amountCents",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        },
        {
          "name": "reason",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "order",
          "typeRef": {
            "name": "Order"
          },
          "required": true,
          "relation": {
            "type": "Order"
          }
        }
      ]
    }
  }
}
