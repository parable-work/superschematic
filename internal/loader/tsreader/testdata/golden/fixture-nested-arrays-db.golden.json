{
  "name": "fixture-nested-arrays-db",
  "kind": "DB",
  "scalars": {
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    }
  },
  "types": {
    "Board": {
      "name": "Board",
      "owner": "src/board.schema.ts",
      "comment": "A game board whose columns are lists of lists.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "labels",
          "comment": "Cell labels, one inner list per row.",
          "typeRef": {
            "name": "string",
            "isArray": true,
            "isArrayOfArrays": true
          },
          "required": true
        },
        {
          "name": "states",
          "comment": "Cell states, one inner list per row.",
          "typeRef": {
            "name": "CellState",
            "isArray": true,
            "isArrayOfArrays": true
          },
          "required": true
        },
        {
          "name": "walls",
          "comment": "Walls, each a list of the points it runs through.",
          "typeRef": {
            "name": "BoardPoint",
            "isArray": true,
            "isArrayOfArrays": true
          },
          "required": true
        },
        {
          "name": "scores",
          "comment": "Scores per round, one inner list per player; absent before the first round.",
          "typeRef": {
            "name": "number",
            "isArray": true,
            "isArrayOfArrays": true
          }
        }
      ]
    },
    "BoardPoint": {
      "name": "BoardPoint",
      "owner": "src/board.schema.ts",
      "comment": "A board coordinate, stored inside the board's JSON columns.",
      "role": "DBTable",
      "fields": [
        {
          "name": "x",
          "typeRef": {
            "name": "number"
          },
          "required": true
        },
        {
          "name": "y",
          "typeRef": {
            "name": "number"
          },
          "required": true
        }
      ],
      "jsonField": true
    }
  },
  "enums": {
    "CellState": {
      "name": "CellState",
      "owner": "fixture-nested-arrays-db",
      "comment": "The state of one board cell.",
      "values": [
        {
          "name": "Empty",
          "serializedAs": "empty"
        },
        {
          "name": "Filled",
          "serializedAs": "filled"
        }
      ]
    }
  }
}
