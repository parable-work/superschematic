{
  "name": "fixture-commerce-db",
  "kind": "DB",
  "scalars": {
    "Generic.Int64": {
      "name": "Generic.Int64",
      "languagePrimitive": "number",
      "typeMappings": {
        "sql": "BIGINT"
      }
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    }
  },
  "types": {
    "Checkout": {
      "name": "Checkout",
      "owner": "src/shop.schema.ts",
      "comment": "A checkout that holds its lines and its gift wrap while it waits for\npayment (D70, D103's step 4): entering held takes every item or none,\nthrough the contract Supply each Inventory implements; placed commits\nthem, expired and cancelled let them go, and returned puts the units\nback.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Holds",
          "implements": true,
          "config": {
            "commitOn": [
              "placed"
            ],
            "holds": {
              "lines": {
                "each": {
                  "field": "lines",
                  "target": "inventoryId"
                },
                "quantity": {
                  "field": "quantity"
                },
                "schema": "Inventory"
              },
              "wrap": {
                "link": "wrap",
                "quantity": 1
              }
            },
            "releaseOn": [
              "expired",
              "cancelled"
            ],
            "returnOn": [
              "returned"
            ],
            "takeOn": [
              "held"
            ]
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "initial": "cart",
            "states": [
              "cart",
              "held",
              "placed",
              "expired",
              "cancelled",
              "returned"
            ],
            "transitions": [
              {
                "from": "cart",
                "to": "held"
              },
              {
                "from": "held",
                "to": "placed"
              },
              {
                "from": "held",
                "to": "expired"
              },
              {
                "from": "held",
                "to": "cancelled"
              },
              {
                "from": "cart",
                "to": "cancelled"
              },
              {
                "from": "placed",
                "to": "returned"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "lines",
          "typeRef": {
            "name": "Line",
            "isArray": true
          },
          "required": true
        },
        {
          "name": "wrap",
          "typeRef": {
            "name": "Inventory"
          },
          "relation": {
            "type": "Inventory"
          }
        }
      ]
    },
    "Inventory": {
      "name": "Inventory",
      "owner": "src/shop.schema.ts",
      "comment": "What a shop sells (D70, D103's step 4): units on hand and units claims\nhold, counted by Stock, each change a movement of its ledger. A caller\nholding stock.adjust receives, adjusts and counts it; its price, in GBP\nminor units, is what a line is held at; and it reads low at or below\nits reorder level.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Stock",
          "implements": true,
          "config": {
            "lowAt": {
              "field": "reorderAt"
            },
            "maxPerHold": 5,
            "permission": "stock.adjust",
            "price": {
              "currency": "GBP",
              "field": "priceCents"
            }
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "priceCents",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        },
        {
          "name": "reorderAt",
          "typeRef": {
            "name": "Generic.Int64"
          }
        }
      ]
    },
    "Line": {
      "name": "Line",
      "owner": "src/shop.schema.ts",
      "comment": "One line of a checkout: the inventory it takes and how many.",
      "role": "DBTable",
      "fields": [
        {
          "name": "inventoryId",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "quantity",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        }
      ],
      "jsonField": true
    }
  }
}
