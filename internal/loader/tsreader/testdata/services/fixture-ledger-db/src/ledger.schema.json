{
  "name": "fixture-ledger-db",
  "kind": "DB",
  "comment": "A household ledger the generated repositories are tested on, in Go and in TypeScript (D79): accounts, each written by a user, entries on them, soft-deleted, searched by their memo, and unique per account by an external id an import upserts by, and the queue each posted entry enqueues.",
  "scalars": {
    "Identity.UUID": { "name": "Identity.UUID", "languagePrimitive": "string" },
    "Identity.Name": { "name": "Identity.Name", "languagePrimitive": "string" },
    "Temporal.DateTime": { "name": "Temporal.DateTime", "languagePrimitive": "string" },
    "Temporal.Date": { "name": "Temporal.Date", "languagePrimitive": "string" },
    "Generic.Int64": { "name": "Generic.Int64", "languagePrimitive": "number" },
    "Generic.JSON": { "name": "Generic.JSON", "languagePrimitive": "string" }
  },
  "enums": {
    "EntryKind": {
      "name": "EntryKind",
      "values": [{ "name": "Debit", "serializedAs": "debit" }, { "name": "Credit", "serializedAs": "credit" }]
    }
  },
  "types": {
    "MailingAddress": {
      "name": "MailingAddress",
      "comment": "Where an account's statements go, a @jsonField type: an account's column holds it as its JSON text.",
      "role": "DBTable",
      "jsonField": true,
      "fields": [
        { "name": "line1", "typeRef": { "name": "string" }, "required": true },
        { "name": "city", "typeRef": { "name": "string" }, "required": true }
      ]
    },
    "Account": {
      "name": "Account",
      "comment": "An account of the household, which a user opened.",
      "role": "DBTable",
      "fields": [
        { "name": "id", "typeRef": { "name": "Identity.UUID" }, "required": true, "key": true, "autoGenerated": true },
        { "name": "name", "typeRef": { "name": "Identity.Name" }, "required": true, "searchField": true },
        { "name": "code", "typeRef": { "name": "string" }, "required": true, "unique": true },
        { "name": "openedOn", "typeRef": { "name": "Temporal.Date" } },
        { "name": "mailingAddress", "typeRef": { "name": "MailingAddress" } },
        { "name": "createdAt", "typeRef": { "name": "Temporal.DateTime" }, "required": true },
        { "name": "createdBy", "typeRef": { "name": "Identity.UUID" }, "required": true },
        { "name": "updatedAt", "typeRef": { "name": "Temporal.DateTime" }, "required": true },
        { "name": "updatedBy", "typeRef": { "name": "Identity.UUID" }, "required": true }
      ]
    },
    "Entry": {
      "name": "Entry",
      "comment": "One line of an account: an amount in minor units, signed, on the day it was booked.",
      "role": "DBTable",
      "indexes": [{ "keys": ["account", "externalId"], "unique": true, "name": "external" }],
      "fields": [
        { "name": "id", "typeRef": { "name": "Identity.UUID" }, "required": true, "key": true, "autoGenerated": true },
        { "name": "account", "typeRef": { "name": "Account" }, "required": true, "relation": { "onDelete": "CASCADE" } },
        { "name": "transfer", "typeRef": { "name": "Account" }, "relation": { "onDelete": "CASCADE" } },
        { "name": "amountCents", "typeRef": { "name": "Generic.Int64" }, "required": true },
        { "name": "bookedOn", "typeRef": { "name": "Temporal.Date" }, "required": true },
        { "name": "kind", "typeRef": { "name": "EntryKind" }, "required": true, "default": "debit" },
        { "name": "memo", "typeRef": { "name": "string" }, "searchField": true },
        { "name": "externalId", "typeRef": { "name": "string" } },
        { "name": "tags", "typeRef": { "name": "string", "isArray": true }, "required": true },
        { "name": "metadata", "typeRef": { "name": "Generic.JSON" } },
        { "name": "reviewedAt", "typeRef": { "name": "Temporal.DateTime" } },
        { "name": "createdAt", "typeRef": { "name": "Temporal.DateTime" }, "required": true },
        { "name": "createdBy", "typeRef": { "name": "Identity.UUID" }, "required": true },
        { "name": "updatedAt", "typeRef": { "name": "Temporal.DateTime" }, "required": true },
        { "name": "updatedBy", "typeRef": { "name": "Identity.UUID" }, "required": true },
        { "name": "deletedAt", "typeRef": { "name": "Temporal.DateTime" } },
        { "name": "deletedBy", "typeRef": { "name": "Identity.UUID" } }
      ]
    },
    "EntryPosted": {
      "name": "EntryPosted",
      "comment": "Enqueued with each entry posted, in the transaction that writes it.",
      "role": "EmbeddedStruct",
      "queue": {},
      "fields": [
        { "name": "entryId", "typeRef": { "name": "Identity.UUID" }, "required": true },
        { "name": "amountCents", "typeRef": { "name": "Generic.Int64" }, "required": true }
      ]
    }
  }
}
