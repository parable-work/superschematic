{
  "name": "fixture-workflow-fields-db",
  "kind": "DB",
  "description": "Tables whose fields are behaviors (D103): an order whose status is a Workflow, and a shipment with two, its status and its paymentStatus. Each stays a table, and each Workflow's fields are its columns.",
  "scalars": {
    "Identity.UUID": { "name": "Identity.UUID", "languagePrimitive": "string" },
    "Temporal.DateTime": { "name": "Temporal.DateTime", "languagePrimitive": "string" }
  },
  "types": {
    "Order": {
      "name": "Order",
      "comment": "An order a customer places, which moves from draft through paid to shipped.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "states": ["draft", "paid", "shipped"],
            "initial": "draft",
            "transitions": [
              { "from": "draft", "to": "paid" },
              { "from": "paid", "to": "shipped", "permission": "orders.ship" }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": { "name": "Identity.UUID" },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        { "name": "title", "typeRef": { "name": "string" }, "required": true },
        { "name": "placedAt", "typeRef": { "name": "Temporal.DateTime" } }
      ]
    },
    "Shipment": {
      "name": "Shipment",
      "comment": "A shipment of goods, which is packed and sent while its payment is settled apart.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "states": ["pending", "packed", "sent"],
            "transitions": [
              { "from": "pending", "to": "packed" },
              { "from": "packed", "to": "sent" }
            ]
          }
        },
        {
          "name": "Workflow",
          "field": "paymentStatus",
          "config": {
            "states": ["unpaid", "paid", "refunded"],
            "transitions": [
              { "from": "unpaid", "to": "paid" },
              { "from": "paid", "to": "refunded" }
            ],
            "outcomes": { "refunded": "failure" }
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": { "name": "Identity.UUID" },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        { "name": "reference", "typeRef": { "name": "string" }, "required": true, "unique": true }
      ]
    }
  }
}
