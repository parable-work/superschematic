{
  "name": "fixture-user-model-db",
  "kind": "DB",
  "comment": "The core user model (D50): a User table and a UserRole table, from which the loader adds Session, UserCredential and UserRoleGrant. The schema is in the JSON form, which can declare Contact.Email case-insensitive; the scalar catalog does not carry the declaration yet.",
  "scalars": {
    "Contact.Email": {
      "name": "Contact.Email",
      "languagePrimitive": "string"
    },
    "Identity.Name": {
      "name": "Identity.Name",
      "languagePrimitive": "string"
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string"
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "languagePrimitive": "string"
    }
  },
  "types": {
    "User": {
      "name": "User",
      "comment": "A person who signs in with their email.",
      "role": "DBTable",
      "user": { "login": "email", "name": "displayName" },
      "fields": [
        {
          "name": "id",
          "typeRef": { "name": "Identity.UUID" },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "email",
          "typeRef": { "name": "Contact.Email" },
          "required": true,
          "unique": true
        },
        {
          "name": "displayName",
          "typeRef": { "name": "Identity.Name" },
          "required": true
        },
        {
          "name": "createdAt",
          "typeRef": { "name": "Temporal.DateTime" },
          "required": true
        }
      ]
    },
    "Role": {
      "name": "Role",
      "comment": "A named set of permissions users are granted.",
      "role": "DBTable",
      "userRole": {},
      "fields": [
        {
          "name": "id",
          "typeRef": { "name": "Identity.UUID" },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "name",
          "typeRef": { "name": "string" },
          "required": true,
          "unique": true
        },
        {
          "name": "permissions",
          "typeRef": { "name": "string", "isArray": true },
          "required": true
        }
      ]
    }
  }
}
