{
  "name": "fixture-vault-db",
  "kind": "DB",
  "scalars": {
    "Identity.UUID": { "name": "Identity.UUID", "languagePrimitive": "string" },
    "Temporal.DateTime": { "name": "Temporal.DateTime", "languagePrimitive": "string" }
  },
  "types": {
    "PlaidItem": {
      "name": "PlaidItem",
      "comment": "A bank link: the access token is a long-lived bank credential, kept encrypted.",
      "role": "DBTable",
      "fields": [
        { "name": "id", "typeRef": { "name": "Identity.UUID" }, "required": true, "key": true, "autoGenerated": true },
        { "name": "itemId", "typeRef": { "name": "string" }, "required": true, "unique": true },
        { "name": "institution", "typeRef": { "name": "string" }, "required": true, "searchField": true },
        { "name": "accessToken", "typeRef": { "name": "string" }, "required": true, "encryptedAtRest": true, "validateMaxLength": 200 },
        { "name": "webhookSecret", "typeRef": { "name": "string" }, "encryptedAtRest": true },
        { "name": "createdAt", "typeRef": { "name": "Temporal.DateTime" }, "required": true },
        { "name": "updatedAt", "typeRef": { "name": "Temporal.DateTime" }, "required": true },
        { "name": "deletedAt", "typeRef": { "name": "Temporal.DateTime" } }
      ]
    },
    "ApiCredential": {
      "name": "ApiCredential",
      "comment": "A service's credential, whose key the code that creates it chooses or the ORM generates.",
      "role": "DBTable",
      "fields": [
        { "name": "id", "typeRef": { "name": "Identity.UUID" }, "required": true, "key": true },
        { "name": "service", "typeRef": { "name": "string" }, "required": true, "unique": true },
        { "name": "secret", "typeRef": { "name": "string" }, "required": true, "encryptedAtRest": true },
        { "name": "rotatedAt", "typeRef": { "name": "Temporal.DateTime" } }
      ]
    }
  }
}
