{
  "name": "fixture-role-events-db",
  "kind": "DB",
  "comment": "The core user model (D50) with a role grant's event (#625): the Role table, a UserRole table, declares an @enqueueOnChange of its grants, which the loader copies onto UserRoleGrant, so granting or revoking a role enqueues a RoleGrantChanged whatever wrote the grant.",
  "scalars": {
    "Contact.Email": {
      "name": "Contact.Email",
      "languagePrimitive": "string"
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string"
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "languagePrimitive": "string"
    }
  },
  "types": {
    "User": {
      "name": "User",
      "comment": "A person who signs in with their email.",
      "role": "DBTable",
      "user": { "login": "email" },
      "fields": [
        { "name": "id", "typeRef": { "name": "Identity.UUID" }, "required": true, "key": true, "autoGenerated": true },
        { "name": "email", "typeRef": { "name": "Contact.Email" }, "required": true, "unique": true }
      ]
    },
    "Role": {
      "name": "Role",
      "comment": "A named set of permissions users are granted. Each grant of it, and each revocation, enqueues a RoleGrantChanged.",
      "role": "DBTable",
      "userRole": {},
      "enqueueOnChange": [
        {
          "queue": "RoleGrantChanged",
          "of": "grants",
          "on": ["insert", "delete"],
          "message": { "user": "user", "role": "role", "grant": "id" }
        },
        {
          "queue": "RoleChanged",
          "on": ["update"],
          "fields": ["name"],
          "message": { "role": "id" }
        }
      ],
      "fields": [
        { "name": "id", "typeRef": { "name": "Identity.UUID" }, "required": true, "key": true, "autoGenerated": true },
        { "name": "name", "typeRef": { "name": "string" }, "required": true, "unique": true },
        { "name": "permissions", "typeRef": { "name": "string", "isArray": true }, "required": true }
      ]
    },
    "RoleGrantChanged": {
      "name": "RoleGrantChanged",
      "comment": "A role granted to a user, or revoked.",
      "role": "EmbeddedStruct",
      "queue": {},
      "fields": [
        { "name": "user", "typeRef": { "name": "Identity.UUID" }, "required": true },
        { "name": "role", "typeRef": { "name": "Identity.UUID" }, "required": true },
        { "name": "grant", "typeRef": { "name": "Identity.UUID" }, "required": true }
      ]
    },
    "RoleChanged": {
      "name": "RoleChanged",
      "comment": "A role renamed.",
      "role": "EmbeddedStruct",
      "queue": {},
      "fields": [
        { "name": "role", "typeRef": { "name": "Identity.UUID" }, "required": true }
      ]
    }
  }
}
