{
  "kind": "General",
  "name": "projects",
  "description": "A project an engine runs with the core's behaviors and no extension: it moves from todo through doing to done, or fails, may be part of a parent project, starts its parent when it starts, is done once every project under it is done, and fails when one of them fails.",
  "types": {
    "Project": {
      "name": "Project",
      "role": "EmbeddedStruct",
      "behaviors": [
        {
          "name": "Workflow",
          "config": {
            "states": ["todo", "doing", "done", "failed"],
            "transitions": [
              { "from": "todo", "to": "doing" },
              { "from": "doing", "to": "done" },
              { "from": "doing", "to": "failed" }
            ],
            "outcomes": { "failed": "failure" }
          }
        },
        { "name": "Links", "config": { "links": { "parent": { "schema": "projects" } } } },
        {
          "name": "Reactions",
          "config": {
            "rules": [
              { "when": { "enters": "doing" }, "then": { "link": "parent", "transition": "doing" } },
              { "when": { "allTerminal": { "schema": "projects", "link": "parent", "outcomes": ["success"] } }, "then": { "transition": "done" } },
              { "when": { "anyTerminal": { "schema": "projects", "link": "parent", "outcomes": ["failure"] } }, "then": { "transition": "failed" } }
            ]
          }
        }
      ],
      "fields": [
        { "name": "title", "typeRef": { "name": "string" }, "required": true, "validateMaxLength": 200 }
      ]
    }
  }
}
