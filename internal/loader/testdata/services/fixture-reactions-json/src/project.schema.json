{
  "kind": "General",
  "name": "projects",
  "description": "A project with the core's behaviors and no extension: it moves from todo through doing to done, or fails, starts its parent when it starts, is done once every project under it is done, and fails when one of them fails. The rules' parent link is a relation to the parent project, which the loader leaves unresolved.",
  "types": {
    "Project": {
      "name": "Project",
      "role": "EmbeddedStruct",
      "behaviors": [
        {
          "name": "Workflow",
          "config": {
            "states": ["todo", "doing", "done", "failed"],
            "transitions": [
              { "from": "todo", "to": "doing" },
              { "from": "doing", "to": "done" },
              { "from": "doing", "to": "failed" }
            ],
            "outcomes": { "failed": "failure" }
          }
        },
        {
          "name": "Reactions",
          "config": {
            "rules": [
              { "when": { "enters": "doing" }, "then": { "link": "parent", "transition": "doing" } },
              { "when": { "allTerminal": { "schema": "projects", "link": "parent", "outcomes": ["success"] } }, "then": { "transition": "done" } },
              { "when": { "anyTerminal": { "schema": "projects", "link": "parent", "outcomes": ["failure"] } }, "then": { "transition": "failed" } }
            ]
          }
        }
      ],
      "fields": [
        { "name": "title", "typeRef": { "name": "string" }, "required": true, "validateMaxLength": 200 }
      ]
    }
  }
}
