{
  "kind": "DB",
  "name": "fixture-engine-db",
  "description": "A support desk's database: its customers and agents are tables, and its accounts and tickets are engine types, which compose behaviors, so the engine keeps their instances and sql and orm leave them out (D58). A ticket moves through a Workflow, collects comments, escalates when nobody answers it, and links to the account it belongs to.",
  "scalars": {
    "Contact.Email": { "name": "Contact.Email", "languagePrimitive": "string" },
    "Identity.Name": { "name": "Identity.Name", "languagePrimitive": "string" },
    "Identity.UUID": { "name": "Identity.UUID", "languagePrimitive": "string" },
    "Temporal.DateTime": { "name": "Temporal.DateTime", "languagePrimitive": "string" }
  },
  "enums": {
    "CustomerTier": {
      "name": "CustomerTier",
      "description": "How much a customer pays; only the Customer table uses it.",
      "values": [
        { "name": "Free", "serializedAs": "free" },
        { "name": "Paid", "serializedAs": "paid" }
      ]
    },
    "TicketPriority": {
      "name": "TicketPriority",
      "description": "How soon a ticket needs an answer; only the Ticket engine type uses it.",
      "values": [
        { "name": "Low", "serializedAs": "low" },
        { "name": "Normal", "serializedAs": "normal" },
        { "name": "Urgent", "serializedAs": "urgent" }
      ]
    }
  },
  "types": {
    "Address": {
      "name": "Address",
      "description": "A postal address, stored as JSON: a table's column and an engine type's field both hold one.",
      "role": "DBTable",
      "jsonField": true,
      "fields": [
        { "name": "line1", "typeRef": { "name": "string" }, "required": true },
        { "name": "city", "typeRef": { "name": "string" }, "required": true },
        { "name": "country", "typeRef": { "name": "string" }, "required": true, "validateMinLength": 2, "validateMaxLength": 2 }
      ]
    },
    "ContactCard": {
      "name": "ContactCard",
      "description": "Who to answer, stored as JSON in a ticket.",
      "role": "DBTable",
      "jsonField": true,
      "fields": [
        { "name": "email", "typeRef": { "name": "Contact.Email" }, "required": true },
        { "name": "phone", "typeRef": { "name": "string" } }
      ]
    },
    "Customer": {
      "name": "Customer",
      "description": "A customer: a table.",
      "role": "DBTable",
      "fields": [
        { "name": "id", "typeRef": { "name": "Identity.UUID" }, "required": true, "key": true, "unique": true, "autoGenerated": true },
        { "name": "name", "typeRef": { "name": "Identity.Name" }, "required": true },
        { "name": "email", "typeRef": { "name": "Contact.Email" }, "required": true, "unique": true },
        { "name": "tier", "typeRef": { "name": "CustomerTier" }, "required": true, "default": "free" },
        { "name": "billingAddress", "typeRef": { "name": "Address" } },
        { "name": "createdAt", "typeRef": { "name": "Temporal.DateTime" }, "required": true }
      ]
    },
    "Agent": {
      "name": "Agent",
      "description": "A support agent: a table, with its manager a relation to another agent.",
      "role": "DBTable",
      "fields": [
        { "name": "id", "typeRef": { "name": "Identity.UUID" }, "required": true, "key": true, "unique": true, "autoGenerated": true },
        { "name": "name", "typeRef": { "name": "Identity.Name" }, "required": true },
        { "name": "manager", "typeRef": { "name": "Agent" } }
      ]
    },
    "Account": {
      "name": "Account",
      "description": "A customer's account with the desk: an engine type, which collects comments.",
      "role": "DBTable",
      "behaviors": [
        { "name": "Comments" }
      ],
      "fields": [
        { "name": "name", "typeRef": { "name": "Identity.Name" }, "required": true },
        { "name": "customerId", "description": "The Customer row the account belongs to, by its key: a plain field, since an engine type reaches no table.", "typeRef": { "name": "Identity.UUID" } },
        { "name": "address", "typeRef": { "name": "Address" } },
        { "name": "slug", "typeRef": { "name": "string" }, "unique": true }
      ]
    },
    "Ticket": {
      "name": "Ticket",
      "description": "A support ticket: an engine type that moves from open through waiting to resolved, escalates after four hours open with no answer, collects comments and links to its account.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Workflow",
          "config": {
            "states": ["open", "waiting", "escalated", "resolved"],
            "transitions": [
              { "from": "open", "to": "waiting" },
              { "from": "waiting", "to": "open" },
              { "from": "open", "to": "escalated" },
              { "from": "escalated", "to": "open" },
              { "from": "open", "to": "resolved" },
              { "from": "waiting", "to": "resolved" },
              { "from": "escalated", "to": "resolved" }
            ]
          }
        },
        { "name": "Comments" },
        {
          "name": "Timers",
          "config": {
            "deadlines": {
              "respond": { "start": { "enters": "open" }, "afterMs": 14400000, "then": { "transition": "escalated" }, "until": { "leaves": "open" } }
            }
          }
        },
        {
          "name": "Links",
          "config": {
            "links": {
              "account": { "schema": "Account", "required": true }
            }
          }
        }
      ],
      "fields": [
        { "name": "title", "typeRef": { "name": "string" }, "required": true, "validateMaxLength": 200 },
        { "name": "priority", "typeRef": { "name": "TicketPriority" }, "required": true, "default": "normal" },
        { "name": "contact", "typeRef": { "name": "ContactCard" }, "required": true },
        { "name": "tags", "typeRef": { "name": "string", "isArray": true } },
        { "name": "dueAt", "typeRef": { "name": "Temporal.DateTime" } }
      ]
    }
  }
}
