{
  "name": "fixture-refs-api",
  "kind": "API",
  "scalars": {
    "Identity.Slug": {
      "name": "Identity.Slug",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "CITEXT"
      }
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string",
      "typeMappings": {
        "sql": "UUID"
      }
    }
  },
  "types": {
    "BasketInput": {
      "name": "BasketInput",
      "role": "APIInput",
      "fields": [
        {
          "name": "lines",
          "typeRef": {
            "name": "BasketLine",
            "isArray": true
          },
          "required": true,
          "validateListMin": 1,
          "validateListMax": 5
        },
        {
          "name": "giftSku",
          "comment": "A gift named by its sku, with every member said.",
          "typeRef": {
            "name": "Identity.Slug"
          },
          "references": {
            "type": "ItemView",
            "options": "Catalog.listItems",
            "value": "sku",
            "label": "name"
          }
        }
      ]
    },
    "BasketLine": {
      "name": "BasketLine",
      "comment": "A line names its item by id, which listItems lists.",
      "role": "EmbeddedStruct",
      "fields": [
        {
          "name": "itemId",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "references": {
            "type": "ItemView"
          }
        },
        {
          "name": "quantity",
          "typeRef": {
            "name": "number"
          },
          "required": true,
          "validateMin": 1,
          "validateMax": 9
        }
      ]
    },
    "BasketView": {
      "name": "BasketView",
      "role": "EmbeddedStruct",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "lines",
          "typeRef": {
            "name": "BasketLine",
            "isArray": true
          },
          "required": true
        }
      ]
    },
    "ItemView": {
      "name": "ItemView",
      "comment": "An item as the catalog lists it: its title, and so the label of every\nreference to it, is its name.",
      "role": "EmbeddedStruct",
      "display": {
        "noun": "Item",
        "plural": "Items",
        "titleField": "name",
        "summaryFields": [
          "name",
          "sku"
        ]
      },
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "sku",
          "typeRef": {
            "name": "Identity.Slug"
          },
          "required": true
        },
        {
          "name": "inStock",
          "typeRef": {
            "name": "boolean"
          },
          "required": true
        }
      ]
    },
    "KindView": {
      "name": "KindView",
      "comment": "A kind as the catalog lists it, by its code: a reference to it holds an\nenum's value, whose schema is a component.",
      "role": "EmbeddedStruct",
      "display": {
        "noun": "Kind",
        "plural": "Kinds",
        "titleField": "name"
      },
      "fields": [
        {
          "name": "code",
          "typeRef": {
            "name": "ItemKind"
          },
          "required": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "string"
          },
          "required": true
        }
      ]
    },
    "ShelfEntry": {
      "name": "ShelfEntry",
      "comment": "Where an item is shelved: under a kind, named by its code.",
      "role": "EmbeddedStruct",
      "fields": [
        {
          "name": "itemId",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "references": {
            "type": "ItemView"
          }
        },
        {
          "name": "kind",
          "typeRef": {
            "name": "ItemKind"
          },
          "required": true,
          "references": {
            "type": "KindView",
            "value": "code"
          }
        }
      ]
    }
  },
  "enums": {
    "ItemKind": {
      "name": "ItemKind",
      "comment": "The kinds of item the catalog shelves.",
      "values": [
        {
          "name": "Book",
          "serializedAs": "book"
        },
        {
          "name": "Game",
          "serializedAs": "game"
        }
      ]
    }
  },
  "operationSets": [
    {
      "name": "Catalog",
      "operations": [
        {
          "name": "listItems",
          "comment": "The items, narrowed by a search of their text and by ids, the lookup\na UI names the references' values through.",
          "typeRef": {
            "name": "ItemView",
            "isArray": true
          },
          "required": true,
          "arguments": [
            {
              "name": "q",
              "typeRef": {
                "name": "string"
              },
              "validateMaxLength": 50,
              "isQuery": true,
              "search": true
            },
            {
              "name": "ids",
              "typeRef": {
                "name": "Identity.UUID",
                "isArray": true
              },
              "validateListMax": 5,
              "isQuery": true,
              "references": {
                "type": "ItemView"
              }
            },
            {
              "name": "inStock",
              "typeRef": {
                "name": "boolean"
              },
              "isQuery": true
            }
          ],
          "httpMethod": "GET",
          "restPath": "items"
        },
        {
          "name": "getItem",
          "typeRef": {
            "name": "ItemView"
          },
          "required": true,
          "arguments": [
            {
              "name": "itemId",
              "typeRef": {
                "name": "Identity.UUID"
              },
              "required": true,
              "references": {
                "type": "ItemView"
              }
            }
          ],
          "httpMethod": "GET",
          "restPath": "items/{itemId}"
        },
        {
          "name": "placeBasket",
          "typeRef": {
            "name": "BasketView"
          },
          "required": true,
          "arguments": [
            {
              "name": "input",
              "typeRef": {
                "name": "BasketInput"
              },
              "required": true
            }
          ],
          "httpMethod": "POST",
          "restPath": "baskets"
        },
        {
          "name": "listKinds",
          "typeRef": {
            "name": "KindView",
            "isArray": true
          },
          "required": true,
          "httpMethod": "GET",
          "restPath": "kinds"
        },
        {
          "name": "shelveItem",
          "comment": "Shelves an item under a kind, a body argument that names it by its\ncode.",
          "typeRef": {
            "name": "ShelfEntry"
          },
          "required": true,
          "arguments": [
            {
              "name": "itemId",
              "typeRef": {
                "name": "Identity.UUID"
              },
              "required": true,
              "references": {
                "type": "ItemView"
              }
            },
            {
              "name": "kind",
              "typeRef": {
                "name": "ItemKind"
              },
              "required": true,
              "references": {
                "type": "KindView",
                "value": "code"
              }
            }
          ],
          "httpMethod": "POST",
          "restPath": "items/{itemId}/shelf"
        }
      ]
    }
  ]
}
