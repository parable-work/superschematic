{
  "scalars": {
    "Generic.Int64": {
      "name": "Generic.Int64",
      "languagePrimitive": "number"
    },
    "Identity.Name": {
      "name": "Identity.Name",
      "languagePrimitive": "string"
    },
    "Network.Url": {
      "name": "Network.Url",
      "languagePrimitive": "string"
    }
  },
  "types": {
    "FixtureConfig": {
      "name": "FixtureConfig",
      "role": "EmbeddedStruct",
      "fields": [
        {
          "name": "DATABASE_URL",
          "title": "Database URL",
          "purpose": "Connection target for the **primary database**.",
          "icon": "database",
          "typeRef": { "name": "Network.Url" },
          "required": true
        },
        {
          "name": "JWT_SECRET",
          "typeRef": { "name": "string" },
          "required": true,
          "secret": true
        },
        {
          "name": "PORT",
          "typeRef": { "name": "number" },
          "required": true,
          "default": "8080"
        },
        {
          "name": "ENVIRONMENT",
          "typeRef": { "name": "FixtureEnvironment" },
          "required": true,
          "default": "development"
        }
      ],
      "envVars": true
    },
    "RetryPolicy": {
      "name": "RetryPolicy",
      "role": "EmbeddedStruct",
      "fields": [
        {
          "name": "maxAttempts",
          "typeRef": { "name": "number" },
          "required": true
        },
        {
          "name": "backoffSeconds",
          "typeRef": { "name": "number" }
        }
      ]
    },
    "FixtureFilter": {
      "name": "FixtureFilter",
      "comment": "JSON-persisted filter: exercises optional-list constraint gating.\nAbsent/null must skip listMin; an explicit [] must fail it (decode must\nnot normalize an absent optional list into an empty non-nil slice).",
      "role": "EmbeddedStruct",
      "jsonField": true,
      "fields": [
        {
          "name": "kind",
          "typeRef": { "name": "string" },
          "required": true,
          "validateMaxLength": 32
        },
        {
          "name": "values",
          "typeRef": { "name": "string", "isArray": true },
          "validateMaxLength": 64,
          "validateListMin": 1,
          "validateListMax": 10
        },
        {
          "name": "minCents",
          "comment": "Scalars with rules of their own, checked after the scalar's.",
          "typeRef": { "name": "Generic.Int64" },
          "required": true,
          "validateMin": 0
        },
        {
          "name": "labels",
          "typeRef": { "name": "Identity.Name", "isArray": true },
          "validateMaxLength": 16
        }
      ]
    }
  }
}
