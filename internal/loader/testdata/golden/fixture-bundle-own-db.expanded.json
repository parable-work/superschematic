{
  "name": "fixture-bundle-own-db",
  "kind": "DB",
  "scalars": {
    "Identity.UUID": {
      "name": "Identity.UUID",
      "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "IdentityUUID",
        "json_schema": "string",
        "python": "uuid.UUID",
        "rust": "uuid::Uuid",
        "sql": "UUID",
        "typescript": "string"
      },
      "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "hasCustomParse": true
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "description": "ISO8601 datetime string. Epoch wire values keep this scalar and declare x-temporal-format (unix, unix_millis, unix_micros, unix_nanos) on the property; the unit is never guessed from digit count.",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "TemporalDateTime",
        "json_schema": "string",
        "python": "datetime.datetime",
        "rust": "chrono::DateTime\u003cchrono::Utc\u003e",
        "sql": "TIMESTAMPTZ",
        "typescript": "JSDate"
      },
      "hasCustomParse": true
    }
  },
  "types": {
    "Note": {
      "name": "Note",
      "owner": "src/reviews.schema.ts",
      "comment": "A note its reviewer approves, with no permission beside.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "StateRules",
          "implements": true,
          "config": {
            "states": {
              "review": {
                "by": [
                  "checkedBy"
                ],
                "frozen": "all"
              }
            }
          },
          "bundle": "Reviewed"
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "states": [
              "draft",
              "review",
              "approved"
            ],
            "transitions": [
              {
                "from": "draft",
                "to": "review"
              },
              {
                "by": [
                  "checkedBy"
                ],
                "from": "review",
                "to": "draft"
              },
              {
                "by": [
                  "checkedBy"
                ],
                "from": "review",
                "to": "approved"
              }
            ]
          },
          "bundle": "Reviewed"
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "text",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "checkedBy",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "status",
          "description": "The state the instance is in.",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "status",
            "value": true
          }
        },
        {
          "name": "statusEnteredAt",
          "description": "When the status last changed, in epoch milliseconds: the create's time, then each transition's. Absent on an instance created before Workflow kept it, until its next transition.",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "enteredAt"
          }
        }
      ],
      "optimistic": true
    },
    "Proposal": {
      "name": "Proposal",
      "owner": "src/reviews.schema.ts",
      "comment": "A proposal its reviewer approves, holding proposals.approve.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "StateRules",
          "implements": true,
          "config": {
            "states": {
              "review": {
                "by": [
                  "reviewer"
                ],
                "frozen": "all"
              }
            }
          },
          "bundle": "Reviewed"
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "states": [
              "draft",
              "review",
              "approved"
            ],
            "transitions": [
              {
                "from": "draft",
                "to": "review"
              },
              {
                "by": [
                  "reviewer"
                ],
                "from": "review",
                "to": "draft"
              },
              {
                "by": [
                  "reviewer"
                ],
                "from": "review",
                "permission": "proposals.approve",
                "to": "approved"
              }
            ]
          },
          "bundle": "Reviewed"
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "reviewer",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "status",
          "description": "The state the instance is in.",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "status",
            "value": true
          }
        },
        {
          "name": "statusEnteredAt",
          "description": "When the status last changed, in epoch milliseconds: the create's time, then each transition's. Absent on an instance created before Workflow kept it, until its next transition.",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "enteredAt"
          }
        }
      ],
      "optimistic": true
    }
  }
}
