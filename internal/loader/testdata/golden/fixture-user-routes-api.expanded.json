  "enums": {
    "SessionTransport": {
      "name": "SessionTransport",
      "owner": "fixture-user-routes-api",
      "comment": "How a session travels: bearer answers its token for the Authorization header; cookie sets the session cookie and answers no token.",
      "values": [
        {
          "name": "Bearer",
          "serializedAs": "bearer"
        },
        {
          "name": "Cookie",
          "serializedAs": "cookie"
        }
      ],
      "origin": "identity"
    }
  },
  "operationSets": [
    {
      "name": "Account",
      "comment": "Signs users in and out, and lets anyone register.",
      "operations": [
        {
          "name": "login",
          "comment": "Signs a user in with their login and password and starts a session. A bearer session answers its token; a cookie session sets the session cookie and answers none.",
          "mcp": {
            "hidden": true,
            "hiddenReason": "It carries a password, which an agent does not hold."
          },
          "typeRef": {
            "name": "LoginResult"
          },
          "required": true,
          "arguments": [
            {
              "name": "input",
              "typeRef": {
                "name": "LoginInput"
              },
              "required": true
            }
          ],
          "public": true,
          "identityOperation": "login",
          "httpMethod": "POST",
          "restPath": "auth/login",
          "middleware": {
            "rateLimit": 10
          },
          "origin": "identity"
        },
        {
          "name": "logout",
          "comment": "Ends the caller's session and clears the session cookie. It answers true.",
          "typeRef": {
            "name": "boolean"
          },
          "required": true,
          "auth": true,
          "identityOperation": "logout",
          "httpMethod": "POST",
          "restPath": "auth/logout",
          "origin": "identity"
        },
        {
          "name": "me",
          "comment": "The caller's user, the roles they hold and the permissions those roles grant.",
          "typeRef": {
            "name": "CurrentUser"
          },
          "required": true,
          "auth": true,
          "identityOperation": "me",
          "httpMethod": "GET",
          "restPath": "auth/me",
          "origin": "identity"
        },
        {
          "name": "capabilities",
          "comment": "For each operation of the API an end user may call, keyed by its OpenAPI operation id, whether its route admits the caller.",
          "typeRef": {
            "name": "Capabilities"
          },
          "required": true,
          "auth": true,
          "identityOperation": "capabilities",
          "httpMethod": "GET",
          "restPath": "auth/capabilities",
          "origin": "identity"
        },
        {
          "name": "changePassword",
          "comment": "Changes the caller's password, given their current one, and ends their other sessions. It answers true.",
          "mcp": {
            "hidden": true,
            "hiddenReason": "It carries a password, which an agent does not hold."
          },
          "typeRef": {
            "name": "boolean"
          },
          "required": true,
          "arguments": [
            {
              "name": "input",
              "typeRef": {
                "name": "ChangePasswordInput"
              },
              "required": true
            }
          ],
          "auth": true,
          "identityOperation": "changePassword",
          "httpMethod": "POST",
          "restPath": "auth/password",
          "middleware": {
            "rateLimit": 10
          },
          "origin": "identity"
        },
        {
          "name": "register",
          "comment": "Creates a user with the login, name and password given and signs them in, as login does.",
          "mcp": {
            "hidden": true,
            "hiddenReason": "It carries a password, which an agent does not hold."
          },
          "typeRef": {
            "name": "LoginResult"
          },
          "required": true,
          "arguments": [
            {
              "name": "input",
              "typeRef": {
                "name": "RegisterInput"
              },
              "required": true
            }
          ],
          "public": true,
          "identityOperation": "register",
          "httpMethod": "POST",
          "restPath": "auth/register",
          "middleware": {
            "rateLimit": 5
          },
          "origin": "identity"
        }
      ],
      "userSessions": {
        "register": true
      }
    },
    {
      "name": "AccountAdmin",
      "comment": "Manages users, roles and the grants between them.",
      "operations": [
        {
          "name": "createUser",
          "comment": "Creates a user with the login, name and password given.",
          "mcp": {
            "hidden": true,
            "hiddenReason": "It carries a password, which an agent does not hold."
          },
          "typeRef": {
