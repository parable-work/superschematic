{
  "name": "fixture-approvals-db",
  "kind": "DB",
  "scalars": {
    "Generic.JSON": {
      "name": "Generic.JSON",
      "description": "Any valid JSON value: object, array, primitive, or null",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "GenericJSON",
        "json_schema": "any",
        "python": "Any",
        "rust": "serde_json::Value",
        "sql": "JSONB",
        "typescript": "JSONValue"
      },
      "hasCustomValidate": true
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "IdentityUUID",
        "json_schema": "string",
        "python": "uuid.UUID",
        "rust": "uuid::Uuid",
        "sql": "UUID",
        "typescript": "string"
      },
      "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "hasCustomParse": true
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "description": "ISO8601 datetime string. Epoch wire values keep this scalar and declare x-temporal-format (unix, unix_millis, unix_micros, unix_nanos) on the property; the unit is never guessed from digit count.",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "TemporalDateTime",
        "json_schema": "string",
        "python": "datetime.datetime",
        "rust": "chrono::DateTime\u003cchrono::Utc\u003e",
        "sql": "TIMESTAMPTZ",
        "typescript": "JSDate"
      },
      "hasCustomParse": true
    }
  },
  "types": {
    "Note": {
      "name": "Note",
      "owner": "src/notes.schema.ts",
      "comment": "A note a person drafts and publishes, kept by its slug (D104). It keeps\nno sub-table, so it has upserts, and an upsert's update of the note its\nslug holds runs through the core as an update does: its author stays who\nits create named, and pinned and views only go up, unless the caller\nholds notes.admin; while it is a draft only its creator edits its body.\nA deleted note is kept, deletedAt stamped, and an upsert of its slug\nfinds none.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Constants",
          "implements": true,
          "config": {
            "fields": [
              "author"
            ],
            "oneWay": {
              "pinned": "up",
              "views": "up"
            },
            "permission": "notes.admin"
          }
        },
        {
          "name": "StateRules",
          "implements": true,
          "config": {
            "states": {
              "draft": {
                "by": [
                  "createdBy"
                ],
                "frozen": [
                  "body"
                ]
              }
            }
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "states": [
              "draft",
              "published"
            ],
            "transitions": [
              {
                "from": "draft",
                "to": "published"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "slug",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "unique": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "body",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "author",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "pinned",
          "typeRef": {
            "name": "boolean"
          },
          "required": true
        },
        {
          "name": "views",
          "typeRef": {
            "name": "number"
          },
          "required": true
        },
        {
          "name": "createdBy",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "deletedAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          }
        },
        {
          "name": "status",
          "description": "The state the instance is in.",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "status",
            "value": true
          }
        },
        {
          "name": "statusEnteredAt",
          "description": "When the status last changed, in epoch milliseconds: the create's time, then each transition's. Absent on an instance created before Workflow kept it, until its next transition.",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "enteredAt"
          }
        }
      ],
      "optimistic": true
    },
    "Task": {
      "name": "Task",
      "owner": "src/tasks.schema.ts",
      "comment": "A task a person plans and its owner proves (D104). Its plan is approved\nbefore it is proved, and that approval survives later edits of the plan;\nits proof is approved against the version its reviewer read, and a change\nof the proof clears that approval. While it is planned only its creator\nedits the plan, and while it is working only its reviewer does; it enters\nproving only with a proof. Its owner stays who its create named, and\nurgent and attempts only go up, unless the caller holds tasks.admin.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Constants",
          "implements": true,
          "config": {
            "fields": [
              "owner"
            ],
            "oneWay": {
              "attempts": "up",
              "urgent": "up"
            },
            "permission": "tasks.admin"
          }
        },
        {
          "name": "StateRules",
          "implements": true,
          "config": {
            "states": {
              "planned": {
                "by": [
                  "createdBy"
                ],
                "frozen": [
                  "plan"
                ]
              },
              "proving": {
                "required": [
                  "proof"
                ]
              },
              "working": {
                "by": [
                  "reviewer"
                ],
                "frozen": [
                  "plan"
                ]
              }
            }
          }
        },
        {
          "name": "Approvals",
          "implements": true,
          "config": {
            "gates": {
              "done": {
                "count": 1,
                "permission": "tasks.review",
                "pinned": true,
                "resetOn": [
                  "proof"
                ]
              },
              "proving": {
                "count": 1,
                "permission": "tasks.review",
                "resetOn": []
              }
            }
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "states": [
              "planned",
              "working",
              "proving",
              "done",
              "cancelled"
            ],
            "transitions": [
              {
                "by": [
                  "owner"
                ],
                "from": "planned",
                "to": "working"
              },
              {
                "by": [
                  "owner"
                ],
                "from": "working",
                "to": "proving"
              },
              {
                "from": "proving",
                "to": "working"
              },
              {
                "from": "proving",
                "to": "done"
              },
              {
                "from": "planned",
                "to": "cancelled"
              },
              {
                "from": "working",
                "to": "cancelled"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "owner",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "reviewer",
          "typeRef": {
            "name": "Identity.UUID"
          }
        },
        {
          "name": "plan",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "proof",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "urgent",
          "typeRef": {
            "name": "boolean"
          },
          "required": true
        },
        {
          "name": "attempts",
          "typeRef": {
            "name": "number"
          },
          "required": true
        },
        {
          "name": "createdBy",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "status",
          "description": "The state the instance is in.",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "status",
            "value": true
          }
        },
        {
          "name": "statusEnteredAt",
          "description": "When the status last changed, in epoch milliseconds: the create's time, then each transition's. Absent on an instance created before Workflow kept it, until its next transition.",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "enteredAt"
          }
        }
      ],
      "optimistic": true
    },
    "TaskApprovalsSignOffs": {
      "name": "TaskApprovalsSignOffs",
      "owner": "src/tasks.schema.ts",
      "comment": "One row per sign-off on the row, keyed by its number, the order it was given in: the gated state, the caller who signed (its subject and kind, whom it acted for and its run's Agent), the assurance its host reported, the permissions it held and the values of the fields the gate's requirements reset on, why, when, and when it was consumed, absent while it counts. A withdrawal deletes its row; consumed ones stay for listSignOffs.",
      "role": "DBTable",
      "fields": [
        {
          "name": "task",
          "description": "The Task row the rows are of; deleting it deletes them.",
          "typeRef": {
            "name": "Task"
          },
          "required": true,
          "relation": {
            "type": "Task",
            "onDelete": "CASCADE"
          }
        },
        {
          "name": "number",
          "description": "The sign-off's number on the row, from 1 in the order they were given, in ten digits zero-padded so the key's order is theirs.",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "state",
          "description": "The gated state it signs off for.",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "subject",
          "description": "The subject of the caller who signed.",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "kind",
          "description": "The caller's kind (D156): user, party, agent or extension; absent when the host named none.",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "actingFor",
          "description": "The subject the caller acted for (D77); absent when it acted for no one.",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "actingForKind",
          "description": "The kind of the subject the caller acted for; absent when the host named none.",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "agent",
          "description": "The Agent whose run the caller was (D158); absent for a caller that was no agent run.",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "signedInAt",
          "description": "When the caller's session last signed in, as its host reported it.",
          "typeRef": {
            "name": "Temporal.DateTime"
          }
        },
        {
          "name": "userVerified",
          "description": "Whether the caller proved user verification on the sign-off itself.",
          "typeRef": {
            "name": "boolean"
          }
        },
        {
          "name": "held",
          "description": "The permissions the caller held when it signed, a list, which a requirement read from rows counts unless it reads them again.",
          "typeRef": {
            "name": "Generic.JSON"
          }
        },
        {
          "name": "values",
          "description": "The value each field the gate's requirements reset on held when it signed, by field, null for none.",
          "typeRef": {
            "name": "Generic.JSON"
          }
        },
        {
          "name": "note",
          "description": "Why, for the others.",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "at",
          "description": "When it was given, in epoch milliseconds.",
          "typeRef": {
            "name": "Temporal.DateTime"
          }
        },
        {
          "name": "consumedAt",
          "description": "When a change of the fields its gate names, an entry into the gated state or a build without its gate consumed it; absent while it counts.",
          "typeRef": {
            "name": "Temporal.DateTime"
          }
        }
      ],
      "indexes": [
        {
          "keys": [
            "task",
            "number"
          ],
          "unique": true,
          "origin": "behavior"
        }
      ],
      "origin": "behavior",
      "behaviorTable": {
        "row": "Task",
        "use": "Approvals",
        "behavior": "Approvals",
        "table": "signOffs",
        "key": "number",
        "rowField": "task"
      }
    }
  }
}
