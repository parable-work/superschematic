  "operationSets": [
    {
      "name": "BatchActions",
      "comment": "A batch's Workflow, for any signed-in caller (D149). Blueprint declares\nno operation: a batch's create stamps its jobs.",
      "operations": [
        {
          "name": "statusTransition",
          "comment": "Moves the instance to another state along a transition the config lists. A transition that names a permission needs a caller who holds it.",
          "docs": {
            "title": "Batch status: transition",
            "description": "Moves the instance to another state along a transition the config lists. A transition that names a permission needs a caller who holds it.",
            "capability": "batch.status.transition",
            "lifecycle": "active",
            "visibility": "public",
            "mappingStatus": "mapped"
          },
          "mcp": {
            "handle": "batch_status_transition",
            "hidden": false,
            "invocationPolicy": "auto"
          },
          "typeRef": {
            "name": "BatchStatusTransitionResult"
          },
          "required": true,
          "arguments": [
            {
              "name": "id",
              "comment": "The key of the Batch row the operation runs on.",
              "typeRef": {
                "name": "Identity.UUID"
              },
              "required": true
            },
            {
              "name": "input",
              "typeRef": {
                "name": "BatchStatusTransitionInput"
              },
              "required": true
            }
          ],
          "auth": true,
          "behaviorOperation": {
            "database": "fixture-blueprint-db",
            "type": "Batch",
            "key": "id",
            "use": "status",
            "behavior": "Workflow",
            "operation": "transition",
            "writes": true
          },
          "httpMethod": "POST",
          "restPath": "batch/{id}/status/transition",
          "origin": "behavior"
        }
      ],
      "behaviorOperations": {
        "type": "Batch"
      },
      "auth": true
    },
    {
      "name": "JobActions",
      "comment": "A job's Workflow and its blockers, for any signed-in caller: a move to\nrunning waits for the jobs of the steps before it (D149).",
      "operations": [
        {
          "name": "dependenciesAddBlocker",
          "comment": "Makes another instance block this one. It must be of the type's own schema or one the config lists, exist, and not be blocked by this instance, directly or through others. An instance in a gated state that is terminal takes no blocker that is not finished.",
          "docs": {
            "title": "Job dependencies: add blocker",
            "description": "Makes another instance block this one. It must be of the type's own schema or one the config lists, exist, and not be blocked by this instance, directly or through others. An instance in a gated state that is terminal takes no blocker that is not finished.",
            "capability": "job.dependencies.add-blocker",
            "lifecycle": "active",
            "visibility": "public",
            "mappingStatus": "mapped"
          },
          "mcp": {
            "handle": "job_dependencies_add_blocker",
            "hidden": false,
            "invocationPolicy": "auto"
          },
          "typeRef": {
            "name": "JobDependenciesAddBlockerResult"
          },
          "required": true,
          "arguments": [
            {
              "name": "id",
              "comment": "The key of the Job row the operation runs on.",
              "typeRef": {
                "name": "Identity.UUID"
              },
              "required": true
            },
            {
              "name": "input",
              "typeRef": {
                "name": "JobDependenciesAddBlockerInput"
              },
              "required": true
            }
          ],
          "auth": true,
          "behaviorOperation": {
            "database": "fixture-blueprint-db",
            "type": "Job",
            "key": "id",
            "use": "Dependencies",
            "behavior": "Dependencies",
            "operation": "addBlocker",
            "writes": true
          },
          "httpMethod": "POST",
          "restPath": "job/{id}/dependencies/add-blocker",
          "origin": "behavior"
        },
        {
          "name": "dependenciesRemoveBlocker",
          "comment": "Stops another instance from blocking this one.",
