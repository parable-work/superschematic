{
  "name": "fixture-barrier-db",
  "kind": "DB",
  "scalars": {
    "Generic.Int64": {
      "name": "Generic.Int64",
      "description": "Signed 64-bit integer; range bounded by JavaScript's safe-integer ceiling.",
      "languagePrimitive": "number",
      "primitive": "Int",
      "typeMappings": {
        "go": "GenericInt64",
        "json_schema": "integer",
        "python": "int",
        "rust": "i64",
        "sql": "BIGINT",
        "typescript": "number"
      },
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "hasCustomParse": true
    },
    "Generic.JSON": {
      "name": "Generic.JSON",
      "description": "Any valid JSON value: object, array, primitive, or null",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "GenericJSON",
        "json_schema": "any",
        "python": "Any",
        "rust": "serde_json::Value",
        "sql": "JSONB",
        "typescript": "JSONValue"
      },
      "hasCustomValidate": true
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "IdentityUUID",
        "json_schema": "string",
        "python": "uuid.UUID",
        "rust": "uuid::Uuid",
        "sql": "UUID",
        "typescript": "string"
      },
      "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "hasCustomParse": true
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "description": "ISO8601 datetime string. Epoch wire values keep this scalar and declare x-temporal-format (unix, unix_millis, unix_micros, unix_nanos) on the property; the unit is never guessed from digit count.",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "TemporalDateTime",
        "json_schema": "string",
        "python": "datetime.datetime",
        "rust": "chrono::DateTime\u003cchrono::Utc\u003e",
        "sql": "TIMESTAMPTZ",
        "typescript": "JSDate"
      },
      "hasCustomParse": true
    }
  },
  "types": {
    "Agent": {
      "name": "Agent",
      "owner": "src/rollouts.schema.ts",
      "comment": "An agent a rollout waits for: ready once it says so, gone when it stops\nanswering, which a rollout does not count as ready.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "outcomes": {
              "gone": "neutral"
            },
            "states": [
              "running",
              "ready",
              "gone"
            ],
            "transitions": [
              {
                "from": "running",
                "to": "ready"
              },
              {
                "from": "running",
                "to": "gone"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "rollout",
          "typeRef": {
            "name": "Rollout"
          },
          "required": true,
          "relation": {
            "type": "Rollout"
          }
        },
        {
          "name": "status",
          "description": "The state the instance is in.",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "status",
            "value": true
          }
        },
        {
          "name": "statusEnteredAt",
          "description": "When the status last changed, in epoch milliseconds: the create's time, then each transition's. Absent on an instance created before Workflow kept it, until its next transition.",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "enteredAt"
          }
        }
      ],
      "optimistic": true
    },
    "Rollout": {
      "name": "Rollout",
      "owner": "src/rollouts.schema.ts",
      "comment": "A rollout that waits for its agents (D104, D103's step 5): a Barrier,\nreleased once every agent that points at it is ready, its deadline\ntrying the release five minutes after it begins waiting, and a person\nholding rollouts.release giving the go-ahead.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Rollups",
          "implements": true,
          "config": {
            "rollups": {
              "ready": {
                "function": "all",
                "gatedStates": [
                  "released"
                ],
                "link": "rollout",
                "outcomes": [
                  "success"
                ],
                "schema": "Agent"
              }
            }
          },
          "bundle": "Barrier"
        },
        {
          "name": "Timers",
          "implements": true,
          "config": {
            "deadlines": {
              "timeout": {
                "afterMs": 300000,
                "start": {
                  "enters": "waiting"
                },
                "then": {
                  "transition": "released"
                }
              }
            }
          },
          "bundle": "Barrier"
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "initial": "waiting",
            "outcomes": {
              "cancelled": "neutral"
            },
            "states": [
              "waiting",
              "released",
              "cancelled"
            ],
            "transitions": [
              {
                "from": "waiting",
                "permission": "rollouts.release",
                "to": "released"
              },
              {
                "from": "waiting",
                "to": "cancelled"
              }
            ]
          },
          "bundle": "Barrier"
        }
      ],
      "bundles": [
        {
          "name": "Barrier",
          "settings": {
            "link": "rollout",
            "releasePermission": "rollouts.release",
            "rows": "Agent",
            "timeoutMs": 300000
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "agents",
          "typeRef": {
            "name": "Agent",
            "isArray": true
          },
          "required": true,
          "hasMany": true
        },
        {
          "name": "status",
          "description": "The state the instance is in.",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "status",
            "value": true
          }
        },
        {
          "name": "statusEnteredAt",
          "description": "When the status last changed, in epoch milliseconds: the create's time, then each transition's. Absent on an instance created before Workflow kept it, until its next transition.",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "enteredAt"
          }
        }
      ],
      "optimistic": true
    },
    "RolloutChange": {
      "name": "RolloutChange",
      "owner": "src/rollouts.schema.ts",
      "comment": "The writes of Rollout's rows its behaviors hear, one message per write, whoever makes it, which a trigger of the table writes and a behavior worker runs (D103).",
      "role": "EmbeddedStruct",
      "fields": [
        {
          "name": "rowKey",
          "description": "The key of the Rollout row written.",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "write",
          "description": "What the write did: insert, update or delete.",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "at",
          "description": "When the write was made, in epoch milliseconds, by the database's clock.",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        },
        {
          "name": "before",
          "description": "The row's columns before the write, by column, as JSON; null for an insert.",
          "typeRef": {
            "name": "Generic.JSON"
          }
        },
        {
          "name": "after",
          "description": "The row's columns after the write, by column, as JSON; null for a delete.",
          "typeRef": {
            "name": "Generic.JSON"
          }
        }
      ],
      "origin": "behavior",
      "behaviorQueue": {
        "row": "Rollout",
        "kind": "changes",
        "behaviors": [
          "Timers"
        ]
      },
      "queue": {
        "retain": "0s",
        "key": "rowKey",
        "serialize": true
      }
    },
    "RolloutDeadline": {
      "name": "RolloutDeadline",
      "owner": "src/rollouts.schema.ts",
      "comment": "The deadlines Rollout's behaviors arm, one message per row, use and deadline, due when it falls due (D103).",
      "role": "EmbeddedStruct",
      "fields": [
        {
          "name": "rowKey",
          "description": "The key of the Rollout row the deadline is armed on.",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "useId",
          "description": "The id of the use that armed it: its anchor field, or the behavior's name for a use the table implements.",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "name",
          "description": "The deadline's name, the use's own.",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "at",
          "description": "When it was armed to fall due, in epoch milliseconds.",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        },
        {
          "name": "payload",
          "description": "What the use armed it with, which its deadline hook reads.",
          "typeRef": {
            "name": "Generic.JSON"
          }
        }
      ],
      "indexes": [
        {
          "keys": [
            "rowKey",
            "useId",
            "name"
          ],
          "unique": true,
          "where": "state IN ('ready', 'claimed')",
          "origin": "behavior"
        },
        {
          "keys": [
            "rowKey"
          ],
          "origin": "behavior"
        }
      ],
      "origin": "behavior",
      "behaviorQueue": {
        "row": "Rollout",
        "kind": "deadlines",
        "behaviors": [
          "Timers"
        ]
      },
      "queue": {
        "retain": "0s"
      }
    },
    "RolloutTimersDeadlines": {
      "name": "RolloutTimersDeadlines",
      "owner": "src/rollouts.schema.ts",
      "comment": "One row per deadline started on the row, keyed by the deadline's name: the time it starts from, the fact it started from, when it is due (null once until cancelled it), whether and when it fired, and what its then met.",
      "role": "DBTable",
      "fields": [
        {
          "name": "rollout",
          "description": "The Rollout row the rows are of; deleting it deletes them.",
          "typeRef": {
            "name": "Rollout"
          },
          "required": true,
          "relation": {
            "type": "Rollout",
            "onDelete": "CASCADE"
          }
        },
        {
          "name": "name",
          "description": "The deadline's name in the config.",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "baseAt",
          "description": "The time the deadline starts from, in epoch milliseconds: the create's, the status's entry's, or the field's.",
          "typeRef": {
            "name": "Temporal.DateTime"
          }
        },
        {
          "name": "armedFrom",
          "description": "The fact it started from, as text: the create's or the entry's time, or the field's value. A write that leaves it as it is arms nothing.",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "dueAt",
          "description": "When it is due, in epoch milliseconds; null once until cancelled it.",
          "typeRef": {
            "name": "Temporal.DateTime"
          }
        },
        {
          "name": "fired",
          "description": "Whether it fired.",
          "typeRef": {
            "name": "boolean"
          }
        },
        {
          "name": "firedAt",
          "description": "When it fired.",
          "typeRef": {
            "name": "Temporal.DateTime"
          }
        },
        {
          "name": "outcome",
          "description": "What its then met when it fired: moved, skipped, vetoed or forbidden.",
          "typeRef": {
            "name": "string"
          }
        }
      ],
      "indexes": [
        {
          "keys": [
            "rollout",
            "name"
          ],
          "unique": true,
          "origin": "behavior"
        }
      ],
      "origin": "behavior",
      "behaviorTable": {
        "row": "Rollout",
        "use": "Timers",
        "behavior": "Timers",
        "table": "deadlines",
        "key": "name",
        "rowField": "rollout"
      }
    }
  }
}
