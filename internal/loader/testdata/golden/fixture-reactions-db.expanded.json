{
  "name": "fixture-reactions-db",
  "kind": "DB",
  "scalars": {
    "Generic.Int64": {
      "name": "Generic.Int64",
      "description": "Signed 64-bit integer; range bounded by JavaScript's safe-integer ceiling.",
      "languagePrimitive": "number",
      "primitive": "Int",
      "typeMappings": {
        "go": "GenericInt64",
        "json_schema": "integer",
        "python": "int",
        "rust": "i64",
        "sql": "BIGINT",
        "typescript": "number"
      },
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "hasCustomParse": true
    },
    "Generic.JSON": {
      "name": "Generic.JSON",
      "description": "Any valid JSON value: object, array, primitive, or null",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "GenericJSON",
        "json_schema": "any",
        "python": "Any",
        "rust": "serde_json::Value",
        "sql": "JSONB",
        "typescript": "JSONValue"
      },
      "hasCustomValidate": true
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "IdentityUUID",
        "json_schema": "string",
        "python": "uuid.UUID",
        "rust": "uuid::Uuid",
        "sql": "UUID",
        "typescript": "string"
      },
      "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "hasCustomParse": true
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "description": "ISO8601 datetime string. Epoch wire values keep this scalar and declare x-temporal-format (unix, unix_millis, unix_micros, unix_nanos) on the property; the unit is never guessed from digit count.",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "TemporalDateTime",
        "json_schema": "string",
        "python": "datetime.datetime",
        "rust": "chrono::DateTime\u003cchrono::Utc\u003e",
        "sql": "TIMESTAMPTZ",
        "typescript": "JSDate"
      },
      "hasCustomParse": true
    }
  },
  "types": {
    "Project": {
      "name": "Project",
      "owner": "src/projects.schema.ts",
      "comment": "A project (D103): its status is a Workflow, which its tasks move. It is\ndone once every task is done with success, and failed once one fails. The\nrules hear Task's writes through task.project, whoever makes them.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Reactions",
          "implements": true,
          "config": {
            "rules": [
              {
                "then": {
                  "transition": "done"
                },
                "when": {
                  "allTerminal": {
                    "link": "project",
                    "outcomes": [
                      "success"
                    ],
                    "schema": "Task"
                  }
                }
              },
              {
                "then": {
                  "transition": "failed"
                },
                "when": {
                  "anyTerminal": {
                    "link": "project",
                    "outcomes": [
                      "failure"
                    ],
                    "schema": "Task"
                  }
                }
              }
            ]
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "outcomes": {
              "cancelled": "neutral",
              "done": "success",
              "failed": "failure"
            },
            "states": [
              "planned",
              "active",
              "done",
              "failed",
              "cancelled"
            ],
            "transitions": [
              {
                "from": "planned",
                "to": "active"
              },
              {
                "from": "planned",
                "to": "cancelled"
              },
              {
                "from": "active",
                "to": "done"
              },
              {
                "from": "active",
                "to": "failed"
              },
              {
                "from": "active",
                "to": "cancelled"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "status",
          "description": "The state the instance is in.",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "status",
            "value": true
          }
        },
        {
          "name": "statusEnteredAt",
          "description": "When the status last changed, in epoch milliseconds: the create's time, then each transition's. Absent on an instance created before Workflow kept it, until its next transition.",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "enteredAt"
          }
        }
      ],
      "optimistic": true
    },
    "ProjectChange": {
      "name": "ProjectChange",
      "owner": "src/projects.schema.ts",
      "comment": "The writes of Project's rows its behaviors hear, one message per write, whoever makes it, which a trigger of the table writes and a behavior worker runs (D103).",
      "role": "EmbeddedStruct",
      "fields": [
        {
          "name": "rowKey",
          "description": "The key of the Project row written.",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "write",
          "description": "What the write did: insert, update or delete.",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "at",
          "description": "When the write was made, in epoch milliseconds, by the database's clock.",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        },
        {
          "name": "before",
          "description": "The row's columns before the write, by column, as JSON; null for an insert.",
          "typeRef": {
            "name": "Generic.JSON"
          }
        },
        {
          "name": "after",
          "description": "The row's columns after the write, by column, as JSON; null for a delete.",
          "typeRef": {
            "name": "Generic.JSON"
          }
        }
      ],
      "origin": "behavior",
      "behaviorQueue": {
        "row": "Project",
        "kind": "changes",
        "behaviors": [
          "Reactions"
        ]
      },
      "queue": {
        "retain": "0s",
        "key": "rowKey",
        "serialize": true
      }
    },
    "Task": {
      "name": "Task",
      "owner": "src/projects.schema.ts",
      "comment": "A task of a project (D103): a task that starts moves its project to\nactive, and one marked urgent starts.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Reactions",
          "implements": true,
          "config": {
            "rules": [
              {
                "then": {
                  "link": "project",
                  "transition": "active"
                },
                "when": {
                  "enters": "doing"
                }
              },
              {
                "then": {
                  "transition": "doing"
                },
                "when": {
                  "changes": {
                    "field": "priority",
                    "to": "urgent"
                  }
                }
              }
            ]
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "outcomes": {
              "done": "success",
              "dropped": "neutral",
              "failed": "failure"
            },
            "states": [
              "todo",
              "doing",
              "done",
              "failed",
              "dropped"
            ],
            "transitions": [
              {
                "from": "todo",
                "to": "doing"
              },
              {
                "from": "todo",
                "to": "dropped"
              },
              {
                "from": "doing",
                "to": "done"
              },
              {
                "from": "doing",
                "to": "failed"
              },
              {
                "from": "doing",
                "to": "dropped"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "priority",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "project",
          "typeRef": {
            "name": "Project"
          },
          "required": true,
          "relation": {
            "type": "Project"
          }
        },
        {
          "name": "status",
          "description": "The state the instance is in.",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "status",
            "value": true
          }
        },
        {
          "name": "statusEnteredAt",
          "description": "When the status last changed, in epoch milliseconds: the create's time, then each transition's. Absent on an instance created before Workflow kept it, until its next transition.",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "enteredAt"
          }
        }
      ],
      "optimistic": true
    },
    "TaskChange": {
      "name": "TaskChange",
      "owner": "src/projects.schema.ts",
      "comment": "The writes of Task's rows its behaviors hear, one message per write, whoever makes it, which a trigger of the table writes and a behavior worker runs (D103).",
      "role": "EmbeddedStruct",
      "fields": [
        {
          "name": "rowKey",
          "description": "The key of the Task row written.",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "write",
          "description": "What the write did: insert, update or delete.",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "at",
          "description": "When the write was made, in epoch milliseconds, by the database's clock.",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        },
        {
          "name": "before",
          "description": "The row's columns before the write, by column, as JSON; null for an insert.",
          "typeRef": {
            "name": "Generic.JSON"
          }
        },
        {
          "name": "after",
          "description": "The row's columns after the write, by column, as JSON; null for a delete.",
          "typeRef": {
            "name": "Generic.JSON"
          }
        }
      ],
      "origin": "behavior",
      "behaviorQueue": {
        "row": "Task",
        "kind": "changes",
        "behaviors": [
          "Reactions"
        ],
        "heardBy": [
          "Project"
        ]
      },
      "queue": {
        "retain": "0s",
        "key": "rowKey",
        "serialize": true
      }
    }
  }
}
