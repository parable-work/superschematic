{
  "name": "fixture-steps-db",
  "kind": "DB",
  "scalars": {
    "Generic.Int64": {
      "name": "Generic.Int64",
      "description": "Signed 64-bit integer; range bounded by JavaScript's safe-integer ceiling.",
      "languagePrimitive": "number",
      "primitive": "Int",
      "typeMappings": {
        "go": "GenericInt64",
        "json_schema": "integer",
        "python": "int",
        "rust": "i64",
        "sql": "BIGINT",
        "typescript": "number"
      },
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "hasCustomParse": true
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "IdentityUUID",
        "json_schema": "string",
        "python": "uuid.UUID",
        "rust": "uuid::Uuid",
        "sql": "UUID",
        "typescript": "string"
      },
      "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "hasCustomParse": true
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "description": "ISO8601 datetime string. Epoch wire values keep this scalar and declare x-temporal-format (unix, unix_millis, unix_micros, unix_nanos) on the property; the unit is never guessed from digit count.",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "TemporalDateTime",
        "json_schema": "string",
        "python": "datetime.datetime",
        "rust": "chrono::DateTime\u003cchrono::Utc\u003e",
        "sql": "TIMESTAMPTZ",
        "typescript": "JSDate"
      },
      "hasCustomParse": true
    }
  },
  "types": {
    "Batch": {
      "name": "Batch",
      "owner": "src/steps.schema.ts",
      "comment": "A batch of steps (D104's step 4): running until every step is done, which\nits rollup done gates, or failed. It counts its steps, counts them by\nstatus and sums their estimates, each computed at a read of the batch\nfrom the steps that point at it, the rows its steps field lists.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Rollups",
          "implements": true,
          "config": {
            "rollups": {
              "anyFailed": {
                "function": "any",
                "link": "batch",
                "outcomes": [
                  "failure"
                ],
                "schema": "Step"
              },
              "byStatus": {
                "field": "status",
                "function": "countBy",
                "link": "batch",
                "schema": "Step"
              },
              "done": {
                "function": "all",
                "gatedStates": [
                  "done"
                ],
                "link": "batch",
                "outcomes": [
                  "success"
                ],
                "schema": "Step"
              },
              "estimate": {
                "field": "estimate",
                "function": "sum",
                "link": "batch",
                "schema": "Step"
              },
              "steps": {
                "function": "count",
                "link": "batch",
                "schema": "Step"
              }
            }
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "outcomes": {
              "failed": "failure"
            },
            "states": [
              "running",
              "done",
              "failed"
            ],
            "transitions": [
              {
                "from": "running",
                "to": "done"
              },
              {
                "from": "running",
                "to": "failed"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "steps",
          "typeRef": {
            "name": "Step",
            "isArray": true
          },
          "required": true,
          "hasMany": true
        },
        {
          "name": "status",
          "description": "The state the instance is in.",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "status",
            "value": true
          }
        },
        {
          "name": "statusEnteredAt",
          "description": "When the status last changed, in epoch milliseconds: the create's time, then each transition's. Absent on an instance created before Workflow kept it, until its next transition.",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "enteredAt"
          }
        }
      ],
      "optimistic": true
    },
    "Step": {
      "name": "Step",
      "owner": "src/steps.schema.ts",
      "comment": "One step of a batch (D104's step 4): blocked by the steps it comes after,\nwhich hold up its start and its finish until each is done, a step that\nfailed blocking until it is removed.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Dependencies",
          "implements": true,
          "config": {
            "gatedStates": [
              "doing",
              "done"
            ]
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "outcomes": {
              "failed": "failure"
            },
            "states": [
              "todo",
              "doing",
              "done",
              "failed"
            ],
            "transitions": [
              {
                "from": "todo",
                "to": "doing"
              },
              {
                "from": "doing",
                "to": "done"
              },
              {
                "from": "doing",
                "to": "failed"
              },
              {
                "from": "todo",
                "to": "failed"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "estimate",
          "typeRef": {
            "name": "Generic.Int64"
          }
        },
        {
          "name": "batch",
          "typeRef": {
            "name": "Batch"
          },
          "required": true,
          "relation": {
            "type": "Batch"
          }
        },
        {
          "name": "status",
          "description": "The state the instance is in.",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "status",
            "value": true
          }
        },
        {
          "name": "statusEnteredAt",
          "description": "When the status last changed, in epoch milliseconds: the create's time, then each transition's. Absent on an instance created before Workflow kept it, until its next transition.",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "enteredAt"
          }
        }
      ],
      "optimistic": true
    },
    "StepDependenciesBlockers": {
      "name": "StepDependenciesBlockers",
      "owner": "src/steps.schema.ts",
      "comment": "On a table, one row per blocker of the row, keyed by its number on the row, the order they were added in: the blocker's table and key, and who added it when. removeBlocker deletes its row, and the row's delete deletes them all.",
      "role": "DBTable",
      "fields": [
        {
          "name": "step",
          "description": "The Step row the rows are of; deleting it deletes them.",
          "typeRef": {
            "name": "Step"
          },
          "required": true,
          "relation": {
            "type": "Step",
            "onDelete": "CASCADE"
          }
        },
        {
          "name": "number",
          "description": "The edge's number on the row, one past the greatest when it was added, in ten digits zero-padded so the key's order is theirs.",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "blockerType",
          "description": "The blocker's table.",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "blockerKey",
          "description": "The blocker's key, a hyphenated UUID kept in base62.",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "addedBy",
          "description": "The subject of the caller that added it, a hyphenated UUID kept in base62; absent for a caller with none.",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "addedAt",
          "description": "When it was added, in epoch milliseconds.",
          "typeRef": {
            "name": "Temporal.DateTime"
          }
        }
      ],
      "indexes": [
        {
          "keys": [
            "step",
            "number"
          ],
          "unique": true,
          "origin": "behavior"
        }
      ],
      "origin": "behavior",
      "behaviorTable": {
        "row": "Step",
        "use": "Dependencies",
        "behavior": "Dependencies",
        "table": "blockers",
        "key": "number",
        "rowField": "step"
      }
    }
  }
}
