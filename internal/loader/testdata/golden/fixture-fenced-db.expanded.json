{
  "name": "fixture-fenced-db",
  "kind": "DB",
  "scalars": {
    "Generic.Int64": {
      "name": "Generic.Int64",
      "description": "Signed 64-bit integer; range bounded by JavaScript's safe-integer ceiling.",
      "languagePrimitive": "number",
      "primitive": "Int",
      "typeMappings": {
        "go": "GenericInt64",
        "json_schema": "integer",
        "python": "int",
        "rust": "i64",
        "sql": "BIGINT",
        "typescript": "number"
      },
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "hasCustomParse": true
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "IdentityUUID",
        "json_schema": "string",
        "python": "uuid.UUID",
        "rust": "uuid::Uuid",
        "sql": "UUID",
        "typescript": "string"
      },
      "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "hasCustomParse": true
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "description": "ISO8601 datetime string. Epoch wire values keep this scalar and declare x-temporal-format (unix, unix_millis, unix_micros, unix_nanos) on the property; the unit is never guessed from digit count.",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "TemporalDateTime",
        "json_schema": "string",
        "python": "datetime.datetime",
        "rust": "chrono::DateTime\u003cchrono::Utc\u003e",
        "sql": "TIMESTAMPTZ",
        "typescript": "JSDate"
      },
      "hasCustomParse": true
    }
  },
  "types": {
    "Courier": {
      "name": "Courier",
      "owner": "src/dispatch.schema.ts",
      "comment": "Who carries a delivery. It has no fence: a write of it advances nothing.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "string"
          },
          "required": true
        }
      ]
    },
    "Delivery": {
      "name": "Delivery",
      "owner": "src/dispatch.schema.ts",
      "comment": "A delivery two parties write, neither waiting on the other. The planner\nwrites the address and the courier, a relation, covered as the key it\nstores, and advances planVersion; the courier's device writes attempts\nand proof, and advances runVersion. A write of one party's fields leaves\nthe other's counter as it was, so neither fails the other's compare.\nNo fence covers note or updatedAt: a write of them alone advances\nneither counter. The courier is nullable, set and cleared by the\nplanner's writes alone: its delete action is RESTRICT, so a courier a\ndelivery names is not deleted. A SET NULL would have the database clear\nthe column itself, an update that advances no fence, and the build\nrefuses a fence that covers such a relation.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "address",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "courier",
          "typeRef": {
            "name": "Courier"
          },
          "relation": {
            "type": "Courier",
            "onDelete": "RESTRICT"
          }
        },
        {
          "name": "planVersion",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true,
          "default": "0"
        },
        {
          "name": "attempts",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true,
          "default": "0"
        },
        {
          "name": "proof",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "runVersion",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true,
          "default": "0"
        },
        {
          "name": "note",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "updatedAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "required": true
        }
      ],
      "fences": [
        {
          "field": "planVersion",
          "covers": [
            "address",
            "courier"
          ]
        },
        {
          "field": "runVersion",
          "covers": [
            "attempts",
            "proof"
          ]
        }
      ]
    },
    "Depot": {
      "name": "Depot",
      "owner": "src/dispatch.schema.ts",
      "comment": "A depot parcels wait in. A delete sets deletedAt, which the fence\ncovers, so the delete advances revision as a rename does; a write of\ncapacity alone does not.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "capacity",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        },
        {
          "name": "revision",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true,
          "default": "0"
        },
        {
          "name": "deletedAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          }
        }
      ],
      "fences": [
        {
          "field": "revision",
          "covers": [
            "name",
            "deletedAt"
          ]
        }
      ]
    },
    "Parcel": {
      "name": "Parcel",
      "owner": "src/dispatch.schema.ts",
      "comment": "A parcel at the desk. Its one fence lists no covers, so every update of\na row advances version by one, whatever it writes: a writer that read\nversion 4 writes where version is 4, and knows no other write came\nbetween. An upsert by trackingCode updates a row the same way.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "trackingCode",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "unique": true
        },
        {
          "name": "weightGrams",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true
        },
        {
          "name": "note",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "version",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true,
          "default": "0"
        }
      ],
      "fences": [
        {
          "field": "version"
        }
      ]
    }
  }
}
