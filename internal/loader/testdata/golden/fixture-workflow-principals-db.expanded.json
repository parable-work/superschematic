{
  "name": "fixture-workflow-principals-db",
  "kind": "DB",
  "scalars": {
    "Identity.UUID": {
      "name": "Identity.UUID",
      "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "IdentityUUID",
        "json_schema": "string",
        "python": "uuid.UUID",
        "rust": "uuid::Uuid",
        "sql": "UUID",
        "typescript": "string"
      },
      "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "hasCustomParse": true
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "description": "ISO8601 datetime string. Epoch wire values keep this scalar and declare x-temporal-format (unix, unix_millis, unix_micros, unix_nanos) on the property; the unit is never guessed from digit count.",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "TemporalDateTime",
        "json_schema": "string",
        "python": "datetime.datetime",
        "rust": "chrono::DateTime\u003cchrono::Utc\u003e",
        "sql": "TIMESTAMPTZ",
        "typescript": "JSDate"
      },
      "hasCustomParse": true
    }
  },
  "types": {
    "Question": {
      "name": "Question",
      "owner": "src/questions.schema.ts",
      "comment": "A question one person asks another (D104). Only the person it is asked of\nanswers it, only its asker withdraws it, and closing an answered one needs\nquestions.close beside being one of the two; a caller who holds\nquestions.moderate makes any of these moves for them, the move's own\npermission still needed. Answering again changes nothing, so a caller\nwhose answer was lost may retry.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "overridePermission": "questions.moderate",
            "repeat": "unchanged",
            "states": [
              "open",
              "answered",
              "withdrawn",
              "closed"
            ],
            "transitions": [
              {
                "by": [
                  "askedOf"
                ],
                "from": "open",
                "to": "answered"
              },
              {
                "by": [
                  "createdBy"
                ],
                "from": "open",
                "to": "withdrawn"
              },
              {
                "by": [
                  "askedOf",
                  "createdBy"
                ],
                "from": "answered",
                "permission": "questions.close",
                "to": "closed"
              },
              {
                "from": "answered",
                "to": "open"
              }
            ]
          }
        },
        {
          "name": "Workflow",
          "field": "review",
          "config": {
            "states": [
              "pending",
              "reviewed"
            ],
            "transitions": [
              {
                "from": "pending",
                "to": "reviewed"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "prompt",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "askedOf",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "createdBy",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true
        },
        {
          "name": "status",
          "description": "The state the instance is in.",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "status",
            "value": true
          }
        },
        {
          "name": "statusEnteredAt",
          "description": "When the status last changed, in epoch milliseconds: the create's time, then each transition's. Absent on an instance created before Workflow kept it, until its next transition.",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "enteredAt"
          }
        },
        {
          "name": "review",
          "description": "The state the instance is in.",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "behavior": {
            "use": "review",
            "behavior": "Workflow",
            "field": "status",
            "value": true
          }
        },
        {
          "name": "reviewEnteredAt",
          "description": "When the status last changed, in epoch milliseconds: the create's time, then each transition's. Absent on an instance created before Workflow kept it, until its next transition.",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "behavior": {
            "use": "review",
            "behavior": "Workflow",
            "field": "enteredAt"
          }
        }
      ],
      "optimistic": true
    }
  }
}
