{
  "name": "fixture-blueprint-db",
  "kind": "DB",
  "scalars": {
    "Identity.UUID": {
      "name": "Identity.UUID",
      "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "IdentityUUID",
        "json_schema": "string",
        "python": "uuid.UUID",
        "rust": "uuid::Uuid",
        "sql": "UUID",
        "typescript": "string"
      },
      "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "hasCustomParse": true
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "description": "ISO8601 datetime string. Epoch wire values keep this scalar and declare x-temporal-format (unix, unix_millis, unix_micros, unix_nanos) on the property; the unit is never guessed from digit count.",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "TemporalDateTime",
        "json_schema": "string",
        "python": "datetime.datetime",
        "rust": "chrono::DateTime\u003cchrono::Utc\u003e",
        "sql": "TIMESTAMPTZ",
        "typescript": "JSDate"
      },
      "hasCustomParse": true
    }
  },
  "types": {
    "Batch": {
      "name": "Batch",
      "owner": "src/batches.schema.ts",
      "comment": "A batch of jobs (D149): its create stamps a job per step of its template,\neach blocked by the jobs of the steps it comes after, and audit only for\na batch whose flags include audit, its report then waiting on index.\nEvery job copies the batch's topic. The batch holds no state of the\nstamp: a read lists its children, the jobs that point at it.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Blueprint",
          "implements": true,
          "config": {
            "copyFields": [
              "topic"
            ],
            "keyField": "step",
            "parentLink": "batch",
            "schema": "Job",
            "steps": {
              "audit": {
                "after": [
                  "index"
                ],
                "data": {
                  "title": "Audit the index"
                },
                "when": {
                  "field": "flags",
                  "includes": "audit"
                }
              },
              "fetch": {
                "data": {
                  "title": "Fetch the sources"
                }
              },
              "index": {
                "after": [
                  "fetch"
                ],
                "data": {
                  "title": "Index what was fetched"
                }
              },
              "report": {
                "after": [
                  "audit"
                ],
                "data": {
                  "title": "Report what was indexed"
                }
              }
            }
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "outcomes": {
              "failed": "failure"
            },
            "states": [
              "running",
              "done",
              "failed"
            ],
            "transitions": [
              {
                "from": "running",
                "to": "done"
              },
              {
                "from": "running",
                "to": "failed"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "topic",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "flags",
          "typeRef": {
            "name": "string",
            "isArray": true
          }
        },
        {
          "name": "jobs",
          "typeRef": {
            "name": "Job",
            "isArray": true
          },
          "required": true,
          "hasMany": true
        },
        {
          "name": "status",
          "description": "The state the instance is in.",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "status",
            "value": true
          }
        },
        {
          "name": "statusEnteredAt",
          "description": "When the status last changed, in epoch milliseconds: the create's time, then each transition's. Absent on an instance created before Workflow kept it, until its next transition.",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "enteredAt"
          }
        }
      ],
      "optimistic": true
    },
    "Job": {
      "name": "Job",
      "owner": "src/batches.schema.ts",
      "comment": "One job of a batch (D149): the step it was stamped as and its topic stay\nas the stamp set them, and it waits to run, and to finish, until the\njobs of the steps before it are done.",
      "role": "DBTable",
      "behaviors": [
        {
          "name": "Constants",
          "implements": true,
          "config": {
            "fields": [
              "step",
              "topic"
            ]
          }
        },
        {
          "name": "Dependencies",
          "implements": true,
          "config": {
            "gatedStates": [
              "running",
              "done"
            ]
          }
        },
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "outcomes": {
              "failed": "failure"
            },
            "states": [
              "queued",
              "running",
              "done",
              "failed"
            ],
            "transitions": [
              {
                "from": "queued",
                "to": "running"
              },
              {
                "from": "running",
                "to": "done"
              },
              {
                "from": "running",
                "to": "failed"
              },
              {
                "from": "queued",
                "to": "failed"
              }
            ]
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "step",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "topic",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "batch",
          "typeRef": {
            "name": "Batch"
          },
          "required": true,
          "relation": {
            "type": "Batch"
          }
        },
        {
          "name": "status",
          "description": "The state the instance is in.",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "status",
            "value": true
          }
        },
        {
          "name": "statusEnteredAt",
          "description": "When the status last changed, in epoch milliseconds: the create's time, then each transition's. Absent on an instance created before Workflow kept it, until its next transition.",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "behavior": {
            "use": "status",
            "behavior": "Workflow",
            "field": "enteredAt"
          }
        }
      ],
      "optimistic": true
    },
    "JobDependenciesBlockers": {
      "name": "JobDependenciesBlockers",
      "owner": "src/batches.schema.ts",
      "comment": "On a table, one row per blocker of the row, keyed by its number on the row, the order they were added in: the blocker's table and key, and who added it when. removeBlocker deletes its row, and the row's delete deletes them all.",
      "role": "DBTable",
      "fields": [
        {
          "name": "job",
          "description": "The Job row the rows are of; deleting it deletes them.",
          "typeRef": {
            "name": "Job"
          },
          "required": true,
          "relation": {
            "type": "Job",
            "onDelete": "CASCADE"
          }
        },
        {
          "name": "number",
          "description": "The edge's number on the row, one past the greatest when it was added, in ten digits zero-padded so the key's order is theirs.",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "blockerType",
          "description": "The blocker's table.",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "blockerKey",
          "description": "The blocker's key, a hyphenated UUID kept in base62.",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "addedBy",
          "description": "The subject of the caller that added it, a hyphenated UUID kept in base62; absent for a caller with none.",
          "typeRef": {
            "name": "string"
          }
        },
        {
          "name": "addedAt",
          "description": "When it was added, in epoch milliseconds.",
          "typeRef": {
            "name": "Temporal.DateTime"
          }
        }
      ],
      "indexes": [
        {
          "keys": [
            "job",
            "number"
          ],
          "unique": true,
          "origin": "behavior"
        }
      ],
      "origin": "behavior",
      "behaviorTable": {
        "row": "Job",
        "use": "Dependencies",
        "behavior": "Dependencies",
        "table": "blockers",
        "key": "number",
        "rowField": "job"
      }
    }
  }
}
