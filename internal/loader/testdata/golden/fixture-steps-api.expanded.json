            "key": "id",
            "use": "Dependencies",
            "behavior": "Dependencies",
            "operation": "removeBlocker",
            "writes": true
          },
          "httpMethod": "POST",
          "restPath": "step/{id}/dependencies/remove-blocker",
          "origin": "behavior"
        },
        {
          "name": "dependenciesListBlockers",
          "comment": "Lists the instance's blockers in the order they were added, one page at a time, with each one's status and whether it blocks.",
          "docs": {
            "title": "Step dependencies: list blockers",
            "description": "Lists the instance's blockers in the order they were added, one page at a time, with each one's status and whether it blocks.",
            "capability": "step.dependencies.list-blockers",
