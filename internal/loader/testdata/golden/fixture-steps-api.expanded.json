{
  "name": "fixture-steps-api",
  "kind": "API",
  "imports": [
    {
      "package": "@schemas/fixture-steps-db",
      "types": [
        "Batch",
        "Step"
      ]
    }
  ],
  "dependencies": [
    {
      "name": "fixture-steps-db",
      "kind": "DB"
    }
  ],
  "scalars": {
    "Generic.Int64": {
      "name": "Generic.Int64",
      "description": "Signed 64-bit integer; range bounded by JavaScript's safe-integer ceiling.",
      "languagePrimitive": "number",
      "primitive": "Int",
      "typeMappings": {
        "go": "GenericInt64",
        "json_schema": "integer",
        "python": "int",
        "rust": "i64",
        "sql": "BIGINT",
        "typescript": "number"
      },
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "hasCustomParse": true
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "IdentityUUID",
        "json_schema": "string",
        "python": "uuid.UUID",
        "rust": "uuid::Uuid",
        "sql": "UUID",
        "typescript": "string"
      },
      "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "hasCustomParse": true
    }
  },
  "types": {
    "BatchStatusTransitionInput": {
      "name": "BatchStatusTransitionInput",
      "owner": "fixture-steps-api",
      "comment": "The parameters of Batch's status transition.",
      "role": "APIInput",
      "fields": [
        {
          "name": "from",
          "comment": "The state the caller read the instance in. An instance in another state refuses the move as the veto stale, before anything else is checked, so a retry that finds its move made is stale with the state it moved to. A table's alone: an engine type refuses it.",
          "typeRef": {
            "name": "BatchStatusState"
          },
          "origin": "behavior"
        },
        {
          "name": "to",
          "comment": "The state to move to.",
          "typeRef": {
            "name": "BatchStatusState"
          },
          "required": true,
          "origin": "behavior"
        }
      ],
      "origin": "behavior"
    },
    "BatchStatusTransitionResult": {
      "name": "BatchStatusTransitionResult",
      "owner": "fixture-steps-api",
      "comment": "What Batch's status transition returns.",
      "role": "EmbeddedStruct",
      "fields": [
        {
          "name": "from",
          "comment": "The state the instance was in.",
          "typeRef": {
            "name": "BatchStatusState"
          },
          "required": true,
          "origin": "behavior"
        },
        {
          "name": "to",
          "comment": "The state it is in now.",
          "typeRef": {
            "name": "BatchStatusState"
          },
          "required": true,
          "origin": "behavior"
        },
        {
          "name": "unchanged",
          "comment": "True when the instance was already in to and the config's repeat is unchanged, so nothing was written; absent otherwise.",
          "typeRef": {
            "name": "boolean"
          },
          "origin": "behavior"
        }
      ],
      "origin": "behavior"
    },
    "StepDependenciesAddBlockerInput": {
      "name": "StepDependenciesAddBlockerInput",
      "owner": "fixture-steps-api",
      "comment": "The parameters of Step's dependencies addBlocker.",
      "role": "APIInput",
      "fields": [
        {
          "name": "id",
          "comment": "The blocker's id.",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "validatePattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
          "origin": "behavior"
        },
        {
          "name": "schema",
          "comment": "The blocker's schema; Step when absent.",
          "typeRef": {
            "name": "StepDependenciesAddBlockerInputSchema"
          },
          "origin": "behavior"
        }
      ],
      "origin": "behavior"
    },
    "StepDependenciesAddBlockerResult": {
      "name": "StepDependenciesAddBlockerResult",
      "owner": "fixture-steps-api",
      "comment": "What Step's dependencies addBlocker returns.",
      "role": "EmbeddedStruct",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "origin": "behavior"
        },
        {
          "name": "open",
          "comment": "Whether it is not finished, so it blocks: its status is not a terminal state of its schema's Workflow whose outcome the config accepts.",
          "typeRef": {
            "name": "boolean"
          },
          "required": true,
          "origin": "behavior"
        },
        {
          "name": "schema",
          "typeRef": {
            "name": "StepDependenciesAddBlockerResultSchema"
          },
          "required": true,
          "origin": "behavior"
        },
        {
          "name": "status",
          "comment": "The blocker's Workflow status.",
          "typeRef": {
            "name": "string"
          },
          "origin": "behavior"
        }
      ],
      "origin": "behavior"
    },
    "StepDependenciesListBlockersInput": {
      "name": "StepDependenciesListBlockersInput",
      "owner": "fixture-steps-api",
      "comment": "The parameters of Step's dependencies listBlockers.",
      "role": "APIInput",
      "fields": [
        {
          "name": "cursor",
          "comment": "The next of the previous page.",
          "typeRef": {
            "name": "string"
          },
          "origin": "behavior"
        },
        {
          "name": "limit",
          "comment": "At most this many blockers; 50 when absent.",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "validateMin": 1,
          "validateMax": 500,
          "origin": "behavior"
        }
      ],
      "origin": "behavior"
    },
    "StepDependenciesListBlockersResult": {
      "name": "StepDependenciesListBlockersResult",
      "owner": "fixture-steps-api",
      "comment": "What Step's dependencies listBlockers returns.",
      "role": "EmbeddedStruct",
      "fields": [
        {
          "name": "items",
          "typeRef": {
            "name": "StepDependenciesListBlockersResultItems",
            "isArray": true
          },
          "required": true,
          "origin": "behavior"
        },
        {
          "name": "next",
          "comment": "The cursor of the next page; null after the last.",
