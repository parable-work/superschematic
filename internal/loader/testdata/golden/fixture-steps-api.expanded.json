  "operationSets": [
    {
      "name": "BatchActions",
      "comment": "A batch's Workflow, for any signed-in caller: a move to done waits for\nevery step to be done (D104's step 4).",
      "operations": [
        {
          "name": "statusTransition",
          "comment": "Moves the instance to another state along a transition the config lists. A transition that names a permission needs a caller who holds it.",
          "docs": {
            "title": "Batch status: transition",
            "description": "Moves the instance to another state along a transition the config lists. A transition that names a permission needs a caller who holds it.",
            "capability": "batch.status.transition",
            "lifecycle": "active",
            "visibility": "public",
            "mappingStatus": "mapped"
          },
          "mcp": {
            "handle": "batch_status_transition",
            "hidden": false,
            "invocationPolicy": "auto"
          },
          "typeRef": {
            "name": "BatchStatusTransitionResult"
          },
          "required": true,
          "arguments": [
            {
              "name": "id",
              "comment": "The key of the Batch row the operation runs on.",
              "typeRef": {
                "name": "Identity.UUID"
              },
              "required": true
            },
            {
              "name": "input",
              "typeRef": {
                "name": "BatchStatusTransitionInput"
              },
              "required": true
            }
          ],
          "auth": true,
          "behaviorOperation": {
            "database": "fixture-steps-db",
            "type": "Batch",
            "key": "id",
            "use": "status",
            "behavior": "Workflow",
            "operation": "transition",
            "writes": true
          },
          "httpMethod": "POST",
          "restPath": "batch/{id}/status/transition",
          "origin": "behavior"
        }
      ],
      "behaviorOperations": {
        "type": "Batch"
      },
      "auth": true
    },
    {
      "name": "StepActions",
      "comment": "A step's Workflow and its blockers, for any signed-in caller: addBlocker,\nremoveBlocker and listBlockers; listDependents is the engine's alone, and\nthe set leaves it out (D104's step 4).",
      "operations": [
        {
          "name": "dependenciesAddBlocker",
          "comment": "Makes another instance block this one. It must be of the type's own schema or one the config lists, exist, and not be blocked by this instance, directly or through others. An instance in a gated state that is terminal takes no blocker that is not finished.",
          "docs": {
            "title": "Step dependencies: add blocker",
            "description": "Makes another instance block this one. It must be of the type's own schema or one the config lists, exist, and not be blocked by this instance, directly or through others. An instance in a gated state that is terminal takes no blocker that is not finished.",
            "capability": "step.dependencies.add-blocker",
            "lifecycle": "active",
            "visibility": "public",
            "mappingStatus": "mapped"
          },
          "mcp": {
            "handle": "step_dependencies_add_blocker",
            "hidden": false,
            "invocationPolicy": "auto"
          },
          "typeRef": {
            "name": "StepDependenciesAddBlockerResult"
          },
          "required": true,
          "arguments": [
            {
              "name": "id",
              "comment": "The key of the Step row the operation runs on.",
              "typeRef": {
                "name": "Identity.UUID"
              },
              "required": true
            },
            {
              "name": "input",
              "typeRef": {
                "name": "StepDependenciesAddBlockerInput"
              },
              "required": true
            }
          ],
          "auth": true,
          "behaviorOperation": {
            "database": "fixture-steps-db",
            "type": "Step",
            "key": "id",
            "use": "Dependencies",
            "behavior": "Dependencies",
            "operation": "addBlocker",
            "writes": true
          },
          "httpMethod": "POST",
          "restPath": "step/{id}/dependencies/add-blocker",
          "origin": "behavior"
        },
        {
          "name": "dependenciesRemoveBlocker",
          "comment": "Stops another instance from blocking this one.",
          "docs": {
            "title": "Step dependencies: remove blocker",
            "description": "Stops another instance from blocking this one.",
            "capability": "step.dependencies.remove-blocker",
            "lifecycle": "active",
