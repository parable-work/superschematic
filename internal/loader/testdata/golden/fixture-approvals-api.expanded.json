        {
          "name": "Planned",
          "serializedAs": "planned"
        },
        {
          "name": "Working",
          "serializedAs": "working"
        },
        {
          "name": "Proving",
          "serializedAs": "proving"
        },
        {
          "name": "Done",
          "serializedAs": "done"
        },
        {
          "name": "Cancelled",
          "serializedAs": "cancelled"
        }
      ],
      "origin": "behavior"
    }
  },
  "operationSets": [
    {
      "name": "TaskActions",
      "comment": "A task's status and approvals operations (D104), for any signed-in\ncaller: the core decides who may move a task, sign it off and change what\nits state freezes.",
      "operations": [
        {
          "name": "approvalsSignOff",
          "comment": "Signs off on the instance for a gated state, as the caller. Needs the gate's permission; refused for the instance's creator unless the gate allows it, while the instance is in the state, and for a caller whose sign-off for the state is not yet consumed.",
          "docs": {
            "title": "Task approvals: sign off",
            "description": "Signs off on the instance for a gated state, as the caller. Needs the gate's permission; refused for the instance's creator unless the gate allows it, while the instance is in the state, and for a caller whose sign-off for the state is not yet consumed.",
            "capability": "task.approvals.sign-off",
            "lifecycle": "active",
            "visibility": "public",
            "mappingStatus": "mapped"
          },
          "mcp": {
            "handle": "task_approvals_sign_off",
            "hidden": false,
            "invocationPolicy": "auto"
          },
          "typeRef": {
            "name": "TaskApprovalsSignOffResult"
          },
          "required": true,
          "arguments": [
            {
              "name": "id",
              "comment": "The key of the Task row the operation runs on.",
              "typeRef": {
                "name": "Identity.UUID"
              },
              "required": true
            },
            {
              "name": "input",
              "typeRef": {
                "name": "TaskApprovalsSignOffInput"
              },
              "required": true
            }
          ],
          "auth": true,
          "behaviorOperation": {
            "database": "fixture-approvals-db",
            "type": "Task",
            "key": "id",
            "use": "Approvals",
            "behavior": "Approvals",
            "operation": "signOff",
            "writes": true,
            "permissions": [
              "tasks.review"
            ]
          },
          "httpMethod": "POST",
          "restPath": "task/{id}/approvals/sign-off",
          "origin": "behavior"
        },
        {
          "name": "approvalsWithdrawSignOff",
          "comment": "Withdraws the caller's sign-off for a gated state, one not yet consumed.",
          "docs": {
            "title": "Task approvals: withdraw sign off",
