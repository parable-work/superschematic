              "required": true
            },
            {
              "name": "input",
              "typeRef": {
                "name": "TaskApprovalsWithdrawSignOffInput"
              },
              "required": true
            }
          ],
          "auth": true,
          "behaviorOperation": {
            "database": "fixture-approvals-db",
            "type": "Task",
            "key": "id",
            "use": "Approvals",
            "behavior": "Approvals",
            "operation": "withdrawSignOff",
            "writes": true,
            "permissions": [
              "tasks.review"
            ]
          },
          "httpMethod": "POST",
          "restPath": "task/{id}/approvals/withdraw-sign-off",
          "origin": "behavior"
        },
        {
          "name": "approvalsListSignOffs",
          "comment": "Lists the instance's sign-offs, oldest first, one page at a time, the consumed ones included; with state, only those for it.",
          "docs": {
            "title": "Task approvals: list sign offs",
            "description": "Lists the instance's sign-offs, oldest first, one page at a time, the consumed ones included; with state, only those for it.",
            "capability": "task.approvals.list-sign-offs",
            "lifecycle": "active",
