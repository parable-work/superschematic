{
  "name": "fixture-state-machine-db",
  "kind": "DB",
  "imports": [
    {
      "package": "@schemas/fixture-state-machine-enums",
      "types": [
        "AccountStatus"
      ]
    }
  ],
  "dependencies": [
    {
      "name": "fixture-state-machine-enums",
      "kind": "General"
    }
  ],
  "scalars": {
    "Identity.UUID": {
      "name": "Identity.UUID",
      "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "IdentityUUID",
        "json_schema": "string",
        "python": "uuid.UUID",
        "rust": "uuid::Uuid",
        "sql": "UUID",
        "typescript": "string"
      },
      "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "hasCustomParse": true
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "description": "ISO8601 datetime string. Epoch wire values keep this scalar and declare x-temporal-format (unix, unix_millis, unix_micros, unix_nanos) on the property; the unit is never guessed from digit count.",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "TemporalDateTime",
        "json_schema": "string",
        "python": "datetime.datetime",
        "rust": "chrono::DateTime\u003cchrono::Utc\u003e",
        "sql": "TIMESTAMPTZ",
        "typescript": "JSDate"
      },
      "hasCustomParse": true
    }
  },
  "types": {
    "SignOff": {
      "name": "SignOff",
      "owner": "src/ticket.schema.ts",
      "comment": "The sign-off a ticket's refund carries, kept as JSON. It is no table, so\nthe database guards nothing of it, and the types still say which step\nfollows which.",
      "role": "DBTable",
      "fields": [
        {
          "name": "step",
          "typeRef": {
            "name": "SignOffStep"
          },
          "required": true,
          "default": "requested"
        },
        {
          "name": "note",
          "typeRef": {
            "name": "string"
          }
        }
      ],
      "jsonField": true,
      "stateMachines": [
        {
          "field": "step",
          "transitions": [
            {
              "from": "requested",
              "to": [
                "granted",
                "refused"
              ]
            }
          ],
          "terminal": [
            "granted",
            "refused"
          ]
        }
      ]
    },
    "Ticket": {
      "name": "Ticket",
      "owner": "src/ticket.schema.ts",
      "comment": "A support ticket. Its state starts open, may be reopened until it is\nclosed, and lists a move from open to open, which is no move. Its review\nis null until a pass reviews the answer, and a retry clears it for the\nnext pass. Its escalation is null until it is raised, and once\nacknowledged only returns to null. Its account's status is an enum of\nanother service.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "subject",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "state",
          "typeRef": {
            "name": "TicketState"
          },
          "required": true,
          "default": "open"
        },
        {
          "name": "review",
          "typeRef": {
            "name": "ReviewOutcome"
          }
        },
        {
          "name": "escalation",
          "typeRef": {
            "name": "Escalation"
          }
        },
        {
          "name": "accountStatus",
          "typeRef": {
            "name": "AccountStatus"
          },
          "required": true,
          "default": "active"
        },
        {
          "name": "signOff",
          "typeRef": {
            "name": "SignOff"
          }
        },
        {
          "name": "updatedAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "required": true
        }
      ],
      "stateMachines": [
        {
          "field": "state",
          "transitions": [
            {
              "from": "open",
              "to": [
                "open",
                "in_progress",
                "resolved",
                "closed"
              ]
            },
            {
              "from": "in_progress",
              "to": [
                "resolved",
                "open"
              ]
            },
            {
              "from": "resolved",
              "to": [
                "open",
                "closed"
              ]
            }
          ],
          "terminal": [
            "closed"
          ]
        },
        {
          "field": "review",
          "transitions": [
            {
              "from": "RETRY",
              "to": [
                "APPROVED",
                "REJECTED"
              ],
              "toNull": true
            }
          ],
          "terminal": [
            "APPROVED",
            "REJECTED"
          ],
          "fromNull": [
            "RETRY",
            "APPROVED",
            "REJECTED"
          ]
        },
        {
          "field": "escalation",
          "transitions": [
            {
              "from": "raised",
              "to": [
                "acknowledged"
              ]
            },
            {
              "from": "acknowledged",
              "toNull": true
            }
          ],
          "fromNull": [
            "raised"
          ]
        },
        {
          "field": "accountStatus",
          "transitions": [
            {
              "from": "active",
              "to": [
                "suspended",
                "closed"
              ]
            },
            {
              "from": "suspended",
              "to": [
                "active",
                "closed"
              ]
            }
          ],
          "terminal": [
            "closed"
          ]
        }
      ]
    }
  },
  "enums": {
    "Escalation": {
      "name": "Escalation",
      "owner": "fixture-state-machine-db",
      "comment": "Whether a ticket was raised to a manager, and heard.",
      "values": [
        {
          "name": "Raised",
          "serializedAs": "raised"
        },
        {
          "name": "Acknowledged",
          "serializedAs": "acknowledged"
        }
      ]
    },
    "ReviewOutcome": {
      "name": "ReviewOutcome",
      "owner": "fixture-state-machine-db",
      "comment": "What a review of a ticket's answer found. Each member's value is its\nname.",
      "values": [
        {
          "name": "RETRY"
        },
        {
          "name": "APPROVED"
        },
        {
          "name": "REJECTED"
        }
      ]
    },
    "SignOffStep": {
      "name": "SignOffStep",
      "owner": "fixture-state-machine-db",
      "comment": "A step of a refund's sign-off.",
      "values": [
        {
          "name": "Requested",
          "serializedAs": "requested"
        },
        {
          "name": "Granted",
          "serializedAs": "granted"
        },
        {
          "name": "Refused",
          "serializedAs": "refused"
        }
      ]
    },
    "TicketState": {
      "name": "TicketState",
      "owner": "fixture-state-machine-db",
      "comment": "Where a ticket stands. A member's value is not its name: the database\nholds the value, and a language's types name the member.",
      "values": [
        {
          "name": "Open",
          "serializedAs": "open"
        },
        {
          "name": "InProgress",
          "serializedAs": "in_progress"
        },
        {
          "name": "Resolved",
          "serializedAs": "resolved"
        },
        {
          "name": "Closed",
          "serializedAs": "closed"
        }
      ]
    }
  }
}
