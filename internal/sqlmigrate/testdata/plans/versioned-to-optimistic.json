      "phase": "expand",
      "statements": [
        "CREATE OR REPLACE FUNCTION product_bump_version() RETURNS trigger AS $$\nBEGIN\n  -- BEFORE UPDATE: the stored row takes the next version.\n  NEW._version := OLD._version + 1;\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql"
      ],
      "subject": "function/product_bump_version",
      "transactional": true
    },
    {
      "index": 2,
      "op": "replaceTrigger",
      "phase": "contract",
      "statements": [
        "DROP TRIGGER trg_product_bump_version ON product",
        "CREATE TRIGGER trg_product_bump_version\n  BEFORE UPDATE ON product\n  FOR EACH ROW EXECUTE FUNCTION product_bump_version()"
      ],
      "subject": "trigger/product/trg_product_bump_version",
      "transactional": true
    },
