      "statements": [
        "DROP TRIGGER trg_product_bump_version ON product",
        "CREATE TRIGGER trg_product_bump_version\n  BEFORE UPDATE ON product\n  FOR EACH ROW EXECUTE FUNCTION product_bump_version()"
      ],
