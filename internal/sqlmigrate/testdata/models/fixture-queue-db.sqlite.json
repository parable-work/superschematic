  "triggers": [
    {
      "definition": "CREATE TRIGGER \"trg_order_line_enqueue_order_changed_delete\" AFTER DELETE ON \"order_line\" FOR EACH ROW\nWHEN OLD.\"product_id\" IS NOT NULL\nBEGIN\n  INSERT INTO \"order_changed_queue\" (\"order_id\", \"line_id\", \"priority\") VALUES (OLD.\"order_id\", OLD.\"id\", 'low')\n    ON CONFLICT (order_id) WHERE state = 'ready' DO UPDATE SET line_id = excluded.line_id, priority = excluded.priority, due_at = excluded.due_at, attempts = 0, last_error = NULL, updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now');\nEND",
      "name": "trg_order_line_enqueue_order_changed_delete",
      "origin": "OrderLine",
      "table": "order_line"
    },
    {
      "definition": "CREATE TRIGGER \"trg_order_line_enqueue_order_changed_insert\" AFTER INSERT ON \"order_line\" FOR EACH ROW\nWHEN NEW.\"product_id\" IS NOT NULL\nBEGIN\n  INSERT INTO \"order_changed_queue\" (\"order_id\", \"line_id\", \"priority\") VALUES (NEW.\"order_id\", NEW.\"id\", 'low')\n    ON CONFLICT (order_id) WHERE state = 'ready' DO UPDATE SET line_id = excluded.line_id, priority = excluded.priority, due_at = excluded.due_at, attempts = 0, last_error = NULL, updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now');\nEND",
      "name": "trg_order_line_enqueue_order_changed_insert",
      "origin": "OrderLine",
      "table": "order_line"
    },
    {
      "definition": "CREATE TRIGGER \"trg_order_line_enqueue_order_changed_update\" AFTER UPDATE ON \"order_line\" FOR EACH ROW\nWHEN (OLD.\"product_id\" IS NOT NEW.\"product_id\" OR OLD.\"quantity\" IS NOT NEW.\"quantity\") AND NEW.\"product_id\" IS NOT NULL\nBEGIN\n  INSERT INTO \"order_changed_queue\" (\"order_id\", \"line_id\", \"priority\") VALUES (NEW.\"order_id\", NEW.\"id\", 'low')\n    ON CONFLICT (order_id) WHERE state = 'ready' DO UPDATE SET line_id = excluded.line_id, priority = excluded.priority, due_at = excluded.due_at, attempts = 0, last_error = NULL, updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now');\nEND",
      "name": "trg_order_line_enqueue_order_changed_update",
      "origin": "OrderLine",
      "table": "order_line"
    }
  ],
  "version": 1
}
