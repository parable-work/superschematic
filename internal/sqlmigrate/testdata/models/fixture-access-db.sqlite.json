  "triggers": [
    {
      "definition": "CREATE TRIGGER \"trg_document_audience_insert\" AFTER INSERT ON \"document\" FOR EACH ROW\nBEGIN\n  -- The @audience of Document (D156, D182): the row's audience resolved into\n  -- effective_audience and effective_agents, whatever writes the row.\n  SELECT RAISE(ABORT, 'document.audience is none of everyone, private, named, inherit') WHERE NEW.\"audience\" IS NULL OR NEW.\"audience\" NOT IN ('everyone', 'private', 'named', 'inherit');\n  SELECT RAISE(ABORT, 'document.agent_access is none of followRole, readOnly, none') WHERE NEW.\"agent_access\" IS NULL OR NEW.\"agent_access\" NOT IN ('followRole', 'readOnly', 'none');\n  UPDATE \"document\" SET \"effective_audience\" = CASE \"document\".\"audience\" WHEN 'everyone' THEN NULL WHEN 'private' THEN CASE WHEN \"document\".\"created_by\" IS NULL THEN '[]' ELSE json_array(\"document\".\"created_by\") END WHEN 'named' THEN (SELECT json_group_array(audience_member.value) FROM (SELECT \"document\".\"created_by\" AS value WHERE \"document\".\"created_by\" IS NOT NULL UNION ALL SELECT value FROM json_each(COALESCE(\"document\".\"audience_named\", '[]')) WHERE value IS NOT NULL) AS audience_member) ELSE CASE WHEN \"document\".\"folder_id\" IS NOT NULL AND EXISTS (SELECT 1 FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = \"document\".\"folder_id\") THEN (SELECT audience_parent.\"effective_audience\" FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = \"document\".\"folder_id\") ELSE CASE WHEN \"document\".\"created_by\" IS NULL THEN '[]' ELSE json_array(\"document\".\"created_by\") END END END,\n    \"effective_agents\" = CASE WHEN \"document\".\"audience\" = 'inherit' AND \"document\".\"folder_id\" IS NOT NULL AND EXISTS (SELECT 1 FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = \"document\".\"folder_id\") AND CASE (SELECT audience_parent.\"effective_agents\" FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = \"document\".\"folder_id\") WHEN 'followRole' THEN 0 WHEN 'readOnly' THEN 1 WHEN 'none' THEN 2 END \u003e CASE \"document\".\"agent_access\" WHEN 'followRole' THEN 0 WHEN 'readOnly' THEN 1 WHEN 'none' THEN 2 END THEN (SELECT audience_parent.\"effective_agents\" FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = \"document\".\"folder_id\") ELSE \"document\".\"agent_access\" END\n    WHERE \"document\".\"id\" = NEW.\"id\";\nEND",
      "name": "trg_document_audience_insert",
      "origin": "Document",
      "refuses": true,
      "table": "document"
    },
    {
      "backfill": "UPDATE \"document\" SET \"audience\" = \"audience\"",
      "backfillNote": "Backfilling trg_document_audience_update resolves the audience of every row of document.",
      "definition": "CREATE TRIGGER \"trg_document_audience_update\" AFTER UPDATE ON \"document\" FOR EACH ROW\nWHEN NEW.\"audience\" IS NULL OR NEW.\"audience\" NOT IN ('everyone', 'private', 'named', 'inherit')\n  OR NEW.\"agent_access\" IS NULL OR NEW.\"agent_access\" NOT IN ('followRole', 'readOnly', 'none')\n  OR NEW.\"effective_audience\" IS NOT CASE NEW.\"audience\" WHEN 'everyone' THEN NULL WHEN 'private' THEN CASE WHEN NEW.\"created_by\" IS NULL THEN '[]' ELSE json_array(NEW.\"created_by\") END WHEN 'named' THEN (SELECT json_group_array(audience_member.value) FROM (SELECT NEW.\"created_by\" AS value WHERE NEW.\"created_by\" IS NOT NULL UNION ALL SELECT value FROM json_each(COALESCE(NEW.\"audience_named\", '[]')) WHERE value IS NOT NULL) AS audience_member) ELSE CASE WHEN NEW.\"folder_id\" IS NOT NULL AND EXISTS (SELECT 1 FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = NEW.\"folder_id\") THEN (SELECT audience_parent.\"effective_audience\" FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = NEW.\"folder_id\") ELSE CASE WHEN NEW.\"created_by\" IS NULL THEN '[]' ELSE json_array(NEW.\"created_by\") END END END\n  OR NEW.\"effective_agents\" IS NOT CASE WHEN NEW.\"audience\" = 'inherit' AND NEW.\"folder_id\" IS NOT NULL AND EXISTS (SELECT 1 FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = NEW.\"folder_id\") AND CASE (SELECT audience_parent.\"effective_agents\" FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = NEW.\"folder_id\") WHEN 'followRole' THEN 0 WHEN 'readOnly' THEN 1 WHEN 'none' THEN 2 END \u003e CASE NEW.\"agent_access\" WHEN 'followRole' THEN 0 WHEN 'readOnly' THEN 1 WHEN 'none' THEN 2 END THEN (SELECT audience_parent.\"effective_agents\" FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = NEW.\"folder_id\") ELSE NEW.\"agent_access\" END\nBEGIN\n  -- The @audience of Document (D156, D182): the row's audience resolved into\n  -- effective_audience and effective_agents, whatever writes the row.\n  SELECT RAISE(ABORT, 'document.audience is none of everyone, private, named, inherit') WHERE NEW.\"audience\" IS NULL OR NEW.\"audience\" NOT IN ('everyone', 'private', 'named', 'inherit');\n  SELECT RAISE(ABORT, 'document.agent_access is none of followRole, readOnly, none') WHERE NEW.\"agent_access\" IS NULL OR NEW.\"agent_access\" NOT IN ('followRole', 'readOnly', 'none');\n  UPDATE \"document\" SET \"effective_audience\" = CASE \"document\".\"audience\" WHEN 'everyone' THEN NULL WHEN 'private' THEN CASE WHEN \"document\".\"created_by\" IS NULL THEN '[]' ELSE json_array(\"document\".\"created_by\") END WHEN 'named' THEN (SELECT json_group_array(audience_member.value) FROM (SELECT \"document\".\"created_by\" AS value WHERE \"document\".\"created_by\" IS NOT NULL UNION ALL SELECT value FROM json_each(COALESCE(\"document\".\"audience_named\", '[]')) WHERE value IS NOT NULL) AS audience_member) ELSE CASE WHEN \"document\".\"folder_id\" IS NOT NULL AND EXISTS (SELECT 1 FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = \"document\".\"folder_id\") THEN (SELECT audience_parent.\"effective_audience\" FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = \"document\".\"folder_id\") ELSE CASE WHEN \"document\".\"created_by\" IS NULL THEN '[]' ELSE json_array(\"document\".\"created_by\") END END END,\n    \"effective_agents\" = CASE WHEN \"document\".\"audience\" = 'inherit' AND \"document\".\"folder_id\" IS NOT NULL AND EXISTS (SELECT 1 FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = \"document\".\"folder_id\") AND CASE (SELECT audience_parent.\"effective_agents\" FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = \"document\".\"folder_id\") WHEN 'followRole' THEN 0 WHEN 'readOnly' THEN 1 WHEN 'none' THEN 2 END \u003e CASE \"document\".\"agent_access\" WHEN 'followRole' THEN 0 WHEN 'readOnly' THEN 1 WHEN 'none' THEN 2 END THEN (SELECT audience_parent.\"effective_agents\" FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = \"document\".\"folder_id\") ELSE \"document\".\"agent_access\" END\n    WHERE \"document\".\"id\" = NEW.\"id\";\nEND",
      "name": "trg_document_audience_update",
      "origin": "Document",
      "refuses": true,
      "table": "document"
    },
    {
      "definition": "CREATE TRIGGER \"trg_folder_audience_cascade\" AFTER UPDATE ON \"folder\" FOR EACH ROW\nWHEN NEW.\"effective_audience\" IS NOT OLD.\"effective_audience\" OR NEW.\"effective_agents\" IS NOT OLD.\"effective_agents\"\nBEGIN\n  -- The children that inherit the audience of Folder (D156, D182), resolved\n  -- again when its own resolved audience changes.\n  UPDATE \"document\" SET \"effective_audience\" = CASE \"document\".\"audience\" WHEN 'everyone' THEN NULL WHEN 'private' THEN CASE WHEN \"document\".\"created_by\" IS NULL THEN '[]' ELSE json_array(\"document\".\"created_by\") END WHEN 'named' THEN (SELECT json_group_array(audience_member.value) FROM (SELECT \"document\".\"created_by\" AS value WHERE \"document\".\"created_by\" IS NOT NULL UNION ALL SELECT value FROM json_each(COALESCE(\"document\".\"audience_named\", '[]')) WHERE value IS NOT NULL) AS audience_member) ELSE CASE WHEN \"document\".\"folder_id\" IS NOT NULL AND EXISTS (SELECT 1 FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = \"document\".\"folder_id\") THEN (SELECT audience_parent.\"effective_audience\" FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = \"document\".\"folder_id\") ELSE CASE WHEN \"document\".\"created_by\" IS NULL THEN '[]' ELSE json_array(\"document\".\"created_by\") END END END,\n    \"effective_agents\" = CASE WHEN \"document\".\"audience\" = 'inherit' AND \"document\".\"folder_id\" IS NOT NULL AND EXISTS (SELECT 1 FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = \"document\".\"folder_id\") AND CASE (SELECT audience_parent.\"effective_agents\" FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = \"document\".\"folder_id\") WHEN 'followRole' THEN 0 WHEN 'readOnly' THEN 1 WHEN 'none' THEN 2 END \u003e CASE \"document\".\"agent_access\" WHEN 'followRole' THEN 0 WHEN 'readOnly' THEN 1 WHEN 'none' THEN 2 END THEN (SELECT audience_parent.\"effective_agents\" FROM \"folder\" AS audience_parent WHERE audience_parent.\"id\" = \"document\".\"folder_id\") ELSE \"document\".\"agent_access\" END\n    WHERE \"document\".\"audience\" = 'inherit' AND \"document\".\"folder_id\" = NEW.\"id\";\nEND",
      "name": "trg_folder_audience_cascade",
      "origin": "Folder",
      "table": "folder"
    },
