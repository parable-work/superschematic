      "definition": "CREATE TRIGGER \"trg_folder_audience_insert\" AFTER INSERT ON \"folder\" FOR EACH ROW\nBEGIN\n  -- The @audience of Folder (D156, D182): the row's audience resolved into\n  -- effective_audience and effective_agents, whatever writes the row.\n  SELECT RAISE(ABORT, 'folder.audience is none of everyone, private, named') WHERE NEW.\"audience\" IS NULL OR NEW.\"audience\" NOT IN ('everyone', 'private', 'named');\n  SELECT RAISE(ABORT, 'folder.agent_access is none of followRole, readOnly, none') WHERE NEW.\"agent_access\" IS NULL OR NEW.\"agent_access\" NOT IN ('followRole', 'readOnly', 'none');\n  UPDATE \"folder\" SET \"effective_audience\" = CASE \"folder\".\"audience\" WHEN 'everyone' THEN NULL WHEN 'private' THEN CASE WHEN \"folder\".\"owner\" IS NULL THEN '[]' ELSE json_array(\"folder\".\"owner\") END WHEN 'named' THEN (SELECT json_group_array(audience_member.value) FROM (SELECT \"folder\".\"owner\" AS value WHERE \"folder\".\"owner\" IS NOT NULL UNION ALL SELECT value FROM json_each(COALESCE(\"folder\".\"audience_named\", '[]')) WHERE value IS NOT NULL) AS audience_member) ELSE CASE WHEN \"folder\".\"owner\" IS NULL THEN '[]' ELSE json_array(\"folder\".\"owner\") END END,\n    \"effective_agents\" = \"folder\".\"agent_access\"\n    WHERE \"folder\".\"id\" = NEW.\"id\";\nEND",
