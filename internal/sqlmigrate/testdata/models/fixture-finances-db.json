      "definition": [
        "CREATE VIEW transaction_list WITH (security_barrier = true) AS\n-- Projection column order is the published Arrow contract.\nSELECT -- noqa: ST06\n  base.id,\n  base.\"date\",\n  base.\"name\",\n  base.description,\n  base.amount,\n  base.account_id,\n  account.\"name\" AS account_name,\n  provider.\"name\" AS provider_name,\n  base.category_id,\n  category.\"name\" AS category_name,\n  category.color AS category_color,\n  category.parent_id AS parent_category_id,\n  parent.\"name\" AS parent_category_name,\n  base.business_id,\n  business.\"name\" AS business_name,\n  base.user_id,\n  person.\"name\" AS user_name\nFROM line_item AS base\n  INNER JOIN account AS account ON base.account_id = account.id\n  INNER JOIN provider AS provider ON account.provider_id = provider.id\n  LEFT JOIN category AS category ON base.category_id = category.id\n  LEFT JOIN category AS parent ON category.parent_id = parent.id\n  LEFT JOIN business AS business ON base.business_id = business.id\n  LEFT JOIN \"user\" AS person ON base.user_id = person.id\n",
        "COMMENT ON VIEW transaction_list IS 'The dashboard''s transaction list, flat (D90): a line item with its account and provider, its category and that category''s parent, its business and its person, as one row. A plain view in the service''s own schema, which binds no session setting, read through the ORMs'' read-only repository.'"
      ],
