{
  "dialect": "sqlite",
  "service": "fixture-list-defaults-db",
  "tables": [
    {
      "columns": [
        {
          "default": "(lower(hex(randomblob(4)) || '-' || hex(randomblob(2)) || '-4' || substr(hex(randomblob(2)), 2) || '-' || substr('89ab', 1 + (random() \u0026 3), 1) || substr(hex(randomblob(2)), 2) || '-' || hex(randomblob(6))))",
