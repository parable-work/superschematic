  "triggers": [
    {
      "definition": "CREATE TRIGGER \"trg_note_attachments_release\" AFTER DELETE ON \"note_attachments\" FOR EACH ROW\nBEGIN\n  -- The object the file of NoteAttachments deleted named (D154, D182), released\n  -- once no file of the table names it: its worker deletes it once no\n  -- file of any table does.\n  INSERT INTO \"attachment_released_queue\" (\"object_key\", \"content_hash\", \"reason\")\n    SELECT OLD.\"object_key\", OLD.\"content_hash\", 'detached' WHERE NOT EXISTS (SELECT 1 FROM \"note_attachments\" WHERE \"object_key\" = OLD.\"object_key\");\nEND",
      "name": "trg_note_attachments_release",
      "origin": "NoteAttachments",
      "table": "note_attachments"
    },
    {
      "definition": "CREATE TRIGGER \"trg_note_audience_insert\" AFTER INSERT ON \"note\" FOR EACH ROW\nBEGIN\n  -- The @audience of Note (D156, D182): the row's audience resolved into\n  -- effective_audience and effective_agents, whatever writes the row.\n  SELECT RAISE(ABORT, 'note.audience is none of everyone, private, named') WHERE NEW.\"audience\" IS NULL OR NEW.\"audience\" NOT IN ('everyone', 'private', 'named');\n  SELECT RAISE(ABORT, 'note.agent_access is none of followRole, readOnly, none') WHERE NEW.\"agent_access\" IS NULL OR NEW.\"agent_access\" NOT IN ('followRole', 'readOnly', 'none');\n  UPDATE \"note\" SET \"effective_audience\" = CASE \"note\".\"audience\" WHEN 'everyone' THEN NULL WHEN 'private' THEN CASE WHEN \"note\".\"owner\" IS NULL THEN '[]' ELSE json_array(\"note\".\"owner\") END WHEN 'named' THEN (SELECT json_group_array(audience_member.value) FROM (SELECT \"note\".\"owner\" AS value WHERE \"note\".\"owner\" IS NOT NULL UNION ALL SELECT value FROM json_each(COALESCE(\"note\".\"audience_named\", '[]')) WHERE value IS NOT NULL) AS audience_member) ELSE CASE WHEN \"note\".\"owner\" IS NULL THEN '[]' ELSE json_array(\"note\".\"owner\") END END,\n    \"effective_agents\" = \"note\".\"agent_access\"\n    WHERE \"note\".\"id\" = NEW.\"id\";\nEND",
      "name": "trg_note_audience_insert",
      "origin": "Note",
      "refuses": true,
      "table": "note"
    },
    {
      "backfill": "UPDATE \"note\" SET \"audience\" = \"audience\"",
      "backfillNote": "Backfilling trg_note_audience_update resolves the audience of every row of note.",
      "definition": "CREATE TRIGGER \"trg_note_audience_update\" AFTER UPDATE ON \"note\" FOR EACH ROW\nWHEN NEW.\"audience\" IS NULL OR NEW.\"audience\" NOT IN ('everyone', 'private', 'named')\n  OR NEW.\"agent_access\" IS NULL OR NEW.\"agent_access\" NOT IN ('followRole', 'readOnly', 'none')\n  OR NEW.\"effective_audience\" IS NOT CASE NEW.\"audience\" WHEN 'everyone' THEN NULL WHEN 'private' THEN CASE WHEN NEW.\"owner\" IS NULL THEN '[]' ELSE json_array(NEW.\"owner\") END WHEN 'named' THEN (SELECT json_group_array(audience_member.value) FROM (SELECT NEW.\"owner\" AS value WHERE NEW.\"owner\" IS NOT NULL UNION ALL SELECT value FROM json_each(COALESCE(NEW.\"audience_named\", '[]')) WHERE value IS NOT NULL) AS audience_member) ELSE CASE WHEN NEW.\"owner\" IS NULL THEN '[]' ELSE json_array(NEW.\"owner\") END END\n  OR NEW.\"effective_agents\" IS NOT NEW.\"agent_access\"\nBEGIN\n  -- The @audience of Note (D156, D182): the row's audience resolved into\n  -- effective_audience and effective_agents, whatever writes the row.\n  SELECT RAISE(ABORT, 'note.audience is none of everyone, private, named') WHERE NEW.\"audience\" IS NULL OR NEW.\"audience\" NOT IN ('everyone', 'private', 'named');\n  SELECT RAISE(ABORT, 'note.agent_access is none of followRole, readOnly, none') WHERE NEW.\"agent_access\" IS NULL OR NEW.\"agent_access\" NOT IN ('followRole', 'readOnly', 'none');\n  UPDATE \"note\" SET \"effective_audience\" = CASE \"note\".\"audience\" WHEN 'everyone' THEN NULL WHEN 'private' THEN CASE WHEN \"note\".\"owner\" IS NULL THEN '[]' ELSE json_array(\"note\".\"owner\") END WHEN 'named' THEN (SELECT json_group_array(audience_member.value) FROM (SELECT \"note\".\"owner\" AS value WHERE \"note\".\"owner\" IS NOT NULL UNION ALL SELECT value FROM json_each(COALESCE(\"note\".\"audience_named\", '[]')) WHERE value IS NOT NULL) AS audience_member) ELSE CASE WHEN \"note\".\"owner\" IS NULL THEN '[]' ELSE json_array(\"note\".\"owner\") END END,\n    \"effective_agents\" = \"note\".\"agent_access\"\n    WHERE \"note\".\"id\" = NEW.\"id\";\nEND",
      "name": "trg_note_audience_update",
      "origin": "Note",
      "refuses": true,
      "table": "note"
    },
    {
      "definition": "CREATE TRIGGER \"trg_note_references_clear\" AFTER DELETE ON \"note\" FOR EACH ROW\nBEGIN\n  -- The references to the row of Note deleted (D154, D182), cleared,\n  -- and the row that held each told on its cleared queue.\n  INSERT INTO \"reference_cleared_queue\" (\"holder_table\", \"holder_key\", \"target_table\", \"target_key\", \"role\")\n    SELECT 'Note', CAST(\"note_id\" AS TEXT), \"target_table\", \"target_key\", \"role\" FROM \"note_references\" WHERE \"target_table\" = 'Note' AND \"target_key\" = CAST(OLD.\"id\" AS TEXT);\n  DELETE FROM \"note_references\" WHERE \"target_table\" = 'Note' AND \"target_key\" = CAST(OLD.\"id\" AS TEXT);\n  INSERT INTO \"reference_cleared_queue\" (\"holder_table\", \"holder_key\", \"target_table\", \"target_key\", \"role\")\n    SELECT 'Ticket', CAST(\"ticket_id\" AS TEXT), \"target_table\", \"target_key\", \"role\" FROM \"ticket_references\" WHERE \"target_table\" = 'Note' AND \"target_key\" = CAST(OLD.\"id\" AS TEXT);\n  DELETE FROM \"ticket_references\" WHERE \"target_table\" = 'Note' AND \"target_key\" = CAST(OLD.\"id\" AS TEXT);\nEND",
      "name": "trg_note_references_clear",
      "origin": "Note",
      "table": "note"
    },
    {
      "definition": "CREATE TRIGGER \"trg_ticket_attachments_release\" AFTER DELETE ON \"ticket_attachments\" FOR EACH ROW\nBEGIN\n  -- The object the file of TicketAttachments deleted named (D154, D182), released\n  -- once no file of the table names it: its worker deletes it once no\n  -- file of any table does.\n  INSERT INTO \"attachment_released_queue\" (\"object_key\", \"content_hash\", \"reason\")\n    SELECT OLD.\"object_key\", OLD.\"content_hash\", 'detached' WHERE NOT EXISTS (SELECT 1 FROM \"ticket_attachments\" WHERE \"object_key\" = OLD.\"object_key\");\nEND",
