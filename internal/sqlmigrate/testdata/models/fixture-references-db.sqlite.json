      "definition": "CREATE TRIGGER \"trg_ticket_references_clear\" AFTER DELETE ON \"ticket\" FOR EACH ROW\nBEGIN\n  -- The references to the row of Ticket deleted (D154, D182), cleared,\n  -- and the row that held each told on its cleared queue.\n  INSERT INTO \"reference_cleared_queue\" (\"holder_table\", \"holder_key\", \"target_table\", \"target_key\", \"role\")\n    SELECT 'Note', CAST(\"note_id\" AS TEXT), \"target_table\", \"target_key\", \"role\" FROM \"note_references\" WHERE \"target_table\" = 'Ticket' AND \"target_key\" = CAST(OLD.\"id\" AS TEXT);\n  DELETE FROM \"note_references\" WHERE \"target_table\" = 'Ticket' AND \"target_key\" = CAST(OLD.\"id\" AS TEXT);\n  INSERT INTO \"reference_cleared_queue\" (\"holder_table\", \"holder_key\", \"target_table\", \"target_key\", \"role\")\n    SELECT 'Ticket', CAST(\"ticket_id\" AS TEXT), \"target_table\", \"target_key\", \"role\" FROM \"ticket_references\" WHERE \"target_table\" = 'Ticket' AND \"target_key\" = CAST(OLD.\"id\" AS TEXT);\n  DELETE FROM \"ticket_references\" WHERE \"target_table\" = 'Ticket' AND \"target_key\" = CAST(OLD.\"id\" AS TEXT);\nEND",
      "name": "trg_ticket_references_clear",
