      "position": "indexes",
      "statements": [
        "DROP MATERIALIZED VIEW IF EXISTS category_totals",
        "CREATE MATERIALIZED VIEW IF NOT EXISTS category_totals AS\n      SELECT category_id, sum(amount_cents) AS total_cents, count(*) AS line_count\n      FROM line_item\n      GROUP BY category_id",
        "COMMENT ON MATERIALIZED VIEW category_totals IS 'Each category''s total, for the dashboard.'"
      ]
