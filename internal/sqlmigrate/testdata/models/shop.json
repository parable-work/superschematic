  "version": 1,
  "views": [
    {
      "columns": [
        {
          "name": "code",
          "type": "VARCHAR(80)"
        },
        {
          "name": "total",
          "type": "BIGINT"
        },
        {
          "name": "customer_name",
          "type": "VARCHAR(80)"
        }
      ],
      "definition": [
        "CREATE VIEW report.order_summary WITH (security_barrier = true) AS\n-- Projection column order is the published Arrow contract.\nSELECT -- noqa: ST06\n  base.code,\n  base.total,\n  customer.\"name\" AS customer_name\nFROM \"order\" AS base\n  INNER JOIN customer AS customer ON base.customer_id = customer.id\n",
        "COMMENT ON VIEW report.order_summary IS 'Orders with their customer''s name, for reporting.'"
      ],
      "name": "order_summary",
      "origin": "OrderSummary",
      "reads": [
        {
          "column": "id",
          "table": "customer"
        },
        {
          "column": "name",
          "table": "customer"
        },
        {
          "column": "code",
          "table": "order"
        },
        {
          "column": "customer_id",
          "table": "order"
        },
        {
          "column": "total",
          "table": "order"
        }
      ],
      "schema": "report"
    }
