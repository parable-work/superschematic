{
  "name": "byhand-db",
  "kind": "DB",
  "comment": "The schema an app adopts for a SQLite file it built by hand before it had one (D116): customers, and the orders they place.",
  "scalars": {
    "Identity.UUID": { "name": "Identity.UUID", "languagePrimitive": "string" },
    "Temporal.DateTime": { "name": "Temporal.DateTime", "languagePrimitive": "string" }
  },
  "enums": {
    "OrderState": {
      "name": "OrderState",
      "values": [{ "name": "Open", "serializedAs": "open" }, { "name": "Shipped", "serializedAs": "shipped" }]
    }
  },
  "types": {
    "Customer": {
      "name": "Customer",
      "comment": "Someone who places orders.",
      "role": "DBTable",
      "fields": [
        { "name": "id", "typeRef": { "name": "Identity.UUID" }, "required": true, "key": true, "autoGenerated": true },
        { "name": "email", "typeRef": { "name": "string" }, "required": true, "unique": true },
        { "name": "name", "typeRef": { "name": "string" }, "required": true },
        { "name": "active", "typeRef": { "name": "boolean" }, "required": true, "default": "true" }
      ]
    },
    "Order": {
      "name": "Order",
      "comment": "An order a customer placed.",
      "role": "DBTable",
      "indexes": [{ "keys": ["placedAt"] }],
      "fields": [
        { "name": "id", "typeRef": { "name": "Identity.UUID" }, "required": true, "key": true, "autoGenerated": true },
        { "name": "customer", "typeRef": { "name": "Customer" }, "required": true, "relation": { "onDelete": "CASCADE" } },
        { "name": "total", "typeRef": { "name": "number" }, "required": true },
        { "name": "note", "typeRef": { "name": "string" } },
        { "name": "state", "typeRef": { "name": "OrderState" }, "required": true, "default": "open" },
        { "name": "tags", "typeRef": { "name": "string", "isArray": true }, "required": true },
        { "name": "placedAt", "typeRef": { "name": "Temporal.DateTime" }, "required": true }
      ]
    }
  }
}
