{
  "version": 1,
  "stack": "require-stack",
  "environment": "Dev",
  "containers": [
    {
      "id": "postgres.container",
      "name": "superschematic-require-stack-dev-postgres",
      "image": "postgres:16-alpine",
      "host": "127.0.0.1",
      "hostPort": 32406,
      "containerPort": 5432,
      "env": [
        {
          "name": "POSTGRES_HOST_AUTH_METHOD",
          "value": "trust"
        }
      ],
      "labels": {
        "superschematic.environment": "Dev",
        "superschematic.stack": "require-stack"
      }
    }
  ],
  "databases": [
    {
      "id": "shop-db.database.shop-db",
      "name": "shop_db",
      "service": "shop-db",
      "container": "postgres.container",
      "url": "postgres://postgres@127.0.0.1:32406/shop_db?sslmode=disable"
    }
  ],
  "keyPairs": [
    {
      "id": "Orders.calls.shop-api.key",
      "caller": "Orders",
      "callee": "shop-api"
    }
  ],
  "migrations": [
    {
      "database": "shop-db",
      "service": "shop-db",
      "resource": "shop-db.database.shop-db",
      "url": "postgres://postgres@127.0.0.1:32406/shop_db?sslmode=disable",
      "model": "models/shop-db.json",
      "plan": "migrations/shop-db.plan.json"
    }
  ],
  "servers": [
    {
      "id": "shop-api.process",
      "deployable": "shop-api",
      "name": "shop-api",
      "wave": 1,
      "module": "server/require-stack/shop-api",
      "binary": "bin/shop-api",
      "port": 21859,
      "url": "http://127.0.0.1:21859",
      "readiness": "/readyz",
      "env": [
        {
          "name": "LOG_LEVEL",
          "value": "info"
        },
        {
          "name": "SHOP_API_CALLERS_ISSUERS",
          "value": "1"
        },
        {
          "name": "SHOP_API_CALLERS_ISSUERS_0_ALGORITHMS",
          "value": "EdDSA"
        },
        {
          "name": "SHOP_API_CALLERS_ISSUERS_0_AUDIENCE",
          "value": "shop-api"
        },
        {
          "name": "SHOP_API_CALLERS_ISSUERS_0_CALLERS",
          "value": "1"
        },
        {
          "name": "SHOP_API_CALLERS_ISSUERS_0_CALLERS_0_DEPLOYABLE",
          "value": "Orders"
        },
        {
          "name": "SHOP_API_CALLERS_ISSUERS_0_CALLERS_0_SERVES",
          "value": "shop-orders"
        },
        {
          "name": "SHOP_API_CALLERS_ISSUERS_0_CALLERS_0_SUBJECT",
          "value": "Orders"
        },
        {
          "name": "SHOP_API_CALLERS_ISSUERS_0_ISSUER",
          "value": "Orders"
        },
        {
          "name": "SHOP_API_CALLERS_ISSUERS_0_KEYS",
          "value": "1"
        },
        {
          "name": "SHOP_API_CALLERS_ISSUERS_0_KEYS_0_JWK",
          "value": {
            "$output": {
              "resource": "Orders.calls.shop-api.key",
              "name": "publicJwk"
            }
          }
        },
        {
          "name": "SHOP_API_CALLERS_ISSUERS_0_MAX_LIFETIME_SECONDS",
          "value": "300"
        },
        {
          "name": "SHOP_DB_DATABASE_URL",
          "value": "postgres://postgres@127.0.0.1:32406/shop_db?sslmode=disable"
        },
        {
          "name": "STRIPE_KEY",
          "secret": "PaymentsSecrets.STRIPE_KEY"
        }
      ]
    },
    {
      "id": "Orders.process",
      "deployable": "Orders",
      "name": "orders",
      "wave": 2,
      "module": "server/require-stack/Orders",
      "binary": "bin/orders",
      "port": 21243,
      "url": "http://127.0.0.1:21243",
      "readiness": "/readyz",
      "env": [
        {
          "name": "FULFILLMENT_REGION",
          "value": "us"
        },
        {
          "name": "MAX_LINE_ITEMS",
          "value": "50"
        },
        {
          "name": "SHOP_API_SERVICE_CREDENTIAL_AUDIENCE",
          "value": "shop-api"
        },
        {
          "name": "SHOP_API_SERVICE_CREDENTIAL_ISSUER",
          "value": "Orders"
        },
        {
          "name": "SHOP_API_SERVICE_CREDENTIAL_KEY",
          "value": {
            "$output": {
              "resource": "Orders.calls.shop-api.key",
              "name": "privateJwk"
            }
          }
        },
        {
          "name": "SHOP_API_SERVICE_CREDENTIAL_SOURCE",
          "value": "signed-token"
        },
        {
          "name": "SHOP_API_SERVICE_URL",
          "value": "http://127.0.0.1:21859"
        },
        {
          "name": "SHOP_DB_DATABASE_URL",
          "value": "postgres://postgres@127.0.0.1:32406/shop_db?sslmode=disable"
        },
        {
          "name": "STRIPE_KEY",
          "secret": "PaymentsSecrets.STRIPE_KEY"
        }
      ]
    }
  ]
}
