{
  "version": 1,
  "stack": "shop-stack",
  "environment": "Dev",
  "target": "local",
  "provisioner": "local",
  "deployables": [
    {
      "name": "Orders",
      "kind": "server",
      "declared": true,
      "platform": "local.process",
      "services": [
        {
          "name": "shop-orders",
          "kind": "API"
        }
      ],
      "calls": [
        {
          "name": "shop-api",
          "kind": "API"
        }
      ],
      "language": "GO",
      "resourceName": "orders",
      "address": "http://127.0.0.1:21592",
      "bindings": [
        {
          "field": "FULFILLMENT_REGION",
          "source": "literal",
          "value": "us"
        },
        {
          "field": "MAX_LINE_ITEMS",
          "source": "literal",
          "value": "50",
          "default": true
        },
        {
          "field": "SHOP_API_SERVICE",
          "source": "derived",
          "value": {
            "credential": {
              "audience": "shop-api",
              "issuer": "Orders",
              "key": {
                "$output": {
                  "resource": "Orders.calls.shop-api.key",
                  "name": "privateJwk"
                }
              },
              "source": "signed-token"
            },
            "url": "http://127.0.0.1:22424"
          },
          "edge": "http:Orders->shop-api"
        },
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "url": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
          },
          "edge": "sql:Orders->shop-db"
        },
        {
          "field": "STRIPE_KEY",
          "source": "secret",
          "secret": "PaymentsSecrets.STRIPE_KEY"
        }
      ]
    },
    {
      "name": "shop-api",
      "kind": "server",
      "platform": "local.process",
      "services": [
        {
          "name": "shop-api",
          "kind": "API"
        }
      ],
      "language": "GO",
      "exposed": true,
      "resourceName": "shop-api",
      "address": "http://127.0.0.1:22424",
      "publicAddress": "http://127.0.0.1:22424",
      "bindings": [
        {
          "field": "LOG_LEVEL",
          "source": "literal",
          "value": "info",
          "default": true
        },
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "url": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
          },
          "edge": "sql:shop-api->shop-db"
        },
        {
          "field": "STRIPE_KEY",
          "source": "secret",
          "secret": "PaymentsSecrets.STRIPE_KEY"
        }
      ]
    },
    {
      "name": "shop-db",
      "kind": "database",
      "platform": "local.postgres",
      "services": [
        {
          "name": "shop-db",
          "kind": "DB"
        }
      ],
      "dialect": "postgres",
      "resourceName": "shop-db",
      "address": "127.0.0.1:32259"
    },
    {
      "name": "shop-orders-ship-orders",
      "kind": "job",
      "platform": "local.job",
      "services": [
        {
          "name": "shop-orders",
          "kind": "API"
        }
      ],
      "calls": [
        {
          "name": "shop-api",
          "kind": "API"
        }
      ],
      "language": "GO",
      "job": {
        "api": "shop-orders",
        "name": "ShipOrders",
        "schedule": "*/15 * * * *",
        "timeZone": "UTC",
        "timeoutSeconds": 300,
        "retries": 1
      },
      "resourceName": "shop-orders-ship-orders",
      "bindings": [
        {
          "field": "FULFILLMENT_REGION",
          "source": "literal",
          "value": "us"
        },
        {
          "field": "MAX_LINE_ITEMS",
          "source": "literal",
          "value": "50",
          "default": true
        },
        {
          "field": "SHOP_API_SERVICE",
          "source": "derived",
          "value": {
            "credential": {
              "audience": "shop-api",
              "issuer": "shop-orders-ship-orders",
              "key": {
                "$output": {
                  "resource": "shop-orders-ship-orders.calls.shop-api.key",
                  "name": "privateJwk"
                }
              },
              "source": "signed-token"
            },
            "url": "http://127.0.0.1:22424"
          },
          "edge": "http:shop-orders-ship-orders->shop-api"
        },
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "url": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
          },
          "edge": "sql:shop-orders-ship-orders->shop-db"
        },
        {
          "field": "STRIPE_KEY",
          "source": "secret",
          "secret": "PaymentsSecrets.STRIPE_KEY"
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "http:Orders->shop-api",
      "kind": "http",
      "from": "Orders",
      "to": "shop-api",
      "service": {
        "name": "shop-api",
        "kind": "API"
      },
      "connector": "local.process-process",
      "field": "SHOP_API_SERVICE"
    },
    {
      "id": "http:shop-orders-ship-orders->shop-api",
      "kind": "http",
      "from": "shop-orders-ship-orders",
      "to": "shop-api",
      "service": {
        "name": "shop-api",
        "kind": "API"
      },
      "connector": "local.job-process",
      "field": "SHOP_API_SERVICE"
    },
    {
      "id": "sql:Orders->shop-db",
      "kind": "sql",
      "from": "Orders",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "local.process-postgres",
      "field": "SHOP_DB_DATABASE"
    },
    {
      "id": "sql:shop-api->shop-db",
      "kind": "sql",
      "from": "shop-api",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "local.process-postgres",
      "field": "SHOP_DB_DATABASE"
    },
    {
      "id": "sql:shop-orders-ship-orders->shop-db",
      "kind": "sql",
      "from": "shop-orders-ship-orders",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "local.job-postgres",
      "field": "SHOP_DB_DATABASE"
    }
  ],
  "secrets": [
    {
      "id": "PaymentsSecrets.STRIPE_KEY",
      "type": "PaymentsSecrets",
      "field": "STRIPE_KEY",
      "readers": [
        "Orders",
        "shop-api",
        "shop-orders-ship-orders"
      ]
    }
  ],
  "resources": {
    "resources": [
      {
        "id": "Orders.calls.shop-api.key",
        "type": "local:serviceauth/keyPair:KeyPair",
        "properties": {
          "algorithm": "Ed25519",
          "callee": "shop-api",
          "caller": "Orders"
        },
        "phase": "infrastructure",
        "owners": [
          "http:Orders->shop-api"
        ]
      },
      {
        "id": "Orders.process",
        "type": "local:process/process:Process",
        "properties": {
          "env": [
            {
              "name": "FULFILLMENT_REGION",
              "value": "us"
            },
            {
              "name": "MAX_LINE_ITEMS",
              "value": "50"
            },
            {
              "name": "SHOP_API_SERVICE_CREDENTIAL_AUDIENCE",
              "value": "shop-api"
            },
            {
              "name": "SHOP_API_SERVICE_CREDENTIAL_ISSUER",
              "value": "Orders"
            },
            {
              "name": "SHOP_API_SERVICE_CREDENTIAL_KEY",
              "value": {
                "$output": {
                  "resource": "Orders.calls.shop-api.key",
                  "name": "privateJwk"
                }
              }
            },
            {
              "name": "SHOP_API_SERVICE_CREDENTIAL_SOURCE",
              "value": "signed-token"
            },
            {
              "name": "SHOP_API_SERVICE_URL",
              "value": "http://127.0.0.1:22424"
            },
            {
              "name": "SHOP_DB_DATABASE_URL",
              "value": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
            },
            {
              "name": "STRIPE_KEY",
              "secret": "PaymentsSecrets.STRIPE_KEY"
            }
          ],
          "language": "go",
          "module": "server/shop-stack/Orders",
          "name": "orders",
          "port": 21592,
          "readiness": "/readyz"
        },
        "dependsOn": [
          "Orders.calls.shop-api.key"
        ],
        "phase": "rollout",
        "owners": [
          "Orders"
        ]
      },
      {
        "id": "postgres.container",
        "type": "local:docker/container:Container",
        "properties": {
          "env": [
            {
              "name": "POSTGRES_HOST_AUTH_METHOD",
              "value": "trust"
            }
          ],
          "image": "postgres:16-alpine",
          "labels": {
            "superschematic.environment": "Dev",
            "superschematic.stack": "shop-stack"
          },
          "name": "superschematic-shop-stack-dev-postgres",
          "ports": [
            {
              "containerPort": 5432,
              "host": "127.0.0.1",
              "hostPort": 32259
            }
          ]
        },
        "phase": "infrastructure",
        "owners": [
          "shop-db"
        ]
      },
      {
        "id": "shop-api.process",
        "type": "local:process/process:Process",
        "properties": {
          "env": [
            {
              "name": "LOG_LEVEL",
              "value": "info"
            },
            {
              "name": "SHOP_DB_DATABASE_URL",
              "value": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
            },
            {
              "name": "STRIPE_KEY",
              "secret": "PaymentsSecrets.STRIPE_KEY"
            }
          ],
          "language": "go",
          "module": "server/shop-stack/shop-api",
          "name": "shop-api",
          "port": 22424,
          "readiness": "/readyz"
        },
        "phase": "rollout",
        "owners": [
          "shop-api"
        ]
      },
      {
        "id": "shop-db.database.shop-db",
        "type": "local:postgres/database:Database",
        "properties": {
          "container": {
            "$output": {
              "resource": "postgres.container",
              "name": "name"
            }
          },
          "name": "shop_db",
          "service": "shop-db",
          "url": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
        },
        "dependsOn": [
          "postgres.container"
        ],
        "phase": "infrastructure",
        "owners": [
          "shop-db"
        ]
      },
      {
        "id": "shop-orders-ship-orders.calls.shop-api.key",
        "type": "local:serviceauth/keyPair:KeyPair",
        "properties": {
          "algorithm": "Ed25519",
          "callee": "shop-api",
          "caller": "shop-orders-ship-orders"
        },
        "phase": "infrastructure",
        "owners": [
          "http:shop-orders-ship-orders->shop-api"
        ]
      },
      {
        "id": "shop-orders-ship-orders.job",
        "type": "local:process/job:Job",
        "properties": {
          "api": "shop-orders",
          "env": [
            {
              "name": "FULFILLMENT_REGION",
              "value": "us"
            },
            {
              "name": "MAX_LINE_ITEMS",
              "value": "50"
            },
            {
              "name": "SHOP_API_SERVICE_CREDENTIAL_AUDIENCE",
              "value": "shop-api"
            },
            {
              "name": "SHOP_API_SERVICE_CREDENTIAL_ISSUER",
              "value": "shop-orders-ship-orders"
            },
            {
              "name": "SHOP_API_SERVICE_CREDENTIAL_KEY",
              "value": {
                "$output": {
                  "resource": "shop-orders-ship-orders.calls.shop-api.key",
                  "name": "privateJwk"
                }
              }
            },
            {
              "name": "SHOP_API_SERVICE_CREDENTIAL_SOURCE",
              "value": "signed-token"
            },
            {
              "name": "SHOP_API_SERVICE_URL",
              "value": "http://127.0.0.1:22424"
            },
            {
              "name": "SHOP_DB_DATABASE_URL",
              "value": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
            },
            {
              "name": "STRIPE_KEY",
              "secret": "PaymentsSecrets.STRIPE_KEY"
            }
          ],
          "job": "ShipOrders",
          "language": "go",
          "module": "server/shop-stack/shop-orders-ship-orders",
          "name": "shop-orders-ship-orders",
          "retries": 1,
          "schedule": "*/15 * * * *",
          "timeZone": "UTC",
          "timeoutSeconds": 300
        },
        "dependsOn": [
          "shop-orders-ship-orders.calls.shop-api.key"
        ],
        "phase": "rollout",
        "owners": [
          "shop-orders-ship-orders"
        ]
      }
    ]
  },
  "deployOrder": [
    {
      "step": "infrastructure",
      "resources": [
        "Orders.calls.shop-api.key",
        "postgres.container",
        "shop-db.database.shop-db",
        "shop-orders-ship-orders.calls.shop-api.key"
      ]
    },
    {
      "step": "migrate",
      "migration": "expand",
      "deployables": [
        "shop-db"
      ]
    },
    {
      "step": "rollout",
      "wave": 1,
      "deployables": [
        "shop-api"
      ],
      "resources": [
        "shop-api.process"
      ]
    },
    {
      "step": "rollout",
      "wave": 2,
      "deployables": [
        "Orders",
        "shop-orders-ship-orders"
      ],
      "resources": [
        "Orders.process",
        "shop-orders-ship-orders.job"
      ]
    },
    {
      "step": "migrate",
      "migration": "contract",
      "deployables": [
        "shop-db"
      ]
    }
  ]
}
