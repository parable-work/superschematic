{
  "version": 1,
  "stack": "allow-stack",
  "environment": "Dev",
  "target": "local",
  "provisioner": "local",
  "deployables": [
    {
      "name": "Orders",
      "kind": "server",
      "declared": true,
      "platform": "local.process",
      "services": [
        {
          "name": "shop-orders",
          "kind": "API"
        }
      ],
      "calls": [
        {
          "name": "shop-api",
          "kind": "API"
        }
      ],
      "language": "GO",
      "resourceName": "orders",
      "address": "http://127.0.0.1:22205",
      "bindings": [
        {
          "field": "FULFILLMENT_REGION",
          "source": "literal",
          "value": "us"
        },
        {
          "field": "MAX_LINE_ITEMS",
          "source": "literal",
          "value": "50",
          "default": true
        },
        {
          "field": "SHOP_API_SERVICE",
          "source": "derived",
          "value": {
            "credential": {
              "audience": "shop-api",
              "issuer": "Orders",
              "key": {
                "$output": {
                  "resource": "Orders.calls.shop-api.key",
                  "name": "privateJwk"
                }
              },
              "source": "signed-token"
            },
            "url": "http://127.0.0.1:21829"
          },
          "edge": "http:Orders->shop-api"
        },
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "url": "postgres://postgres@127.0.0.1:31452/shop_db?sslmode=disable"
          },
          "edge": "sql:Orders->shop-db"
        },
        {
          "field": "SHOP_ORDERS_CALLERS",
          "source": "derived",
          "value": {
            "issuers": []
          },
          "callersOf": "shop-orders"
        },
        {
          "field": "STRIPE_KEY",
          "source": "secret",
          "secret": "PaymentsSecrets.STRIPE_KEY"
        }
      ]
    },
    {
      "name": "shop-api",
      "kind": "server",
      "platform": "local.process",
      "services": [
        {
          "name": "shop-api",
          "kind": "API"
        }
      ],
      "buckets": [
        {
          "name": "shop-media",
          "kind": "Bucket"
        }
      ],
      "language": "GO",
      "exposed": true,
      "resourceName": "shop-api",
      "address": "http://127.0.0.1:21829",
      "publicAddress": "http://127.0.0.1:21829",
      "bindings": [
        {
          "field": "LOG_LEVEL",
          "source": "literal",
          "value": "info",
          "default": true
        },
        {
          "field": "SHOP_API_CALLERS",
          "source": "derived",
          "value": {
            "issuers": [
              {
                "algorithms": [
                  "EdDSA"
                ],
                "audience": "shop-api",
                "callers": [
                  {
                    "deployable": "Orders",
                    "serves": [
                      "shop-orders"
                    ],
                    "subject": "Orders"
                  }
                ],
                "issuer": "Orders",
                "keys": [
                  {
                    "jwk": {
                      "$output": {
                        "resource": "Orders.calls.shop-api.key",
                        "name": "publicJwk"
                      }
                    }
                  }
                ],
                "maxLifetimeSeconds": 300
              },
              {
                "algorithms": [
                  "EdDSA"
                ],
                "audience": "shop-api",
                "callers": [
                  {
                    "deployable": "shop-orders-fulfil-orders",
                    "serves": [
                      "shop-orders"
                    ],
                    "subject": "shop-orders-fulfil-orders"
                  }
                ],
                "issuer": "shop-orders-fulfil-orders",
                "keys": [
                  {
                    "jwk": {
                      "$output": {
                        "resource": "shop-orders-fulfil-orders.calls.shop-api.key",
                        "name": "publicJwk"
                      }
                    }
                  }
                ],
                "maxLifetimeSeconds": 300
              },
              {
                "algorithms": [
                  "EdDSA"
                ],
                "audience": "shop-api",
                "callers": [
                  {
                    "deployable": "shop-orders-ship-orders",
                    "serves": [
                      "shop-orders"
                    ],
                    "subject": "shop-orders-ship-orders"
                  }
                ],
                "issuer": "shop-orders-ship-orders",
                "keys": [
                  {
                    "jwk": {
                      "$output": {
                        "resource": "shop-orders-ship-orders.calls.shop-api.key",
                        "name": "publicJwk"
                      }
                    }
                  }
                ],
                "maxLifetimeSeconds": 300
              }
            ]
          },
          "callersOf": "shop-api",
          "edges": [
            "http:Orders->shop-api",
            "http:shop-orders-fulfil-orders->shop-api",
            "http:shop-orders-ship-orders->shop-api"
          ]
        },
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "url": "postgres://postgres@127.0.0.1:31452/shop_db?sslmode=disable"
          },
          "edge": "sql:shop-api->shop-db"
        },
        {
          "field": "SHOP_MEDIA_BUCKET",
          "source": "derived",
          "value": {
            "endpoint": "http://127.0.0.1:24452",
            "name": "shop-media"
          },
          "edge": "bucket:shop-api->shop-media"
        },
        {
          "field": "STRIPE_KEY",
          "source": "secret",
          "secret": "PaymentsSecrets.STRIPE_KEY"
        }
      ]
    },
    {
      "name": "shop-db",
      "kind": "database",
      "platform": "local.postgres",
      "services": [
        {
          "name": "shop-db",
          "kind": "DB"
        }
      ],
      "dialect": "postgres",
      "resourceName": "shop-db",
      "address": "127.0.0.1:31452"
    },
    {
      "name": "shop-media",
      "kind": "bucket",
      "platform": "local.gcs",
      "services": [
        {
          "name": "shop-media",
          "kind": "Bucket"
        }
      ],
      "resourceName": "shop-media",
      "address": "http://127.0.0.1:24452"
    },
    {
      "name": "shop-orders-fulfil-orders",
      "kind": "worker",
      "platform": "local.worker",
      "services": [
        {
          "name": "shop-orders",
          "kind": "API"
        }
      ],
      "calls": [
        {
          "name": "shop-api",
          "kind": "API"
        }
      ],
      "language": "GO",
      "worker": {
        "api": "shop-orders",
        "name": "FulfilOrders",
        "queue": "OrderPlaced",
        "database": "shop-db",
        "instances": 1,
        "concurrency": 4,
        "graceSeconds": 8
      },
      "resourceName": "shop-orders-fulfil-orders",
      "bindings": [
        {
          "field": "FULFILLMENT_REGION",
          "source": "literal",
          "value": "us"
        },
        {
          "field": "MAX_LINE_ITEMS",
          "source": "literal",
          "value": "50",
          "default": true
        },
        {
          "field": "SHOP_API_SERVICE",
          "source": "derived",
          "value": {
            "credential": {
              "audience": "shop-api",
              "issuer": "shop-orders-fulfil-orders",
              "key": {
                "$output": {
                  "resource": "shop-orders-fulfil-orders.calls.shop-api.key",
                  "name": "privateJwk"
                }
              },
              "source": "signed-token"
            },
            "url": "http://127.0.0.1:21829"
          },
          "edge": "http:shop-orders-fulfil-orders->shop-api"
        },
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "url": "postgres://postgres@127.0.0.1:31452/shop_db?sslmode=disable"
          },
          "edge": "sql:shop-orders-fulfil-orders->shop-db"
        },
        {
          "field": "STRIPE_KEY",
          "source": "secret",
          "secret": "PaymentsSecrets.STRIPE_KEY"
        }
      ]
    },
    {
      "name": "shop-orders-ship-orders",
      "kind": "job",
      "platform": "local.job",
      "services": [
        {
          "name": "shop-orders",
          "kind": "API"
        }
      ],
      "calls": [
        {
          "name": "shop-api",
          "kind": "API"
        }
      ],
      "language": "GO",
      "job": {
        "api": "shop-orders",
        "name": "ShipOrders",
        "schedule": "*/15 * * * *",
        "timeZone": "UTC",
        "timeoutSeconds": 300,
        "retries": 1
      },
      "resourceName": "shop-orders-ship-orders",
      "bindings": [
        {
          "field": "FULFILLMENT_REGION",
          "source": "literal",
          "value": "us"
        },
        {
          "field": "MAX_LINE_ITEMS",
          "source": "literal",
          "value": "50",
          "default": true
        },
        {
          "field": "SHOP_API_SERVICE",
          "source": "derived",
          "value": {
            "credential": {
              "audience": "shop-api",
              "issuer": "shop-orders-ship-orders",
              "key": {
                "$output": {
                  "resource": "shop-orders-ship-orders.calls.shop-api.key",
                  "name": "privateJwk"
                }
              },
              "source": "signed-token"
            },
            "url": "http://127.0.0.1:21829"
          },
          "edge": "http:shop-orders-ship-orders->shop-api"
        },
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "url": "postgres://postgres@127.0.0.1:31452/shop_db?sslmode=disable"
          },
          "edge": "sql:shop-orders-ship-orders->shop-db"
        },
        {
          "field": "STRIPE_KEY",
          "source": "secret",
          "secret": "PaymentsSecrets.STRIPE_KEY"
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "bucket:shop-api->shop-media",
      "kind": "bucket",
      "from": "shop-api",
      "to": "shop-media",
      "service": {
        "name": "shop-media",
        "kind": "Bucket"
      },
      "connector": "local.process-gcs",
      "field": "SHOP_MEDIA_BUCKET"
    },
    {
      "id": "http:Orders->shop-api",
      "kind": "http",
      "from": "Orders",
      "to": "shop-api",
      "service": {
        "name": "shop-api",
        "kind": "API"
      },
      "connector": "local.process-process",
      "field": "SHOP_API_SERVICE"
    },
    {
      "id": "http:shop-orders-fulfil-orders->shop-api",
      "kind": "http",
      "from": "shop-orders-fulfil-orders",
      "to": "shop-api",
      "service": {
        "name": "shop-api",
        "kind": "API"
      },
      "connector": "local.worker-process",
      "field": "SHOP_API_SERVICE"
    },
    {
      "id": "http:shop-orders-ship-orders->shop-api",
      "kind": "http",
      "from": "shop-orders-ship-orders",
      "to": "shop-api",
      "service": {
        "name": "shop-api",
        "kind": "API"
      },
      "connector": "local.job-process",
      "field": "SHOP_API_SERVICE"
    },
    {
      "id": "sql:Orders->shop-db",
      "kind": "sql",
      "from": "Orders",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "local.process-postgres",
      "field": "SHOP_DB_DATABASE"
    },
    {
      "id": "sql:shop-api->shop-db",
      "kind": "sql",
      "from": "shop-api",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "local.process-postgres",
      "field": "SHOP_DB_DATABASE"
    },
    {
      "id": "sql:shop-orders-fulfil-orders->shop-db",
      "kind": "sql",
      "from": "shop-orders-fulfil-orders",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "local.worker-postgres",
      "field": "SHOP_DB_DATABASE"
    },
    {
      "id": "sql:shop-orders-ship-orders->shop-db",
      "kind": "sql",
      "from": "shop-orders-ship-orders",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "local.job-postgres",
      "field": "SHOP_DB_DATABASE"
    }
  ],
  "secrets": [
    {
      "id": "PaymentsSecrets.STRIPE_KEY",
      "type": "PaymentsSecrets",
      "field": "STRIPE_KEY",
      "readers": [
        "Orders",
        "shop-api",
        "shop-orders-fulfil-orders",
        "shop-orders-ship-orders"
      ]
    }
  ],
  "resources": {
    "resources": [
      {
        "id": "Orders.calls.shop-api.key",
        "type": "local:serviceauth/keyPair:KeyPair",
        "properties": {
          "algorithm": "Ed25519",
          "callee": "shop-api",
          "caller": "Orders"
        },
        "phase": "infrastructure",
        "owners": [
          "http:Orders->shop-api"
        ]
      },
      {
        "id": "Orders.process",
        "type": "local:process/process:Process",
        "properties": {
          "env": [
            {
              "name": "FULFILLMENT_REGION",
              "value": "us"
            },
            {
              "name": "MAX_LINE_ITEMS",
              "value": "50"
            },
            {
              "name": "SHOP_API_SERVICE_CREDENTIAL_AUDIENCE",
              "value": "shop-api"
            },
            {
              "name": "SHOP_API_SERVICE_CREDENTIAL_ISSUER",
              "value": "Orders"
            },
            {
              "name": "SHOP_API_SERVICE_CREDENTIAL_KEY",
              "value": {
                "$output": {
                  "resource": "Orders.calls.shop-api.key",
                  "name": "privateJwk"
                }
              }
            },
            {
              "name": "SHOP_API_SERVICE_CREDENTIAL_SOURCE",
              "value": "signed-token"
            },
            {
              "name": "SHOP_API_SERVICE_URL",
              "value": "http://127.0.0.1:21829"
            },
            {
              "name": "SHOP_DB_DATABASE_URL",
              "value": "postgres://postgres@127.0.0.1:31452/shop_db?sslmode=disable"
            },
            {
              "name": "SHOP_ORDERS_CALLERS_ISSUERS",
              "value": "0"
            },
            {
              "name": "STRIPE_KEY",
              "secret": "PaymentsSecrets.STRIPE_KEY"
            }
          ],
          "language": "go",
          "module": "server/allow-stack/Orders",
          "name": "orders",
          "port": 22205,
          "readiness": "/readyz"
        },
        "dependsOn": [
          "Orders.calls.shop-api.key"
        ],
        "phase": "rollout",
        "owners": [
          "Orders"
        ]
      },
      {
        "id": "postgres.container",
        "type": "local:docker/container:Container",
        "properties": {
          "env": [
            {
              "name": "POSTGRES_HOST_AUTH_METHOD",
              "value": "trust"
            }
          ],
          "image": "postgres:16-alpine",
          "labels": {
            "superschematic.environment": "Dev",
            "superschematic.stack": "allow-stack"
          },
          "name": "superschematic-allow-stack-dev-postgres",
          "ports": [
            {
              "containerPort": 5432,
              "host": "127.0.0.1",
              "hostPort": 31452
            }
          ],
          "readiness": {
            "exec": [
              "pg_isready",
              "--host",
              "127.0.0.1",
              "--port",
              "5432",
              "--username",
              "postgres",
              "--quiet"
            ]
          }
        },
        "phase": "infrastructure",
        "owners": [
          "shop-db"
        ]
      },
      {
        "id": "shop-api.process",
        "type": "local:process/process:Process",
        "properties": {
          "env": [
            {
              "name": "LOG_LEVEL",
              "value": "info"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS",
              "value": "3"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_0_ALGORITHMS",
              "value": "EdDSA"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_0_AUDIENCE",
              "value": "shop-api"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_0_CALLERS",
              "value": "1"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_0_CALLERS_0_DEPLOYABLE",
              "value": "Orders"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_0_CALLERS_0_SERVES",
              "value": "shop-orders"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_0_CALLERS_0_SUBJECT",
              "value": "Orders"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_0_ISSUER",
              "value": "Orders"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_0_KEYS",
              "value": "1"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_0_KEYS_0_JWK",
              "value": {
                "$output": {
                  "resource": "Orders.calls.shop-api.key",
                  "name": "publicJwk"
                }
              }
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_0_MAX_LIFETIME_SECONDS",
              "value": "300"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_1_ALGORITHMS",
              "value": "EdDSA"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_1_AUDIENCE",
              "value": "shop-api"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_1_CALLERS",
              "value": "1"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_1_CALLERS_0_DEPLOYABLE",
              "value": "shop-orders-fulfil-orders"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_1_CALLERS_0_SERVES",
              "value": "shop-orders"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_1_CALLERS_0_SUBJECT",
              "value": "shop-orders-fulfil-orders"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_1_ISSUER",
              "value": "shop-orders-fulfil-orders"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_1_KEYS",
              "value": "1"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_1_KEYS_0_JWK",
              "value": {
                "$output": {
                  "resource": "shop-orders-fulfil-orders.calls.shop-api.key",
                  "name": "publicJwk"
                }
              }
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_1_MAX_LIFETIME_SECONDS",
              "value": "300"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_2_ALGORITHMS",
              "value": "EdDSA"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_2_AUDIENCE",
              "value": "shop-api"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_2_CALLERS",
              "value": "1"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_2_CALLERS_0_DEPLOYABLE",
              "value": "shop-orders-ship-orders"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_2_CALLERS_0_SERVES",
              "value": "shop-orders"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_2_CALLERS_0_SUBJECT",
              "value": "shop-orders-ship-orders"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_2_ISSUER",
              "value": "shop-orders-ship-orders"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_2_KEYS",
              "value": "1"
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_2_KEYS_0_JWK",
              "value": {
                "$output": {
                  "resource": "shop-orders-ship-orders.calls.shop-api.key",
                  "name": "publicJwk"
                }
              }
            },
            {
              "name": "SHOP_API_CALLERS_ISSUERS_2_MAX_LIFETIME_SECONDS",
              "value": "300"
            },
            {
              "name": "SHOP_DB_DATABASE_URL",
              "value": "postgres://postgres@127.0.0.1:31452/shop_db?sslmode=disable"
            },
            {
              "name": "SHOP_MEDIA_BUCKET_ENDPOINT",
              "value": "http://127.0.0.1:24452"
            },
            {
              "name": "SHOP_MEDIA_BUCKET_NAME",
              "value": "shop-media"
            },
            {
              "name": "STRIPE_KEY",
              "secret": "PaymentsSecrets.STRIPE_KEY"
            }
          ],
          "language": "go",
          "module": "server/allow-stack/shop-api",
          "name": "shop-api",
          "port": 21829,
          "readiness": "/readyz"
        },
        "dependsOn": [
          "Orders.calls.shop-api.key",
          "shop-orders-fulfil-orders.calls.shop-api.key",
          "shop-orders-ship-orders.calls.shop-api.key"
        ],
        "phase": "rollout",
        "owners": [
          "shop-api"
        ]
      },
      {
        "id": "shop-db.database.shop-db",
        "type": "local:postgres/database:Database",
        "properties": {
          "container": {
            "$output": {
              "resource": "postgres.container",
              "name": "name"
            }
          },
          "name": "shop_db",
          "service": "shop-db",
          "url": "postgres://postgres@127.0.0.1:31452/shop_db?sslmode=disable"
        },
        "dependsOn": [
          "postgres.container"
        ],
        "phase": "infrastructure",
        "owners": [
          "shop-db"
        ]
      },
      {
        "id": "shop-media.bucket",
        "type": "local:storage/bucket:Bucket",
        "properties": {
          "container": {
            "$output": {
              "resource": "storage.container",
              "name": "name"
            }
          },
          "endpoint": "http://127.0.0.1:24452",
          "name": "shop-media",
          "service": "shop-media"
        },
        "dependsOn": [
          "storage.container"
        ],
        "phase": "infrastructure",
        "owners": [
          "shop-media"
        ]
      },
      {
        "id": "shop-orders-fulfil-orders.calls.shop-api.key",
        "type": "local:serviceauth/keyPair:KeyPair",
        "properties": {
          "algorithm": "Ed25519",
          "callee": "shop-api",
          "caller": "shop-orders-fulfil-orders"
        },
