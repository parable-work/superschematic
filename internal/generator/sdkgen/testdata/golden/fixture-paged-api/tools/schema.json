    {
      "name": "catalog.listItems",
      "operationId": "CatalogListItemsHandler",
      "title": "",
      "capability": "",
      "lifecycle": "",
      "visibility": "",
      "audience": "",
      "guidance": {"useWhen":"","doNotUseWhen":"","success":"","errors":[]},
      "replay": null,
      "description": "The items, two to a page unless the caller asks for up to five, by\ntheir ids or their stock, in order of their names unless the caller\nsorts them by name or sku, either way. Pages: pass the result's `next` back as `cursor`, with the same `sort`, for the next page; `next` is null after the last.",
      "namespace": "catalog",
      "methodName": "listItems",
      "httpMethod": "GET",
      "httpPath": "/api/items",
      "requiresAuth": false,
      "requiredPermissions": [],
      "isScoped": false,
      "bindingStatus": "ready",
      "inputSchemaDigest": "sha256:29f4e1a9208a47999644619895b7fadb40f7ace3a9397f642fcb7556525390c9",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cursor": {"description":"The `next` of the previous page; absent for the first page.","maxLength":1024,"minLength":1,"pattern":"^[A-Za-z0-9_-]+$","type":"string"},
          "ids": {"description":"Array of Identity.UUID values","items":{"description":"UUID v4 with automatic base62 encoding for client-facing APIs","pattern":"^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$","type":"string","x-superschematic-scalar":"Identity.UUID"},"maxItems":5,"type":"array"},
          "inStock": {"description":"A boolean value (true or false)","type":"boolean"},
          "limit": {"description":"The most items the page holds: 1 to 5, 2 when absent.","maximum":5,"minimum":1,"type":"integer"},
          "sort": {"description":"The order of the page: a field, or - and a field for descending; ties break by id. A cursor holds the sort it was returned under. One of `name`, `-name`, `sku` or `-sku`; `name` when left out.","enum":["name","-name","sku","-sku"],"type":"string","x-superschematic-sort":true}
        }
      },
      "returns": {
        "type": "object",
        "description": "A page of ItemView",
        "properties": {
          "items": {"description":"Array of ItemView","items":{"description":"ItemView object","type":"object"},"type":"array"},
          "next": {"description":"The cursor of the next page, to send as cursor; null after the last page.","type":["string","null"]}
        },
        "required": ["items", "next"]
      }
    },
