{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "{{.MCPBindingVersion}}",
  "generatedAt": "{{.Timestamp}}",
  "apiId": "{{.APIID}}",
  "sdkClassName": "{{.SDKClassName}}",
  "tools": [
{{- range $i, $tool := .Tools}}
{{- if $i}},{{end}}
    {
      "toolName": "{{$tool.Name}}",
      "apiId": "{{$tool.MCPBinding.APIID}}",
      "namespace": "{{$tool.MCPBinding.Namespace}}",
      "methodName": "{{$tool.MCPBinding.MethodName}}",
      "isTenantScoped": {{$tool.MCPBinding.IsTenantNS}}{{if $tool.MCPBinding.TenantParam}},
      "tenantParam": "{{$tool.MCPBinding.TenantParam}}"{{end}},
      "arguments": [
{{- range $j, $argument := $tool.MCPBinding.Arguments}}
{{- if $j}},{{end}}
        {
          "toolParameter": "{{$argument.ToolParameter}}",
          "required": {{$argument.Required}},
          "kind": "{{$argument.Kind}}",
          "target": "{{$argument.Target}}"
        }
{{- end}}
      ],
      "methodArgs": [
{{- range $k, $methodArg := $tool.MCPBinding.MethodArgs}}
{{- if $k}},{{end}}
        {
          "position": {{$methodArg.Position}},
          "kind": "{{$methodArg.Kind}}",
          "target": "{{$methodArg.Target}}"{{if $methodArg.Sources}},
          "sources": [{{range $s, $source := $methodArg.Sources}}{{if $s}}, {{end}}"{{$source}}"{{end}}]{{end}}
        }
{{- end}}
      ]
    }
{{- end}}
  ]
}
