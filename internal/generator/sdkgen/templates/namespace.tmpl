        if ({{.TSName}}Value.length > {{.ValidateListMax}}) {
          {{.TSName}}Errors.push({ validator: 'listMax', message: '{{.Name}} must contain at most {{.ValidateListMax}} items.' });
        }
        {{- end}}
        {{- if .ChecksItems}}
        {{- if and .ItemIsText .ValidatePattern}}
        let {{.TSName}}Pattern: RegExp | null = null;
        try {
          {{.TSName}}Pattern = new RegExp('{{escape_backslash .ValidatePattern}}', 'u');
        } catch {
          // An invalid pattern refuses every item.
        }
        {{- end}}
        {{.TSName}}Value.forEach((item: unknown, index: number) => {
          const itemPath = `{{.TSName}}[${index}]`;
          {{- if .ItemIsText}}
          const itemText = String(item);
          if (/^\p{White_Space}*$/u.test(itemText)) {
            setFieldErrors(queryParamErrors, itemPath, [{ validator: 'required', message: `{{.Name}}[${index}] is required.` }]);
          } else if (itemText.includes(',') || /^\p{White_Space}|\p{White_Space}$/u.test(itemText)) {
            setFieldErrors(queryParamErrors, itemPath, [{ validator: 'pattern', message: `{{.Name}}[${index}] must not contain a comma or surrounding space.` }]);
          {{- if .ValidateMinLength}}
          } else if ([...itemText].length < {{.ValidateMinLength}}) {
            setFieldErrors(queryParamErrors, itemPath, [{ validator: 'minLength', message: `{{.Name}}[${index}] must be at least {{.ValidateMinLength}} characters.` }]);
          {{- end}}
          {{- if .ValidateMaxLength}}
          } else if ([...itemText].length > {{.ValidateMaxLength}}) {
            setFieldErrors(queryParamErrors, itemPath, [{ validator: 'maxLength', message: `{{.Name}}[${index}] must be at most {{.ValidateMaxLength}} characters.` }]);
          {{- end}}
          {{- if .ValidatePattern}}
          } else if ({{.TSName}}Pattern === null || !{{.TSName}}Pattern.test(itemText)) {
            setFieldErrors(queryParamErrors, itemPath, [{ validator: 'pattern', message: `{{.Name}}[${index}] has an invalid format.` }]);
          {{- end}}
          }
          {{- else}}
          const itemNumber = Number(item);
          if (Number.isNaN(itemNumber)) {
            return;
          }
          {{- $next := "if"}}
          {{- if .ValidateMin}}
          {{$next}} (itemNumber < {{.ValidateMin}}) {
            setFieldErrors(queryParamErrors, itemPath, [{ validator: 'min', message: `{{.Name}}[${index}] must be at least {{.ValidateMin}}.` }]);
          {{- $next = "} else if"}}
          {{- end}}
          {{- if .ValidateMax}}
          {{$next}} (itemNumber > {{.ValidateMax}}) {
            setFieldErrors(queryParamErrors, itemPath, [{ validator: 'max', message: `{{.Name}}[${index}] must be at most {{.ValidateMax}}.` }]);
          {{- end}}
          }
          {{- end}}
        });
        {{- end}}
      }
      {{- if .ChecksList}}
      if ({{.TSName}}Errors.length > 0) {
        setFieldErrors(queryParamErrors, "{{.TSName}}", {{.TSName}}Errors);
      }
      {{- end}}
    }
    {{- end}}
    {{- else}}
    {
      const {{.TSName}}Errors: { validator: string; message: string }[] = [];
      const {{.TSName}}Value = {{$queryParamsExpr}}?.{{.TSName}};
      {{- if .Required}}
      if ({{.TSName}}Value === undefined || {{.TSName}}Value === null) {
        {{.TSName}}Errors.push({ validator: 'required', message: '{{.Name}} is required' });
      } else {
      {{- end}}
      {{- if or .ValidateMin .ValidateMax}}
      const {{.TSName}}NumericValue = Number({{.TSName}}Value);
      if (!Number.isNaN({{.TSName}}NumericValue)) {
        {{- if .ValidateMin}}
        if ({{.TSName}}NumericValue < {{.ValidateMin}}) {
          {{.TSName}}Errors.push({ validator: 'min', message: '{{.Name}} must be at least {{.ValidateMin}}.' });
        }
        {{- end}}
        {{- if .ValidateMax}}
        if ({{.TSName}}NumericValue > {{.ValidateMax}}) {
          {{.TSName}}Errors.push({ validator: 'max', message: '{{.Name}} must be at most {{.ValidateMax}}.' });
        }
        {{- end}}
      }
      {{- end}}
      {{- if .ValidateMinLength}}
      if (typeof {{.TSName}}Value === 'string' && [...{{.TSName}}Value].length < {{.ValidateMinLength}}) {
        {{.TSName}}Errors.push({ validator: 'minLength', message: '{{.Name}} must be at least {{.ValidateMinLength}} characters.' });
      }
      {{- end}}
      {{- if .ValidateMaxLength}}
      if (typeof {{.TSName}}Value === 'string' && [...{{.TSName}}Value].length > {{.ValidateMaxLength}}) {
        {{.TSName}}Errors.push({ validator: 'maxLength', message: '{{.Name}} must be at most {{.ValidateMaxLength}} characters.' });
      }
      {{- end}}
      {{- if .ValidatePattern}}
      if (typeof {{.TSName}}Value === 'string') {
        try {
          const {{.TSName}}Pattern = new RegExp('{{escape_backslash .ValidatePattern}}', 'u');
          if (!{{.TSName}}Pattern.test({{.TSName}}Value)) {
            {{.TSName}}Errors.push({ validator: 'pattern', message: '{{.Name}} has an invalid format.' });
          }
        } catch {
          {{.TSName}}Errors.push({ validator: 'pattern', message: '{{.Name}} has an invalid format.' });
        }
      }
      {{- end}}
      {{- if .ValidateListMin}}
      if (Array.isArray({{.TSName}}Value) && {{.TSName}}Value.length < {{.ValidateListMin}}) {
        {{.TSName}}Errors.push({ validator: 'listMin', message: '{{.Name}} must contain at least {{.ValidateListMin}} items.' });
      }
      {{- end}}
      {{- if .ValidateListMax}}
      if (Array.isArray({{.TSName}}Value) && {{.TSName}}Value.length > {{.ValidateListMax}}) {
        {{.TSName}}Errors.push({ validator: 'listMax', message: '{{.Name}} must contain at most {{.ValidateListMax}} items.' });
      }
      {{- end}}
      {{- if .Required}}
      }
      {{- end}}
      if ({{.TSName}}Errors.length > 0) {
        setFieldErrors(queryParamErrors, "{{.TSName}}", {{.TSName}}Errors);
      }
    }
    {{- end}}
    {{- end}}
    if (Object.keys(queryParamErrors).length > 0) {
      throw new ValidationError(queryParamErrors);
    }
    {{- end}}
    {{- if .Page}}
    {
      // The page (D60): limit is a whole number from 1 to {{.Page.MaxLimit}}, and the route
      // answers {{.Page.DefaultLimit}} items when it is absent.
      const limit: unknown = {{if and .ScalarArgs (not .HasInput)}}requestParams{{else}}params{{end}}?.limit;
      if (limit !== undefined && limit !== null) {
        const limitNumber = Number(limit);
        if (!Number.isInteger(limitNumber)) {
          throw new ValidationError({ limit: [{ validator: 'type', message: 'limit must be a whole number.' }] });
        }
        if (limitNumber < 1) {
          throw new ValidationError({ limit: [{ validator: 'min', message: 'limit must be at least 1.' }] });
        }
        if (limitNumber > {{.Page.MaxLimit}}) {
          throw new ValidationError({ limit: [{ validator: 'max', message: 'limit must be at most {{.Page.MaxLimit}}.' }] });
        }
      }
    }
    {{- end}}
    {{- if .Filterable}}
    // Serialize bracket-notation filters into query params
    const filterParams: Record<string, string> = {};
    if (filters) {
      for (const [field, spec] of Object.entries(filters)) {
        if (typeof spec === 'string') {
          filterParams[`filter[${field}]`] = spec;
        } else {
          filterParams[`filter[${field}][${spec.op}]`] = spec.value;
        }
      }
    }
    {{- end}}

    {{- if has_encrypted_body .Method .Encrypted}}
    const requestPayload = await this.client.encryptRequestPayload(
      {{- if .HasInput}}
      input,
      {{- else if .ScalarArgs}}
      scalarInput,
      {{- else}}
      {},
      {{- end}}
      options?.publicEncryptionKey
    );
    {{- end}}

    {{- if eq .Method "GET"}}
    // Make GET request
    {{- if and .ScalarArgs (not .HasInput)}}
    // Scalar args take precedence over @query params; spread order is intentional.
    const scalarParams = { {{if .HasQuery}}...requestParams, {{end}}...scalarInput };
    {{- end}}
    const result = await this.client.get<{{.TSOutputType}}>(
      `{{scoped_path (.TSPath) $.Namespace.IsScopedNS $.Namespace.ScopeParamName}}`,
      { ...toRequestOptions({{if .ScalarArgs}}requestSignal{{else}}signal{{end}}){{if .HasInput}}, data: input{{end}}{{if and .ScalarArgs (not .HasInput)}}{{if .Filterable}}, params: { ...scalarParams, ...filterParams }{{else}}, params: scalarParams{{end}}{{else if and .HasQuery .Filterable}}, params: { ...params, ...filterParams }{{else if .HasQuery}}, params{{else if .Filterable}}, params: filterParams{{end}} }
    );
    {{- else if eq .Method "POST"}}
    // Make POST request
    const result = await this.client.post<{{.TSOutputType}}>(
      `{{scoped_path (.TSPath) $.Namespace.IsScopedNS $.Namespace.ScopeParamName}}`,
      {{- if has_encrypted_body .Method .Encrypted}}
      requestPayload,
      {{- else if .HasInput}}
      input,
      {{- else if .ScalarArgs}}
      scalarInput,
      {{- else}}
      undefined,
      {{- end}}
      { ...toRequestOptions({{if has_encrypted_body .Method .Encrypted}}options{{else if .ScalarArgs}}requestSignal{{else}}signal{{end}}){{if and .HasQuery .Filterable}}, params: { ...{{if .ScalarArgs}}requestParams{{else}}params{{end}}, ...filterParams }{{else if .HasQuery}}, params{{if .ScalarArgs}}: requestParams{{end}}{{else if .Filterable}}, params: filterParams{{end}} }
    );
    {{- else if eq .Method "PUT"}}
    // Make PUT request
    const result = await this.client.put<{{.TSOutputType}}>(
      `{{scoped_path (.TSPath) $.Namespace.IsScopedNS $.Namespace.ScopeParamName}}`,
      {{- if has_encrypted_body .Method .Encrypted}}
      requestPayload,
      {{- else if .HasInput}}
      input,
      {{- else if .ScalarArgs}}
      scalarInput,
      {{- else}}
      undefined,
      {{- end}}
      { ...toRequestOptions({{if has_encrypted_body .Method .Encrypted}}options{{else if .ScalarArgs}}requestSignal{{else}}signal{{end}}){{if and .HasQuery .Filterable}}, params: { ...{{if .ScalarArgs}}requestParams{{else}}params{{end}}, ...filterParams }{{else if .HasQuery}}, params{{if .ScalarArgs}}: requestParams{{end}}{{else if .Filterable}}, params: filterParams{{end}} }
    );
    {{- else if eq .Method "PATCH"}}
    // Make PATCH request
    const result = await this.client.patch<{{.TSOutputType}}>(
      `{{scoped_path (.TSPath) $.Namespace.IsScopedNS $.Namespace.ScopeParamName}}`,
      {{- if has_encrypted_body .Method .Encrypted}}
      requestPayload,
      {{- else if .HasInput}}
      input,
      {{- else if .ScalarArgs}}
      scalarInput,
      {{- else}}
      undefined,
      {{- end}}
      { ...toRequestOptions({{if has_encrypted_body .Method .Encrypted}}options{{else if .ScalarArgs}}requestSignal{{else}}signal{{end}}){{if and .HasQuery .Filterable}}, params: { ...{{if .ScalarArgs}}requestParams{{else}}params{{end}}, ...filterParams }{{else if .HasQuery}}, params{{if .ScalarArgs}}: requestParams{{end}}{{else if .Filterable}}, params: filterParams{{end}} }
    );
    {{- else if eq .Method "DELETE"}}
    // Make DELETE request; config.data carries its input or its arguments as
    // the body, where the route reads them.
    const result = await this.client.delete<{{.TSOutputType}}>(
      `{{scoped_path (.TSPath) $.Namespace.IsScopedNS $.Namespace.ScopeParamName}}`,
      { ...toRequestOptions({{if .ScalarArgs}}requestSignal{{else}}signal{{end}}){{if .HasInput}}, data: input{{else if .ScalarArgs}}, data: scalarInput{{end}}{{if and .HasQuery .Filterable}}, params: { ...{{if .ScalarArgs}}requestParams{{else}}params{{end}}, ...filterParams }{{else if .HasQuery}}, params{{if .ScalarArgs}}: requestParams{{end}}{{else if .Filterable}}, params: filterParams{{end}} }
    );
    {{- end}}

    {{- if $endpoint.HasOutputParser}}
    {{- if $endpoint.Page}}
    return {
      items: Array.isArray(result.items) ? result.items.map(parse{{type_ref $endpoint.OutputType}}FromJSON) : result.items,
      next: result.next,
    };
    {{- else if $endpoint.OutputIsMap}}
    return result !== null && typeof result === 'object'
      ? Object.fromEntries(
          Object.entries(result).map(([key, value]) => [key, {{if $endpoint.OutputIsArray}}Array.isArray(value) ? value.map(parse{{type_ref $endpoint.OutputType}}FromJSON) : value{{else}}parse{{type_ref $endpoint.OutputType}}FromJSON(value){{end}}])
        )
      : result;
    {{- else if $endpoint.OutputIsArrayOfArrays}}
    return Array.isArray(result)
      ? result.map((row) => (Array.isArray(row) ? row.map(parse{{type_ref $endpoint.OutputType}}FromJSON) : row))
      : result;
    {{- else if $endpoint.OutputIsArray}}
    return Array.isArray(result) ? result.map(parse{{type_ref $endpoint.OutputType}}FromJSON) : result;
    {{- else if $endpoint.OutputNullable}}
    return result === null ? null : parse{{type_ref $endpoint.OutputType}}FromJSON(result);
    {{- else}}
    return parse{{type_ref $endpoint.OutputType}}FromJSON(result);
    {{- end}}
    {{- else}}
    return result;
    {{- end}}
  }
  {{- if .Page}}
  {{- $scoped := $.Namespace.IsScopedNS}}
  {{- $scope := $.Namespace.ScopeParamName}}

  /**
   * Every item of {{.Name}}, page after page (D60): it asks for each page with
   * the next of the page before, from params.cursor (absent for the first
   * page) with params.limit items a page, and only when the loop has taken
   * every item of the page before. It stops after the page whose next is
   * null; an error ends it: the one a page failed with, or one for a page
   * whose next is the cursor it was asked with.
   {{- range .PathParams}}
   {{- if not (and $scoped (eq .TSName $scope))}}
   * @param {{.TSName}} - {{.Name}} parameter
   {{- end}}
   {{- end}}
   {{- if .HasInput}}
   * @param input - Request payload
   {{- else if .ScalarArgs}}
   {{- range .ScalarArgs}}
   * @param {{toCamelCase .Name}} - {{.Name}} argument
   {{- end}}
   {{- end}}
   * @param params - Optional query parameters, as {{.Name}} takes them
   {{- if .Filterable}}
   * @param filters - Optional bracket-notation filters (filter[field]=value)
   {{- end}}
   * @param signal - Optional AbortSignal, or RequestOptions with a signal and an end user to forward, for every page
   * @returns An AsyncIterable of {{type_ref .OutputType}}
   */
  public {{.AllName}}(
    {{- range .PathParams}}
    {{- if not (and $scoped (eq .TSName $scope))}}
    {{.TSName}}: {{.TSType}},
    {{- end}}
    {{- end}}
    {{- if .HasInput}}
    input: {{type_ref .InputType}},
    {{- else if .ScalarArgs}}
    {{- range .ScalarArgs}}
    {{toCamelCase .Name}}{{if not .Required}}?{{end}}: any,
    {{- end}}
    {{- end}}
    params?: any,
    {{- if .Filterable}}
    filters?: FilterParam,
    {{- end}}
    signal?: any
  ): AsyncIterable<{{.TSItemType}}> {
    {{- $pathArgs := ""}}
    {{- range .PathParams}}
    {{- if not (and $scoped (eq .TSName $scope))}}
    {{- $pathArgs = printf "%s%s, " $pathArgs .TSName}}
    {{- end}}
    {{- end}}
    {{- $tail := "signal"}}
    {{- if .Filterable}}
    {{- $tail = "filters, signal"}}
    {{- end}}
    {{- if and .ScalarArgs (not .HasInput) (gt (len .ScalarArgs) 1)}}
    {{- $first := toCamelCase (index .ScalarArgs 0).Name}}
    {{- $second := toCamelCase (index .ScalarArgs 1).Name}}
    {{- $rest := ""}}
    {{- range $i, $arg := .ScalarArgs}}
    {{- if gt $i 1}}
    {{- $rest = printf "%s%s, " $rest (toCamelCase $arg.Name)}}
    {{- end}}
    {{- end}}
    // The object call, {{.AllName}}({ {{range $i, $arg := .ScalarArgs}}{{if $i}}, {{end}}{{toCamelCase $arg.Name}}{{end}} }, params, signal), takes the
    // query parameters second, as {{.Name}} does.
    if (typeof {{$first}} === 'object' && {{$first}} !== null && !Array.isArray({{$first}})) {
      const query: any = {{$second}};
      return pageItems('{{.Page.Operation}}', query?.cursor, (cursor) =>
        this.{{.Name}}({{$pathArgs}}{{$first}}, { ...query, cursor }, {{$rest}}params, {{$tail}})
      );
    }
    {{- end}}
    return pageItems('{{.Page.Operation}}', params?.cursor, (cursor) =>
      this.{{.Name}}({{$pathArgs}}{{if .HasInput}}input, {{else}}{{range .ScalarArgs}}{{toCamelCase .Name}}, {{end}}{{end}}{ ...params, cursor }, {{$tail}})
    );
  }
  {{- end}}
  {{- end}}
  {{- end}}
}
