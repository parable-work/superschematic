// The implementation of the {{ .SchemaName }} API.
//
// superschematic wrote this package once, as a scaffold, because it was
// missing. It never writes it again: the package is yours. Each method
// answers 501 Not Implemented until you implement it.
{{- if .HasJobs }}
// Each job fails until you implement it.
{{- end }}
{{- if .HasWorkers }}
// Each worker fails every message until you implement it.
{{- end }}
{{- if .HasDerivers }}
// Each deriver fails every field until you implement it.
{{- end }}

import { notImplemented{{ if .WebhookProviders }}, unauthorized{{ end }} } from '{{ .RuntimePackage }}';
import type {
{{- if .ChecksEndUsers }}
  AuthenticatorFactory,
{{- end }}
  Constructor,
  Deps,
{{- if .HasDerivers }}
  DeriversConstructor,
{{- end }}
{{- if .HasJobs }}
  JobsConstructor,
{{- end }}
{{- if .HasManualRoutes }}
  ManualRoutesConstructor,
{{- end }}
{{- if .HasWorkers }}
  WorkersConstructor,
{{- end }}
{{- range .Namespaces }}
  {{ .InterfaceName }},
{{- end }}
} from '{{ .PackageName }}';

/** Builds the implementation of {{ .SchemaName }} from its dependencies. Its type is the generated Constructor. */
export const create: Constructor = deps => ({
{{- range .Namespaces }}
  {{ .Property }}: {{ .Property }}Implementation(deps),
{{- end }}
{{- if .WebhookProviders }}
  // The verifier of each @hmacVerified provider, which checks the
  // signature of its requests. The scaffold's refuses every request.
  webhookVerifiers: {
{{- range .WebhookProviders }}
    {{ tsString . }}: async () => {
      throw unauthorized({{ tsString (printf "%s verifies no %s signature yet" $.SchemaName .) }});
    },
{{- end }}
  },
{{- end }}
});
{{- if .ChecksEndUsers }}

/**
 * Builds the authenticator that establishes the end user on the routes
 * that require one. The scaffold's establishes none, so each such route
 * answers 401: verify the request's credential (ctx.bearerToken, or a
 * header) with your identity provider and return its Principal.
 */
export const authenticate: AuthenticatorFactory = () => async () => null;
{{- end }}
{{- if .HasManualRoutes }}

/**
 * Builds the handlers of the @manualRouteRegistration operations of
 * {{ .SchemaName }} from its dependencies. Its type is the generated
 * ManualRoutesConstructor. The router runs each route's auth gate, then
 * hands its handler the Hono context and the RequestContext, and sends the
 * Response the handler returns.
 */
export const createManualRoutes: ManualRoutesConstructor = deps => ({
{{- range .ManualEndpoints }}
  async {{ .Key }}() {
    throw notImplemented('{{ .NamespaceProperty }}.{{ .Name }}');
  },
{{- end }}
});
{{- end }}
{{- if .HasJobs }}

/**
 * Builds the jobs of {{ .SchemaName }} from its dependencies. Its type is the
 * generated JobsConstructor. A job's entrypoint calls one method per run,
 * with a signal that SIGTERM aborts; the run fails when it rejects.
 */
export const createJobs: JobsConstructor = deps => ({
{{- range .Jobs }}
  async {{ .Method }}() {
    throw notImplemented('job {{ .Name }}');
  },
{{- end }}
});
{{- end }}
{{- if .HasWorkers }}

/**
 * Builds the workers of {{ .SchemaName }} from its dependencies. Its type is the
 * generated WorkersConstructor. A worker's entrypoint calls one method per
 * message it claims; the message is done when it resolves, and fails, to be
 * retried, when it rejects. A message may come again, so a method is
 * idempotent.
 */
export const createWorkers: WorkersConstructor = deps => ({
{{- range .Workers }}
  async {{ .Method }}(message) {
    throw notImplemented('worker {{ .Name }}');
  },
{{- end }}
});
{{- end }}
{{- if .HasDerivers }}

/**
 * Builds the derivers of {{ .SchemaName }} from its dependencies. Its type is the
 * generated DeriversConstructor. A deriver's entrypoint calls the method of
 * each stale derived field, which asks a model; a value settles the field,
 * and a failure or a rejection counts an attempt.
 */
export const createDerivers: DeriversConstructor = deps => ({
{{- range .Derivers }}
  {{ .Member }}: {
{{- $deriver := . }}
{{- range .Methods }}
    async {{ .Method }}(item) {
      throw notImplemented('deriver {{ $deriver.Name }}, {{ .Schema }}.{{ .Field }}');
    },
{{- end }}
  },
{{- end }}
});
{{- end }}
{{- range .Namespaces }}

function {{ .Property }}Implementation(deps: Deps): {{ .InterfaceName }} {
  return {
{{- $ns := . }}
{{- range .Endpoints }}
    async {{ .Name }}() {
      throw notImplemented('{{ $ns.Property }}.{{ .Name }}');
    },
{{- end }}
  };
}
{{- end }}
