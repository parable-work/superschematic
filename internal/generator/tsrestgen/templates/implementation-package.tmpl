{
  "name": "{{ .ImplementationPackage }}",
  "version": "0.0.0",
  "description": "The implementation of the {{ .SchemaName }} API.",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
{{- range $i, $dep := .ImplementationDependencies }}{{ if $i }},{{ end }}
    "{{ $dep.Name }}": "{{ $dep.Spec }}"
{{- end }}
  },
  "devDependencies": {
    "@types/node": "{{ .NodeTypesVersion }}",
    "typescript": "{{ .TSVersion }}"
  }
}
