{
  "name": "{{ .ImplementationPackage }}",
  "version": "0.0.0",
  "description": "The implementation of the {{ .SchemaName }} API.",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "{{ .PackageName }}": "workspace:*",
    "{{ .TypesPackage }}": "workspace:*",
{{- if and .Deps.DatabaseTypesPackage (ne .Deps.DatabaseTypesPackage .TypesPackage) }}
    "{{ .Deps.DatabaseTypesPackage }}": "workspace:*",
{{- end }}
{{- range .Deps.MemoryStores }}
{{- if .Definitions }}
    "{{ .Definitions }}": "workspace:*",
{{- end }}
{{- end }}
    "{{ .RuntimePackage }}": "*"
  },
  "devDependencies": {
    "@types/node": "{{ .NodeTypesVersion }}",
    "typescript": "{{ .TSVersion }}"
  }
}
