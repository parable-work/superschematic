{
  "name": "{{ .PackageName }}",
  "version": "1.0.0",
  "description": "Generated TypeScript API server for the {{ .SchemaName }} schema. DO NOT EDIT.",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    },
    "./interfaces": {
      "types": "./interfaces.ts",
      "import": "./interfaces.ts"
    },
    "./router": {
      "types": "./router.ts",
      "import": "./router.ts"
    },
    "./deps": {
      "types": "./deps.ts",
      "import": "./deps.ts"
    },
{{- if .HasEnvConfig }}
    "./config": {
      "types": "./config.ts",
      "import": "./config.ts"
    },
{{- end }}
    "./openapi.json": "./openapi.json"
{{- if .PermissionCatalogJSON }},
    "./permissions.json": "./permissions.json"
{{- end }}
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "api",
    "server",
    "hono",
    "typescript",
    "{{ .SchemaName }}"
  ],
  "author": "{{ .Author }}",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {},
  "peerDependencies": {
{{- range $i, $pkg := .PeerPackages }}
    "{{ $pkg }}": "*",
{{- end }}
{{- range .DepsPeerPackages }}
    "{{ . }}": "*",
{{- end }}
    "{{ .RuntimePackage }}": "*",
{{- if .Deps.Database }}
    "hono": "{{ .HonoVersion }}",
    "pg": "{{ .PGPeerRange }}"
{{- else }}
    "hono": "{{ .HonoVersion }}"
{{- end }}
  },
  "devDependencies": {
    "@types/node": "{{ .NodeTypesVersion }}",
{{- if .Deps.Database }}
    "@types/pg": "{{ .PGTypesVersion }}",
{{- end }}
    "hono": "{{ .HonoVersion }}",
    "typescript": "{{ .TSVersion }}"
  }
}
