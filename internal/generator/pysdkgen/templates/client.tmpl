                raise SDKError("public_encryption_key.public_key is empty") from None
            try:
                parsed_key = serialization.load_der_public_key(base64.b64decode(normalized))
            except ValueError as err:
                raise SDKError("public_encryption_key.public_key must be a valid public key") from err

        if not isinstance(parsed_key, rsa.RSAPublicKey):
            raise SDKError("public_encryption_key.public_key must be an RSA public key")
        return parsed_key

    def _rsa_oaep_padding(self) -> padding.OAEP:
        self._ensure_cryptography()
        return padding.OAEP(
            mgf=padding.MGF1(algorithm=hashes.SHA256()),
            algorithm=hashes.SHA256(),
            label=None,
        )

    def _log_debug(self, message: str, **fields: Any) -> None:
        if not self._debug:
            return
        if fields:
            self._logger.debug("%s %s", message, fields)
            return
        self._logger.debug(message)

    def _log_error(self, message: str, **fields: Any) -> None:
        if fields:
            self._logger.error("%s %s", message, fields)
            return
        self._logger.error(message)

    @staticmethod
    def _json_default(value: Any) -> Any:
        if isinstance(value, Enum):
            return value.value
        if hasattr(value, "to_dict") and callable(value.to_dict):
            return value.to_dict()
        if hasattr(value, "model_dump") and callable(value.model_dump):
            return value.model_dump(by_alias=True, mode="json", exclude_none=True)
        if is_dataclass(value):
            return asdict(value)
        raise TypeError(f"Object of type {type(value).__name__} is not JSON serializable")
