{
  "name": "@acme/fixture-api-api",
  "version": "1.0.0",
  "description": "Generated TypeScript API server for the fixture-api schema. DO NOT EDIT.",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    },
    "./interfaces": {
      "types": "./interfaces.ts",
      "import": "./interfaces.ts"
    },
    "./router": {
      "types": "./router.ts",
      "import": "./router.ts"
    },
    "./deps": {
      "types": "./deps.ts",
      "import": "./deps.ts"
    },
    "./config": {
      "types": "./config.ts",
      "import": "./config.ts"
    },
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "api",
    "server",
    "hono",
    "typescript",
    "fixture-api"
  ],
  "author": "Acme Corp",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {},
  "peerDependencies": {
    "@acme/fixture-api-types": "*",
    "@acme/http-runtime": "*",
    "hono": "4.13.8",
    "pg": ">=8.11.0"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/pg": "8.23.1",
    "hono": "4.13.8",
    "typescript": "5.9.3"
  }
}
