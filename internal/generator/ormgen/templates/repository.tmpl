// batch{{ toGoName $rel.FieldName }}ByIDs fetches multiple {{ $rel.TargetType }} records by their IDs using a single query.
//
// This is the recursion point: the FindMany below hydrates {{ $rel.TargetType }}'s own
// relations, which lands back here for each of them. enterRelationHydration is
// what bounds that -- see the guard's contract in utils.go. defaultSelection
// says whether the caller named a nested selection or fell back to
// {{ $rel.TargetType }}Fields{}.All(); only the fallback is pruned.
//
// A refusal returns no rows rather than an error, because the caller's miss
// path already writes the id-only stub that a refused expansion should produce.
func (r *{{ $.Name }}) batch{{ toGoName $rel.FieldName }}ByIDs(ctx context.Context, ids []{{ $.UUIDGoType }}, opts *{{ $rel.TargetType }}FindOptions, defaultSelection bool) (map[{{ $.UUIDGoType }}]*types.{{ $rel.TargetType }}, error) {
	if len(ids) == 0 {
		return map[{{ $.UUIDGoType }}]*types.{{ $rel.TargetType }}{}, nil
	}

	ctx, allowed := enterRelationHydration(ctx, "{{ $.TypeName }}", "{{ $rel.FieldName }}", "{{ $rel.TargetType }}", defaultSelection)
	if !allowed {
		return map[{{ $.UUIDGoType }}]*types.{{ $rel.TargetType }}{}, nil
	}

	// Get repository for related type
	var repo *{{ $rel.TargetType }}Repository
	if r.tx != nil {
		txDB := r.txDB
		if txDB == nil {
			txDB = r.db
		}
		repo = &{{ $rel.TargetType }}Repository{tx: r.tx, txDB: txDB}
	} else if r.db != nil {
		repo = r.db.{{ $rel.TargetType }}
	} else if r.txDB != nil {
		repo = r.txDB.{{ $rel.TargetType }}
	} else {
		return nil, fmt.Errorf("no database connection available for batch fetch")
	}

	findOpts := opts
	if findOpts == nil || findOpts.Fields.IsZero() {
		findOpts = &{{ $rel.TargetType }}FindOptions{
			Fields: ({{ $rel.TargetType }}Fields{}).All(),
		}
	} else {
		optsCopy := *findOpts
		findOpts = &optsCopy
	}

	if findOpts.Limit <= 0 || findOpts.Limit < len(ids) {
		findOpts.Limit = len(ids)
	}

	relatedRecords, err := repo.findRelated(
		ctx,
		&{{ $rel.TargetType }}Filter{
			Id: &UUIDFilter{
				In: ids,
			},
		},
		findOpts,
	)
	if err != nil {
		return nil, err
	}

	relatedByID := make(map[{{ $.UUIDGoType }}]*types.{{ $rel.TargetType }}, len(relatedRecords))
	for _, related := range relatedRecords {
		if related == nil {
			continue
		}
		relatedID, ok := {{ lowerFirst $.TypeName }}UUIDValue(related.Id)
		if !ok {
			continue
		}
		relatedByID[relatedID] = related
	}

	return relatedByID, nil
}
