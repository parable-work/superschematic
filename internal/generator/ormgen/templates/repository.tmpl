	results := []*types.{{ .TypeName }}{}
	for rows.Next() {
		result := &types.{{ .TypeName }}{}

		// Create temporary variables for nullable fields that need pointer scanning (per-row)
		{{ template "nullableTempVarsFields" .Fields }}

		// Create temporary variables for relationship foreign keys (we don't store these directly on the struct)
		{{- range $i, $rel := .Relationships }}
		{{- if not $rel.IsArray }}
		var tempRel{{ toGoName $rel.FieldName }} *{{ $.UUIDGoType }}
		{{- end }}
		{{- end }}

		// Track whether special fields were selected so we can post-process after Scan.
		{{ template "nullableSelectedFlagsFields" .Fields }}
		{{- range $i, $rel := .Relationships }}
		{{- if not $rel.IsArray }}
		var selectedRel{{ toGoName $rel.FieldName }} bool
		{{- end }}
		{{- end }}

		scanDest := make([]any, len(fieldStrings))
		for i, fieldName := range fieldStrings {
			switch fieldName {
		{{- range $i, $field := .Fields }}
		{{ template "scanDestCaseForField" $field }}
		{{- end }}
			{{- range $i, $rel := .Relationships }}
			{{- if not $rel.IsArray }}
			case "{{ $rel.DBColumnName }}":
				scanDest[i] = &tempRel{{ toGoName $rel.FieldName }}
				selectedRel{{ toGoName $rel.FieldName }} = true
			{{- end }}
			{{- end }}
			default:
				return nil, 0, fmt.Errorf("unexpected field %q for {{ .TypeName }}.FindMany", fieldName)
			}
		}

		if err := rows.Scan(scanDest...); err != nil {
			return nil, 0, fmt.Errorf("failed to scan row: %w", err)
		}

		// Copy nullable fields when present
		{{ template "nullablePostCopyFields" .Fields }}

		// Set relationship IDs from scanned FK values (hydration happens after loop)
		{{- range $i, $rel := .Relationships }}
		{{- if not $rel.IsArray }}
		if selectedRel{{ toGoName $rel.FieldName }} && tempRel{{ toGoName $rel.FieldName }} != nil {
			{{- if $rel.IsRequired }}
			result.{{ toGoName $rel.FieldName }}.Id = {{ if $rel.TargetPrimaryKeyIsPointer }}{{ lowerFirst $.TypeName }}UUIDPtr(*tempRel{{ toGoName $rel.FieldName }}){{ else }}*tempRel{{ toGoName $rel.FieldName }}{{ end }}
			{{- else }}
			// Initialize pointer for optional relationship before setting ID
			result.{{ toGoName $rel.FieldName }} = &types.{{ $rel.TargetType }}{Id: {{ if $rel.TargetPrimaryKeyIsPointer }}{{ lowerFirst $.TypeName }}UUIDPtr(*tempRel{{ toGoName $rel.FieldName }}){{ else }}*tempRel{{ toGoName $rel.FieldName }}{{ end }}}
			{{- end }}
		}
		{{- end }}
		{{- end }}

		results = append(results, result)
	}

	if err := rows.Err(); err != nil {
		return nil, 0, fmt.Errorf("error iterating rows: %w", err)
	}

	// Batch hydrate relationships (outside the row loop for efficiency)
	{{- range $i, $rel := .Relationships }}
	{{- if not $rel.IsArray }}
	if opts.Fields.{{ toGoName $rel.FieldName }} || {{- if eq $rel.TargetType $.TypeName }} (opts.Fields.{{ toGoName $rel.FieldName }}Nested != nil && !opts.Fields.{{ toGoName $rel.FieldName }}Nested.IsZero()) {{- else }} !opts.Fields.{{ toGoName $rel.FieldName }}Nested.IsZero() {{- end }} {
		// Collect unique FK IDs from results (dedupe during collection)
		{{ $rel.FieldName }}IDSet := make(map[{{ $.UUIDGoType }}]bool)
		var {{ $rel.FieldName }}IDs []{{ $.UUIDGoType }}
		for _, result := range results {
			var zeroID {{ $.UUIDGoType }}
			{{- if $rel.IsRequired }}
			{{ $rel.FieldName }}ID, ok := {{ lowerFirst $.TypeName }}UUIDValue(result.{{ toGoName $rel.FieldName }}.Id)
			if ok && {{ $rel.FieldName }}ID != zeroID && !{{ $rel.FieldName }}IDSet[{{ $rel.FieldName }}ID] {
				{{ $rel.FieldName }}IDSet[{{ $rel.FieldName }}ID] = true
				{{ $rel.FieldName }}IDs = append({{ $rel.FieldName }}IDs, {{ $rel.FieldName }}ID)
			}
			{{- else }}
			// Check if optional relationship pointer is not nil before accessing Id
			if result.{{ toGoName $rel.FieldName }} != nil {
				{{ $rel.FieldName }}ID, ok := {{ lowerFirst $.TypeName }}UUIDValue(result.{{ toGoName $rel.FieldName }}.Id)
				if ok && {{ $rel.FieldName }}ID != zeroID && !{{ $rel.FieldName }}IDSet[{{ $rel.FieldName }}ID] {
					{{ $rel.FieldName }}IDSet[{{ $rel.FieldName }}ID] = true
					{{ $rel.FieldName }}IDs = append({{ $rel.FieldName }}IDs, {{ $rel.FieldName }}ID)
				}
			}
			{{- end }}
		}

		// Batch fetch related entities with typed child field options.
		childFields := ({{ $rel.TargetType }}Fields{}).All()
		childFieldsAreDefault := true
		{{- if eq $rel.TargetType $.TypeName }}
		if opts.Fields.{{ toGoName $rel.FieldName }}Nested != nil && !opts.Fields.{{ toGoName $rel.FieldName }}Nested.IsZero() {
			childFields = *opts.Fields.{{ toGoName $rel.FieldName }}Nested
			childFieldsAreDefault = false
		}
		{{- else }}
		if !opts.Fields.{{ toGoName $rel.FieldName }}Nested.IsZero() {
			childFields = opts.Fields.{{ toGoName $rel.FieldName }}Nested
			childFieldsAreDefault = false
		}
		{{- end }}

		{{ $rel.FieldName }}Map, err := r.batch{{ toGoName $rel.FieldName }}ByIDs(ctx, {{ $rel.FieldName }}IDs, &{{ $rel.TargetType }}FindOptions{
			Fields: childFields,
			Limit:  len({{ $rel.FieldName }}IDs),
		}, childFieldsAreDefault)
		if err != nil {
			return nil, 0, fmt.Errorf("failed to batch fetch {{ $rel.FieldName }}: %w", err)
		}

		// Hydrate results from map
		for _, result := range results {
			{{- if $rel.IsRequired }}
			{{ $rel.FieldName }}ID, ok := {{ lowerFirst $.TypeName }}UUIDValue(result.{{ toGoName $rel.FieldName }}.Id)
			if ok {
				if rel, ok := {{ $rel.FieldName }}Map[{{ $rel.FieldName }}ID]; ok {
					result.{{ toGoName $rel.FieldName }} = *rel
				}
			}
			{{- else }}
			// Check if optional relationship pointer is not nil before accessing Id
			if result.{{ toGoName $rel.FieldName }} != nil {
				{{ $rel.FieldName }}ID, ok := {{ lowerFirst $.TypeName }}UUIDValue(result.{{ toGoName $rel.FieldName }}.Id)
				if ok {
					if rel, ok := {{ $rel.FieldName }}Map[{{ $rel.FieldName }}ID]; ok {
						result.{{ toGoName $rel.FieldName }} = rel
					}
				}
			}
			{{- end }}
		}
	}
	{{- end }}
	{{- end }}
	{{- range $i, $rel := .Relationships }}
	{{- if $rel.IsArray }}
	if opts.Fields.{{ toGoName $rel.FieldName }}Nested != nil {
		childFields := *opts.Fields.{{ toGoName $rel.FieldName }}Nested
		if childFields.IsZero() {
			childFields = {{ $rel.TargetType }}Fields{Id: true}
		}
		childFieldsValue := reflect.ValueOf(&childFields).Elem()
		parentRelationFieldCandidates := []string{
			{{- if $rel.HasManyParentRelationField }}
			"{{ $rel.HasManyParentRelationField }}",
			{{- end }}
			"{{ $.TypeName }}",
			"{{ toGoName $rel.FieldName }}",
		}
		for _, candidate := range parentRelationFieldCandidates {
			field := childFieldsValue.FieldByName(candidate)
			if !field.IsValid() || !field.CanSet() || field.Kind() != reflect.Bool {
