		}

		parentIDSet := make(map[{{ $.UUIDGoType }}]bool, len(results))
		parentIDs := make([]{{ $.UUIDGoType }}, 0, len(results))
		for _, result := range results {
			if result == nil {
				continue
			}
			resultID, ok := {{ lowerFirst $.TypeName }}UUIDValue(result.Id)
			if !ok {
				continue
			}
			if !parentIDSet[resultID] {
				parentIDSet[resultID] = true
				parentIDs = append(parentIDs, resultID)
			}
		}
		if len(parentIDs) > 0 {
			// Get repository for related type
			var repo *{{ $rel.TargetType }}Repository
			if r.tx != nil {
				txDB := r.txDB
				if txDB == nil {
					txDB = r.db
				}
				repo = &{{ $rel.TargetType }}Repository{tx: r.tx, txDB: txDB}
			} else if r.db != nil {
				repo = r.db.{{ $rel.TargetType }}
			} else if r.txDB != nil {
				repo = r.txDB.{{ $rel.TargetType }}
			} else {
				return nil, 0, fmt.Errorf("no database connection available for {{ $rel.FieldName }} hydration")
			}

			childFilter := &{{ $rel.TargetType }}Filter{}
			childFilterValue := reflect.ValueOf(childFilter).Elem()
			filterFieldCandidates := []string{
				{{- if $rel.HasManyParentFilterField }}
				"{{ $rel.HasManyParentFilterField }}",
				{{- end }}
				"{{ $.TypeName }}ID",
				"{{ toGoName $rel.FieldName }}ID",
			}
			var selectedFilterField string
			filterSet := false
			for _, candidate := range filterFieldCandidates {
				field := childFilterValue.FieldByName(candidate)
				if !field.IsValid() || !field.CanSet() {
					continue
				}
				field.Set(reflect.ValueOf(&UUIDFilter{
					In: parentIDs,
				}))
				selectedFilterField = candidate
				filterSet = true
				break
			}
			if !filterSet {
				return nil, 0, fmt.Errorf("failed to locate hasMany FK filter for {{ $.TypeName }}.{{ $rel.FieldName }}")
			}

			// The other recursion point: these children hydrate their own relations.
			// This block only runs on an explicit nested selection, so the cycle half
			// of the guard does not apply and only the depth cap can refuse it.
			children := []*types.{{ $rel.TargetType }}{}
			if hydrationCtx, allowed := enterRelationHydration(ctx, "{{ $.TypeName }}", "{{ $rel.FieldName }}", "{{ $rel.TargetType }}", false); allowed {
				fetched, _, findErr := repo.FindMany(hydrationCtx, childFilter, &{{ $rel.TargetType }}FindOptions{
					Fields: childFields,
					Limit:  1000000,
				})
				if findErr != nil {
					return nil, 0, fmt.Errorf("failed to batch fetch {{ $rel.FieldName }}: %w", findErr)
				}
				children = fetched
			}

			parentFieldCandidates := []string{
				{{- if $rel.HasManyParentRelationField }}
				"{{ $rel.HasManyParentRelationField }}",
				{{- end }}
				strings.TrimSuffix(selectedFilterField, "ID"),
				"{{ $.TypeName }}",
				"{{ toGoName $rel.FieldName }}",
			}
			childrenByParentID := make(map[{{ $.UUIDGoType }}][]types.{{ $rel.TargetType }}, len(parentIDs))
			for _, child := range children {
				if child == nil {
					continue
				}
				childValue := reflect.ValueOf(child)
				if childValue.Kind() == reflect.Ptr {
					if childValue.IsNil() {
						continue
					}
					childValue = childValue.Elem()
				}
				if !childValue.IsValid() || childValue.Kind() != reflect.Struct {
					continue
				}

				var parentID {{ $.UUIDGoType }}
				foundParent := false
				for _, candidate := range parentFieldCandidates {
					parentField := childValue.FieldByName(candidate)
					if !parentField.IsValid() {
						continue
					}
					if parentField.Kind() == reflect.Ptr {
						if parentField.IsNil() {
							continue
						}
						parentField = parentField.Elem()
					}
					if !parentField.IsValid() || parentField.Kind() != reflect.Struct {
						continue
					}
					idField := parentField.FieldByName("Id")
					if !idField.IsValid() || !idField.CanInterface() {
						continue
					}
					id, ok := {{ lowerFirst $.TypeName }}UUIDValue(idField.Interface())
					if !ok {
						continue
					}
					parentID = id
					foundParent = true
					break
				}
				if !foundParent {
					continue
				}

				childrenByParentID[parentID] = append(childrenByParentID[parentID], *child)
			}

			for _, result := range results {
				if result == nil {
					continue
				}
				resultID, ok := {{ lowerFirst $.TypeName }}UUIDValue(result.Id)
				if !ok {
					continue
				}
				result.{{ toGoName $rel.FieldName }} = childrenByParentID[resultID]
			}
		}
	}
	{{- end }}
	{{- end }}

	return results, totalCount, nil
}

// CreateOne inserts a new {{ .TypeName }} record
func (r *{{ .Name }}) CreateOne(ctx context.Context, input *types.{{ .TypeName }}) (*types.{{ .TypeName }}, error) {
	// Set audit fields
	{{- range .Fields }}
	{{- if eq .Name "createdBy" }}
	if !HasUserID(ctx) {
		return nil, ErrNoUserInContext
	}
	input.CreatedBy = GetUserID(ctx)
	{{- end }}
	{{- if eq .Name "updatedBy" }}
	input.UpdatedBy = GetUserID(ctx)
	{{- end }}
	{{- end }}

	// Build INSERT query
	var fields []string
	var placeholders []string
	var values []interface{}
	paramNum := 0

	{{- range .Fields }}
	{{- if and .IsPrimaryKey $.PrimaryKeyIsUUID }}
	// Schema-owned identities may supply a stable UUID. A zero value keeps the
	// database-generated default used by ordinary creates.
	{
		var zeroPrimaryKey {{ $.UUIDGoType }}
		if primaryKey, ok := {{ lowerFirst $.TypeName }}UUIDValue(input.{{ toGoName .Name }}); ok && primaryKey != zeroPrimaryKey {
			fields = append(fields, `{{ .QuotedDBName }}`)
			paramNum++
			placeholders = append(placeholders, fmt.Sprintf("$%d", paramNum))
			values = append(values, primaryKey.ToUUID())
		}
	}
	{{- end }}
	{{- end }}

	{{- range .Fields }}
