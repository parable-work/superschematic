	limitOffsetClause := buildLimitOffsetClauseTyped(opts.Limit, opts.Offset)

	// Build query
	query := fmt.Sprintf(`SELECT %s FROM {{ .QuotedTableName }}%s%s%s`, selectFields, whereClause, orderByClause, limitOffsetClause)

	// Get total count
	countQuery := fmt.Sprintf(`SELECT COUNT(*) FROM {{ .QuotedTableName }}%s`, whereClause)

