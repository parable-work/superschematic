				result.{{ toGoName $member.Relationship.FieldName }} = rel
				{{- end }}
			} else {
				// Preserve FK ID even when entity not found (e.g. soft-deleted)
				{{- if $member.Relationship.IsRequired }}
				result.{{ toGoName $member.Relationship.FieldName }}.Id = {{ if $member.Relationship.TargetPrimaryKeyIsPointer }}{{ lowerFirst $.TypeName }}UUIDPtr(*tempRel{{ toGoName $member.Relationship.FieldName }}){{ else }}*tempRel{{ toGoName $member.Relationship.FieldName }}{{ end }}
				{{- else }}
				result.{{ toGoName $member.Relationship.FieldName }} = &types.{{ $member.Relationship.TargetType }}{Id: {{ if $member.Relationship.TargetPrimaryKeyIsPointer }}{{ lowerFirst $.TypeName }}UUIDPtr(*tempRel{{ toGoName $member.Relationship.FieldName }}){{ else }}*tempRel{{ toGoName $member.Relationship.FieldName }}{{ end }}}
				{{- end }}
			}
		} else {
			// Just set the ID when not including full entity
			{{- if $member.Relationship.IsRequired }}
			result.{{ toGoName $member.Relationship.FieldName }}.Id = {{ if $member.Relationship.TargetPrimaryKeyIsPointer }}{{ lowerFirst $.TypeName }}UUIDPtr(*tempRel{{ toGoName $member.Relationship.FieldName }}){{ else }}*tempRel{{ toGoName $member.Relationship.FieldName }}{{ end }}
			{{- else }}
			// Initialize pointer for optional relationship before setting ID
			result.{{ toGoName $member.Relationship.FieldName }} = &types.{{ $member.Relationship.TargetType }}{Id: {{ if $member.Relationship.TargetPrimaryKeyIsPointer }}{{ lowerFirst $.TypeName }}UUIDPtr(*tempRel{{ toGoName $member.Relationship.FieldName }}){{ else }}*tempRel{{ toGoName $member.Relationship.FieldName }}{{ end }}}
			{{- end }}
		}
	}
	{{- end }}
	{{- end }}

	return result, nil
	{{- end }}
}

// FindMany retrieves multiple {{ .TypeName }} records matching the filter
func (r *{{ .Name }}) FindMany(ctx context.Context, filter *{{ .TypeName }}Filter, opts *{{ .TypeName }}FindOptions) ([]*types.{{ .TypeName }}, int, error) {
	if opts == nil || opts.Fields.IsZero() {
		return nil, 0, fmt.Errorf("fields must be specified in FindOptions for performance")
	}

	// Build selected fields in OrderedMembers order so FK columns match scan order.
	var fieldStrings []string
	{{- range .OrderedMembers }}
	{{- if .IsRelationship }}
	if opts.Fields.{{ toGoName .Relationship.FieldName }} || {{- if eq .Relationship.TargetType $.TypeName }} (opts.Fields.{{ toGoName .Relationship.FieldName }}Nested != nil && !opts.Fields.{{ toGoName .Relationship.FieldName }}Nested.IsZero()) {{- else }} !opts.Fields.{{ toGoName .Relationship.FieldName }}Nested.IsZero() {{- end }} {
		fieldStrings = append(fieldStrings, "{{ .Relationship.DBColumnName }}")
