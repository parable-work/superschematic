// UpsertMany inserts each input, or, when a row already holds its value of
// the unique key on, sets each field update names of that row to the value
// the input would have inserted, and returns each input's row and what it
// did with it, in the inputs' order (D89). One statement writes a batch of
// rows, opts.Batch or as many as Postgres binds the parameters of, and more
// rows take a statement per batch, in one transaction; a write that may
// take more than one statement runs in a transaction of its own when none
// is open. An update that names no field leaves each row that holds a key
// as it is.{{ if .HasSoftDelete }} A soft-deleted row that holds a key is left as it is, and
// UpsertMany returns ErrNotFound.{{ end }} Two inputs of one batch that hold one key fail
// the statement, and a key over an expression, whose rows the statement's
// cannot be matched to the inputs by, is refused.
func (r *{{ .Name }}) UpsertMany(ctx context.Context, inputs []*types.{{ .TypeName }}, on {{ .TypeName }}UniqueKey, update {{ .TypeName }}Fields, opts *UpsertOptions) ([]UpsertResult[*types.{{ .TypeName }}], error) {
	key, ok := {{ lowerFirst .TypeName }}UniqueKeys[on]
	if !ok {
		return nil, fmt.Errorf("orm: {{ .TypeName }} has no unique key %q", string(on))
	}
	if key.rows == "" {
		return nil, upsertExpressionKey("UpsertMany", "{{ .TypeName }}", string(on))
	}
	if opts == nil {
		opts = &UpsertOptions{}
	}
	{{- range .Fields }}
	{{- if or .IsPrimaryKey .IsAuditField .IsInternalMetadata }}
	if update.{{ toGoName .Name }} {
		return nil, fmt.Errorf("orm: UpsertMany of {{ $.TypeName }} sets the fields an update sets, not {{ .Name }}")
	}
	{{- end }}
	{{- end }}
	batch, err := upsertBatch("{{ .TypeName }}", opts.Batch, {{ .BatchRows }})
	if err != nil {
		return nil, err
	}
	if len(inputs) == 0 {
		return []UpsertResult[*types.{{ .TypeName }}]{}, nil
	}
	if len(inputs) <= batch && !opts.OnlyIfChanged{{ range .EncryptedFields }} && !update.{{ toGoName .Name }}{{ end }} {
		return r.upsertBatches(ctx, inputs, on, update, batch, false)
	}
	return inTransaction(ctx, r.database(), r.tx, func(tx pgx.Tx) ([]UpsertResult[*types.{{ .TypeName }}], error) {
		return (&{{ .Name }}{tx: tx, txDB: r.database()}).upsertBatches(ctx, inputs, on, update, batch, opts.OnlyIfChanged)
	})
}
{{- end }}

// upsertBatches is UpsertMany on the repository's connection, a batch at a
// time: each batch's statement, a read of the rows it left as they were,
// only if changed, and the second statement of each encrypted field.
func (r *{{ .Name }}) upsertBatches(ctx context.Context, inputs []*types.{{ .TypeName }}, on {{ .TypeName }}UniqueKey, update {{ .TypeName }}Fields, batch int, onlyIfChanged bool) ([]UpsertResult[*types.{{ .TypeName }}], error) {
	key := {{ lowerFirst .TypeName }}UniqueKeys[on]
	{{- if .GenericJSONListFields }}
	for i, input := range inputs {
		if err := refuseNull{{ .TypeName }}GenericJSONElements(input); err != nil {
			return nil, fmt.Errorf("upsert {{ .TypeName }} %d: %w", i, err)
		}
	}
	{{- end }}

	// Set audit fields
	{{- range .Fields }}
	{{- if eq .Name "createdBy" }}
	if !HasUserID(ctx) {
		return nil, ErrNoUserInContext
	}
	for _, input := range inputs {
		input.CreatedBy = GetUserID(ctx)
	}
	{{- end }}
	{{- if eq .Name "updatedBy" }}
	{{- if .IsRequired }}
	for _, input := range inputs {
		input.UpdatedBy = GetUserID(ctx)
	}
	{{- else }}
	{{- if $.RequireUpdatedBy }}
	if !HasUserID(ctx) {
		return nil, ErrNoUserInContext
	}
	{{- end }}
	if HasUserID(ctx) {
		for _, input := range inputs {
			userID := GetUserID(ctx)
			input.UpdatedBy = &userID
		}
	}
	{{- end }}
	{{- end }}
	{{- end }}

	// Each field update names takes the value the input would have
	// inserted, which an upsert only if changed compares with the row's.
	var setClauses, compareCurrent, compareNext []string
	{{- range .Fields }}
	{{- if and (not .IsPrimaryKey) (not .IsAuditField) (not .IsInternalMetadata) (not .IsEncrypted) (not .IsOwned) }}
	if update.{{ toGoName .Name }} {
		setClauses = append(setClauses, {{ goRawString .SQL.SetExcluded }})
		compareCurrent = append(compareCurrent, {{ goRawString .SQL.Compared }})
		compareNext = append(compareNext, {{ goRawString .SQL.CompareExcluded }})
	}
	{{- end }}
	{{- end }}
	{{- range .Relationships }}
	{{- if not .IsArray }}
	if update.{{ toGoName .FieldName }} {
		setClauses = append(setClauses, {{ goRawString .SQL.SetExcluded }})
		compareCurrent = append(compareCurrent, {{ goRawString .SQL.Compared }})
		compareNext = append(compareNext, {{ goRawString .SQL.CompareExcluded }})
	}
	{{- end }}
	{{- end }}

	results := make([]UpsertResult[*types.{{ .TypeName }}], 0, len(inputs))
	for start := 0; start < len(inputs); start += batch {
		chunk := inputs[start:min(start+batch, len(inputs))]
		{{- if .EncryptedFields }}
		// Each row's key, generated when unset, and its encrypted fields
		// sealed under it (D85).
		prepared := make([]*types.{{ .TypeName }}, len(chunk))
		for i, input := range chunk {
			sealed, err := r.seal(input)
			if err != nil {
				return nil, fmt.Errorf("upsert {{ .TypeName }} %d: %w", start+i, err)
			}
			prepared[i] = sealed
		}
		{{- else }}
		prepared := chunk
		{{- end }}

		// The batch's rows, as CreateMany writes them.
		rows := make([][]batchInsertCell, 0, len(prepared))
		for _, input := range prepared {
			var row []batchInsertCell
			{{- template "batchInsertRow" . }}
			rows = append(rows, row)
		}
		fieldNames, valuePlaceholders, values := buildBatchInsert(rows)
		assignments := append([]string(nil), setClauses...)
		if len(setClauses) == 0 {
			// An update that names no field leaves each row as it is.
			assignments = append(assignments, key.keep)
		} else {
			{{- range .Fields }}
			{{- if eq .Name "updatedAt" }}
			values = append(values, time.Now())
			assignments = append(assignments, fmt.Sprintf({{ printf "%q" $.SQL.UpdatedAt }}, len(values)))
			{{- end }}
			{{- end }}
			{{- range .Fields }}
			{{- if eq .Name "updatedBy" }}
			if HasUserID(ctx) {
				values = append(values, GetUserID(ctx))
				assignments = append(assignments, fmt.Sprintf({{ printf "%q" $.SQL.UpdatedBy }}, len(values)))
			}
			{{- end }}
			{{- end }}
		}
		query := fmt.Sprintf(
			{{ goRawString .SQL.Upsert }},
			strings.Join(fieldNames, ", "),
			strings.Join(valuePlaceholders, ", "),
			key.conflict,
			strings.Join(assignments, ", "),
			upsertWhere({{ goRawString .SQL.LiveCondition }}, compareCurrent, compareNext, onlyIfChanged),
		)
		returned, inserted, err := r.upsertReturned(ctx, query, values)
		if err != nil {
			return nil, err
		}

		// A row is its input's by the key's values; an input that sets none
		// of them, whose key the database generates, takes the next row whose
		// key no input holds, as the rows come back in the inputs' order.
		keys := make([]string, len(prepared))
		set := make([]bool, len(prepared))
		for i, input := range prepared {
			keys[i], set[i] = {{ lowerFirst .TypeName }}KeyOf(on, input)
		}
		matcher := newUpsertMatcher(keys, set)
		matched := make([]*UpsertResult[*types.{{ .TypeName }}], len(prepared))
		for n, row := range returned {
			text, ok := {{ lowerFirst .TypeName }}KeyOf(on, row)
			i := matcher.take(text, ok)
			if i < 0 {
				return nil, fmt.Errorf("orm: UpsertMany of {{ .TypeName }} wrote a row whose %s no input holds", string(on))
			}
			status := UpsertUnchanged
			if inserted[n] {
				status = UpsertInserted
			} else if len(setClauses) > 0 {
				status = UpsertUpdated
			}
			matched[i] = &UpsertResult[*types.{{ .TypeName }}]{Row: row, Status: status}
		}

		// A row it did not return is one it left as it was, only if changed,
		// which it reads back by its key, or a deleted one.
		var left []int
		for i := range matched {
			if matched[i] == nil {
				left = append(left, i)
			}
		}
		if len(left) > 0 {
			if !onlyIfChanged {
				return nil, fmt.Errorf("the {{ .TypeName }} row that holds the %s of input %d is deleted: %w", string(on), start+left[0], ErrNotFound)
			}
			keyValues := make([][]any, len(left))
			wanted := make([]*types.{{ .TypeName }}, len(left))
			for n, i := range left {
				cells, ok := upsertCellValues(rows[i], key.columns)
				if !ok {
					return nil, fmt.Errorf("no {{ .TypeName }} row holds an unset %s: %w", string(on), ErrNotFound)
				}
				keyValues[n], wanted[n] = cells, prepared[i]
			}
			found, err := r.rowsOfKeys(ctx, on, keyValues, wanted)
			if err != nil {
				return nil, err
			}
			for n, i := range left {
				matched[i] = &UpsertResult[*types.{{ .TypeName }}]{Row: found[n], Status: UpsertUnchanged}
			}
		}
		for {{ if .EncryptedFields }}i{{ else }}_{{ end }}, result := range matched {
			{{- if .EncryptedFields }}
			// Each encrypted field update names, which the statement left
			// as it was, set to the input's when it differs.
			want := &{{ .TypeName }}Update{}
			{{- range .EncryptedFields }}
			if update.{{ toGoName .Name }} {
				{{- if .DerefValue }}
				if chunk[i].{{ toGoName .Name }} != nil {
					want.{{ toGoName .Name }} = chunk[i].{{ toGoName .Name }}
				} else {
					want.{{ toGoName .Name }}SetNull = true
				}
				{{- else }}
				value := chunk[i].{{ toGoName .Name }}
				want.{{ toGoName .Name }} = &value
				{{- end }}
			}
			{{- end }}
			resealed, err := r.resealed(ctx, result, want)
			if err != nil {
				return nil, err
			}
			result = resealed
			{{- end }}
			results = append(results, *result)
		}
	}
	return results, nil
}

// upsertReturned runs an upsert's statement, query with values, and scans
// each row it returns and whether it inserted it.
func (r *{{ .Name }}) upsertReturned(ctx context.Context, query string, values []any) ([]*types.{{ .TypeName }}, []bool, error) {
	var rows pgx.Rows
	var err error
	if r.tx != nil {
		rows, err = r.tx.Query(ctx, query, values...)
	} else {
		rows, err = r.db.pool.Query(ctx, query, values...)
	}
	if err != nil {
		return nil, nil, fmt.Errorf("failed to execute upsert: %w", err)
	}
	defer rows.Close()
	var returned []*types.{{ .TypeName }}
	var inserted []bool
	for rows.Next() {
		var flag bool
		row, err := r.scanReturned(rows, &flag)
		if err != nil {
			return nil, nil, fmt.Errorf("failed to scan result: %w", err)
		}
		returned = append(returned, row)
		inserted = append(inserted, flag)
	}
	if err := rows.Err(); err != nil {
		return nil, nil, fmt.Errorf("error iterating results: %w", err)
	}
	return returned, inserted, nil
}

