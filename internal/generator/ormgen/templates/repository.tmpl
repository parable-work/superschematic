		if selectedRel{{ toGoName $rel.FieldName }} && tempRel{{ toGoName $rel.FieldName }} != nil {
			{{- if $rel.IsRequired }}
			result.{{ toGoName $rel.FieldName }}.Id = {{ if $rel.TargetPrimaryKeyIsPointer }}{{ lowerFirst $.TypeName }}UUIDPtr(*tempRel{{ toGoName $rel.FieldName }}){{ else }}*tempRel{{ toGoName $rel.FieldName }}{{ end }}
			{{- else }}
			// Initialize pointer for optional relationship before setting ID
			result.{{ toGoName $rel.FieldName }} = &types.{{ $rel.TargetType }}{Id: {{ if $rel.TargetPrimaryKeyIsPointer }}{{ lowerFirst $.TypeName }}UUIDPtr(*tempRel{{ toGoName $rel.FieldName }}){{ else }}*tempRel{{ toGoName $rel.FieldName }}{{ end }}}
			{{- end }}
		}
		{{- end }}
		{{- end }}

		results = append(results, result)
	}

	if err := rows.Err(); err != nil {
		return nil, fmt.Errorf("error iterating rows: %w", err)
	}

	// Batch hydrate relationships (outside the row loop for efficiency)
	{{- range $i, $rel := .Relationships }}
	{{- if not $rel.IsArray }}
	if fields.{{ toGoName $rel.FieldName }} || {{- if $rel.NestedByPointer }} (fields.{{ toGoName $rel.FieldName }}Nested != nil && !fields.{{ toGoName $rel.FieldName }}Nested.IsZero()) {{- else }} !fields.{{ toGoName $rel.FieldName }}Nested.IsZero() {{- end }} {
		// Collect unique FK IDs from results (dedupe during collection)
		{{ $rel.FieldName }}IDSet := make(map[{{ $.UUIDGoType }}]bool)
		var {{ $rel.FieldName }}IDs []{{ $.UUIDGoType }}
		for _, result := range results {
			var zeroID {{ $.UUIDGoType }}
			{{- if $rel.IsRequired }}
			{{ $rel.FieldName }}ID, ok := {{ lowerFirst $.TypeName }}UUIDValue(result.{{ toGoName $rel.FieldName }}.Id)
			if ok && {{ $rel.FieldName }}ID != zeroID && !{{ $rel.FieldName }}IDSet[{{ $rel.FieldName }}ID] {
				{{ $rel.FieldName }}IDSet[{{ $rel.FieldName }}ID] = true
				{{ $rel.FieldName }}IDs = append({{ $rel.FieldName }}IDs, {{ $rel.FieldName }}ID)
			}
			{{- else }}
			// Check if optional relationship pointer is not nil before accessing Id
			if result.{{ toGoName $rel.FieldName }} != nil {
				{{ $rel.FieldName }}ID, ok := {{ lowerFirst $.TypeName }}UUIDValue(result.{{ toGoName $rel.FieldName }}.Id)
				if ok && {{ $rel.FieldName }}ID != zeroID && !{{ $rel.FieldName }}IDSet[{{ $rel.FieldName }}ID] {
					{{ $rel.FieldName }}IDSet[{{ $rel.FieldName }}ID] = true
					{{ $rel.FieldName }}IDs = append({{ $rel.FieldName }}IDs, {{ $rel.FieldName }}ID)
				}
			}
			{{- end }}
		}

		// Batch fetch related entities with typed child field options.
		childFields := ({{ $rel.TargetType }}Fields{}).All()
		childFieldsAreDefault := true
		{{- if $rel.NestedByPointer }}
		if fields.{{ toGoName $rel.FieldName }}Nested != nil && !fields.{{ toGoName $rel.FieldName }}Nested.IsZero() {
			childFields = *fields.{{ toGoName $rel.FieldName }}Nested
			childFieldsAreDefault = false
		}
		{{- else }}
		if !fields.{{ toGoName $rel.FieldName }}Nested.IsZero() {
			childFields = fields.{{ toGoName $rel.FieldName }}Nested
			childFieldsAreDefault = false
		}
		{{- end }}

		{{ $rel.FieldName }}Map, err := r.batch{{ toGoName $rel.FieldName }}ByIDs(ctx, {{ $rel.FieldName }}IDs, &{{ $rel.TargetType }}FindOptions{
			Fields: childFields,
			Limit:  len({{ $rel.FieldName }}IDs),
		}, childFieldsAreDefault)
		if err != nil {
			return nil, fmt.Errorf("failed to batch fetch {{ $rel.FieldName }}: %w", err)
		}

		// Hydrate results from map
		for _, result := range results {
			{{- if $rel.IsRequired }}
			{{ $rel.FieldName }}ID, ok := {{ lowerFirst $.TypeName }}UUIDValue(result.{{ toGoName $rel.FieldName }}.Id)
			if ok {
				if rel, ok := {{ $rel.FieldName }}Map[{{ $rel.FieldName }}ID]; ok {
					result.{{ toGoName $rel.FieldName }} = *rel
				}
			}
			{{- else }}
			// Check if optional relationship pointer is not nil before accessing Id
			if result.{{ toGoName $rel.FieldName }} != nil {
				{{ $rel.FieldName }}ID, ok := {{ lowerFirst $.TypeName }}UUIDValue(result.{{ toGoName $rel.FieldName }}.Id)
				if ok {
					if rel, ok := {{ $rel.FieldName }}Map[{{ $rel.FieldName }}ID]; ok {
						result.{{ toGoName $rel.FieldName }} = rel
					}
				}
			}
			{{- end }}
		}
	}
	{{- end }}
	{{- end }}
	{{- range $i, $rel := .Relationships }}
	{{- if $rel.IsArray }}
	if fields.{{ toGoName $rel.FieldName }}Nested != nil {
		childFields := *fields.{{ toGoName $rel.FieldName }}Nested
		if childFields.IsZero() {
			childFields = {{ $rel.TargetType }}Fields{Id: true}
		}
		childFieldsValue := reflect.ValueOf(&childFields).Elem()
		parentRelationFieldCandidates := []string{
			{{- if $rel.HasManyParentRelationField }}
			"{{ $rel.HasManyParentRelationField }}",
			{{- end }}
			"{{ $.TypeName }}",
			"{{ toGoName $rel.FieldName }}",
		}
		for _, candidate := range parentRelationFieldCandidates {
			field := childFieldsValue.FieldByName(candidate)
			if !field.IsValid() || !field.CanSet() || field.Kind() != reflect.Bool {
				continue
			}
			field.SetBool(true)
			break
		}

		parentIDSet := make(map[{{ $.UUIDGoType }}]bool, len(results))
		parentIDs := make([]{{ $.UUIDGoType }}, 0, len(results))
		for _, result := range results {
			if result == nil {
				continue
			}
			resultID, ok := {{ lowerFirst $.TypeName }}UUIDValue(result.Id)
			if !ok {
				continue
			}
			if !parentIDSet[resultID] {
				parentIDSet[resultID] = true
				parentIDs = append(parentIDs, resultID)
			}
		}
		if len(parentIDs) > 0 {
			// Get repository for related type
			var repo *{{ $rel.TargetType }}Repository
			if r.tx != nil {
				txDB := r.txDB
				if txDB == nil {
					txDB = r.db
				}
				repo = &{{ $rel.TargetType }}Repository{tx: r.tx, txDB: txDB}
			} else if r.db != nil {
				repo = r.db.{{ $rel.TargetType }}
			} else if r.txDB != nil {
				repo = r.txDB.{{ $rel.TargetType }}
			} else {
				return nil, fmt.Errorf("no database connection available for {{ $rel.FieldName }} hydration")
			}

			childFilter := &{{ $rel.TargetType }}Filter{}
			childFilterValue := reflect.ValueOf(childFilter).Elem()
			filterFieldCandidates := []string{
				{{- if $rel.HasManyParentFilterField }}
				"{{ $rel.HasManyParentFilterField }}",
				{{- end }}
				"{{ $.TypeName }}ID",
				"{{ toGoName $rel.FieldName }}ID",
			}
			var selectedFilterField string
			filterSet := false
			for _, candidate := range filterFieldCandidates {
				field := childFilterValue.FieldByName(candidate)
				if !field.IsValid() || !field.CanSet() {
					continue
				}
				field.Set(reflect.ValueOf(&UUIDFilter{
					In: parentIDs,
				}))
				selectedFilterField = candidate
				filterSet = true
				break
			}
			if !filterSet {
				return nil, fmt.Errorf("failed to locate hasMany FK filter for {{ $.TypeName }}.{{ $rel.FieldName }}")
			}

			// The other recursion point: these children hydrate their own relations.
			// This block only runs on an explicit nested selection, so the cycle half
			// of the guard does not apply and only the depth cap can refuse it.
			children := []*types.{{ $rel.TargetType }}{}
			if hydrationCtx, allowed := enterRelationHydration(ctx, "{{ $.TypeName }}", "{{ $rel.FieldName }}", "{{ $rel.TargetType }}", false); allowed {
				fetched, findErr := repo.findRelated(hydrationCtx, childFilter, &{{ $rel.TargetType }}FindOptions{
					Fields: childFields,
					Limit:  1000000,
				})
				if findErr != nil {
					return nil, fmt.Errorf("failed to batch fetch {{ $rel.FieldName }}: %w", findErr)
				}
				children = fetched
			}

			parentFieldCandidates := []string{
				{{- if $rel.HasManyParentRelationField }}
				"{{ $rel.HasManyParentRelationField }}",
				{{- end }}
				strings.TrimSuffix(selectedFilterField, "ID"),
				"{{ $.TypeName }}",
				"{{ toGoName $rel.FieldName }}",
			}
			childrenByParentID := make(map[{{ $.UUIDGoType }}][]types.{{ $rel.TargetType }}, len(parentIDs))
			for _, child := range children {
				if child == nil {
					continue
				}
				childValue := reflect.ValueOf(child)
				if childValue.Kind() == reflect.Ptr {
					if childValue.IsNil() {
						continue
					}
					childValue = childValue.Elem()
				}
				if !childValue.IsValid() || childValue.Kind() != reflect.Struct {
					continue
				}

				var parentID {{ $.UUIDGoType }}
				foundParent := false
				for _, candidate := range parentFieldCandidates {
					parentField := childValue.FieldByName(candidate)
					if !parentField.IsValid() {
						continue
					}
					if parentField.Kind() == reflect.Ptr {
						if parentField.IsNil() {
							continue
						}
						parentField = parentField.Elem()
					}
					if !parentField.IsValid() || parentField.Kind() != reflect.Struct {
						continue
					}
					idField := parentField.FieldByName("Id")
					if !idField.IsValid() || !idField.CanInterface() {
						continue
					}
					id, ok := {{ lowerFirst $.TypeName }}UUIDValue(idField.Interface())
					if !ok {
						continue
					}
					parentID = id
					foundParent = true
					break
				}
				if !foundParent {
					continue
				}

				childrenByParentID[parentID] = append(childrenByParentID[parentID], *child)
			}

			for _, result := range results {
				if result == nil {
					continue
				}
				resultID, ok := {{ lowerFirst $.TypeName }}UUIDValue(result.Id)
				if !ok {
					continue
				}
				result.{{ toGoName $rel.FieldName }} = childrenByParentID[resultID]
			}
		}
	}
	{{- end }}
	{{- end }}

	return results, nil
}

// FindPage reads a page of the {{ .TypeName }} rows filter finds (D60, amended), in
// opts.Sort's order, ties broken by {{ .PrimaryKeySortField.Name }} in the same direction: up to
// opts.Limit rows after opts.After, and Next when more follow. It runs one
// query of opts.Limit + 1 rows and no count. A key is a row's {{ .PrimaryKeySortField.Name }} alone:
// in an order by a sort field, the query reads the key's row for its value,
// soft-deleted or not and whatever the filter, so a row the filter no longer
// finds still places the page. An After that holds no {{ .PrimaryKeySortField.Name }}, or whose row
// no longer exists in an order by a sort field, is ErrPageKey. A key of another
// order cannot be told from one of this order: the router refuses a cursor
// of another sort before FindPage reads it.
func (r *{{ .Name }}) FindPage(ctx context.Context, filter *{{ .TypeName }}Filter, opts *{{ .TypeName }}PageOptions) (*{{ .TypeName }}Page, error) {
	if opts == nil || opts.Fields.IsZero() {
		return nil, fmt.Errorf("fields must be specified in PageOptions for performance")
	}
	if opts.Limit < 0 {
