		return 0, fmt.Errorf("{{ .DBName }} cannot be updated with both value and null assignment")
	}
	if update.{{ toGoName .Name }}SetNull {
		setClauses = append(setClauses, `{{ .QuotedDBName }} = NULL`)
	} else if update.{{ toGoName .Name }} != nil {
	{{- else }}
	if update.{{ toGoName .Name }} != nil {
	{{- end }}
		paramNum++
		setClauses = append(setClauses, fmt.Sprintf(`{{ .QuotedDBName }} = $%d`, paramNum))
		{{- if .IsJSONField }}
		jsonValue{{ toGoName .Name }}, err := marshalJSONFieldValue(*update.{{ toGoName .Name }})
		if err != nil {
			return 0, fmt.Errorf("failed to marshal JSON field {{ .Name }}: %w", err)
		}
		values = append(values, jsonValue{{ toGoName .Name }})
		{{- else if .IsUUIDScalar }}
		values = append(values, (*update.{{ toGoName .Name }}).ToUUID())
		{{- else if .IsDateTimeScalar }}
		values = append(values, time.Time(*update.{{ toGoName .Name }}))
		{{- else }}
		values = append(values, *update.{{ toGoName .Name }})
		{{- end }}
	}
	{{- end }}
	{{- end }}

	{{- range .Relationships }}
	{{- if not .IsArray }}
	// Handle relationship foreign key: {{ .FieldName }}
	{{- if not .IsRequired }}
	if update.{{ toGoName .FieldName }}ID != nil && update.{{ toGoName .FieldName }}IDSetNull {
		return 0, fmt.Errorf("{{ .DBColumnName }} cannot be updated with both value and null assignment")
	}
	if update.{{ toGoName .FieldName }}IDSetNull {
		setClauses = append(setClauses, "{{ .DBColumnName }} = NULL")
	} else if update.{{ toGoName .FieldName }}ID != nil {
	{{- else }}
	if update.{{ toGoName .FieldName }}ID != nil {
	{{- end }}
		paramNum++
		setClauses = append(setClauses, fmt.Sprintf("{{ .DBColumnName }} = $%d", paramNum))
		values = append(values, update.{{ toGoName .FieldName }}ID.ToUUID())
	}
	{{- end }}
	{{- end }}

	// Set updated_at
	{{- range .Fields }}
	{{- if eq .Name "updatedAt" }}
	paramNum++
	setClauses = append(setClauses, fmt.Sprintf("updated_at = $%d", paramNum))
	values = append(values, time.Now())
	{{- end }}
	{{- end }}

	// Set updated_by
	{{- range .Fields }}
	{{- if eq .Name "updatedBy" }}
	if update.UpdatedBy != nil {
		paramNum++
		setClauses = append(setClauses, fmt.Sprintf("updated_by = $%d", paramNum))
		values = append(values, *update.UpdatedBy)
	} else if HasUserID(ctx) {
		paramNum++
		setClauses = append(setClauses, fmt.Sprintf("updated_by = $%d", paramNum))
		values = append(values, GetUserID(ctx))
	}
	{{- end }}
	{{- end }}

	if len(setClauses) == 0 {
		return 0, fmt.Errorf("no fields to update")
	}

	// Build WHERE clause
	whereClause := filter.buildWhereClause(&values, paramNum)

	{{- if .HasSoftDelete }}
	if whereClause == "" {
		whereClause = " WHERE deleted_at IS NULL"
	} else {
		whereClause += " AND deleted_at IS NULL"
	}
	{{- end }}

	query := fmt.Sprintf(
		`UPDATE {{ .QuotedTableName }} SET %s%s`,
		strings.Join(setClauses, ", "),
		whereClause,
	)

	// Execute query
	var result pgconn.CommandTag
	var err error
	if r.tx != nil {
		result, err = r.tx.Exec(ctx, query, values...)
	} else {
		result, err = r.db.pool.Exec(ctx, query, values...)
	}
	if err != nil {
		return 0, fmt.Errorf("failed to execute update: %w", err)
	}

	return int(result.RowsAffected()), nil
}

