// PruneHistory invokes the generated {{ .PruneFunctionName }} SQL function:
// it deletes superseded history rows older than retentionDays while keeping
// the latest row per key (and any externally referenced pins the schema
// declares). Returns the number of history rows deleted.
//
// chunkRows > 0 caps each call and repeats until the backlog is drained, so a
// first pass over months of accumulated history is a series of bounded
// statements instead of one DELETE over the whole candidate set. Outside a
// transaction each chunk commits on its own, which is what keeps the lock hold
// and the WAL burst bounded; inside one (r.tx set) the chunks still bound each
// statement but commit together. chunkRows <= 0 prunes in a single call.
func (r *{{ .Name }}) PruneHistory(ctx context.Context, retentionDays, chunkRows int) (int64, error) {
	query := `SELECT {{ .PruneFunctionName }}($1, $2)`

	// NULL max_rows is the SQL function's "no cap".
	var maxRows any
	if chunkRows > 0 {
		maxRows = chunkRows
	}

	var total int64
	for {
		var deleted int64
		var row pgx.Row
		if r.tx != nil {
			row = r.tx.QueryRow(ctx, query, retentionDays, maxRows)
		} else {
			row = r.db.pool.QueryRow(ctx, query, retentionDays, maxRows)
		}
		if err := row.Scan(&deleted); err != nil {
			return total, fmt.Errorf("failed to prune {{ .TypeName }} history: %w", err)
		}
		total += deleted
		// A short chunk means the candidate set is exhausted.
		if maxRows == nil || deleted < int64(chunkRows) {
			return total, nil
		}
		if err := ctx.Err(); err != nil {
			return total, err
		}
	}
}

// PruneHistoryFunctionName is the SQL function PruneHistory calls. A caller
// that reports prune counts per table takes the name from here instead of
// re-deriving one from the Go type or field name, which would be a
// hand-maintained mirror of a schema-defined name.
func (r *{{ .Name }}) PruneHistoryFunctionName() string {
	return "{{ .PruneFunctionName }}"
}
