		relRequested := opts != nil && (opts.Fields.{{ toGoName $member.Relationship.FieldName }} || {{- if $member.Relationship.NestedByPointer }} (opts.Fields.{{ toGoName $member.Relationship.FieldName }}Nested != nil && !opts.Fields.{{ toGoName $member.Relationship.FieldName }}Nested.IsZero()) {{- else }} !opts.Fields.{{ toGoName $member.Relationship.FieldName }}Nested.IsZero() {{- end }})
		if relRequested {
			childFields := ({{ $member.Relationship.TargetType }}Fields{}).All()
			childFieldsAreDefault := true
			{{- if $member.Relationship.NestedByPointer }}
			if opts.Fields.{{ toGoName $member.Relationship.FieldName }}Nested != nil && !opts.Fields.{{ toGoName $member.Relationship.FieldName }}Nested.IsZero() {
				childFields = *opts.Fields.{{ toGoName $member.Relationship.FieldName }}Nested
				childFieldsAreDefault = false
			}
			{{- else }}
			if !opts.Fields.{{ toGoName $member.Relationship.FieldName }}Nested.IsZero() {
				childFields = opts.Fields.{{ toGoName $member.Relationship.FieldName }}Nested
				childFieldsAreDefault = false
			}
			{{- end }}

			relMap, err := r.batch{{ toGoName $member.Relationship.FieldName }}ByIDs(ctx, []{{ $.UUIDGoType }}{*tempRel{{ toGoName $member.Relationship.FieldName }}}, &{{ $member.Relationship.TargetType }}FindOptions{
				Fields: childFields,
				Limit:  1,
			}, childFieldsAreDefault)
			if err != nil {
				return nil, fmt.Errorf("failed to fetch {{ $member.Relationship.FieldName }}: %w", err)
			}
			if rel, ok := relMap[*tempRel{{ toGoName $member.Relationship.FieldName }}]; ok {
				{{- if $member.Relationship.IsRequired }}
				result.{{ toGoName $member.Relationship.FieldName }} = *rel
				{{- else }}
				result.{{ toGoName $member.Relationship.FieldName }} = rel
				{{- end }}
			} else {
				// Preserve FK ID even when entity not found (e.g. soft-deleted)
				{{- if $member.Relationship.IsRequired }}
				result.{{ toGoName $member.Relationship.FieldName }}.Id = {{ if $member.Relationship.TargetPrimaryKeyIsPointer }}{{ lowerFirst $.TypeName }}UUIDPtr(*tempRel{{ toGoName $member.Relationship.FieldName }}){{ else }}*tempRel{{ toGoName $member.Relationship.FieldName }}{{ end }}
				{{- else }}
				result.{{ toGoName $member.Relationship.FieldName }} = &types.{{ $member.Relationship.TargetType }}{Id: {{ if $member.Relationship.TargetPrimaryKeyIsPointer }}{{ lowerFirst $.TypeName }}UUIDPtr(*tempRel{{ toGoName $member.Relationship.FieldName }}){{ else }}*tempRel{{ toGoName $member.Relationship.FieldName }}{{ end }}}
				{{- end }}
			}
		} else {
			// Just set the ID when not including full entity
			{{- if $member.Relationship.IsRequired }}
			result.{{ toGoName $member.Relationship.FieldName }}.Id = {{ if $member.Relationship.TargetPrimaryKeyIsPointer }}{{ lowerFirst $.TypeName }}UUIDPtr(*tempRel{{ toGoName $member.Relationship.FieldName }}){{ else }}*tempRel{{ toGoName $member.Relationship.FieldName }}{{ end }}
			{{- else }}
			// Initialize pointer for optional relationship before setting ID
			result.{{ toGoName $member.Relationship.FieldName }} = &types.{{ $member.Relationship.TargetType }}{Id: {{ if $member.Relationship.TargetPrimaryKeyIsPointer }}{{ lowerFirst $.TypeName }}UUIDPtr(*tempRel{{ toGoName $member.Relationship.FieldName }}){{ else }}*tempRel{{ toGoName $member.Relationship.FieldName }}{{ end }}}
