		}
	}
	{{- end }}
	{{- end }}
	{{- if .EncryptedFields }}

	// Open each encrypted field under the row's key (D85).
	if err := r.open(result); err != nil {
		return nil, err
	}
	{{- end }}

	return result, nil
	{{- end }}
}

// FindMany retrieves multiple {{ .TypeName }} records matching the filter, and how
// many it matches in all, -1 when the options skip the count
func (r *{{ .Name }}) FindMany(ctx context.Context, filter *{{ .TypeName }}Filter, opts *{{ .TypeName }}FindOptions) ([]*types.{{ .TypeName }}, int, error) {
	if opts == nil || opts.Fields.IsZero() {
		return nil, 0, fmt.Errorf("fields must be specified in FindOptions for performance")
	}

	// Build selected fields in OrderedMembers order so FK columns match scan order.
	fieldStrings := {{ lowerFirst .TypeName }}FieldStrings(opts.Fields)

	// Validate fields
	if err := validateFields(fieldStrings, {{ .TypeName }}AllowedFields); err != nil {
		return nil, 0, err
	}

	// Build SELECT clause
	selectFields := buildSelectFieldsTyped(fieldStrings, "{{ .TableName }}")
	if selectFields == "" {
		return nil, 0, fmt.Errorf("no valid fields specified")
	}

	// Build WHERE clause
	var args []interface{}
	whereClause := filter.buildWhereClause(&args, 0)

	{{- if .HasSoftDelete }}
	// Apply soft-delete filter unless IncludeDeleted is set
	if !opts.IncludeDeleted {
		if whereClause == "" {
			whereClause = {{ printf "%q" .SQL.LiveWhere }}
		} else {
			whereClause += {{ printf "%q" .SQL.Live }}
		}
	}
	{{- end }}

	// Build ORDER BY clause
	orderByClause := build{{ .TypeName }}OrderByClause(opts.OrderBy, `{{ .QuotedTableName }}`)

	// Build LIMIT/OFFSET clause
	limitOffsetClause := buildLimitOffsetClauseTyped(opts.Limit, opts.Offset)

	// Build query
	query := fmt.Sprintf({{ goRawString .SQL.FindMany }}, selectFields, whereClause, orderByClause, limitOffsetClause)

	// Get total count, unless the options skip it (D89)
	totalCount := -1
	if !opts.SkipCount {
		countQuery := fmt.Sprintf({{ goRawString .SQL.Count }}, whereClause)

		var countRow pgx.Row
		if r.tx != nil {
			countRow = r.tx.QueryRow(ctx, countQuery, args...)
		} else {
			countRow = r.db.pool.QueryRow(ctx, countQuery, args...)
		}
		if err := countRow.Scan(&totalCount); err != nil {
			return nil, 0, fmt.Errorf("failed to get count: %w", err)
		}
	}

	results, err := r.findRows(ctx, "FindMany", query, args, fieldStrings, opts.Fields{{ if .VectorFields }}, nil{{ end }})
	if err != nil {
		return nil, 0, err
	}
	return results, totalCount, nil
}

// findRelated reads the rows filter finds as FindMany reads them, with no
// count: the read that loads a relation's rows for the rows of another
// table's read (D90), which counts nothing, as the TypeScript
// repositories' include does.
func (r *{{ .Name }}) findRelated(ctx context.Context, filter *{{ .TypeName }}Filter, opts *{{ .TypeName }}FindOptions) ([]*types.{{ .TypeName }}, error) {
	if opts == nil || opts.Fields.IsZero() {
		return nil, fmt.Errorf("fields must be specified in FindOptions for performance")
	}
	fieldStrings := {{ lowerFirst .TypeName }}FieldStrings(opts.Fields)
	if err := validateFields(fieldStrings, {{ .TypeName }}AllowedFields); err != nil {
		return nil, err
	}
	selectFields := buildSelectFieldsTyped(fieldStrings, "{{ .TableName }}")
	if selectFields == "" {
		return nil, fmt.Errorf("no valid fields specified")
	}
	var args []interface{}
	whereClause := filter.buildWhereClause(&args, 0)
	{{- if .HasSoftDelete }}
	if !opts.IncludeDeleted {
		if whereClause == "" {
			whereClause = {{ printf "%q" .SQL.LiveWhere }}
		} else {
			whereClause += {{ printf "%q" .SQL.Live }}
		}
	}
	{{- end }}
	orderByClause := build{{ .TypeName }}OrderByClause(opts.OrderBy, `{{ .QuotedTableName }}`)
	limitOffsetClause := buildLimitOffsetClauseTyped(opts.Limit, opts.Offset)
	query := fmt.Sprintf({{ goRawString .SQL.FindMany }}, selectFields, whereClause, orderByClause, limitOffsetClause)
	return r.findRows(ctx, "FindMany", query, args, fieldStrings, opts.Fields{{ if .VectorFields }}, nil{{ end }})
}

// {{ lowerFirst .TypeName }}FieldStrings are the columns fields selects, in OrderedMembers
// order so FK columns match scan order, and the primary key when fields
// hydrates a hasMany relation, which maps the children by it.
func {{ lowerFirst .TypeName }}FieldStrings(fields {{ .TypeName }}Fields) []string {
	var fieldStrings []string
	{{- range .OrderedMembers }}
	{{- if .IsRelationship }}
	if fields.{{ toGoName .Relationship.FieldName }} || {{- if .Relationship.NestedByPointer }} (fields.{{ toGoName .Relationship.FieldName }}Nested != nil && !fields.{{ toGoName .Relationship.FieldName }}Nested.IsZero()) {{- else }} !fields.{{ toGoName .Relationship.FieldName }}Nested.IsZero() {{- end }} {
		fieldStrings = append(fieldStrings, "{{ .Relationship.DBColumnName }}")
	}
	{{- else }}
	if fields.{{ toGoName .Field.Name }} {
		fieldStrings = append(fieldStrings, "{{ .Field.DBName }}")
	}
	{{- end }}
	{{- end }}
	{{- if .HasArrayRelationships }}
	// hasMany hydration needs the parent primary key for child mapping.
	hasManyRequested := false
	{{- range $i, $rel := .Relationships }}
	{{- if $rel.IsArray }}
	if fields.{{ toGoName $rel.FieldName }}Nested != nil {
		hasManyRequested = true
	}
	{{- end }}
	{{- end }}
	if hasManyRequested && !containsString(fieldStrings, "{{ .PrimaryKeyCol }}") {
		fieldStrings = append(fieldStrings, "{{ .PrimaryKeyCol }}")
	}
	{{- end }}
	{{- if .EncryptedFields }}
	// An encrypted field's envelope is bound to the row's key, which opening
	// it reads (D85).
	if ({{ range $i, $f := .EncryptedFields }}{{ if $i }} || {{ end }}fields.{{ toGoName $f.Name }}{{ end }}) && !containsString(fieldStrings, "{{ .PrimaryKeyCol }}") {
		fieldStrings = append(fieldStrings, "{{ .PrimaryKeyCol }}")
	}
	{{- end }}
	return fieldStrings
}

// findRows runs query, a select of the columns fieldStrings names, in turn,
// with args, scans its rows, and hydrates the relations fields selects, as
// FindMany and FindPage read them. method names the caller in an error.
{{- if .VectorFields }}
// With distances, the select ends with the distance Nearest orders by,
// which it appends, row by row (D84).
{{- end }}
func (r *{{ .Name }}) findRows(ctx context.Context, method, query string, args []interface{}, fieldStrings []string, fields {{ .TypeName }}Fields{{ if .VectorFields }}, distances *[]float64{{ end }}) ([]*types.{{ .TypeName }}, error) {
	// Execute query
	var rows pgx.Rows
	var err error
	if r.tx != nil {
		rows, err = r.tx.Query(ctx, query, args...)
	} else {
		rows, err = r.db.pool.Query(ctx, query, args...)
	}
	if err != nil {
		return nil, fmt.Errorf("failed to execute query: %w", err)
	}
	defer rows.Close()

	// Scan results
	results := []*types.{{ .TypeName }}{}
	for rows.Next() {
		result := &types.{{ .TypeName }}{}

		// Create temporary variables for nullable fields that need pointer scanning (per-row)
		{{ template "nullableTempVarsFields" .Fields }}

		// Create temporary variables for relationship foreign keys (we don't store these directly on the struct)
		{{- range $i, $rel := .Relationships }}
		{{- if not $rel.IsArray }}
		var tempRel{{ toGoName $rel.FieldName }} *{{ $.UUIDGoType }}
		{{- end }}
		{{- end }}

		// Track whether special fields were selected so we can post-process after Scan.
		{{ template "nullableSelectedFlagsFields" .Fields }}
		{{- range $i, $rel := .Relationships }}
		{{- if not $rel.IsArray }}
		var selectedRel{{ toGoName $rel.FieldName }} bool
		{{- end }}
		{{- end }}

		scanDest := make([]any, len(fieldStrings))
		for i, fieldName := range fieldStrings {
			switch fieldName {
		{{- range $i, $field := .Fields }}
		{{ template "scanDestCaseForField" $field }}
		{{- end }}
			{{- range $i, $rel := .Relationships }}
			{{- if not $rel.IsArray }}
			case "{{ $rel.DBColumnName }}":
				scanDest[i] = &tempRel{{ toGoName $rel.FieldName }}
				selectedRel{{ toGoName $rel.FieldName }} = true
			{{- end }}
			{{- end }}
			default:
				return nil, fmt.Errorf("unexpected field %q for {{ .TypeName }}.%s", fieldName, method)
			}
		}

		{{- if .VectorFields }}
		var distance float64
		if distances != nil {
			scanDest = append(scanDest, &distance)
		}
		{{- end }}

		if err := rows.Scan(scanDest...); err != nil {
			return nil, fmt.Errorf("failed to scan row: %w", err)
		}
		{{- if .VectorFields }}
		if distances != nil {
			*distances = append(*distances, distance)
		}
		{{- end }}

		// Copy nullable fields when present
		var jsonFieldDecodeErr error
		{{ template "nullablePostCopyFields" .Fields }}
		if jsonFieldDecodeErr != nil {
			return nil, jsonFieldDecodeErr
		}
		{{- if .EncryptedFields }}
		if err := r.open(result); err != nil {
			return nil, err
		}
