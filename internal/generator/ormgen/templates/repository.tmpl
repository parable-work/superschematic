	// Validate fields
	if err := validateFields(fieldStrings, {{ .TypeName }}AllowedFields); err != nil {
		return nil, 0, err
	}

	// Build SELECT clause
	selectFields := buildSelectFieldsTyped(fieldStrings, "{{ .TableName }}")
	if selectFields == "" {
		return nil, 0, fmt.Errorf("no valid fields specified")
	}

	// Build WHERE clause
	var args []interface{}
	whereClause := filter.buildWhereClause(&args, 0)

	{{- if .HasSoftDelete }}
	// Apply soft-delete filter unless IncludeDeleted is set
	if !opts.IncludeDeleted {
		if whereClause == "" {
			whereClause = " WHERE deleted_at IS NULL"
		} else {
			whereClause += " AND deleted_at IS NULL"
		}
	}
