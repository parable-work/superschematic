{{- /*
The writes of a table whose fields are behaviors (D103), each through the
core in a transaction: CreateOne, CreateMany, UpdateOne, DeleteOne, and the
upserts, which insert what the core's create gives a row.
*/}}
{{- define "behaviorCreateOne" }}

{{ docComment "" (printf "CreateOne inserts a new %s row through the behaviors' core (D103), in a transaction: each behavior's create initializes the fields it owns, and the row is read back. A refusal of the core's is returned as the *rules.Refusal it is." .TypeName) }}
func (r *{{ .Name }}) CreateOne(ctx context.Context, input *{{ .TypeName }}Create) (*types.{{ .TypeName }}, error) {
	return inTransaction(ctx, r.database(), r.tx, func(tx pgx.Tx) (*types.{{ .TypeName }}, error) {
		return (&{{ .Name }}{tx: tx, txDB: r.database()}).createThroughCore(ctx, input)
	})
}
{{- end }}

{{- define "behaviorCreateMany" }}

{{ docComment "" (printf "CreateMany inserts multiple %s rows, each a create of the behaviors' core (D103), in order, in one transaction." .TypeName) }}
func (r *{{ .Name }}) CreateMany(ctx context.Context, inputs []*{{ .TypeName }}Create) ([]*types.{{ .TypeName }}, error) {
	if len(inputs) == 0 {
		return []*types.{{ .TypeName }}{}, nil
	}
	return inTransaction(ctx, r.database(), r.tx, func(tx pgx.Tx) ([]*types.{{ .TypeName }}, error) {
		repo := &{{ .Name }}{tx: tx, txDB: r.database()}
		rows := make([]*types.{{ .TypeName }}, 0, len(inputs))
		for _, input := range inputs {
			row, err := repo.createThroughCore(ctx, input)
			if err != nil {
				return nil, err
			}
			rows = append(rows, row)
		}
		return rows, nil
	})
}
{{- end }}

{{- define "behaviorUpdateOne" }}

{{ docComment "" (printf "UpdateOne updates a single %s row by ID through the behaviors' core (D103), in a transaction: the own fields update sets, which holds no field a behavior owns, and the row is read back. It returns ErrNotFound when no live row holds id, and any other refusal of the core's as the *rules.Refusal it is." .TypeName) }}
func (r *{{ .Name }}) UpdateOne(ctx context.Context, id {{ .PrimaryKeyType }}, update *{{ .TypeName }}Update) (*types.{{ .TypeName }}, error) {
	if update == nil {
		update = &{{ .TypeName }}Update{}
	}
	{{- if .GenericJSONListFields }}
	if err := refuseNull{{ .TypeName }}UpdateGenericJSONElements(update); err != nil {
		return nil, fmt.Errorf("update {{ .TypeName }}: %w", err)
	}
	{{- end }}
	return inTransaction(ctx, r.database(), r.tx, func(tx pgx.Tx) (*types.{{ .TypeName }}, error) {
		repo := &{{ .Name }}{tx: tx, txDB: r.database()}
		{{- if .EncryptedFields }}
		// Each encrypted field the update sets, sealed for the row (D85).
		sealedUpdate, err := repo.sealUpdate(id, update)
		if err != nil {
			return nil, fmt.Errorf("update {{ .TypeName }}: %w", err)
		}
		update := sealedUpdate
		{{- end }}
		patch := repo.corePatch(update)
		columns, err := repo.updateColumns(ctx, update)
		if err != nil {
			return nil, err
		}
		if len(patch) == 0 && len(columns) == 0 {
			return nil, fmt.Errorf("no fields to update")
		}
		if err := rules.RunUpdate(ctx, rulesHost(tx), {{ printf "%q" .TypeName }}, {{ .WireKey "id" }}, patch, behaviorCaller(ctx), &rules.ExecuteOptions{OwnColumns: columns}); err != nil {
			return nil, behaviorNotFound(err, {{ printf "%q" .TypeName }}, id)
		}
		return repo.GetOne(ctx, id, nil)
	})
}
{{- end }}

{{- define "behaviorDeleteOne" }}

{{- $verb := "permanently deletes" }}
{{- $how := "" }}
{{- if .HasSoftDelete }}{{ $verb = "soft deletes" }}{{ $how = ": the live row is stamped deleted in place of deleted" }}
{{- else if .HistoryActorCol }}{{ $how = printf ". The history tombstone records the context user as its %s" .HistoryActorCol }}{{ end }}

{{ docComment "" (printf "DeleteOne %s a single %s row by ID through the behaviors' core (D103), in a transaction%s. It returns ErrNotFound when no live row holds id, and any other refusal of the core's as the *rules.Refusal it is." $verb .TypeName $how) }}
func (r *{{ .Name }}) DeleteOne(ctx context.Context, id {{ .PrimaryKeyType }}) error {
	{{- if .HasSoftDelete }}
	if !HasUserID(ctx) {
		return ErrNoUserInContext
	}
	{{- end }}
	_, err := inTransaction(ctx, r.database(), r.tx, func(tx pgx.Tx) (struct{}, error) {
		opts := &rules.ExecuteOptions{}
		{{- if .HasSoftDelete }}
		opts.SoftDelete = map[string]any{ {{- printf "%q" .DeletedAtCol }}: time.Now()}
		{{- if .HasDeletedBy }}
		opts.SoftDelete[{{ printf "%q" (.FieldColumn "deletedBy") }}] = GetUserID(ctx)
		{{- end }}
		{{- else if .HistoryActorCol }}
		if _, err := tx.Exec(ctx, historyActorCTE+"SELECT _history_actor FROM history_actor", historyActor(ctx)); err != nil {
			return struct{}{}, fmt.Errorf("failed to set the history actor: %w", err)
		}
		{{- end }}
		if err := rules.RunDelete(ctx, rulesHost(tx), {{ printf "%q" .TypeName }}, {{ .WireKey "id" }}, behaviorCaller(ctx), opts); err != nil {
			return struct{}{}, behaviorNotFound(err, {{ printf "%q" .TypeName }}, id)
		}
		{{- if and (not .HasSoftDelete) .HistoryActorCol }}
		if err := clearHistoryActor(ctx, tx); err != nil {
			return struct{}{}, err
		}
		{{- end }}
		return struct{}{}, nil
	})
	return err
}
{{- end }}

{{- define "behaviorUpsertOne" }}

{{ docComment "" (printf "UpsertOne inserts input, or, when a row already holds its value of the unique key on, applies update to that row instead, and returns the row (D79). The insert writes the row with the fields its behaviors own as the core's create gives them (D103), and the update sets update's own fields alone; an update that sets no field leaves the row as it is.%s" (or (and .HasSoftDelete " A soft-deleted row that holds the key is left as it is, and UpsertOne returns ErrNotFound.") "")) }}
func (r *{{ .Name }}) UpsertOne(ctx context.Context, input *{{ .TypeName }}Create, on {{ .TypeName }}UniqueKey, update *{{ .TypeName }}Update) (*types.{{ .TypeName }}, error) {
	result, err := r.UpsertOneResult(ctx, input, on, update, nil)
	if err != nil {
		return nil, err
	}
	return result.Row, nil
}

// UpsertOneResult is UpsertOne, and what it did with the row: inserted it,
// updated the row that held the key, or left that row as it was (D89).
// With opts.OnlyIfChanged it updates the row only when a field the update
// sets differs from what the row holds, which it reads back otherwise. It
// runs in a transaction of its own when none is open: the core's create of
// the row comes first, in it (D103).
func (r *{{ .Name }}) UpsertOneResult(ctx context.Context, input *{{ .TypeName }}Create, on {{ .TypeName }}UniqueKey, update *{{ .TypeName }}Update, opts *UpsertOptions) (UpsertResult[*types.{{ .TypeName }}], error) {
	var none UpsertResult[*types.{{ .TypeName }}]
	key, ok := {{ lowerFirst .TypeName }}UniqueKeys[on]
	if !ok {
		return none, fmt.Errorf("orm: {{ .TypeName }} has no unique key %q", string(on))
	}
	if opts == nil {
		opts = &UpsertOptions{}
	}
	if opts.OnlyIfChanged && key.rows == "" {
		return none, upsertExpressionKey("UpsertOneResult", "{{ .TypeName }}", string(on))
	}
	if update == nil {
		update = &{{ .TypeName }}Update{}
	}
	return inTransaction(ctx, r.database(), r.tx, func(tx pgx.Tx) (UpsertResult[*types.{{ .TypeName }}], error) {
		repo := &{{ .Name }}{tx: tx, txDB: r.database()}
		rows, err := repo.upsertInputs(ctx, []*{{ .TypeName }}Create{input})
		if err != nil {
			return none, err
		}
		result, err := repo.upsertRow(ctx, rows[0], on, update, opts.OnlyIfChanged)
		if err != nil {
			return none, err
		}
		return *result, nil
	})
}
{{- end }}

{{- define "behaviorUpsertMany" }}

{{ docComment "" (printf "UpsertMany inserts each input, or, when a row already holds its value of the unique key on, sets each field update names of that row to the value the input would have inserted, and returns each input's row and what it did with it, in the inputs' order (D89). Each insert writes the row with the fields its behaviors own as the core's create gives them (D103), and update names none of them: only their operations change them. It runs in a transaction of its own when none is open, the core's creates first, then a statement per batch of rows, opts.Batch or as many as Postgres binds the parameters of. An update that names no field leaves each row that holds a key as it is.%s Two inputs of one batch that hold one key fail the statement, and a key over an expression, whose rows the statement's cannot be matched to the inputs by, is refused." (or (and .HasSoftDelete " A soft-deleted row that holds a key is left as it is, and UpsertMany returns ErrNotFound.") "")) }}
func (r *{{ .Name }}) UpsertMany(ctx context.Context, inputs []*{{ .TypeName }}Create, on {{ .TypeName }}UniqueKey, update {{ .TypeName }}Fields, opts *UpsertOptions) ([]UpsertResult[*types.{{ .TypeName }}], error) {
	key, ok := {{ lowerFirst .TypeName }}UniqueKeys[on]
	if !ok {
		return nil, fmt.Errorf("orm: {{ .TypeName }} has no unique key %q", string(on))
	}
	if key.rows == "" {
		return nil, upsertExpressionKey("UpsertMany", "{{ .TypeName }}", string(on))
	}
	if opts == nil {
		opts = &UpsertOptions{}
	}
	{{- range .Fields }}
	{{- if or .IsPrimaryKey .IsAuditField .IsInternalMetadata }}
	if update.{{ toGoName .Name }} {
		return nil, fmt.Errorf("orm: UpsertMany of {{ $.TypeName }} sets the fields an update sets, not {{ .Name }}")
	}
	{{- end }}
	{{- end }}
	{{- range .OwnedFields }}
	if update.{{ .Member }} {
		return nil, fmt.Errorf("orm: UpsertMany of {{ $.TypeName }} sets the fields an update sets, not %q, which behavior {{ .Behavior }} on {{ .Use }} owns (D103): only its operations change it", {{ printf "%q" .Field }})
	}
	{{- end }}
	batch, err := upsertBatch("{{ .TypeName }}", opts.Batch, {{ .BatchRows }})
	if err != nil {
		return nil, err
	}
	if len(inputs) == 0 {
		return []UpsertResult[*types.{{ .TypeName }}]{}, nil
	}
	return inTransaction(ctx, r.database(), r.tx, func(tx pgx.Tx) ([]UpsertResult[*types.{{ .TypeName }}], error) {
		repo := &{{ .Name }}{tx: tx, txDB: r.database()}
		rows, err := repo.upsertInputs(ctx, inputs)
		if err != nil {
			return nil, err
		}
		return repo.upsertBatches(ctx, rows, on, update, batch, opts.OnlyIfChanged)
	})
}
{{- end }}
