// GetVersion retrieves a historical {{ .TypeName }} value by version. A delete
// tombstone's version is not a value of the row, so it reads as ErrNotFound.
func (r *{{ .Name }}) GetVersion(ctx context.Context, id {{ .PrimaryKeyType }}, version int64) (*types.{{ .TypeName }}, error) {
	query := `SELECT {{ .HistoryDataCol }} FROM {{ .QuotedHistoryTableName }} WHERE {{ .QuotedPrimaryKey }} = $1 AND _version = $2 AND {{ .HistoryOperationCol }} <> 'DELETE'`

	var data []byte
	var row pgx.Row
	if r.tx != nil {
		row = r.tx.QueryRow(ctx, query, id{{ if .PrimaryKeyIsUUID }}.ToUUID(){{ end }}, version)
	} else {
		row = r.db.pool.QueryRow(ctx, query, id{{ if .PrimaryKeyIsUUID }}.ToUUID(){{ end }}, version)
	}

	if err := row.Scan(&data); err != nil {
		if err == pgx.ErrNoRows {
			return nil, ErrNotFound
		}
		return nil, fmt.Errorf("failed to scan {{ .TypeName }} history version: %w", err)
	}

	result, err := decode{{ .TypeName }}HistoryData(data)
	if err != nil {
		return nil, err
	}
	return result, nil
}

// ListVersions retrieves historical {{ .TypeName }} values ordered by version.
func (r *{{ .Name }}) ListVersions(ctx context.Context, id {{ .PrimaryKeyType }}, opts *{{ .TypeName }}HistoryOptions) ([]types.HistoryRecord[*types.{{ .TypeName }}], error) {
	if opts == nil {
		opts = &{{ .TypeName }}HistoryOptions{}
	}
	query := `SELECT _version, {{ .HistoryOperationCol }}, {{ .HistoryRecordedAtCol }}, {{ .HistoryDataCol }} FROM {{ .QuotedHistoryTableName }} WHERE {{ .QuotedPrimaryKey }} = $1 ORDER BY _version ASC`
	query += buildLimitOffsetClauseTyped(opts.Limit, opts.Offset)

	var rows pgx.Rows
	var err error
	if r.tx != nil {
		rows, err = r.tx.Query(ctx, query, id{{ if .PrimaryKeyIsUUID }}.ToUUID(){{ end }})
	} else {
		rows, err = r.db.pool.Query(ctx, query, id{{ if .PrimaryKeyIsUUID }}.ToUUID(){{ end }})
	}
	if err != nil {
		return nil, fmt.Errorf("failed to query {{ .TypeName }} history versions: %w", err)
	}
	defer rows.Close()

	records := []types.HistoryRecord[*types.{{ .TypeName }}]{}
	for rows.Next() {
		var record types.HistoryRecord[*types.{{ .TypeName }}]
		var data []byte
		if err := rows.Scan(&record.Version, &record.Operation, &record.RecordedAt, &data); err != nil {
			return nil, fmt.Errorf("failed to scan {{ .TypeName }} history version: %w", err)
		}
		value, err := decode{{ .TypeName }}HistoryData(data)
		if err != nil {
			return nil, err
		}
		record.Value = value
		records = append(records, record)
	}
	if err := rows.Err(); err != nil {
		return nil, fmt.Errorf("error iterating {{ .TypeName }} history versions: %w", err)
	}

	return records, nil
}

// GetAsOf retrieves the latest historical {{ .TypeName }} value at or before ts.
// It returns ErrNotFound when the row did not exist then: no history row at
// or before ts, or the latest one is a delete tombstone{{ if .HasSoftDelete }} or a soft-deleted image{{ end }}.
func (r *{{ .Name }}) GetAsOf(ctx context.Context, id {{ .PrimaryKeyType }}, ts time.Time) (*types.{{ .TypeName }}, error) {
	query := `SELECT {{ .HistoryDataCol }}
FROM (
  SELECT {{ .HistoryOperationCol }}, {{ .HistoryDataCol }}
  FROM {{ .QuotedHistoryTableName }}
  WHERE {{ .QuotedPrimaryKey }} = $1 AND {{ .HistoryRecordedAtCol }} <= $2
  ORDER BY {{ .HistoryRecordedAtCol }} DESC, _version DESC
  LIMIT 1
) latest
WHERE {{ .HistoryOperationCol }} <> 'DELETE'{{ if .HasSoftDelete }} AND ({{ .HistoryDataCol }}->>'{{ $.DeletedAtCol }}') IS NULL{{ end }}`

	var data []byte
	var row pgx.Row
	if r.tx != nil {
		row = r.tx.QueryRow(ctx, query, id{{ if .PrimaryKeyIsUUID }}.ToUUID(){{ end }}, ts)
	} else {
		row = r.db.pool.QueryRow(ctx, query, id{{ if .PrimaryKeyIsUUID }}.ToUUID(){{ end }}, ts)
	}

	if err := row.Scan(&data); err != nil {
		if err == pgx.ErrNoRows {
