	if chunkRows > 0 {
		maxRows = chunkRows
	}

	var total int64
	for {
		var deleted int64
		var row pgx.Row
		if r.tx != nil {
			row = r.tx.QueryRow(ctx, query, retentionDays, maxRows)
		} else {
			row = r.db.pool.QueryRow(ctx, query, retentionDays, maxRows)
		}
		if err := row.Scan(&deleted); err != nil {
			return total, fmt.Errorf("failed to prune {{ .TypeName }} history: %w", err)
		}
		total += deleted
		// A short chunk means the candidate set is exhausted.
		if maxRows == nil || deleted < int64(chunkRows) {
			return total, nil
		}
		if err := ctx.Err(); err != nil {
