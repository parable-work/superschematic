// build{{ .TypeName }}OrderByClause builds an ORDER BY clause for {{ .TypeName }}.
// quotedTable is the table's name as the FROM clause spells it, quoted when
// it is a keyword (a table named order is "order").
func build{{ .TypeName }}OrderByClause(orderBy []{{ .TypeName }}OrderBy, quotedTable string) string {
	if len(orderBy) == 0 {
		return ""
	}

	var clauses []string
	for _, order := range orderBy {
		fieldStr := string(order.Field)
		direction := "ASC"
		if order.Desc {
			direction = "DESC"
		}
		// Use pre-computed quoted field name
		quotedField, ok := {{ .TypeName }}QuotedFields[fieldStr]
		if !ok {
			quotedField = fieldStr // Fallback to unquoted if not found
		}
		clauses = append(clauses, fmt.Sprintf("%s.%s %s", quotedTable, quotedField, direction))
	}

	if len(clauses) == 0 {
		return ""
	}

	return " ORDER BY " + strings.Join(clauses, ", ")
}

