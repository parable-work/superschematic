{{ docComment "" (printf "createThroughCore is CreateOne on the repository's transaction: input's row stamped%s, created by the behaviors' core, whose uses initialize the fields they own, with the columns the insert writes, and read back." (or (and .EncryptedFields " and sealed") "")) }}
func (r *{{ .Name }}) createThroughCore(ctx context.Context, input *{{ .TypeName }}Create) (*types.{{ .TypeName }}, error) {
	row := input.row()
	{{- if .GenericJSONListFields }}
	if err := refuseNull{{ .TypeName }}GenericJSONElements(row); err != nil {
		return nil, fmt.Errorf("create {{ .TypeName }}: %w", err)
	}
	{{- end }}
	{{- template "behaviorStamps" . }}
	{{- if .EncryptedFields }}

	// The key, generated when unset, and each encrypted field sealed under
	// it (D85).
	sealed, err := r.seal(row)
	if err != nil {
		return nil, fmt.Errorf("create {{ .TypeName }}: %w", err)
	}
	row = sealed
	{{- end }}
	columns, err := r.createColumns(row)
	if err != nil {
		return nil, err
	}
	opts := &rules.CreateOptions{ID: r.createKey(row), ExecuteOptions: rules.ExecuteOptions{OwnColumns: columns}}
	{{- if or .PrimaryKeyIsUUID .PrimaryKey.IsStringLike }}
	key, err := rules.RunCreate(ctx, rulesHost(r.tx), {{ printf "%q" .TypeName }}, r.coreOwn(row), behaviorCaller(ctx), opts)
	if err != nil {
		return nil, err
	}
	{{- else }}
	// The core's key is the row's own, which the create names.
	if _, err := rules.RunCreate(ctx, rulesHost(r.tx), {{ printf "%q" .TypeName }}, r.coreOwn(row), behaviorCaller(ctx), opts); err != nil {
		return nil, err
	}
	{{- end }}
	{{- if .PrimaryKeyIsUUID }}
	id, err := {{ .KeyParse }}(key)
	if err != nil {
		return nil, fmt.Errorf("create {{ .TypeName }}: the core's key %q: %w", key, err)
	}
	{{- else if .PrimaryKey.IsStringLike }}
	id := {{ .PrimaryKeyType }}(key)
	{{- else if .PrimaryKeyIsPointer }}
	id := *row.{{ toGoName .PrimaryKeyField }}
	{{- else }}
	id := row.{{ toGoName .PrimaryKeyField }}
	{{- end }}
	return r.GetOne(ctx, id, nil)
}

// upsertInputs are inputs as an upsert inserts them (D103): each one's row
// with the fields its behaviors own as the core's create of it gives them,
// run to its change set and not applied, so the insert writes what CreateOne
// would have, and the update, which sets none of them, leaves them as the
// row holds them. A refusal of the core's is returned before anything is
// written.
func (r *{{ .Name }}) upsertInputs(ctx context.Context, inputs []*{{ .TypeName }}Create) ([]*types.{{ .TypeName }}, error) {
	host := rulesHost(r.tx)
	rows := make([]*types.{{ .TypeName }}, 0, len(inputs))
	for _, input := range inputs {
		row := input.row()
		owned, err := rules.PrepareCreate(ctx, host, {{ printf "%q" .TypeName }}, r.coreOwn(row), behaviorCaller(ctx), &rules.CreateOptions{ID: r.createKey(row)})
		if err != nil {
			return nil, err
		}
		{{- range .OwnedFields }}
		{{- if .DateTime }}
		if at, err := rules.TimeOfMillis(owned[{{ printf "%q" .Use }}][{{ printf "%q" .Name }}]); err != nil {
			return nil, fmt.Errorf("upsert {{ $.TypeName }}: the core's {{ .Use }}.{{ .Name }}: %w", err)
		} else if at != nil {
			{{- if .Pointer }}
			value := {{ .GoType }}(*at)
			row.{{ .Member }} = &value
			{{- else }}
			row.{{ .Member }} = {{ .GoType }}(*at)
			{{- end }}
		}
		{{- else }}
		if value, ok := owned[{{ printf "%q" .Use }}][{{ printf "%q" .Name }}]; ok {
			if err := json.Unmarshal(value, &row.{{ .Member }}); err != nil {
				return nil, fmt.Errorf("upsert {{ $.TypeName }}: the core's {{ .Use }}.{{ .Name }} %s: %w", value, err)
			}
		}
		{{- end }}
		{{- end }}
		rows = append(rows, row)
	}
	return rows, nil
}
{{- end }}

