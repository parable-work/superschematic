// GetOne retrieves a single {{ .TypeName }} by ID
func (r *{{ .Name }}) GetOne(ctx context.Context, id {{ .PrimaryKeyType }}, opts *{{ .TypeName }}GetOptions) (*types.{{ .TypeName }}, error) {
	// Determine if we're using partial field selection
	var fieldStrings []string
	usePartialFields := opts != nil && !opts.Fields.IsZero()

	// Build query - if no fields specified, select all in scan order
	var query string
	if usePartialFields {
		// Build selected fields in OrderedMembers order so FK columns match scan order.
		{{- range .OrderedMembers }}
		{{- if .IsRelationship }}
		if opts.Fields.{{ toGoName .Relationship.FieldName }} || {{- if .Relationship.NestedByPointer }} (opts.Fields.{{ toGoName .Relationship.FieldName }}Nested != nil && !opts.Fields.{{ toGoName .Relationship.FieldName }}Nested.IsZero()) {{- else }} !opts.Fields.{{ toGoName .Relationship.FieldName }}Nested.IsZero() {{- end }} {
			fieldStrings = append(fieldStrings, "{{ .Relationship.DBColumnName }}")
		}
		{{- else }}
		if opts.Fields.{{ toGoName .Field.Name }} {
			fieldStrings = append(fieldStrings, "{{ .Field.DBName }}")
		}
		{{- end }}
		{{- end }}
		{{- if .HasArrayRelationships }}
		// hasMany hydration needs the parent primary key for child mapping.
		hasManyRequested := false
