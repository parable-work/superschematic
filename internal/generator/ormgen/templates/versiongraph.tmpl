// materialize reads a commit's tree: it walks the commit's parents, takes
// each entity's nearest patch, drops the deletes and reads the row versions
// the rest name from history. An empty commit is the empty tree.
func (e *graphEngine) materialize(ctx context.Context, tx pgx.Tx, commit string) (graphTree, error) {
	tree := graphTree{}
	if commit == "" {
		return tree, nil
	}
	ceiling := e.walkCeiling
	if ceiling <= 0 {
		ceiling = DefaultWalkCeiling
	}
	rows, err := tx.Query(ctx, e.spec.walk, commit, ceiling)
	if err != nil {
		return nil, fmt.Errorf("failed to walk commits: %w", err)
	}
	var chain []string
	var lastParent string
	for rows.Next() {
		var id, parent string
		var epoch int64
		if err := rows.Scan(&id, &parent, &epoch); err != nil {
			rows.Close()
			return nil, fmt.Errorf("failed to scan commit: %w", err)
		}
		if epoch > e.spec.schemaEpoch {
			rows.Close()
			return nil, fmt.Errorf("%w: commit %s has epoch %d, this graph %d", ErrSchemaEpoch, id, epoch, e.spec.schemaEpoch)
		}
		chain = append(chain, id)
		lastParent = parent
	}
	rows.Close()
	if err := rows.Err(); err != nil {
		return nil, fmt.Errorf("failed to walk commits: %w", err)
	}
	if len(chain) == 0 {
		return nil, ErrNotFound
	}
	if lastParent != "" {
		return nil, fmt.Errorf("%w: %d commits", ErrWalkCeiling, ceiling)
	}

	type pin struct {
		ids      []string
		versions []int64
	}
	pins := map[string]*pin{}
	rows, err = tx.Query(ctx, e.spec.patches, chain)
	if err != nil {
		return nil, fmt.Errorf("failed to read patches: %w", err)
	}
	for rows.Next() {
		var kind, id, operation string
		var version int64
		if err := rows.Scan(&kind, &id, &version, &operation); err != nil {
			rows.Close()
			return nil, fmt.Errorf("failed to scan patch: %w", err)
		}
		if operation == "DELETE" {
			continue
		}
		if pins[kind] == nil {
			pins[kind] = &pin{}
		}
		pins[kind].ids = append(pins[kind].ids, id)
		pins[kind].versions = append(pins[kind].versions, version)
	}
	rows.Close()
	if err := rows.Err(); err != nil {
		return nil, fmt.Errorf("failed to read patches: %w", err)
	}

	for _, kind := range e.spec.kinds {
		p := pins[kind.name]
		if p == nil {
			continue
		}
		rows, err := tx.Query(ctx, kind.images, p.ids, p.versions)
		if err != nil {
			return nil, fmt.Errorf("failed to read %s history: %w", kind.name, err)
		}
		found := 0
		for rows.Next() {
			var raw []byte
			if err := rows.Scan(&raw); err != nil {
				rows.Close()
				return nil, fmt.Errorf("failed to scan %s history: %w", kind.name, err)
			}
			tree.add(kind.name, raw)
			found++
		}
		rows.Close()
		if err := rows.Err(); err != nil {
			return nil, fmt.Errorf("failed to read %s history: %w", kind.name, err)
		}
		if found != len(p.ids) {
			return nil, fmt.Errorf("%w: %d of %d %s rows", ErrHistoryMissing, len(p.ids)-found, len(p.ids), kind.name)
		}
	}
	return tree, nil
}

// compose is core.compose(materialize(ref.base) or empty, the ref's own
// rows). It returns the composed tree, the core's findings and the own rows.
func (e *graphEngine) compose(ctx context.Context, tx pgx.Tx, ref graphRef) (graphTree, []versiongraph.Finding, graphTree, error) {
	base, err := e.materialize(ctx, tx, ref.base)
	if err != nil {
		return nil, nil, nil, err
	}
	own, err := e.ownRows(ctx, tx, ref.id)
	if err != nil {
		return nil, nil, nil, err
	}
	baseJSON, err := base.json()
	if err != nil {
		return nil, nil, nil, err
	}
	ownJSON, err := own.json()
	if err != nil {
		return nil, nil, nil, err
	}
	result, err := versiongraph.Compose(versiongraph.ComposeRequest{Descriptor: e.spec.descriptor, Base: baseJSON, Overlay: ownJSON})
	if err != nil {
		return nil, nil, nil, err
	}
	tree, err := decodeGraphTree(result.Tree)
	if err != nil {
		return nil, nil, nil, err
	}
	return tree, result.Findings, own, nil
}

