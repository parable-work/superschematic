// deleteEntity writes the row that deletes an entity on a ref: a copy of
// the entity's effective row, so every NOT NULL column holds, with
// deleted_on_ref set.
func (e *graphEngine) deleteEntity(ctx context.Context, tx pgx.Tx, ref graphRef, composed map[string]map[string]json.RawMessage, kindName, key string) error {
	kind, err := e.spec.kind(kindName)
	if err != nil {
		return err
	}
	row, ok := composed[kindName][key]
	if !ok {
		return fmt.Errorf("%w: %s %s", ErrEntityNotFound, kindName, key)
	}
	_, err = e.writeRow(ctx, tx, kind, ref, row, true)
	return err
}

// unsetEntity removes a ref's own row of an entity through the kind's
// actor-recording hard delete, so the ref reads the entity through its base.
func (e *graphEngine) unsetEntity(ctx context.Context, tx pgx.Tx, ref graphRef, kindName string, key {{ .UUIDGoType }}) error {
	kind, err := e.spec.kind(kindName)
	if err != nil {
		return err
	}
	id, err := e.slot(ctx, tx, kind, ref.id, uuidText(key))
	if err != nil {
		return err
	}
	if id == "" {
		return fmt.Errorf("%w: no %s override of %s", ErrEntityNotFound, kindName, uuidText(key))
	}
	rowID, err := parseUUIDText(id)
	if err != nil {
		return err
	}
	return kind.unset(ctx, tx, rowID)
}

// graphCommitOptions are a commit's message and whether it is tagged.
type graphCommitOptions struct {
	message string
	tag     bool
}

// commit composes the ref, diffs it against its last commit (or its base)
// and writes a commit with a patch per changed entity. It returns the new
// commit's id, or ErrNothingToCommit. The caller moves the ref's head.
func (e *graphEngine) commit(ctx context.Context, tx pgx.Tx, ref graphRef, opts graphCommitOptions) (string, error) {
	composed, _, own, err := e.compose(ctx, tx, ref)
	if err != nil {
		return "", err
	}
	composedJSON, err := composed.json()
	if err != nil {
		return "", err
	}
	validated, err := versiongraph.Validate(versiongraph.TreeRequest{Descriptor: e.spec.descriptor, Tree: composedJSON})
	if err != nil {
		return "", err
	}
	if len(validated.Findings) > 0 {
		return "", &InvalidTreeError{Findings: validated.Findings}
	}
	parent := ref.head
	if parent == "" {
		parent = ref.base
	}
	previous, err := e.materialize(ctx, tx, parent)
	if err != nil {
		return "", err
	}
	changes, err := e.diff(previous, composed)
	if err != nil {
		return "", err
	}
	if len(changes) == 0 {
		return "", ErrNothingToCommit
	}
	ownByKey, err := e.spec.index(own)
	if err != nil {
		return "", err
	}
	previousByKey, err := e.spec.index(previous)
	if err != nil {
		return "", err
	}

	type patch struct {
		Kind      string `json:"kind"`
		Key       string `json:"key"`
		ID        string `json:"id"`
		Version   int64  `json:"version"`
		Operation string `json:"op"`
	}
	patches := make([]patch, 0, len(changes))
	for _, change := range changes {
		kind, err := e.spec.kind(change.Kind)
		if err != nil {
			return "", err
		}
		// An ADD or UPDATE pins the winning row. A DELETE pins the ref's
		// tombstone, or the entity's last committed row when a removed
		// parent took it with it.
		pinned := change.Row
		if change.Operation == "DELETE" {
			pinned = previousByKey[change.Kind][change.EntityKey]
			if raw, ok := ownByKey[change.Kind][change.EntityKey]; ok {
				if row, err := readGraphRow(kind, raw); err == nil && row.tombstone {
					pinned = raw
				}
			}
		}
		row, err := readGraphRow(kind, pinned)
		if err != nil {
			return "", err
		}
		patches = append(patches, patch{Kind: change.Kind, Key: change.EntityKey, ID: row.id, Version: row.version, Operation: change.Operation})
	}

	hash, err := e.contentHash(composed)
	if err != nil {
		return "", err
	}
	var sequence *int64
	if opts.tag {
		if _, err := tx.Exec(ctx, e.spec.lockRoot, ref.root); err != nil {
			return "", fmt.Errorf("failed to lock the root for a tag: %w", err)
		}
		var next int64
		if err := tx.QueryRow(ctx, e.spec.nextSequence, ref.root).Scan(&next); err != nil {
			return "", fmt.Errorf("failed to read the next sequence: %w", err)
		}
		sequence = &next
	}
	var message *string
	if opts.message != "" {
		message = &opts.message
	}
	var id string
	if err := tx.QueryRow(ctx, e.spec.insertCommit, ref.root, ref.id, parent, message, e.spec.schemaEpoch, hash, sequence, GetUserID(ctx)).Scan(&id); err != nil {
		return "", fmt.Errorf("failed to write commit: %w", err)
	}
	patchJSON, err := json.Marshal(patches)
	if err != nil {
		return "", err
	}
	if _, err := tx.Exec(ctx, e.spec.insertPatches, id, patchJSON); err != nil {
		return "", fmt.Errorf("failed to write patches: %w", err)
	}
	return id, nil
}

// commitAndMove commits the ref and moves its head, sealing it when asked.
// Nothing to commit is not an error when allowEmpty is set: the ref's
// _version still moves and the returned commit is "".
func (e *graphEngine) commitAndMove(ctx context.Context, tx pgx.Tx, ref graphRef, opts graphCommitOptions, allowEmpty, seal bool) (string, error) {
	commit, err := e.commit(ctx, tx, ref, opts)
	if errors.Is(err, ErrNothingToCommit) && allowEmpty {
		commit, err = "", nil
	}
	if err != nil {
		return "", err
	}
	if err := e.touchRef(ctx, tx, ref, commit, seal); err != nil {
		return "", err
	}
	return commit, nil
}

// commitRoot reads a commit's root.
func (e *graphEngine) commitRoot(ctx context.Context, tx pgx.Tx, commit string) (string, error) {
	var root string
	err := tx.QueryRow(ctx, e.spec.commitRoot, commit).Scan(&root)
	if errors.Is(err, pgx.ErrNoRows) {
		return "", ErrNotFound
	}
	if err != nil {
		return "", fmt.Errorf("failed to read commit: %w", err)
	}
	return root, nil
}

// merge merges source's head into target against source's base. With no
// conflicts it writes every entity the target does not already hold as the
// merge left it: the merged row, or the row that deletes the entity.
func (e *graphEngine) merge(ctx context.Context, tx pgx.Tx, source, target graphRef, resolutions []versiongraph.Resolution) ([]versiongraph.Conflict, error) {
	base, err := e.materialize(ctx, tx, source.base)
	if err != nil {
		return nil, err
	}
	theirs := base
	if source.head != "" {
		if theirs, err = e.materialize(ctx, tx, source.head); err != nil {
			return nil, err
		}
	}
	ours, _, _, err := e.compose(ctx, tx, target)
	if err != nil {
		return nil, err
	}
	request := versiongraph.MergeRequest{Descriptor: e.spec.descriptor, Resolutions: resolutions}
	if request.Base, err = base.json(); err != nil {
		return nil, err
	}
	if request.Ours, err = ours.json(); err != nil {
		return nil, err
	}
	if request.Theirs, err = theirs.json(); err != nil {
		return nil, err
	}
	result, err := versiongraph.Merge(request)
	if err != nil {
		return nil, err
	}
	if len(result.Conflicts) > 0 {
		return result.Conflicts, nil
	}
	merged, err := decodeGraphTree(result.Merged)
	if err != nil {
		return nil, err
	}
	mergedByKey, err := e.spec.index(merged)
	if err != nil {
		return nil, err
	}
	oursByKey, err := e.spec.index(ours)
	if err != nil {
		return nil, err
	}
	for _, outcome := range result.Entities {
		if outcome.Side == "ours" {
			continue
		}
		if outcome.Deleted {
			if _, live := oursByKey[outcome.Kind][outcome.EntityKey]; !live {
				continue
			}
			if err := e.deleteEntity(ctx, tx, target, oursByKey, outcome.Kind, outcome.EntityKey); err != nil {
				return nil, err
			}
			continue
		}
		kind, err := e.spec.kind(outcome.Kind)
		if err != nil {
			return nil, err
		}
		row, ok := mergedByKey[outcome.Kind][outcome.EntityKey]
		if !ok {
			return nil, fmt.Errorf("version graph: the merge left no %s row for %s", outcome.Kind, outcome.EntityKey)
		}
		if _, err := e.writeRow(ctx, tx, kind, target, row, false); err != nil {
			return nil, err
		}
	}
	return nil, nil
}

// revert writes the rows that make the ref compose to tree: each entity
// tree holds that the ref composes differently is written from tree, and
// each entity only the ref holds is deleted on it.
func (e *graphEngine) revert(ctx context.Context, tx pgx.Tx, ref graphRef, tree graphTree) error {
	current, _, _, err := e.compose(ctx, tx, ref)
	if err != nil {
		return err
	}
	changes, err := e.diff(current, tree)
	if err != nil {
		return err
	}
	currentByKey, err := e.spec.index(current)
	if err != nil {
		return err
	}
	for _, change := range changes {
		if change.Operation == "DELETE" {
			if err := e.deleteEntity(ctx, tx, ref, currentByKey, change.Kind, change.EntityKey); err != nil {
				return err
			}
			continue
		}
		kind, err := e.spec.kind(change.Kind)
		if err != nil {
			return err
		}
		if _, err := e.writeRow(ctx, tx, kind, ref, change.Row, false); err != nil {
			return err
		}
	}
	return nil
}

// refCommits lists a ref's own commits, newest first: its head and the
// parents that the ref itself wrote.
func (e *graphEngine) refCommits(ctx context.Context, tx pgx.Tx, ref graphRef) ([]string, error) {
	if ref.head == "" {
		return nil, nil
	}
	ceiling := e.walkCeiling
	if ceiling <= 0 {
		ceiling = DefaultWalkCeiling
	}
	rows, err := tx.Query(ctx, e.spec.refCommits, ref.head, ref.id, ceiling)
	if err != nil {
		return nil, fmt.Errorf("failed to list commits: %w", err)
	}
	defer rows.Close()
	var ids []string
	for rows.Next() {
		var id string
		if err := rows.Scan(&id); err != nil {
			return nil, fmt.Errorf("failed to scan commit: %w", err)
		}
		ids = append(ids, id)
	}
	return ids, rows.Err()
}
