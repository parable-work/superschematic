	var conditions []string
	paramNum := paramOffset

	{{- range .Fields }}
	{{- if .FilterKind }}
	if f.{{ toGoName .Name }} != nil {
	{{- range .FilterConditions }}
	{{- template "filterCondition" . }}
	{{- end }}
	}
	{{- end }}
	{{- end }}

	{{- range .Relationships }}
	{{- if not .IsArray }}
	if f.{{ toGoName .FieldName }}ID != nil {
	{{- range .FilterConditions }}
	{{- template "filterCondition" . }}
	{{- end }}
	}
	{{- end }}
	{{- end }}

	{{- range .PathRelations }}
	if f.{{ .GoField }} != nil {
		before := len(*args)
		through := f.{{ .GoField }}.conditions(args, paramNum)
		paramNum += len(*args) - before
		{{- if .TargetLive }}
		through = append(through, {{ goRawString .TargetLive }})
		{{- end }}
		where := ""
		if len(through) > 0 {
			where = " WHERE " + strings.Join(through, " AND ")
		}
		conditions = append(conditions, fmt.Sprintf({{ goRawString .Probe }}, where))
	}
	{{- end }}

	{{- range .ReferencedBy }}
	if f.{{ .FilterField }} != nil {
		probe := {{ goRawString .Probe.Probe }}
		{{- if .SourceHasSoftDelete }}
		if !f.{{ .FilterField }}.IncludeDeleted {
			probe += {{ goRawString .Probe.Live }}
		}
		{{- end }}
		if f.{{ .FilterField }}.Exists {
			conditions = append(conditions, fmt.Sprintf({{ goRawString .Probe.Exists }}, probe))
		} else {
			conditions = append(conditions, fmt.Sprintf({{ goRawString .Probe.NotExists }}, probe))
		}
	}
	{{- end }}
	{{- if .HasSearch }}

	if f.SearchText != nil {
		for _, term := range searchTerms(*f.SearchText) {
			paramNum++
			conditions = append(conditions, fmt.Sprintf({{ goRawString .SearchCondition }}, paramNum))
			*args = append(*args, searchLikePattern(term))
		}
	}
	{{- end }}

	// AllOf's filters' conditions are the filter's own, ANDed (D99), each
	// one's placeholders numbered after the last.
	for i := range f.AllOf {
		before := len(*args)
		conditions = append(conditions, f.AllOf[i].conditions(args, paramNum)...)
		paramNum += len(*args) - before
	}

	if len(f.AnyOf) > 0 {
		start := len(*args)
		branches := make([]string, 0, len(f.AnyOf))
		every := false
		for i := range f.AnyOf {
			before := len(*args)
			branch := f.AnyOf[i].conditions(args, paramNum)
			paramNum += len(*args) - before
			if len(branch) == 0 {
				every = true
				continue
			}
			branches = append(branches, "("+strings.Join(branch, " AND ")+")")
		}
		if every {
			// A branch of no condition keeps every row, and so does the
			// whole: the other branches' parameters go too. AnyOf is the
			// last condition, so no placeholder follows theirs.
			*args = (*args)[:start]
		} else {
			conditions = append(conditions, "("+strings.Join(branches, " OR ")+")")
		}
	}

	return conditions
}
{{- end }}


{{- define "filterCondition" }}
{{- if eq .Op "in" }}
		if len({{ .Field }}.In) > 0 {
			placeholders := make([]string, len({{ .Field }}.In))
			for i, {{ .Loop }} := range {{ .Field }}.In {
				paramNum++
				placeholders[i] = fmt.Sprintf("$%d", paramNum)
				*args = append(*args, {{ .Value }})
			}
			conditions = append(conditions, fmt.Sprintf({{ goRawString .SQL }}, strings.Join(placeholders, ", ")))
		}
{{- else if eq .Op "between" }}
		if {{ .Field }}.Between != nil {
			paramNum++
			conditions = append(conditions, fmt.Sprintf({{ goRawString .SQL }}, paramNum))
			*args = append(*args, {{ .Field }}.Between.{{ .Min }})
			paramNum++
			conditions = append(conditions, fmt.Sprintf({{ goRawString .SQL2 }}, paramNum))
			*args = append(*args, {{ .Field }}.Between.{{ .Max }})
		}
{{- else if eq .Op "isNull" }}
		if {{ .Field }}.IsNull != nil {
			if *{{ .Field }}.IsNull {
				conditions = append(conditions, {{ goRawString .SQL }})
			} else {
				conditions = append(conditions, {{ goRawString .SQL2 }})
			}
		}
{{- else }}
		if {{ .Field }}.{{ .Member }} != nil {
			paramNum++
			conditions = append(conditions, fmt.Sprintf({{ goRawString .SQL }}, paramNum))
			*args = append(*args, {{ .Value }})
		}
{{- end }}
{{- end }}
