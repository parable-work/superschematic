func (r *{{ $repo }}) UpdateMany(ctx context.Context, filter *{{ .TypeName }}Filter, update *{{ .TypeName }}Update) (int, error) {
	var args []any
	sets, _, _, err := r.sets(update, &args)
	if err != nil {
