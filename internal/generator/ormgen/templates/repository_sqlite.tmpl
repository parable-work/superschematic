	if sets, args, err = r.stamped(ctx, update, sets, args); err != nil {
		return 0, err
	}
	if len(sets) == 0 {
		return 0, fmt.Errorf("no fields to update")
	}
	where := r.where(filter, &args, false)
	n, err := {{ $v }}.exec(ctx, r.q(), fmt.Sprintf({{ $v }}.st.updateMany, strings.Join(sets, ", "), where), args...)
	if err != nil {
		return 0, fmt.Errorf("failed to execute update: %w", err)
	}
	return n, nil
}

