func (r *{{ $repo }}) updateOne(ctx context.Context, id {{ .PrimaryKeyType }}, update *{{ .TypeName }}Update, version *int64) (*types.{{ .TypeName }}, error) {
	var args []any
	sets, _, _, err := r.sets(update, &args)
	if err != nil {
