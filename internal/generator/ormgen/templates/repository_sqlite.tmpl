// RunDeadline runs a due deadline of a {{ $r.TypeName }} row through the behaviors'
// core (D103) on SQLite, as the Postgres repository's does.
func (r *{{ $repo }}) RunDeadline(ctx context.Context, deadline types.{{ $r.DeadlineQueue }}, claim *rules.Claim) (*rules.DeadlineRun, error) {
	payload, err := json.Marshal({{ .Payload }})
	if err != nil {
		return nil, fmt.Errorf("orm: the payload of {{ $r.TypeName }}'s deadline %s.%s: %w", {{ .UseID }}, {{ .Name }}, err)
	}
	var run *rules.DeadlineRun
	err = r.inTx(ctx, func(tx *sql.Tx) error {
		opts, err := r.operationOptions(ctx)
		if err != nil {
			return err
		}
		run, err = rules.RunDeadline(ctx, sqliteRulesHost(tx), {{ printf "%q" $r.TypeName }}, rules.Deadline{Key: {{ .RowKey }}, UseID: {{ .UseID }}, Name: {{ .Name }}, At: {{ .At }}, Payload: payload}, behaviorCaller(ctx), claim, opts)
		return err
	})
	return run, err
}
