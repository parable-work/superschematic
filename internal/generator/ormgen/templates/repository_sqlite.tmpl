// UpsertOneResult is UpsertOne, and what it did with its row (D89).
func (r *{{ $repo }}) UpsertOneResult(ctx context.Context, input *{{ .CreateInput }}, on {{ .TypeName }}UniqueKey, update *{{ .TypeName }}Update, opts *UpsertOptions) (UpsertResult[*types.{{ .TypeName }}], error) {
	key, ok := {{ $v }}UniqueKeys[on]
	if !ok {
		return UpsertResult[*types.{{ .TypeName }}]{}, fmt.Errorf("orm: {{ .TypeName }} has no unique key %q", string(on))
	}
	onlyIfChanged := opts != nil && opts.OnlyIfChanged
	var out UpsertResult[*types.{{ .TypeName }}]
	err := r.within(ctx, func(q sqliteQuerier) error {
		if err := r.stampCreate(ctx, input); err != nil {
			return err
		}
		record, err := sqliteMembersOf(input)
		if err != nil {
			return fmt.Errorf("upsert {{ .TypeName }}: %w", err)
		}
		var args []any
		sets, compare, next, err := r.sets(update, &args)
		if err != nil {
			return err
		}
		if len(sets) > 0 {
			if sets, args, err = r.stamped(ctx, update, sets, args); err != nil {
				return err
			}
		}
		upserted, err := {{ $v }}.upsert(ctx, q, record, key, sets, args, compare, next, onlyIfChanged)
		if err != nil {
			return err
		}
		rows, err := r.decode(ctx, []sqliteRecord{upserted.record}, {{ .TypeName }}Fields{}, false)
		if err != nil {
			return err
		}
		out = UpsertResult[*types.{{ .TypeName }}]{Row: rows[0], Status: upserted.status}
		return nil
	})
	return out, err
}

// {{ $v }}Excluded are the columns UpsertMany may set from the input a
// row of it would have inserted: the columns of {{ .TypeName }}Update.
var {{ $v }}Excluded = map[string]string{
	{{- range .SQLite.Updates }}
	{{ printf "%q" .Name }}: {{ goRawString .Quoted }},
	{{- end }}
}

// UpsertMany inserts each input, or, when a row already holds its value of
// the unique key on, sets each field update names of that row to the value
// the input would have inserted, and returns each input's row and what it
// did with it, in the inputs' order (D89): a row at a time, in one
// transaction.
func (r *{{ $repo }}) UpsertMany(ctx context.Context, inputs []*{{ .CreateInput }}, on {{ .TypeName }}UniqueKey, update {{ .TypeName }}Fields, opts *UpsertOptions) ([]UpsertResult[*types.{{ .TypeName }}], error) {
	key, ok := {{ $v }}UniqueKeys[on]
	if !ok {
		return nil, fmt.Errorf("orm: {{ .TypeName }} has no unique key %q", string(on))
	}
	if key.expression {
		return nil, upsertExpressionKey("UpsertMany", "{{ .TypeName }}", string(on))
	}
	if opts != nil && opts.Batch < 0 {
		return nil, fmt.Errorf("orm: UpsertMany writes 1 or more {{ .TypeName }} rows a statement, not %d", opts.Batch)
	}
	var excluded []string
	for _, column := range {{ lowerFirst .TypeName }}FieldStrings(update) {
		quoted, ok := {{ $v }}Excluded[column]
		if !ok {
			return nil, fmt.Errorf("orm: UpsertMany of {{ .TypeName }} sets the fields an update sets, not %s", column)
		}
		excluded = append(excluded, quoted)
	}
	onlyIfChanged := opts != nil && opts.OnlyIfChanged
	out := make([]UpsertResult[*types.{{ .TypeName }}], 0, len(inputs))
	err := r.within(ctx, func(q sqliteQuerier) error {
		for _, input := range inputs {
			if err := r.stampCreate(ctx, input); err != nil {
				return err
			}
			record, err := sqliteMembersOf(input)
			if err != nil {
				return fmt.Errorf("upsert {{ .TypeName }}: %w", err)
			}
			var sets, compare, next []string
			var args []any
			for _, quoted := range excluded {
				sets = append(sets, quoted+" = excluded."+quoted)
				compare, next = append(compare, {{ goRawString .Table.Quoted }}+"."+quoted), append(next, "excluded."+quoted)
			}
			if len(sets) > 0 {
				if sets, args, err = r.stamped(ctx, nil, sets, args); err != nil {
					return err
				}
			}
			upserted, err := {{ $v }}.upsert(ctx, q, record, key, sets, args, compare, next, onlyIfChanged)
			if err != nil {
				return err
			}
			rows, err := r.decode(ctx, []sqliteRecord{upserted.record}, {{ .TypeName }}Fields{}, false)
			if err != nil {
				return err
			}
			out = append(out, UpsertResult[*types.{{ .TypeName }}]{Row: rows[0], Status: upserted.status})
		}
		return nil
	})
	if err != nil {
		return nil, err
	}
	return out, nil
}
{{- end }}
{{- end }}
{{- end }}

