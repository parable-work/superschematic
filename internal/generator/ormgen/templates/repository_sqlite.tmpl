{{- /*
sqliteBehaviors are the writes of a table that composes behaviors on SQLite
(D103, D116): through the behaviors' core, in the repository's transaction,
over the rules module's SQLite store. The Postgres repository's conversions
of a row to the core's own fields, and of a write to its columns and its
stamps, are the dialects' both; each column is then held as SQLite holds it.
*/}}
{{- define "sqliteBehaviors" }}
{{- $v := printf "%sSQLite" (lowerFirst .TypeName) }}
{{- $repo := printf "%sSQLiteRepository" .TypeName }}
{{- $r := . }}

// pg is {{ .TypeName }}'s Postgres repository on no connection, whose
// conversions of a row to the behaviors' core's own fields, and of a write
// to its columns and its stamps, this one runs, its columns then held as
// SQLite holds them (D103, D116).
func (r *{{ $repo }}) pg() *{{ .Name }} { return &{{ .Name }}{} }

// operationOptions are the stamps an operation's write of the row sets, as
// SQLite holds them.
func (r *{{ $repo }}) operationOptions(ctx context.Context) (*rules.ExecuteOptions, error) {
	opts := r.pg().operationOptions(ctx)
	if opts == nil {
		return nil, nil
	}
	converted := *opts
	columns, err := {{ $v }}.coreColumns(opts.OwnColumns)
	if err != nil {
		return nil, err
	}
	converted.OwnColumns = columns
	return &converted, nil
}

// inTx runs fn in the repository's transaction, or in one of its own.
func (r *{{ $repo }}) inTx(ctx context.Context, fn func(tx *sql.Tx) error) error {
	return r.within(ctx, func(q sqliteQuerier) error { return fn(q.(*sql.Tx)) })
}

// CreateOne creates a {{ .TypeName }} row through the behaviors' core (D103), in a
// transaction, whose uses initialize the fields they own, and reads it back.
func (r *{{ $repo }}) CreateOne(ctx context.Context, input *{{ .CreateInput }}) (*types.{{ .TypeName }}, error) {
	var out *types.{{ .TypeName }}
	err := r.inTx(ctx, func(tx *sql.Tx) error {
		pg := r.pg()
		row := input.row()
		if err := r.stampCreate(ctx, row); err != nil {
			return err
		}
		columns, err := pg.createColumns(row)
		if err != nil {
			return err
		}
		if columns, err = {{ $v }}.coreColumns(columns); err != nil {
			return err
		}
		opts := &rules.CreateOptions{ID: pg.createKey(row), ExecuteOptions: rules.ExecuteOptions{OwnColumns: columns{{ if .Preconditions }}, Preconditions: behaviorPreconditions(ctx){{ end }}}}
		{{- if or .PrimaryKeyIsUUID .PrimaryKey.IsStringLike }}
		key, err := rules.RunCreate(ctx, sqliteRulesHost(tx), {{ printf "%q" .TypeName }}, pg.coreOwn(row), behaviorCaller(ctx), opts)
		if err != nil {
			return err
		}
		{{- else }}
		if _, err := rules.RunCreate(ctx, sqliteRulesHost(tx), {{ printf "%q" .TypeName }}, pg.coreOwn(row), behaviorCaller(ctx), opts); err != nil {
			return err
		}
		{{- end }}
		{{- if .PrimaryKeyIsUUID }}
		id, err := {{ .KeyParse }}(key)
		if err != nil {
			return fmt.Errorf("create {{ .TypeName }}: the core's key %q: %w", key, err)
		}
		{{- else if .PrimaryKey.IsStringLike }}
		id := {{ .PrimaryKeyType }}(key)
		{{- else if .PrimaryKeyIsPointer }}
		id := *row.{{ toGoName .PrimaryKeyField }}
		{{- else }}
		id := row.{{ toGoName .PrimaryKeyField }}
		{{- end }}
		{{- if $.HeldByAccess }}
		// A row a party's or an agent run's grants do not reach rolls the
		// create back (D156).
		created, err := {{ $v }}.keyArg(id)
		if err != nil {
			return err
		}
		if accessGranted(ctx) {
			if err := sqliteRequireCreated(ctx, tx, {{ printf "%q" .TypeName }}, {{ $v }}.quoted, []any{created}); err != nil {
				return err
			}
		}
		{{- end }}
		out, err = (&{{ $repo }}{db: r.db, tx: tx}).GetOne(ctx, id, nil)
		return err
	})
	return out, err
}

// UpdateOne updates a single {{ .TypeName }} row by ID through the behaviors' core
// (D103), in a transaction: the own fields update sets, and the row is read
// back. It returns ErrNotFound when no live row holds id, and any other
// refusal of the core's as the *rules.Refusal it is.
func (r *{{ $repo }}) UpdateOne(ctx context.Context, id {{ .PrimaryKeyType }}, update *{{ .TypeName }}Update) (*types.{{ .TypeName }}, error) {
	if update == nil {
		update = &{{ .TypeName }}Update{}
	}
	{{- if $.HeldByAccess }}
	key, err := {{ $v }}.keyArg(id)
	if err != nil {
		return nil, err
	}
	if err := r.requireReach(ctx, key, true); err != nil {
		return nil, err
	}
	{{- end }}
	var out *types.{{ .TypeName }}
	err {{ if not $.HeldByAccess }}:{{ end }}= r.inTx(ctx, func(tx *sql.Tx) error {
		pg := r.pg()
		patch := pg.corePatch(update)
		columns, err := pg.updateColumns(ctx, update)
		if err != nil {
			return err
		}
		{{- if not (.HasField "updatedAt") }}
		if len(patch) == 0 && len(columns) == 0 {
			return fmt.Errorf("no fields to update")
		}
		{{- end }}
		if columns, err = {{ $v }}.coreColumns(columns); err != nil {
			return err
		}
		{{- if .HasField "updatedAt" }}
		// updated_at takes the database's clock, as UpdateOne's statement stamps it.
		{{- end }}
		if err := rules.RunUpdate(ctx, sqliteRulesHost(tx), {{ printf "%q" .TypeName }}, {{ .WireKey "id" }}, patch, behaviorCaller(ctx), &rules.ExecuteOptions{OwnColumns: columns{{ if .HasField "updatedAt" }}, NowColumns: []string{ {{- printf "%q" (.FieldColumn "updatedAt") -}} }{{ end }}{{ if .Preconditions }}, Preconditions: behaviorPreconditions(ctx){{ end }}}); err != nil {
			return behaviorNotFound(err, {{ printf "%q" .TypeName }}, id)
		}
		out, err = (&{{ $repo }}{db: r.db, tx: tx}).GetOne(ctx, id, nil)
		return err
	})
	return out, err
}

// DeleteOne deletes a single {{ .TypeName }} row by ID through the behaviors' core
// (D103), in a transaction{{ if .HasSoftDelete }}: the live row is stamped deleted in place of
// deleted{{ end }}. It returns ErrNotFound when no live row holds id, and any other
// refusal of the core's as the *rules.Refusal it is.
func (r *{{ $repo }}) DeleteOne(ctx context.Context, id {{ .PrimaryKeyType }}) error {
	{{- if .HasSoftDelete }}
	if !HasUserID(ctx) {
		return ErrNoUserInContext
	}
	{{- end }}
	{{- if $.HeldByAccess }}
	key, err := {{ $v }}.keyArg(id)
	if err != nil {
		return err
	}
	if err := r.requireReach(ctx, key, true); err != nil {
		return err
	}
	{{- end }}
	return r.inTx(ctx, func(tx *sql.Tx) error {
		opts := &rules.ExecuteOptions{ {{- if .Preconditions }}Preconditions: behaviorPreconditions(ctx){{ end -}} }
		{{- if .HasSoftDelete }}
		stamps := map[string]any{ {{- printf "%q" .DeletedAtCol }}: time.Now()}
		{{- if .HasDeletedBy }}
		stamps[{{ printf "%q" (.FieldColumn "deletedBy") }}] = GetUserID(ctx)
		{{- end }}
		softDelete, err := {{ $v }}.coreColumns(stamps)
		if err != nil {
			return err
		}
		opts.SoftDelete = softDelete
		{{- end }}
		if err := rules.RunDelete(ctx, sqliteRulesHost(tx), {{ printf "%q" .TypeName }}, {{ .WireKey "id" }}, behaviorCaller(ctx), opts); err != nil {
			return behaviorNotFound(err, {{ printf "%q" .TypeName }}, id)
		}
		return nil
	})
}
