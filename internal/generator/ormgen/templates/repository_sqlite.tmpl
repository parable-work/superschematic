{{- $ops := printf "%sSQLite%sOperations" (lowerFirst $r.TypeName) .GoName }}

// {{ .GoName }} returns the operations of {{ $r.TypeName }}'s {{ .Member }} on SQLite.
func (r *{{ $repo }}) {{ .GoName }}() {{ .Interface }} { return {{ $ops }}{r: r} }

// {{ $ops }} runs {{ .Interface }} through the behaviors' core on the SQLite
// repository's transaction, or one of its own.
type {{ $ops }} struct{ r *{{ $repo }} }
{{- range .Operations }}

// {{ .GoName }} runs {{ $use.Member }}'s {{ .Name }} in a transaction, as the Postgres
// repository's does.
{{- if .Table }}
func (o {{ $ops }}) {{ .GoName }}(ctx context.Context, params {{ .Params }}) ({{ .ResultReturn }}, error) {
{{- else }}
func (o {{ $ops }}) {{ .GoName }}(ctx context.Context, id {{ $r.PrimaryKeyType }}, params {{ .Params }}) ({{ .ResultReturn }}, error) {
	{{- if $.HeldByAccess }}
	// The caller's reach first, as the Postgres repository's (D156, D201).
	if key, err := {{ $v }}.keyArg(id); err != nil {
		var none {{ .ResultReturn }}
		return none, err
	} else if err := o.r.requireReach(ctx, key, {{ .Writes }}); err != nil {
		var none {{ .ResultReturn }}
		return none, behaviorOutOfReach(err, {{ printf "%q" $r.TypeName }}, {{ $r.WireKey "id" }}, id)
	}
	{{- end }}
{{- end }}
	{{- if eq .Params "json.RawMessage" }}
	var given any = params
	if len(params) == 0 {
		given = nil
	}
	{{- end }}
	var out {{ .ResultReturn }}
	err := o.r.inTx(ctx, func(tx *sql.Tx) error {
		{{- if .Table }}
		raw, err := rules.RunTableOperation(ctx, sqliteRulesHost(tx), {{ printf "%q" $r.TypeName }}, {{ printf "%q" $use.ID }}, {{ printf "%q" .Name }}, {{ if eq .Params "json.RawMessage" }}given{{ else }}params{{ end }}, behaviorCaller(ctx), nil)
		if err != nil {
			return err
		}
		{{- if and $.HeldByAccess .AnswersRow }}
		// The core reads every row; its answer keeps to the caller (D156).
		if raw, err = sqliteKeepAnsweredRow(ctx, tx, {{ printf "%q" $r.TypeName }}, {{ $v }}.quoted, raw, {{ printf "%q" .AnswersRow }}); err != nil {
			return err
		}
		{{- end }}
		{{- else }}
		opts, err := o.r.operationOptions(ctx)
		if err != nil {
			return err
		}
		raw, err := rules.RunOperation(ctx, sqliteRulesHost(tx), {{ printf "%q" $r.TypeName }}, {{ $r.WireKey "id" }}, {{ printf "%q" $use.ID }}, {{ printf "%q" .Name }}, {{ if eq .Params "json.RawMessage" }}given{{ else }}params{{ end }}, behaviorCaller(ctx), opts)
		if err != nil {
			return behaviorNotFound(err, {{ printf "%q" $r.TypeName }}, id)
		}
		{{- end }}
		{{- if .ResultIsStruct }}
		out = &{{ .Result }}{}
		if err := json.Unmarshal(raw, out); err != nil {
			return fmt.Errorf("orm: the result of {{ $r.TypeName }}'s {{ $use.Member }} {{ .Name }}, %s: %w", raw, err)
		}
		{{- else }}
		if err := json.Unmarshal(raw, &out); err != nil {
			return fmt.Errorf("orm: the result of {{ $r.TypeName }}'s {{ $use.Member }} {{ .Name }}, %s: %w", raw, err)
		}
		{{- end }}
		return nil
	})
	if err != nil {
		var zero {{ .ResultReturn }}
		return zero, err
	}
	return out, nil
}
{{- end }}
