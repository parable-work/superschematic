// RunChange runs a write of a {{ $r.TypeName }} row through the behaviors' core
// (D103) on SQLite, as the Postgres repository's does.
func (r *{{ $repo }}) RunChange(ctx context.Context, change types.{{ $r.ChangeQueue }}, claim *rules.Claim) (*rules.ChangeRun, error) {
	before, err := json.Marshal({{ .Before }})
	if err != nil {
		return nil, fmt.Errorf("orm: the image before {{ $r.TypeName }}'s change of %s: %w", {{ .RowKey }}, err)
	}
	after, err := json.Marshal({{ .After }})
	if err != nil {
		return nil, fmt.Errorf("orm: the image after {{ $r.TypeName }}'s change of %s: %w", {{ .RowKey }}, err)
	}
	var run *rules.ChangeRun
	err = r.inTx(ctx, func(tx *sql.Tx) error {
		opts, err := r.operationOptions(ctx)
		if err != nil {
			return err
		}
		run, err = rules.RunChange(ctx, sqliteRulesHost(tx), {{ printf "%q" $r.TypeName }}, rules.Change{Key: {{ .RowKey }}, Write: {{ .Write }}, At: {{ .At }}, Before: before, After: after}, behaviorCaller(ctx), claim, opts)
		return err
	})
	return run, err
}
{{- end }}
{{- with .EventQueue }}

// RunEvent spends a claimed event of a {{ $r.TypeName }} row and runs handle in the
// same transaction (D104) on SQLite, as the Postgres repository's does.
func (r *{{ $repo }}) RunEvent(ctx context.Context, event types.{{ . }}, claim *rules.Claim, handle func(ctx context.Context, tx TxInterface) error) (*rules.EventRun, error) {
	var run *rules.EventRun
	// The handler's transaction runs its after-commit work after the commit
	// of the transaction the event runs in, the repository's or its own
	// (D166).
	work := func(tx *sql.Tx, commit *txCommit) error {
		var err error
		run, err = rules.SpendEvent(ctx, sqliteRulesHost(tx), {{ printf "%q" $r.TypeName }}, claim)
		if err != nil || !run.Ran {
			return err
		}
		return handle(ctx, r.db.txOf(tx, 0, commit))
	}
	var err error
	if r.tx != nil {
		commit := r.commit
		if commit == nil {
			commit = &txCommit{}
		}
		err = work(r.tx, commit)
	} else {
		commit := &txCommit{}
		err = r.db.withinCommitting(ctx, commit, func(tx *sql.Tx) error { return work(tx, commit) })
	}
	if err != nil {
		return nil, err
	}
	return run, nil
}
{{- end }}
