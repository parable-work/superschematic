func (q *{{ .Name }}Queue) Release(ctx context.Context, id, token string) error {
	return {{ lowerFirst .Name }}Queue.release(ctx, q.pool, id, token)
}
{{ if .RetainSeconds }}
// Prune deletes up to limit messages done {{ .RetainSeconds }}s ago or more, the oldest
// first, and returns how many it deleted; a worker runs it again while it
// deletes limit. It never deletes a dead message.
{{- else }}
// Prune deletes up to limit done messages, the oldest first, which the queue
// holds only from before it kept none, and returns how many it deleted. It
// never deletes a dead message.
{{- end }}
func (q *{{ .Name }}Queue) Prune(ctx context.Context, limit int) (int, error) {
	return {{ lowerFirst .Name }}Queue.prune(ctx, q.pool, limit)
}

// Slot takes one of slots locks named for the queue, which a worker in
// drain mode holds while it runs (D145), so no more than slots of them
// drain the queue at once: it reports false when every one is taken, and
// otherwise returns the function that gives the slot back.
func (q *{{ .Name }}Queue) Slot(ctx context.Context, slots int) (release func(), ok bool, err error) {
	return {{ lowerFirst .Name }}Queue.slot(ctx, q.pool, slots)
}

// NextDue reports how long until the first ready message that is not due
// yet falls due, by the database's clock, or false when none waits: a
// worker in drain mode that found the queue idle waits for one due within
// its horizon instead of exiting (D145).
func (q *{{ .Name }}Queue) NextDue(ctx context.Context) (time.Duration, bool, error) {
	return {{ lowerFirst .Name }}Queue.nextDue(ctx, q.pool)
}
{{- end }}
