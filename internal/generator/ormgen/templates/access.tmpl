		return access.GrantAuthentication{}, fmt.Errorf("Unknown grant: %w", access.ErrGrantRefused)
	}
	if err != nil {
		return access.GrantAuthentication{}, err
	}
	grant, err := grantOf(found)
	if err != nil {
		return access.GrantAuthentication{}, err
	}
	if grant.TargetType == "CalendarFeed" || strings.HasPrefix(grant.TargetType, "CalendarFeed;") {
		return access.GrantAuthentication{}, fmt.Errorf("A calendar feed's token reads its feed alone: %w", access.ErrGrantRefused)
	}
	ended, err := GrantEnded(ctx, db, grant, now)
	if err != nil {
		return access.GrantAuthentication{}, err
	}
	if ended == access.GrantNotStarted {
		return access.GrantAuthentication{}, fmt.Errorf("The grant has not started: %w", access.ErrGrantRefused)
	}
	if ended != "" {
		return access.GrantAuthentication{}, fmt.Errorf("The grant has ended: %w", access.ErrGrantRefused)
	}
	name := grant.Role
	var permissions, reaches []string
	role, err := db.Get{{ .Access.Roles }}Repository().FindOne(ctx, &{{ .Access.Roles }}Filter{Name: &StringFilter{Eq: &name}}, nil)
	switch {
	case errors.Is(err, ErrNotFound):
	case err != nil:
		return access.GrantAuthentication{}, err
	default:
		permissions, reaches = role.Permissions, role.Reaches
	}
	if permissions == nil {
		permissions = []string{}
	}
	return access.GrantAuthentication{
		Principal: access.Principal{
			Subject:    grant.Holder,
			Kind:       grant.HolderPrincipalKind(),
			Grants:     []access.GrantReach{{"{{"}}ID: grant.ID, TargetType: grant.TargetType, TargetID: grant.TargetID, Reaches: access.ReachesOf(reaches)}},
			Credential: &access.Credential{Kind: access.CredentialGrant, ID: grant.ID},
		},
		Role:        grant.Role,
		Permissions: permissions,
	}, nil
}

var _ access.GrantAuthority = (*Database)(nil)
{{- end }}
{{- if .Access.Log }}

// accessLogRepositories are the repositories the access log writes: the
// Database's, or an open transaction's.
type accessLogRepositories interface {
	Get{{ .Access.Log }}Repository() {{ .Access.Log }}RepositoryInterface
}

// RecordAccess writes entry to the access log (D156), through db as the
// system actor, so a caller's own access never hides its log row: in an
// open transaction, with it.
func RecordAccess(ctx context.Context, db accessLogRepositories, entry access.LogEntry) error {
	members := map[string]any{"at": time.Now().UTC().Format(time.RFC3339Nano), "kind": entry.Kind}
	for name, value := range map[string]string{
		"principal":     entry.Principal,
		"principalKind": entry.PrincipalKind,
		"actingFor":     entry.ActingFor,
		"credential":    entry.Credential,
		"operation":     entry.Operation,
		"targetType":    entry.TargetType,
		"targetId":      entry.TargetID,
		"field":         entry.Field,
	} {
		if value != "" {
			members[name] = value
		}
	}
	data, err := json.Marshal(members)
	if err != nil {
		return err
	}
	var row types.{{ .Access.Log }}
	if err := json.Unmarshal(data, &row); err != nil {
		return fmt.Errorf("orm: record access: %w", err)
	}
	_, err = db.Get{{ .Access.Log }}Repository().CreateOne(AsSystem(ctx), &row)
	return err
}

// accessLog is the access.Log over a database's @accessLog table.
type accessLog struct{ db accessLogRepositories }

func (l accessLog) Record(ctx context.Context, entry access.LogEntry) error {
	return RecordAccess(ctx, l.db, entry)
}

// AccessLogOf is the access log over db's {{ .Access.Log }} table (D156), written as
// the system actor.
func AccessLogOf(db accessLogRepositories) access.Log {
	return accessLog{db: db}
}
