.PHONY: all test format lint deps clean help

# Default target
all: test

# Run tests
test:
	@echo "Running tests..."
	go test -v ./...

# Format code
format:
	@echo "Formatting code..."
	goimports -w .
	gofmt -w .

# Lint code
lint:
	@echo "Linting code..."
	golangci-lint run

# Install dependencies
deps:
	@echo "Installing dependencies..."
	go mod download
	go mod tidy

# Clean build artifacts
clean:
	@echo "Cleaning..."
	go clean

# Help
help:
	@echo "Available targets:"
	@echo "  test    - Run tests"
	@echo "  format  - Format code"
	@echo "  lint    - Run linter"
	@echo "  deps    - Install dependencies"
	@echo "  clean   - Clean build artifacts"
	@echo "  help    - Show this help message"
