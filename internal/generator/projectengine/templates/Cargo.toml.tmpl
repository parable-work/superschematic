# Code generated by superschematic. DO NOT EDIT.
#
# The engine of the {{ .Schema }} schema (D58), with every behavior the
# schema's types compose compiled in: the core's behaviors,
{{- if .WorkQueue }}
# the work queue's,
{{- end }}
# and each extension's, from the crate its registration names.
# superschematic writes it on every build of the schema while its types
# compose an extension's behavior; a host that opens the engine on the
# schema depends on it and passes behaviors() and tools() in its options.
[package]
name = {{ quote .Name }}
version = "0.0.0"
edition = "2021"
rust-version = {{ quote .RustVersion }}
description = "The engine of the {{ .Schema }} schema, with the behaviors its types compose"
license = "UNLICENSED"
publish = false

# The bindings a host of another language links, each a crate of its own
# over behaviors(), built from this lock file into this target directory:
# ffi, the C ABI's static archive a Go server links in the core's place
# (scripts/engine-archive.sh --crate <this directory>/ffi --out <dir>).
[workspace]
resolver = "2"
members = [{{ range $i, $m := .Members }}{{ if $i }}, {{ end }}{{ quote $m }}{{ end }}]

# The databases the engine runs on: both by default, as the engine has
# them. A host that needs one turns the default off and names it.
[features]
default = ["sqlite", "postgres"]
sqlite = {{ .Features "sqlite" }}
postgres = {{ .Features "postgres" }}

[dependencies]
# The engine's JSON features (D58): a number keeps its text, an object its
# members' order.
serde_json = { version = "1.0.149", features = ["arbitrary_precision", "preserve_order"] }
{{ .Engine.Crate }} = {{ .Engine.Spec }}
{{ .Behaviors.Crate }} = {{ .Behaviors.Spec }}
{{- if .WorkQueue }}
{{ .WorkQueue.Crate }} = {{ .WorkQueue.Spec }}
{{- end }}
{{- range .Extensions }}
# {{ range $i, $b := .Behaviors }}{{ if $i }}, {{ end }}{{ $b.Name }}{{ end }}
{{ .Crate }} = { path = {{ quote .Path }} }
{{- end }}
