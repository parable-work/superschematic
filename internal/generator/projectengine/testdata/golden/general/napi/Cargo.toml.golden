# Code generated by superschematic. DO NOT EDIT.
#
# The engine addon of the shop schema (D58): the engine's Node-API
# addon over the behaviors() of the crate this directory is in, which a
# TypeScript server loads in place of the core's by naming the file (the
# engine option addon, or SUPERSCHEMATIC_ENGINE_ADDON). Build it with the
# checkout's scripts/engine-napi.sh, which prints the file it wrote:
#
#   scripts/engine-napi.sh --crate <this directory> --out <dir>
[package]
name = "schemas-shop-engine-napi"
version = "0.0.0"
edition = "2021"
rust-version = "1.99.0"
description = "The engine addon of the shop schema, the engine's Node-API addon over the behaviors its types compose"
license = "UNLICENSED"
publish = false

[lib]
# cdylib: the .node file Node.js and Bun load. Its Node-API symbols
# resolve only when one loads it, so it has no Rust test: a test binary
# would not link. A TypeScript test opens an engine on it.
crate-type = ["cdylib"]
test = false
doctest = false

# The databases the addon's engine opens, both by default, as the engine's
# own addon has them. js-behaviors is the test addon's bridge to behaviors
# written in TypeScript (scripts/engine-napi.sh --js-behaviors), never in a
# shipped addon.
[features]
default = ["sqlite", "postgres"]
sqlite = ["schemas-shop-engine/sqlite", "superschematic-engine-napi/sqlite"]
postgres = ["schemas-shop-engine/postgres", "superschematic-engine-napi/postgres"]
js-behaviors = ["superschematic-engine-napi/js-behaviors"]

[dependencies]
schemas-shop-engine = { path = "..", default-features = false }
# The addon as a library and export_engine_napi!, which this crate expands
# once; never the core's addon, whose exports these would register again.
superschematic-engine-napi = { version = "0.0.0", default-features = false }

# The link arguments a Node-API addon needs (build.rs).
[build-dependencies]
napi-build = "=2.5.0"
