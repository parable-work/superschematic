        let opened = String::from_utf8_lossy(&opened).into_owned();
        assert_eq!(code, ENG_OK, "eng_open: {opened}");
        let info: serde_json::Value = serde_json::from_str(&opened).expect("eng_open writes JSON");
        assert_eq!(info["project"], env!("CARGO_PKG_NAME"), "{info}");
        let registered = info["behaviors"].as_array().expect("the behaviors' names");
        for name in project::COMPOSED {
            assert!(
                registered.iter().any(|n| n == name),
                "{name} is not registered: {info}"
            );
        }
        assert_eq!(super::eng_close(engine), ENG_OK);
        let _ = std::fs::remove_dir_all(&dir);
    }
