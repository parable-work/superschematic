    /// The archive's exports open an engine on SQLite as the Go binding
    /// opens one, under the schema's tools, and the engine runs every
    /// behavior the schema composes.
    #[test]
    fn the_archive_opens_an_engine_that_runs_every_behavior_the_schema_composes() {
        let dir =
            std::env::temp_dir().join(format!("{}-{}", env!("CARGO_PKG_NAME"), std::process::id()));
        std::fs::create_dir_all(&dir).expect("a directory");
        let tools: serde_json::Value = serde_json::from_str(project::TOOLS).expect("TOOLS is JSON");
        let config = serde_json::json!({
            "path": dir.join("engine.db").to_string_lossy(),
            "policy": "allowAll",
            "tools": tools,
        })
        .to_string();
        let mut engine = 0u64;
        let mut out = std::ptr::null_mut();
        let mut out_len = 0usize;
        // SAFETY: config is config.len() readable bytes and the outputs are
        // writable; the archive's output is copied, then released.
        let (code, opened) = unsafe {
            let code = super::eng_open(
                config.as_ptr(),
                config.len(),
                &mut engine,
                &mut out,
                &mut out_len,
            );
            let opened = std::slice::from_raw_parts(out, out_len).to_vec();
            super::eng_free(out, out_len);
            (code, opened)
