[package]
name = "schemas-shop-engine-ffi"
version = "0.0.0"
edition = "2021"
rust-version = "1.99.0"
description = "The engine archive of the shop schema, the engine's C ABI over the behaviors its types compose"
license = "UNLICENSED"
