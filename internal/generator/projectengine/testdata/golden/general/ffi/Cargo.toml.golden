default = ["sqlite", "postgres"]
sqlite = ["schemas-shop-engine/sqlite", "superschematic-engine-abi/sqlite"]
postgres = ["schemas-shop-engine/postgres", "superschematic-engine-abi/postgres"]

[dependencies]
