# expands once; never the core's archive, whose exports these would define
# again.
superschematic-engine-abi = { version = "0.0.0", default-features = false }

[dev-dependencies]
serde_json = { version = "1.0.149", features = ["arbitrary_precision", "preserve_order"] }
