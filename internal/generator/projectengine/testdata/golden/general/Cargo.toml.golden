# Code generated by superschematic. DO NOT EDIT.
#
# The engine of the shop schema (D58), with every behavior the
# schema's types compose compiled in: the core's behaviors,
# and each extension's, from the crate its registration names.
# superschematic writes it on every build of the schema while its types
# compose a behavior of the work queue, of the commerce package or of an
# extension, which the core's engine archive leaves out; a host that opens
# the engine on the schema depends on it and passes behaviors() and tools()
# in its options.
[package]
name = "schemas-shop-engine"
version = "0.0.0"
edition = "2021"
rust-version = "1.99.0"
description = "The engine of the shop schema, with the behaviors its types compose"
license = "UNLICENSED"
publish = false

# The bindings a host of another language links, each a crate of its own
# over behaviors(), built from this lock file into this target directory:
# ffi, the C ABI's static archive a Go server links in the core's place
# (scripts/engine-archive.sh --crate <this directory>/ffi --out <dir>), and
# napi, the Node-API addon a TypeScript server loads in the core's place
# (scripts/engine-napi.sh --crate <this directory>/napi --out <dir>).
[workspace]
resolver = "2"
members = ["ffi", "napi"]

# What a release of the engine ships its archive and addon with: one
# codegen unit and LTO across the crates, symbols stripped
# (scripts/engine-napi.sh --dist).
[profile.dist]
inherits = "release"
lto = "fat"
codegen-units = 1
strip = "symbols"

# The databases the engine runs on: both by default, as the engine has
# them. A host that needs one turns the default off and names it.
[features]
default = ["sqlite", "postgres"]
sqlite = ["superschematic-engine/sqlite", "superschematic-engine-behaviors/sqlite"]
postgres = ["superschematic-engine/postgres", "superschematic-engine-behaviors/postgres"]

[dependencies]
# The engine's JSON features (D58): a number keeps its text, an object its
# members' order.
serde_json = { version = "1.0.149", features = ["arbitrary_precision", "preserve_order"] }
superschematic-engine = { version = "0.0.0", default-features = false }
superschematic-engine-behaviors = { version = "0.0.0", default-features = false }
# acme.Rating
acme-behaviors = { path = "../../../../../crates/behaviors" }
