{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FixtureConfig",
  "description": "Environment variables for fixture-general (generated by superschematic)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "DATABASE_URL": {
      "type": "string"
    },
    "ENVIRONMENT": {
      "type": "string",
      "default": "development"
    },
    "JWT_SECRET": {
      "type": "string"
    },
    "PORT": {
      "type": "integer",
      "default": 8080
    }
  },
  "required": [
    "DATABASE_URL",
    "JWT_SECRET"
  ],
  "x-superschematic": {
    "schemaName": "fixture-general",
    "typeName": "FixtureConfig",
    "envVars": [
      {
        "name": "DATABASE_URL",
        "irType": "Network.Url",
        "primitive": "string",
        "required": true,
        "hasDefault": false,
        "isScalar": true
      },
      {
        "name": "ENVIRONMENT",
        "irType": "FixtureEnvironment",
        "primitive": "string",
        "required": true,
        "hasDefault": true,
        "default": "development",
        "isEnum": true,
        "enumValues": [
          "development",
          "production"
        ]
      },
      {
        "name": "JWT_SECRET",
        "irType": "string",
        "primitive": "string",
        "required": true,
        "hasDefault": false
      },
      {
        "name": "PORT",
        "irType": "number",
        "primitive": "number",
        "required": true,
        "hasDefault": true,
        "default": "8080"
      }
    ]
  }
}
