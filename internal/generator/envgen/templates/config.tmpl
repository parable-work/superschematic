// formatValidationError formats a validation error with helpful context.
func formatValidationError(envVar string, value string, validationErrs []types.ValidationError) error {
	var messages []string

	for _, e := range validationErrs {
		messages = append(messages, e.Message)
	}

	if len(messages) == 0 {
		return fmt.Errorf("environment variable %s failed validation with value %q", envVar, value)
	}

	return fmt.Errorf("environment variable %s=%q is invalid: %s", envVar, value, strings.Join(messages, "; "))
}
