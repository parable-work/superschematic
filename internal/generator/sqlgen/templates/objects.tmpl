{{- /*
The derived objects create.sql writes, one statement each without its
trailing semicolon. create.tmpl renders them through objects.go, and so
does the migration planner's model (internal/sqlmigrate), so the two
never disagree.
*/ -}}

{{- define "captureFunction" }}{{ $history := . -}}
CREATE OR REPLACE FUNCTION {{ $history.FunctionName }}() RETURNS trigger AS $$
BEGIN
  IF (TG_WHEN = 'BEFORE') THEN
    -- BEFORE UPDATE: the stored row takes the next version.
    NEW._version := OLD._version + 1;
    RETURN NEW;
  END IF;
  IF (TG_OP = 'DELETE') THEN
    -- Tombstone at OLD._version + 1: keeps (key, _version) strictly monotonic so
    -- the unique history index holds and the latest history row for a deleted key
    -- is the DELETE. The data payload is the pre-delete image at the tombstone's
    -- version.
{{- if $history.ActorColumn }} Its {{ $history.ActorColumn }} is the actor a hard delete set in
    -- {{ $history.ActorSetting }} for the statement, else the row's own value.
{{- end }}
{{- if $history.ExcludeArray }}
    -- Every image leaves out {{ join $history.ExcludedColumns ", " }}.
{{- end }}
    INSERT INTO {{ $history.QuotedName }} ({{ $history.QuotedKeyColumn }}, _version, operation, data)
    VALUES (
      OLD.{{ $history.QuotedKeyColumn }},
      OLD._version + 1,
      'DELETE',
      {{ if $history.ExcludeArray }}(to_jsonb(OLD) - {{ $history.ExcludeArray }}){{ else }}to_jsonb(OLD){{ end }} || jsonb_build_object(
        '_version', OLD._version + 1
{{- if $history.ActorColumn }},
        '{{ $history.ActorColumn }}', COALESCE(
          NULLIF(current_setting('{{ $history.ActorSetting }}', true), '')::{{ $history.ActorColumnType }},
          OLD.{{ $history.QuotedActorColumn }}
        )
{{- end }}
      )
    );
    RETURN OLD;
  END IF;
  -- AFTER INSERT OR UPDATE: record the row as stored, so an INSERT ... ON
  -- CONFLICT DO UPDATE records the one UPDATE it made.
  INSERT INTO {{ $history.QuotedName }} ({{ $history.QuotedKeyColumn }}, _version, operation, data)
  VALUES (NEW.{{ $history.QuotedKeyColumn }}, NEW._version, TG_OP, to_jsonb(NEW){{ if $history.ExcludeArray }} - {{ $history.ExcludeArray }}{{ end }});
  RETURN NEW;
END;
$$ LANGUAGE plpgsql
{{- end }}

{{- define "pruneFunction" }}{{ $history := . -}}
CREATE OR REPLACE FUNCTION {{ $history.PruneFunctionName }}(retention_days INTEGER DEFAULT {{ $history.RetentionDays }}, max_rows INTEGER DEFAULT NULL) RETURNS BIGINT AS $$
DECLARE
  deleted_count BIGINT;
BEGIN
  WITH candidates AS (
    SELECT h.history_id
    FROM {{ $history.QuotedName }} h
    WHERE h.recorded_at < now() - make_interval(days => retention_days)
      AND EXISTS (
        SELECT 1
        FROM {{ $history.QuotedName }} newer
        WHERE newer.{{ $history.QuotedKeyColumn }} = h.{{ $history.QuotedKeyColumn }}
          AND newer._version > h._version
      )
{{- range $pin := $history.PruneKeep }}
      AND NOT EXISTS (
        SELECT 1
        FROM {{ $pin.QuotedTable }} {{ $pin.Alias }}
        WHERE {{ $pin.Alias }}.{{ $pin.QuotedKeyColumn }} = h.{{ $history.QuotedKeyColumn }}
          AND {{ $pin.Alias }}.{{ $pin.QuotedVersionColumn }} = h._version
      )
{{- end }}
    LIMIT max_rows
  ),
  deleted AS (
    DELETE FROM {{ $history.QuotedName }} h
    USING candidates c
    WHERE h.history_id = c.history_id
    RETURNING 1
  )
  SELECT count(*) INTO deleted_count FROM deleted;
  RETURN deleted_count;
END;
$$ LANGUAGE plpgsql
{{- end }}

{{- define "bumpFunction" }}{{ $optimistic := . -}}
CREATE OR REPLACE FUNCTION {{ $optimistic.FunctionName }}() RETURNS trigger AS $$
BEGIN
  -- BEFORE UPDATE: the stored row takes the next version.
  NEW._version := OLD._version + 1;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql
{{- end }}

{{- define "trigger" }}{{ $trigger := . -}}
CREATE TRIGGER {{ $trigger.Name }}
  {{ $trigger.Timing }} ON {{ $trigger.QuotedTable }}
  FOR EACH ROW EXECUTE FUNCTION {{ $trigger.Function }}()
{{- end }}
