-- Generated PostgreSQL DDL for schema: {{ .SchemaName }}
-- This file is auto-generated. Do not edit manually.

{{- if .Extensions }}

-- Enable required PostgreSQL extensions
{{- range .Extensions }}
{{- if eq . "pgcrypto" }}
-- Note: pgcrypto is only needed for PostgreSQL < 13 (for gen_random_uuid)
-- PostgreSQL 13+ has gen_random_uuid() built-in
{{- end }}
CREATE EXTENSION IF NOT EXISTS {{ . }};
{{- end }}
{{ end }}

-- Create tables (without foreign key constraints)
{{- range $table := .Tables }}

CREATE TABLE {{ $table.QuotedName }} (
{{- range $i, $col := $table.Columns }}{{ if $i }},{{ end }}
  {{ $col.QuotedName }} {{ $col.Type }}{{ if $col.DefaultValue }} DEFAULT {{ $col.DefaultValue }}{{ end }}{{ if not $col.Nullable }} NOT NULL{{ end }}{{ if $col.IsPrimaryKey }} PRIMARY KEY{{ end }}
{{- end }}
{{- if $table.Unique }}{{ range $table.Unique }},
  UNIQUE ({{ join . ", " }}){{ end }}
{{- end }}
);
{{- if $table.SearchFields }}

-- Add search_text generated column for trigram search
ALTER TABLE {{ $table.QuotedName }} ADD COLUMN search_text TEXT GENERATED ALWAYS AS (
  {{ searchTextExpr $table.SearchFields }}
) STORED;
{{- end }}

COMMENT ON TABLE {{ $table.QuotedName }} IS '{{ if $table.Doc }}{{ replace $table.Doc "'" "''" }}{{ else }}Generated from schema type: {{ $table.OriginalName }}{{ end }}';
{{- end }}
{{- if .JoinTables }}

-- Create join tables for many-to-many relationships
{{- range $jt := .JoinTables }}

CREATE TABLE {{ $jt.QuotedName }} (
  {{ $jt.QuotedLeftColumn }} {{ $jt.LeftColumnType }} NOT NULL,
  {{ $jt.QuotedRightColumn }} {{ $jt.RightColumnType }} NOT NULL,
  PRIMARY KEY ({{ $jt.QuotedLeftColumn }}, {{ $jt.QuotedRightColumn }})
);

COMMENT ON TABLE {{ $jt.QuotedName }} IS 'Join table for {{ $jt.LeftTable }}.{{ $jt.OriginalField }}';
{{- end }}
{{- end }}
{{- if .HistoryTables }}

-- Create history tables for versioned entities
{{- range $history := .HistoryTables }}

CREATE TABLE {{ $history.QuotedName }} (
{{- range $i, $col := $history.Columns }}{{ if $i }},{{ end }}
  {{ $col.QuotedName }} {{ $col.Type }}{{ if $col.DefaultValue }} DEFAULT {{ $col.DefaultValue }}{{ end }}{{ if not $col.Nullable }} NOT NULL{{ end }}{{ if $col.IsPrimaryKey }} PRIMARY KEY{{ end }}
{{- end }}
){{ if $history.Partitioned }} PARTITION BY {{ $history.PartitionClause }}{{ end }};
{{ if eq $history.PartitionBy "month" }}
CREATE TABLE {{ $history.QuotedDefaultPartition }} PARTITION OF {{ $history.QuotedName }} DEFAULT;
{{ end -}}

{{- if eq $history.PartitionBy "month" }}
CREATE INDEX {{ $history.VersionIndexName }} ON {{ $history.QuotedName }} ({{ $history.QuotedKeyColumn }}, _version);
{{- else }}
CREATE UNIQUE INDEX {{ $history.UniqueIndexName }} ON {{ $history.QuotedName }} ({{ $history.QuotedKeyColumn }}, _version);
{{- end }}
CREATE INDEX {{ $history.RecordedIndexName }} ON {{ $history.QuotedName }} ({{ $history.QuotedKeyColumn }}, recorded_at);
{{- if gt $history.RetentionDays 0 }}
-- The prune function filters on recorded_at alone; the index above leads with
-- the row key and cannot serve it, so retention would seq-scan the whole
-- history table on every pass.
CREATE INDEX {{ $history.RetentionIndexName }} ON {{ $history.QuotedName }} (recorded_at);
{{- end }}

COMMENT ON TABLE {{ $history.QuotedName }} IS 'Version history for {{ $history.SourceTableName }}';
{{- end }}
{{- end }}

-- Add foreign key constraints
{{- range $table := .Tables }}
{{- if $table.ForeignKeys }}
{{- range $fk := $table.ForeignKeys }}

ALTER TABLE {{ $table.QuotedName }}
  ADD CONSTRAINT {{ $fk.ConstraintName }}
  FOREIGN KEY ({{ $fk.QuotedColumn }})
  REFERENCES {{ $fk.QuotedRefTable }}({{ $fk.QuotedRefColumn }})
  ON DELETE {{ if $fk.OnDelete }}{{ $fk.OnDelete }}{{ else }}CASCADE{{ end }};
{{- end }}
{{- end }}
{{- end }}
{{- if .JoinTables }}

-- Add foreign key constraints for join tables
{{- range $jt := .JoinTables }}

ALTER TABLE {{ $jt.QuotedName }}
  ADD CONSTRAINT {{ $jt.LeftConstraintName }}
  FOREIGN KEY ({{ $jt.QuotedLeftColumn }})
  REFERENCES {{ $jt.QuotedLeftTable }}(id)
  ON DELETE CASCADE;

ALTER TABLE {{ $jt.QuotedName }}
  ADD CONSTRAINT {{ $jt.RightConstraintName }}
  FOREIGN KEY ({{ $jt.QuotedRightColumn }})
  REFERENCES {{ $jt.QuotedRightTable }}(id)
  ON DELETE CASCADE;
{{- end }}
{{- end }}

-- Create indexes
{{- range $table := .Tables }}
{{- if $table.Indexes }}
{{- range $idx := $table.Indexes }}

CREATE {{ if $idx.Unique }}UNIQUE {{ end }}INDEX {{ $idx.Name }} ON {{ $table.QuotedName }} USING {{ $idx.Type }} ({{ join $idx.Columns ", " }}){{ if $idx.Where }} WHERE {{ $idx.Where }}{{ end }};
{{- end }}
{{- end }}
{{- if $table.SearchFields }}

CREATE INDEX idx_{{ $table.Name }}_search_trgm ON {{ $table.QuotedName }} USING GIN (search_text gin_trgm_ops);
{{- end }}
{{- end }}
{{- if .HistoryTables }}

-- Create history capture functions and triggers
{{- range $history := .HistoryTables }}

{{ $history.CaptureFunctionSQL }};
{{- range $trigger := $history.Triggers }}

{{ $trigger.SQL }};
{{- end }}
{{- if gt $history.RetentionDays 0 }}

-- max_rows caps one call so a caller can drain a backlog in committed chunks
-- instead of one unbounded DELETE; NULL means no cap. The retention filter uses
-- now() (STABLE, folded once per statement and indexable) rather than
-- clock_timestamp() (VOLATILE, re-evaluated per row).
{{ $history.PruneFunctionSQL }};
{{- end }}
{{- end }}
{{- end }}
{{- if .OptimisticTables }}

-- Create version bump functions and triggers for optimistic entities
{{- range $optimistic := .OptimisticTables }}

{{ $optimistic.BumpFunctionSQL }};

{{ $optimistic.Trigger.SQL }};
{{- end }}
{{- end }}
{{- if .Projections }}

-- Create projection views: read-only relations over the tables above. A
-- setting a view binds without optional makes current_setting raise while
-- it is unset, so the view fails closed.
{{- range $view := .Projections }}

CREATE SCHEMA IF NOT EXISTS {{ $view.QuotedPool }};

{{ projectionViewDDL $view }}
{{- end }}
{{- end }}
