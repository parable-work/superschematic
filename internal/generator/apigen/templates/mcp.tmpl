// mcpCaller is the endpoint's caller as a read across tables takes it,
// with its roles' permissions; a 401 for none.
func mcpCaller(ctx context.Context) (crosstable.Caller, *runtimemcp.ServedProblem) {
	caller := mcpsession.GetCaller(ctx)
	if caller.Anonymous() {
		return crosstable.Caller{}, &runtimemcp.ServedProblem{Status: gohttp.StatusUnauthorized, Title: "Unauthorized", Detail: "Authentication required"}
	}
	var held []string
	for _, role := range mcpsession.GetRoles(ctx) {
		held = append(held, role.Permissions...)
	}
	return crosstable.Caller{Principal: caller, Permissions: held}, nil
}

// mcpServed is a read across tables as a served tool answers it.
func mcpServed[T any](result *T, problem *crosstable.Problem, err error) (any, *runtimemcp.ServedProblem, error) {
	if err != nil {
		return nil, nil, err
	}
	if problem != nil {
		return nil, &runtimemcp.ServedProblem{Status: problem.Status, Title: problem.Title, Detail: problem.Detail}, nil
	}
	return result, nil, nil
}
