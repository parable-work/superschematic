		values := runtimegraphroutes.Values{"kind": string(change.Kind), "entityKey": change.EntityKey, "operation": string(change.Operation)}
		if row := runtimegraphroutes.JSONText(change.Row); row != nil {
			values["row"] = row
		}
		view = append(view, values)
	}
{{- else if eq $op "entityHistory" }}
	if {{ $set.Var }}.Kind(kind) == nil {
		return nil, runtimegraphroutes.NotFound("the {{ $set.Graph }} graph has no kind " + kind)
	}
	changes, err := g.graph.EntityHistory(graphReading(ctx), {{ $set.RootKeyParam }}, {{ $.Graphs.DBTypes }}.{{ $set.Graph }}EntityKind(kind), key)
	if err != nil {
		return nil, graphRefusal(err)
	}
	rows := make([]*{{ $.Graphs.DBTypes }}.{{ $set.Graph }}Commit, 0, len(changes))
	for _, change := range changes {
		rows = append(rows, change.Commit)
	}
	commits, err := g.commits(ctx, rows)
	if err != nil {
		return nil, err
	}
	view := make([]runtimegraphroutes.Values, 0, len(changes))
	for i, change := range changes {
		view = append(view, runtimegraphroutes.Values{"commit": commits[i], "operation": string(change.Operation)})
	}
{{- end }}
{{- if ne $op "discard" }}
{{- if not (or (eq $op "released") (eq $op "diff") (eq $op "entityHistory")) }}
	if err != nil {
		return nil, err
	}
{{- end }}
{{- if .OutputIsArray }}
	return graphDecode[{{ .GoResultType }}](view)
{{- else }}
	out, err := graphDecode[{{ .OutputGoType }}](view)
	if err != nil {
		return nil, err
	}
	return &out, nil
{{- end }}
{{- end }}
}
{{- end }}
{{- end }}
