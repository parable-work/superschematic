}

func createOpenAPIHandler(apiVersion, baseURL string) gohttp.HandlerFunc {
	spec, err := injectOpenAPIRuntimeValues(openAPISpec, apiVersion, baseURL)
	if err != nil {
		spec = openAPISpec
	}

	return func(w gohttp.ResponseWriter, r *gohttp.Request) {
		w.Header().Set("Content-Type", "application/json")
		w.Write([]byte(spec))
	}
}

func injectOpenAPIRuntimeValues(specJSON, apiVersion, baseURL string) (string, error) {
	var spec map[string]interface{}
	if err := json.Unmarshal([]byte(specJSON), &spec); err != nil {
		return "", err
	}

	info, ok := spec["info"].(map[string]interface{})
	if !ok {
		info = make(map[string]interface{})
		spec["info"] = info
	}
	info["version"] = apiVersion

	spec["servers"] = []map[string]interface{}{
		{
			"url":         baseURL,
			"description": "Runtime server",
		},
	}

	updated, err := json.MarshalIndent(spec, "", "  ")
	if err != nil {
		return "", err
	}

	return string(updated), nil
}

