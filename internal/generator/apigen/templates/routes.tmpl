// =============================================================================
// Query parameter parsing helpers
// =============================================================================
// These functions parse query parameters from the URL and convert them to Go types.
// They handle missing values gracefully by returning defaults or nil for pointer types.

// parseIntQueryParam parses an integer query parameter with a default value.
// Returns the default if the parameter is missing or cannot be parsed.
func parseIntQueryParam(r *gohttp.Request, name string, defaultVal int64) int64 {
	val := r.URL.Query().Get(name)
	if val == "" {
		return defaultVal
	}
	parsed, err := strconv.ParseInt(val, 10, 64)
	if err != nil {
		return defaultVal
	}
	return parsed
}

// parseIntQueryParamPtr parses an optional integer query parameter.
// Returns nil if the parameter is missing or cannot be parsed.
func parseIntQueryParamPtr(r *gohttp.Request, name string) *int64 {
	val := r.URL.Query().Get(name)
	if val == "" {
		return nil
	}
	parsed, err := strconv.ParseInt(val, 10, 64)
	if err != nil {
		return nil
	}
	return &parsed
}

// parseStringQueryParam parses a string query parameter with a default value.
// Returns the default if the parameter is missing.
func parseStringQueryParam(r *gohttp.Request, name string, defaultVal string) string {
	val := r.URL.Query().Get(name)
	if val == "" {
		return defaultVal
	}
	return val
}

// parseStringQueryParamPtr parses an optional string query parameter.
// Returns nil if the parameter is missing.
func parseStringQueryParamPtr(r *gohttp.Request, name string) *string {
	val := r.URL.Query().Get(name)
	if val == "" {
		return nil
	}
	return &val
}

// parseBoolQueryParam parses a boolean query parameter with a default value.
// Accepts: true, false, 1, 0 (case-insensitive).
// Returns the default if the parameter is missing or cannot be parsed.
func parseBoolQueryParam(r *gohttp.Request, name string, defaultVal bool) bool {
	val := r.URL.Query().Get(name)
	if val == "" {
		return defaultVal
	}
	parsed, err := strconv.ParseBool(val)
	if err != nil {
		return defaultVal
	}
	return parsed
}

// parseBoolQueryParamPtr parses an optional boolean query parameter.
// Returns nil if the parameter is missing or cannot be parsed.
func parseBoolQueryParamPtr(r *gohttp.Request, name string) *bool {
	val := r.URL.Query().Get(name)
	if val == "" {
		return nil
	}
	parsed, err := strconv.ParseBool(val)
	if err != nil {
		return nil
	}
	return &parsed
}

// parseFloat64QueryParam parses a float64 query parameter with a default value.
// Returns the default if the parameter is missing or cannot be parsed.
func parseFloat64QueryParam(r *gohttp.Request, name string, defaultVal float64) float64 {
	val := r.URL.Query().Get(name)
	if val == "" {
		return defaultVal
	}
	parsed, err := strconv.ParseFloat(val, 64)
	if err != nil {
		return defaultVal
	}
	return parsed
}

// parseFloat64QueryParamPtr parses an optional float64 query parameter.
