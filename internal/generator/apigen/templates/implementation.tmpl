// Package {{ toPackageName .SchemaName }} implements the {{ .SchemaName }} API.
//
// superschematic wrote this package once, as a scaffold, because it was
// missing. It never writes it again: the package is yours. Each method
// answers 501 Not Implemented until you implement it.
package {{ toPackageName .SchemaName }}

import (
	"context"
{{- if .HasEncryptedEndpoints }}
	"errors"
{{- end }}
{{- if .IsPublic }}
	"net/http"
{{- end }}
{{- if or .HasFilterableEndpoints .HasEncryptedEndpoints }}
{{ end }}
{{- if .HasFilterableEndpoints }}
	"{{ $.Naming.HTTPRuntimeGoModule }}/filterparse"
{{- end }}
{{- if .HasEncryptedEndpoints }}
	runtimemiddleware "{{ $.Naming.HTTPRuntimeGoModule }}/middleware"
{{- end }}

	api "{{ .ModulePath }}"
{{- if .NeedsTypesImport }}
	types "{{ .TypesModule }}"
{{- end }}
)

// New builds the implementation of {{ .SchemaName }} from its dependencies. Its
// signature is the generated one, api.Constructor.
func New(deps api.Deps) (api.Implementations, error) {
	return api.Implementations{
{{- range .Namespaces }}
		{{ toGoName . }}: &{{ toGoName . }}{deps: deps},
{{- end }}
{{- if .HasWebhookHMACEndpoints }}
		// WebhookVerifiers verifies each @hmacVerified provider's requests:
		// {{ join .RequiredWebhookProviders ", " }}. The server does not start until each has one.
		WebhookVerifiers: map[string]api.WebhookVerifier{},
{{- end }}
	}, nil
}

var _ api.Constructor = New
{{- if .IsPublic }}

// AuthMiddleware authenticates the end user on the protected routes of
// {{ .SchemaName }}. The server's entrypoint passes it to the generated
// Config.AuthMiddleware. The scaffold's refuses every request with 401:
// verify the request's credential with your identity provider, put the
// principal on the request context as your auth provider's routes read it
// (with the session provider, api.ContextWithPrincipalID and
// api.ContextWithRoles), then call next.
func AuthMiddleware(deps api.Deps) (func(http.Handler) http.Handler, error) {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			api.RespondError(w, r, http.StatusUnauthorized, "Authentication required")
		})
	}, nil
}
{{- end }}
{{- if .HasEncryptedEndpoints }}

// PayloadDecryptor decrypts the request bodies of {{ .SchemaName }}'s encrypted
// operations. The server's entrypoint passes it to the generated
// Config.PayloadDecryptor. The scaffold's decrypts nothing, so each encrypted
// operation is refused until it returns your key service's decryptor.
func PayloadDecryptor(deps api.Deps) (runtimemiddleware.PayloadDecryptor, error) {
	return noDecryptor{}, nil
}

// noDecryptor refuses every payload.
type noDecryptor struct{}

func (noDecryptor) Decrypt(context.Context, string) ([]byte, error) {
	return nil, errors.New("{{ .SchemaName }} has no payload decryptor yet")
}
{{- end }}
{{- range .Namespaces }}
{{- $namespace := . }}

// {{ toGoName . }} implements api.{{ toGoName . }}Implementation.
type {{ toGoName . }} struct {
	deps api.Deps
}
{{- range $.Endpoints }}
{{- if eq .Namespace $namespace }}

// {{ .ShortImplName }} handles {{ .Method }} {{ .Path }}.
func (impl *{{ toGoName $namespace }}) {{ .ShortImplName }}(ctx context.Context{{- range .PathParams }}, {{ .Name }} {{ .GoType }}{{- end }}{{- range .QueryParams }}, {{ .Name }} {{ if .IsArray }}[]{{ else if not .Required }}*{{ end }}{{ .GoType }}{{- end }}{{- if .Filterable }}, filters []filterparse.Filter{{- end }}{{- if .HasInput }}, input *types.{{ .InputType }}{{- else if .ScalarArgs }}{{- range .ScalarArgs }}, {{ .Name }} {{ .GoListType }}{{- end }}{{- end }}{{- if .HasFileUpload }}, files map[string]*api.FileUploadData{{- end }}) ({{- if .OutputIsArray }}{{ .OutputGoListType }}{{- else }}*{{ .OutputGoType }}{{- end }}, error) {
	return nil, api.NotImplementedError("{{ toGoName $namespace }}.{{ .ShortImplName }}")
}
{{- end }}
{{- end }}
{{- end }}
