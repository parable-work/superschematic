// WiringConstructor is the signature of the implementation's constructor
// of the wiring's options, NewWiring(deps Deps) (Wiring, error), which every
// entrypoint of {{ .SchemaName }} calls with its Deps{{ if $w.Builds }} before Wire fills them{{ end }}.
// The scaffolded implementation asserts it:
// var _ {{ toPackageName .SchemaName }}.WiringConstructor = NewWiring.
type WiringConstructor func(deps Deps) (Wiring, error)
{{- if $w.Builds }}

// Wire builds deps' notifier{{ if $w.Agents }}, agent dispatcher{{ end }}{{ if $w.Inbound }} and inbound path{{ end }} over db, the ORM
// Deps.DB holds, with wiring's options, in D192's order: the dispatcher
// first, then the notifier, which takes its requests and its reply actions,
// then the inbound path, which takes the notifier and the dispatcher's
// approval of a send, and last the dispatcher is given both. A member of
// Deps it already holds is kept, so an app that builds its own wins.
func Wire(deps Deps, db {{ $w.DatabaseType }}, wiring Wiring) (Deps, error) {
	if db == nil {
		return deps, errors.New("{{ .SchemaName }}: Wire needs the ORM of {{ .Deps.Database }}")
	}
	if deps.Notifier != nil {
		return deps, nil
	}
	host := db.{{ if or $w.Agents $w.Inbound }}Orchestration{{ else }}Notifications{{ end }}()
{{- if $w.Agents }}
	agentOptions := wiring.Agents
	if agentOptions.Providers == nil {
		agentOptions.Providers = deps.Providers
	}
	if agentOptions.Logger == nil {
		agentOptions.Logger = deps.Logger
	}
	dispatcher := deps.Agents
	if dispatcher == nil {
		var err error
		if dispatcher, err = agents.New(host, agentOptions); err != nil {
			return deps, fmt.Errorf("the agent dispatcher of {{ .SchemaName }}: %w", err)
		}
	}
{{- end }}
	notifierOptions := wiring.Notifier
	if notifierOptions.Providers == nil {
		notifierOptions.Providers = deps.Providers
	}
	if notifierOptions.Logger == nil {
		notifierOptions.Logger = deps.Logger
	}
{{- if $w.Agents }}
	if notifierOptions.Agents == nil {
		notifierOptions.Agents = dispatcher
	}
	// An approval's approve and deny are two reply actions of the
	// dispatcher's (D190), beside the app's of approval.requested.
	replies := make(map[string]map[string]notify.ReplyAction, len(notifierOptions.Replies)+1)
	for kind, actions := range notifierOptions.Replies {
		replies[kind] = actions
	}
	approvals := map[string]notify.ReplyAction{}
	for verb, action := range dispatcher.ReplyActions() {
		approvals[verb] = action
	}
	for verb, action := range replies["approval.requested"] {
		approvals[verb] = action
	}
	replies["approval.requested"] = approvals
	notifierOptions.Replies = replies
{{- end }}
	notifier, err := notify.New(host, notifierOptions)
	if err != nil {
		return deps, fmt.Errorf("the notifier of {{ .SchemaName }}: %w", err)
	}
{{- if $w.Inbound }}
	path := deps.Inbound
	if path == nil {
		inboundOptions := wiring.Inbound
		if inboundOptions.Notifier == nil {
			inboundOptions.Notifier = notifier
		}
		if inboundOptions.Providers == nil {
			inboundOptions.Providers = deps.Providers
		}
		if inboundOptions.Logger == nil {
			inboundOptions.Logger = deps.Logger
		}
{{- if $w.Agents }}
		if inboundOptions.Approve == nil {
			inboundOptions.Approve = dispatcher
		}
{{- end }}
		if path, err = inbound.New(host, inboundOptions); err != nil {
			return deps, fmt.Errorf("the inbound path of {{ .SchemaName }}: %w", err)
		}
	}
{{- end }}
{{- if $w.Agents }}
	dispatcher.SetNotifier(notifier)
{{- if $w.Inbound }}
	dispatcher.SetInbound(path)
{{- end }}
	deps.Agents = dispatcher
{{- end }}
	deps.Notifier = notifier
{{- if $w.Inbound }}
	deps.Inbound = path
{{- end }}
	return deps, nil
}
{{- end }}

