// {{ .QueueFunc }} is the queue of the worker {{ .Name }}, {{ .Queue }}, the notifier's
// (D190): each event routed and each notice delivered, escalated or
// digested by Deps.Notifier, which Wire builds.
func {{ .QueueFunc }}(deps Deps, db {{ $w.DatabaseType }}, wiring Wiring) (worker.Queue, error) {
	if deps.Notifier == nil {
		return worker.Queue{}, errors.New("{{ $.SchemaName }}: the worker {{ .Name }} needs Deps.Notifier, which Wire builds")
	}
	return deps.Notifier.WorkerQueue(), nil
}
{{- else if eq .Runtime "agents" }}

// {{ .QueueFunc }} is the queue of the worker {{ .Name }}, {{ .Queue }}, the agent
// dispatcher's (D192): each run request handed to Deps.Agents, which Wire
// builds, and its prune the queue's and the transcripts' past their
// retention.
func {{ .QueueFunc }}(deps Deps, db {{ $w.DatabaseType }}, wiring Wiring) (worker.Queue, error) {
	if deps.Agents == nil {
		return worker.Queue{}, errors.New("{{ $.SchemaName }}: the worker {{ .Name }} needs Deps.Agents, which Wire builds")
	}
	return deps.Agents.WorkerQueue(), nil
}
{{- else if eq .Runtime "runRequests" }}

// {{ .QueueFunc }} is the queue of the worker {{ .Name }}, {{ .Queue }}, D157's run
// requests: each an inbound message's, which the inbound path enqueued,
// handed to Deps.Agents as it is.
func {{ .QueueFunc }}(deps Deps, db {{ $w.DatabaseType }}, wiring Wiring) (worker.Queue, error) {
	if deps.Inbound == nil || deps.Agents == nil {
		return worker.Queue{}, errors.New("{{ $.SchemaName }}: the worker {{ .Name }} needs Deps.Inbound and Deps.Agents, which Wire builds")
	}
	return deps.Inbound.RunQueue(deps.Agents.HandleRunRequest)
}
{{- else if eq .Runtime "audience" }}

// {{ .QueueFunc }} is the queue of the worker {{ .Name }}, {{ .Queue }}, an @audience
// declaration's (D156, #734): each message's rows, those that inherit
// their audience from the parent it names, resolved again by
// db.ResolveAudience after the parent's write. Postgres alone holds an
// @audience queue (#734), so db is never the SQLite database's.
func {{ .QueueFunc }}(deps Deps, db {{ $w.DatabaseType }}, wiring Wiring) (worker.Queue, error) {
	if db == nil {
		return worker.Queue{}, errors.New("{{ $.SchemaName }}: the worker {{ .Name }} needs the ORM of {{ $.Deps.Database }}")
	}
	queue := db.{{ .Queue }}Queue()
	return worker.Queue{
		Name:  {{ printf "%q" .Queue }},
		Lease: orm.{{ .Queue }}Lease,
		Claim: func(ctx context.Context, n int, lease time.Duration) ([]worker.Message, error) {
			claims, err := queue.Claim(ctx, n, lease)
			if err != nil {
				return nil, err
			}
			messages := make([]worker.Message, len(claims))
			for i, claim := range claims {
				message := claim.Message
				messages[i] = worker.Message{
					ID:      claim.ID,
					Token:   claim.Token,
					Attempt: claim.Attempt,
					Handle: func(ctx context.Context) error {
						_, err := db.ResolveAudience(ctx, message.ChildTable, message.ParentKey)
						return err
					},
				}
			}
			return messages, nil
		},
		Extend:   queue.Extend,
		Complete: queue.Complete,
		Fail:     queue.Fail,
		Release:  queue.Release,
		Prune:    queue.Prune,
		Slot:     queue.Slot,
		NextDue:  queue.NextDue,
	}, nil
}
{{- else }}

// {{ .QueueFunc }} is the queue of the worker {{ .Name }}, {{ .Queue }}, a @searchable
// declaration's (D155, D187): each message's row indexed again by
// crosstable.IndexSearch over the database's CrossTables(), with wiring's
// Indexing.
func {{ .QueueFunc }}(deps Deps, db {{ $w.DatabaseType }}, wiring Wiring) (worker.Queue, error) {
	if db == nil {
		return worker.Queue{}, errors.New("{{ $.SchemaName }}: the worker {{ .Name }} needs the ORM of {{ $.Deps.Database }}")
	}
{{- if $w.SQLite }}
	// The database lists sqlite first, so the queue claims on its SQLite
	// file (#717).
	queue := orm.New{{ .Queue }}SQLiteQueue(db.SQL())
{{- else }}
	queue := db.{{ .Queue }}Queue()
{{- end }}
	host := db.CrossTables()
	return worker.Queue{
		Name:  {{ printf "%q" .Queue }},
		Lease: orm.{{ .Queue }}Lease,
		Claim: func(ctx context.Context, n int, lease time.Duration) ([]worker.Message, error) {
			claims, err := queue.Claim(ctx, n, lease)
			if err != nil {
				return nil, err
			}
			messages := make([]worker.Message, len(claims))
			for i, claim := range claims {
				message := crosstable.SearchIndexing{SourceTable: claim.Message.SourceTable, SourceKey: claim.Message.SourceKey}
				messages[i] = worker.Message{
					ID:      claim.ID,
					Token:   claim.Token,
					Attempt: claim.Attempt,
					Handle: func(ctx context.Context) error {
						_, err := crosstable.IndexSearch(ctx, host, message, wiring.Indexing)
						return err
					},
				}
			}
			return messages, nil
		},
		Extend:   queue.Extend,
		Complete: queue.Complete,
		Fail:     queue.Fail,
		Release:  queue.Release,
		Prune:    queue.Prune,
{{- if $w.SQLite }}
		// SQLite holds no advisory locks and keeps no next due time: a
		// worker in drain mode takes no slot and stops once idle (D145).
{{- else }}
		Slot:     queue.Slot,
		NextDue:  queue.NextDue,
{{- end }}
	}, nil
}
{{- end }}
{{- end }}
