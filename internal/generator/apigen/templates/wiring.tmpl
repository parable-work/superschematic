	// Deps.Providers and Deps.Logger when it names none{{ if $w.Agents }}, the dispatcher
	// as its Agents, and the dispatcher's approve and deny as the reply
	// actions of approval.requested beside the app's{{ end }}.
	Notifier notify.Options

	// NotifierRoutes are the inbox's and the relays' paths, and how a
	// relay's inbound messages are read{{ if $w.Inbound }}: the inbound path's unless set{{ end }}.
	NotifierRoutes notify.RoutesOptions
{{- end }}
{{- if $w.Inbound }}

	// Inbound are the inbound path's options (D157, D192): the bucket an
	// inbound message's files go to and the deployment's inbound address
	// among them. Wire gives it the notifier, Deps.Providers and
	// Deps.Logger when it names none{{ if $w.Agents }}, and the dispatcher as its approval
	// of a send{{ end }}.
	Inbound inbound.Options
{{- end }}
{{- if $w.Agents }}

	// Agents are the agent dispatcher's options (D158, D192): its
	// endpoint, which the sandbox reaches the agent routes at, its tools
	// and its transcripts among them. Wire gives it Deps.Providers and
	// Deps.Logger when it names none, and the notifier{{ if $w.Inbound }} and the inbound
	// path{{ end }} once they are built.
	Agents agents.Options

	// AgentRoutes are what the agent routes take: how the caller of an
	// approval's route is established, the session's caller with its
	// roles' permissions unless set.
	AgentRoutes agents.RoutesOptions

	// Authenticator is what the authenticator of a run's token takes: the
	// operation of each call, held to the run's autonomy.
	Authenticator agents.AuthenticatorOptions
{{- end }}
{{- if $w.Calendar }}

	// Calendar are the calendar's routes' options (D152, D187): each
	// source's permission, its path (/api/calendar unless set) and its
	// feeds' window. The wiring gives it the database's CrossTables() and
	// the session's caller when it names none.
	Calendar crosstable.CalendarRoutesOptions
{{- end }}
{{- if $w.Search }}

	// Search are the search route's options (D155, D187): each table's
	// permission, its path (/api/search unless set) and its embeddings.
	// The wiring gives it the database's CrossTables() and the session's
