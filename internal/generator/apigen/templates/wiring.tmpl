// ProcessPendingFiles is one pass of the file processor over what the
// attachments of {{ .Deps.Database }} have pending (D154, D159, #603): each file's text
// extracted and its preview made by the processors the environment's files
// slots name, in slot order, the text recorded as its extractedText, which
// search indexes with its row, and the preview put beside the object. A
// file no processor reads or one a processor fails on is recorded failed.
// An implementation's job runs it on a schedule, or an operation after an
// upload completes, with the bucket wiring.Files names:
//
//	run, err := api.ProcessPendingFiles(ctx, deps, api.Wiring{Files: fileprocessing.Options{Bucket: deps.Uploads}})
func ProcessPendingFiles(ctx context.Context, deps Deps, wiring Wiring) (fileprocessing.Run, error) {
	options := wiring.Files
	if options.Attachments == nil {
		if deps.DB == nil {
			return fileprocessing.Run{}, errors.New("{{ .SchemaName }}: ProcessPendingFiles needs Deps.DB, the ORM of {{ .Deps.Database }}")
		}
		options.Attachments = deps.DB.Attachments()
	}
	if options.Providers == nil {
		options.Providers = deps.Providers
	}
	if options.Logger == nil {
		options.Logger = deps.Logger
	}
	if options.Bucket == nil {
		return fileprocessing.Run{}, errors.New("{{ .SchemaName }}: ProcessPendingFiles reads the attachments' objects from the bucket wiring.Files names, and it names none")
	}
	return fileprocessing.Process(ctx, options)
}
{{- end }}

// Authenticator is the auth step of {{ .SchemaName }}'s routes: inner, the API's own
// (its identity's middleware or its AuthMiddleware, nil for none),
{{- if and $w.Agents $w.Grants }}
// behind the agent dispatcher's authenticator (D192), which establishes a
// running run's token as the run, its reach narrowed and every call held
// to its autonomy, and any other grant's token as its holder (D180).
{{- else if $w.Grants }}
// behind the grants' (D180): a grant's token is established as its holder,
// a party or any other but an agent run, every other request inner's.
{{- else }}
// as it is: the database keeps no grants.
{{- end }}
{{- if $w.Teams }}
// The caller it establishes then gets its teams, read on every call
// (#735), so an audience that names a team admits each of its members.
func Authenticator(deps Deps, db {{ $w.DatabaseType }}, wiring Wiring, inner func(http.Handler) http.Handler) func(http.Handler) http.Handler {
	return session.TeamAuthenticator(db, authenticator(deps, db, wiring, inner))
}

// authenticator is Authenticator but the caller's teams.
func authenticator(deps Deps, db {{ $w.DatabaseType }}, wiring Wiring, inner func(http.Handler) http.Handler) func(http.Handler) http.Handler {
{{- else }}
func Authenticator(deps Deps, db {{ $w.DatabaseType }}, wiring Wiring, inner func(http.Handler) http.Handler) func(http.Handler) http.Handler {
{{- end }}
{{- if and $w.Agents $w.Grants }}
	if deps.Agents != nil {
		return deps.Agents.Authenticator(db, inner, wiring.Authenticator)
	}
{{- end }}
{{- if $w.Grants }}
	return session.GrantAuthenticator(db, inner, nil)
{{- else }}
	if inner == nil {
		return func(next http.Handler) http.Handler { return next }
	}
	return inner
{{- end }}
}
{{- if $w.Serves }}

// Routes are the routes the runtime serves beside {{ .SchemaName }}'s router, on a
// router of their own: auth, Authenticator's step, establishes the caller
// of each that needs one.
{{- if $w.Builds }}
//
//   - The inbox (GET /api/inbox, POST /api/inbox/{id}/read and /ack), behind
//     auth, and the relays' callbacks (POST /webhooks/{slot}/inbound and
//     /status), whose adapter checks the relay's signature, outside it
//     (notify.Notifier.Routes).
{{- end }}
{{- if $w.Agents }}
//
//   - The agent routes under the dispatcher's endpoint's path, which a
//     run's token reaches, and its approvals' routes behind auth
//     (agents.Agents.Routes).
{{- end }}
{{- if $w.Calendar }}
//
//   - The calendar (/api/calendar), behind auth but for a feed's fetch,
//     which reads as its token's holder (crosstable.CalendarRoutes).
{{- end }}
{{- if $w.Search }}
//
//   - Search across tables (GET /api/search), behind auth
//     (crosstable.SearchRoutes).
{{- end }}
//
// Each path is wiring's when it names one.
func Routes(deps Deps, db {{ $w.DatabaseType }}, wiring Wiring, auth func(http.Handler) http.Handler) *chi.Mux {
	if auth == nil {
		auth = func(next http.Handler) http.Handler { return next }
	}
	r := chi.NewRouter()
{{- if $w.Builds }}
	if deps.Notifier != nil {
		options := wiring.NotifierRoutes
{{- if $w.Inbound }}
		if options.Inbound == nil && deps.Inbound != nil {
			// Every message a relay receives takes the inbound path, which
			// hands a user's reply to the notifier (D157).
			options.Inbound = deps.Inbound.RelayInbound
		}
{{- end }}
		notifier := deps.Notifier.Routes(options)
		inbox := pathOr(options.InboxPath, notify.DefaultInboxPath)
		r.With(auth).Handle(inbox, notifier)
		r.With(auth).Handle(inbox+"/*", notifier)
		r.Handle(pathOr(options.RelayPath, notify.DefaultRelayPath)+"/*", notifier)
	}
{{- end }}
{{- if $w.Agents }}
	if deps.Agents != nil {
		options := wiring.AgentRoutes
		if options.Authenticate == nil {
			options.Authenticate = principalOf
		}
		agentRoutes := deps.Agents.Routes(options)
		r.Handle(deps.Agents.Path()+"/*", agentRoutes)
		r.With(auth).Handle(deps.Agents.Path()+"/approvals/*", agentRoutes)
	}
{{- end }}
{{- if $w.Calendar }}
	calendar := wiring.Calendar
	if calendar.Host == nil {
		calendar.Host = db.CrossTables()
	}
	if calendar.Authenticate == nil {
		calendar.Authenticate = callerOf
	}
	calendarPath := pathOr(calendar.Base, "/api/calendar")
	calendarRoutes := crosstable.CalendarRoutes(calendar)
	r.With(auth).Handle(calendarPath, calendarRoutes)
	r.With(auth).Handle(calendarPath+"/*", calendarRoutes)
	// A calendar client sends no header: a feed's fetch reads as the
	// holder of the token its URL holds.
	r.Handle(calendarPath+"/feed/*", calendarRoutes)
{{- end }}
{{- if $w.Search }}
	search := wiring.Search
	if search.Host == nil {
		search.Host = db.CrossTables()
	}
	if search.Authenticate == nil {
		search.Authenticate = callerOf
	}
	r.With(auth).Handle(pathOr(search.Base, "/api/search"), crosstable.SearchRoutes(search))
{{- end }}
	return r
}

// pathOr is path without a trailing slash, or fallback when it is empty.
func pathOr(path, fallback string) string {
	for len(path) > 1 && path[len(path)-1] == '/' {
		path = path[:len(path)-1]
	}
	if path == "" {
		return fallback
	}
	return path
}

{{- if or $w.CrossTables $w.Agents }}

// permissionsOf are the permissions of the roles the auth step put on
// the request.
func permissionsOf(r *http.Request) []string {
	var held []string
	for _, role := range session.GetRoles(r.Context()) {
		held = append(held, role.Permissions...)
	}
	return held
}
{{- end }}
{{- if $w.CrossTables }}

// callerOf is the caller the auth step put on the request, with its roles'
// permissions, as a read across tables takes it; nil for none, which the
// route answers 401.
func callerOf(r *http.Request) (*crosstable.Caller, error) {
	caller := session.GetCaller(r.Context())
	if caller.Anonymous() {
		return nil, nil
	}
	return &crosstable.Caller{Principal: caller, Permissions: permissionsOf(r)}, nil
}
{{- end }}
{{- if $w.Agents }}

// principalOf is the caller the auth step put on the request, with its
// roles' permissions, as an approval's route takes it; nil for none, which
// the route answers 401.
func principalOf(r *http.Request) (*orchestration.Principal, error) {
	caller := session.GetCaller(r.Context())
	if caller.Anonymous() {
		return nil, nil
	}
	return &orchestration.Principal{Principal: caller, Permissions: permissionsOf(r)}, nil
}
{{- end }}
{{- end }}
