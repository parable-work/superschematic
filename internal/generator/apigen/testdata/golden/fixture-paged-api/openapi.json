            "description": "Internal server error"
          }
        },
        "summary": "placeBasket",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/items": {
      "get": {
        "description": "The items, two to a page unless the caller asks for up to five, by\ntheir ids or their stock, in order of their names unless the caller\nsorts them by name or sku, either way.",
        "operationId": "CatalogListItemsHandler",
        "parameters": [
          {
            "explode": false,
            "in": "query",
            "name": "ids",
            "required": false,
            "schema": {
              "items": {
                "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
                "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
                "type": "string"
              },
              "maxItems": 5,
              "type": "array"
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "inStock",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "The order of the page: a field, or - and a field for descending; ties break by id. A cursor holds the sort it was returned under.",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "name",
              "enum": [
                "name",
                "-name",
                "sku",
                "-sku"
              ],
              "type": "string"
            },
            "x-superschematic-sort": true
          },
          {
            "description": "The `next` of the previous page; absent for the first page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            }
          },
          {
            "description": "The most items the page holds: 1 to 5, 2 when absent.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 2,
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "properties": {
                        "items": {
                          "items": {
                            "$ref": "#/components/schemas/ItemView"
                          },
                          "type": "array"
                        },
                        "next": {
                          "description": "The cursor of the next page, to send as cursor; null after the last page.",
                          "nullable": true,
                          "type": "string"
                        }
                      },
                      "required": [
                        "items",
                        "next"
                      ],
                      "type": "object"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/ResponseMeta"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "listItems",
        "tags": [
          "catalog"
        ]
      }
    },
