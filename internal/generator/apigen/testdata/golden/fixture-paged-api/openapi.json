{
  "components": {
    "schemas": {
      "BasketInput": {
        "description": "Request body: the lines of a basket to place.",
        "properties": {
          "lines": {
            "items": {
              "$ref": "#/components/schemas/BasketLine"
            },
            "maxItems": 5,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "lines"
        ],
        "type": "object"
      },
      "BasketLine": {
        "description": "One line of a basket: an item and how many of it.",
        "properties": {
          "itemId": {
            "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
            "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
            "type": "string"
          },
          "quantity": {
            "format": "double",
            "maximum": 9,
            "minimum": 1,
            "type": "number"
          }
        },
        "required": [
          "itemId",
          "quantity"
        ],
        "type": "object"
      },
      "BasketView": {
        "description": "A placed basket.",
        "properties": {
          "id": {
            "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
            "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
            "type": "string"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/BasketLine"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "lines"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ItemView": {
        "description": "An item of the catalog.",
        "properties": {
          "id": {
            "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
            "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
            "type": "string"
          },
          "inStock": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "sku": {
            "description": "A URL friendly version of a string",
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "sku",
          "inStock"
        ],
        "type": "object"
      },
