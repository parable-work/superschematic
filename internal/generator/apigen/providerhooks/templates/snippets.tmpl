// firstStep, permissionStep and afterDecryptStep are the marker steps the
// route snippets write.
func firstStep(string) runtimerouting.Middleware {
	return func(next gohttp.Handler) gohttp.Handler { return next }
}

func permissionStep(int) runtimerouting.Middleware {
	return func(next gohttp.Handler) gohttp.Handler { return next }
}

func afterDecryptStep(string) runtimerouting.Middleware {
	return func(next gohttp.Handler) gohttp.Handler { return next }
}
