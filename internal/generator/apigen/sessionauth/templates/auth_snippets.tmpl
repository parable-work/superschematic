{{ define "middlewareAliases" }}

// ===========================================================================
// Type Aliases (delegated to http-runtime/session)
// ===========================================================================

// Role is the role projection (id + name + permissions) propagated through
// request context.
type Role = runtimesession.Role
{{- if not .Auth.Identity }}

// SessionRecord is the session row the SessionStore returns.
type SessionRecord = runtimesession.Record

// Principal is the authenticated principal the PrincipalStore returns.
type Principal = runtimesession.Principal
{{- end }}
{{- end }}

{{ define "middlewareAuthz" }}

// ===========================================================================
// Authorization (delegated to http-runtime/session)
// ===========================================================================

var (
	RequireAuth        = runtimesession.RequireAuth
	RequirePermissions = runtimesession.RequirePermissions
	HasAnyPermission   = runtimesession.HasAnyPermission
)
{{- end }}

