{{ define "middlewareStores" }}

// ===========================================================================
// ORM Store Adapters
// ===========================================================================
// Each adapter is generated only when the upstream DB schema declares the
// table shape it queries, so this file always compiles against the upstream
// ORM regardless of which auth tables the schema defines.

{{- if .Auth.HasSessionStore }}

type ormSessionStore struct {
	db orm.DatabaseInterface
}

func (s *ormSessionStore) FindByJTI(ctx context.Context, jti string) (runtimesession.Record, error) {
	// The filter takes the scalar UUID type, not its string form; a string
	// that is not a UUID cannot name a session.
	jtiUUID, err := scalars.ParseUUID(jti)
	if err != nil {
		return runtimesession.Record{}, runtimesession.ErrNotFound
	}
	session, err := s.db.GetSessionRepository().FindOne(ctx, &orm.SessionFilter{
		Jti: &orm.UUIDFilter{Eq: &jtiUUID},
	}, &orm.SessionFindOptions{
		IncludeDeleted: true,
	})
	if err != nil {
		if errors.Is(err, orm.ErrNotFound) {
			return runtimesession.Record{}, runtimesession.ErrNotFound
		}
		return runtimesession.Record{}, err
	}
	return runtimesession.Record{
		ID:          session.Id.String(),
		PrincipalID: session.User.Id.String(),
		ExpiresAt:   session.ExpiresAt,
		DeletedAt:   session.DeletedAt,
	}, nil
}

// NewSessionStore creates a SessionStore backed by the generated ORM.
func NewSessionStore(db orm.DatabaseInterface) runtimesession.Store {
	return &ormSessionStore{db: db}
}
{{- end }}

{{- if .Auth.HasPrincipalStore }}

type ormPrincipalStore struct {
	db orm.DatabaseInterface
}

func (s *ormPrincipalStore) GetByID(ctx context.Context, id string) (runtimesession.Principal, error) {
	idUUID, err := scalars.ParseUUID(id)
	if err != nil {
		return runtimesession.Principal{}, runtimesession.ErrNotFound
	}
	user, err := s.db.GetUserRepository().FindOne(ctx, &orm.UserFilter{
		Id: &orm.UUIDFilter{Eq: &idUUID},
	}, nil)
	if err != nil {
		if errors.Is(err, orm.ErrNotFound) {
			return runtimesession.Principal{}, runtimesession.ErrNotFound
		}
		return runtimesession.Principal{}, err
	}
	return runtimesession.Principal{
		ID:   user.Id.String(),
		Name: string(user.Name),
	}, nil
}

// NewPrincipalStore creates a PrincipalStore backed by the generated ORM.
func NewPrincipalStore(db orm.DatabaseInterface) runtimesession.PrincipalStore {
	return &ormPrincipalStore{db: db}
}
