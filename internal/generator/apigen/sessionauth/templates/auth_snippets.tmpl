// ===========================================================================
// Auth Context (delegated to http-runtime/session)
// ===========================================================================

// ContextWithPrincipalID returns a new context with the authenticated principal's ID set.
func ContextWithPrincipalID(ctx context.Context, principalID string) context.Context {
	return runtimesession.ContextWithPrincipalID(ctx, principalID)
}

// GetPrincipalID extracts the authenticated principal's ID from context.
func GetPrincipalID(ctx context.Context) string {
	return runtimesession.GetPrincipalID(ctx)
}

// HasPrincipalID reports whether a principal ID is set on the context.
func HasPrincipalID(ctx context.Context) bool {
	return runtimesession.HasPrincipalID(ctx)
}

// ContextWithPrincipalName returns a new context with the principal's display name set.
func ContextWithPrincipalName(ctx context.Context, name string) context.Context {
	return runtimesession.ContextWithPrincipalName(ctx, name)
}

// GetPrincipalName extracts the principal's display name from context.
func GetPrincipalName(ctx context.Context) string {
	return runtimesession.GetPrincipalName(ctx)
}

// ContextWithSessionID returns a new context with the session ID set.
func ContextWithSessionID(ctx context.Context, sessionID string) context.Context {
	return runtimesession.ContextWithSessionID(ctx, sessionID)
}

// GetSessionID extracts the session ID from context.
func GetSessionID(ctx context.Context) string {
	return runtimesession.GetSessionID(ctx)
}

// ContextWithRoles returns a new context with the principal's roles set.
func ContextWithRoles(ctx context.Context, roles []runtimesession.Role) context.Context {
	return runtimesession.ContextWithRoles(ctx, roles)
}

// GetRoles extracts the principal's roles from context. Returns nil when no
// roles are set.
func GetRoles(ctx context.Context) []runtimesession.Role {
	return runtimesession.GetRoles(ctx)
}
