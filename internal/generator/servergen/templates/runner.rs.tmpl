//! Code generated by superschematic. DO NOT EDIT.
//!
//! Runner {{ .Name }} of stack {{ .Stack }}: the engine's runner of {{ $db.Service }}, an
//! engine database (D58; docs/stack-model.md, {{ .Sections }}). superschematic
//! writes it on every build of the stack, a member of the output root's Cargo
//! workspace, and cargo builds it: `cargo build --release --locked`.
//!
//! It reads its database's connection from the environment, the one field
//! its edge derives, {{ $db.Field }} (section 3.4), and no API's config. It opens
//! the engine on it in the background, retrying until the database answers,
//! starts the engine's runner as {{ .Name }}, holding each engine type, and
//! runs it until SIGTERM or SIGINT, then stops the runner and exits 0. On
//! Postgres the runner runs while it holds the runner's lock, so a second
//! instance only waits. It serves no port.

mod engine;

use std::process::ExitCode;

use {{ .RuntimeIdent }}::logging::{self, tracing};
use {{ .RuntimeIdent }}::stackconfig;
use {{ .RuntimeIdent }}::Shutdown;
{{ range .CrateUses }}
{{ . }}
{{- end }}

/// The stack the runner is of, which each line of its log names.
const STACK: &str = {{ rustString .Stack }};

/// The runner, which each line of its log names.
const NAME: &str = {{ rustString .Name }};

/// Why the runner could not start, or stopped: a message that names what
/// failed.
type Failure = Box<dyn std::error::Error + Send + Sync>;

#[tokio::main]
async fn main() -> ExitCode {
    if let Err(err) = logging::init_json_as(STACK, logging::RUNNER, NAME) {
        eprintln!("{NAME}: install the logger: {err}");
        return ExitCode::FAILURE;
    }
    match run().await {
        Ok(()) => ExitCode::SUCCESS,
        Err(err) => {
            tracing::error!(error = %err, "runner failed");
            ExitCode::FAILURE
        }
    }
}

/// Opens the engine and runs its runner until SIGTERM or SIGINT.
async fn run() -> Result<(), Failure> {
    let shutdown = Shutdown::on_signals()?;
{{ rustLetChain $db.Var (printf "stackconfig::load_database(%s)" (rustString $db.Field)) (printf "map_err(|err| format!(\"database %s: {err}\"))?" $db.Service) }}
{{ .OpenLet $engine }}
    shutdown.cancelled().await;
    tracing::info!("shutting down");
    // The runner stops with the engine, which lets go of its database off
    // the runtime.
    {{ $engine.Var }}.shutdown().await;
    tracing::info!("stopped");
    Ok(())
}
