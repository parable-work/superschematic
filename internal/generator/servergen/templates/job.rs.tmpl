{{- $api := index .APIs 0 -}}
//! Code generated by superschematic. DO NOT EDIT.
//!
//! Job {{ .Name }} of stack {{ .Stack }}: job {{ .Job.Name }} of {{ $api.Service }}
//! (docs/stack-model.md, {{ .Sections }}). superschematic writes it on every
//! build of the stack, a member of the output root's Cargo workspace, and
//! cargo builds it: `cargo build --release --locked`.
//!
//! It reads its whole configuration from the environment, as the API's
//! server does: the API's @envVars settings and the fields its edges derive,
//! one variable per member (section 3.4). It builds the API's Deps as the
//! server does, calls the implementation's `create_jobs`, and runs the job's
//! method once, with a `Shutdown` that SIGTERM or SIGINT cancels. It logs the
//! run's end and, when the job fails, exits 1, so the platform records the
//! run as failed and runs it again if the job's retries allow. It serves no
//! port, and builds no identity service and no router (D52, D65). When the
//! environment names an OTLP endpoint (`OTEL_EXPORTER_OTLP_ENDPOINT`), it
//! exports a span of the run, flushed before it exits (D67).
//!
//! The API's implementation is the crate at the naming file's
//! `[implementation_paths] rust` template, which each build copies into the
//! output root's `impl/<service>`, the mirror this crate builds against
//! (section 8.6): {{ $api.ImplCrate }}{{ if $api.ImplDir }}, at {{ $api.ImplDir }}{{ end }}
{{- if .Engines }}
//!
//! Its API's database is an engine database, whose engine (D58) its Deps
//! holds, which `engine.rs` opens in the background.

mod engine;
{{- end }}

use std::process::ExitCode;
{{- if or .Buckets .MemoryStores }}
use std::sync::Arc;
{{- end }}
use std::time::Instant;
{{ range .RuntimeUses }}
{{ . }}
{{- end }}
{{ range .CrateUses }}
{{ . }}
{{- end }}

/// The stack the job is of, which each line of its log names.
const STACK: &str = {{ rustString .Stack }};

/// The job, which each line of its log names.
const NAME: &str = {{ rustString .Name }};

/// Why the job could not run, or failed: a message that names what failed.
type Failure = Box<dyn std::error::Error + Send + Sync>;

#[tokio::main]
async fn main() -> ExitCode {
    // The log and, when the environment names an OTLP endpoint, trace export
    // (D67), which flushes the spans still buffered as main returns.
    let installed = telemetry::start(Defaults {
        stack: STACK,
        kind: logging::JOB,
        name: NAME,
    });
    let _telemetry = match installed {
        Ok(telemetry) => telemetry,
        Err(err) => {
            eprintln!("{NAME}: install the logger: {err}");
            return ExitCode::FAILURE;
        }
    };
    let started = Instant::now();
    match run().await {
        Ok(()) => {
            tracing::info!(took = started.elapsed().as_secs_f64(), "job done");
            ExitCode::SUCCESS
        }
        Err(err) => {
            tracing::error!(took = started.elapsed().as_secs_f64(), error = %err, "job failed");
            ExitCode::FAILURE
        }
    }
}

/// Builds the job from the environment and runs it once, until its method
/// returns. SIGTERM or SIGINT cancels the `Shutdown` the method is given; a
/// second signal ends the process at once.
async fn run() -> Result<(), Failure> {
    let shutdown = Shutdown::on_signals()?;
{{- template "rs-background-deps" . }}
{{ rustLetChain "jobs" (printf "%s::create_jobs(%s)" $api.ImplAlias $api.Deps) "await" (printf "map_err(|err| format!(\"jobs of %s: {err}\"))?" $api.Service) }}
{{ rustMacro "tracing::info" (printf "api = %s" (rustString $api.Service)) (printf "class = %s" (rustString .Job.Name)) (rustString "job started") }}
{{ .JobRun }}
{{- if .Engines }}
    // The engine closes once the job ends, off the runtime.
{{- range .Engines }}
    {{ .Var }}.shutdown().await;
{{- end }}
{{- end }}
{{- if .MemoryStores }}
    // Each memory store closes once the job ends.
{{- range .MemoryStores }}
    {{ .Var }}.close().await;
{{- end }}
{{- end }}
{{- if .Closes }}
    ran
{{- end }}
}
{{ template "rs-functions" . }}
