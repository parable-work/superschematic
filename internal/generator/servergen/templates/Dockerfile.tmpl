ENV GOTOOLCHAIN=local CGO_ENABLED=1
WORKDIR /src
COPY . .
COPY --from=superscalar /libsuperscalar_ffi.a /archives/
{{- if .Docker.VersionGraphGo }}
COPY --from=versiongraph /libsuperschematic_versiongraph.a /archives/
