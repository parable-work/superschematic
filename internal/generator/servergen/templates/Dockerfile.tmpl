    --mount=type=cache,target=/root/.cache/go-build \
    go build -mod=mod -trimpath -o /out/server .

FROM gcr.io/distroless/cc-debian13:nonroot
COPY --from=build /out/server /server
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/server"]
