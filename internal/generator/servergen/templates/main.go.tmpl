// newHandler answers /healthz and /readyz, and hands every other request
// to the router of the API that registers its method and path. A request
// ID and a recovered panic cover every request.
func newHandler(logger *zap.Logger, draining *atomic.Bool, apis []served, dependencies []dependency) http.Handler {
