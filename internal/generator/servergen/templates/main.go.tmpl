			if api.router.Match(chi.NewRouteContext(), {{ if anyIdentity .APIs }}method{{ else }}r.Method{{ end }}, path) {
				api.router.ServeHTTP(w, r)
				return
			}
		}
		apis[0].router.ServeHTTP(w, r)
	})
}

// serve listens on $PORT until ctx ends. Then it lets a second signal end
// the process, answers /readyz 503, and gives the requests in flight
// shutdownTimeout to finish.
func serve(ctx context.Context, stop context.CancelFunc, logger *zap.Logger, draining *atomic.Bool, handler http.Handler) error {
	port := os.Getenv("PORT")
	if port == "" {
		port = defaultPort
	}
	server := &http.Server{
		Addr:              net.JoinHostPort("", port),
		Handler:           handler,
		ReadHeaderTimeout: 10 * time.Second,
	}
	errc := make(chan error, 1)
	go func() {
		logger.Info("listening", zap.String("addr", server.Addr))
		errc <- server.ListenAndServe()
	}()
	select {
	case err := <-errc:
		return fmt.Errorf("listen on %s: %w", server.Addr, err)
	case <-ctx.Done():
	}
	stop()
	draining.Store(true)
	logger.Info("shutting down")
	shutdownCtx, cancel := context.WithTimeout(context.Background(), shutdownTimeout)
	defer cancel()
	if err := server.Shutdown(shutdownCtx); err != nil {
		return fmt.Errorf("shut down: %w", err)
	}
	if err := <-errc; !errors.Is(err, http.ErrServerClosed) {
		return err
	}
	logger.Info("stopped")
	return nil
}
