		switch r.URL.Path {
		case "/healthz":
			writeJSON(w, http.StatusOK, map[string]any{"status": "ok"})
		case "/readyz":
			if draining.Load() {
				writeJSON(w, http.StatusServiceUnavailable, map[string]any{"status": "draining"})
				return
			}
			unavailable := []string{}
			for _, dep := range dependencies {
				ctx, cancel := context.WithTimeout(r.Context(), readinessTimeout)
				err := dep.check(ctx)
				cancel()
				if err != nil {
					logger.Warn("not ready", zap.String("dependency", dep.name), zap.Error(err))
					unavailable = append(unavailable, dep.name)
				}
			}
			if len(unavailable) > 0 {
				writeJSON(w, http.StatusServiceUnavailable, map[string]any{"status": "unavailable", "unavailable": unavailable})
				return
			}
			writeJSON(w, http.StatusOK, map[string]any{"status": "ready"})
