#[cfg(test)]
mod tests {
    use super::*;

    fn arguments(line: &[&str]) -> Arguments {
        parse(line.iter().map(|argument| (*argument).to_owned())).expect("a command line")
    }

    #[test]
    fn it_listens_on_loopback_at_the_port_unless_told_another_address() {
        let listen = |line: &[&str], port: Option<&str>| {
            address(&arguments(line), port).map(|address| address.to_string())
        };
        let default = format!("127.0.0.1:{DEFAULT_PORT}");
        assert_eq!(listen(&[], None), Ok(default.clone()));
        assert_eq!(listen(&[], Some("")), Ok(default));
        assert_eq!(listen(&[], Some("9123")), Ok("127.0.0.1:9123".to_owned()));
        assert_eq!(
            listen(&["--listen", "127.0.0.2"], Some("9123")),
            Ok("127.0.0.2:9123".to_owned())
        );
        assert_eq!(
            listen(&["--listen=[::1]:7000"], Some("9123")),
            Ok("[::1]:7000".to_owned())
        );
        assert!(listen(&[], Some("http")).is_err());
        assert!(listen(&["--listen", "localhost"], None).is_err());
    }

    #[test]
    fn it_listens_on_every_interface_only_when_told_to_in_those_words() {
        let listen = |line: &[&str]| {
            address(&arguments(line), Some("9123")).map(|address| address.to_string())
        };
        assert_eq!(
            listen(&["--every-interface"]),
            Ok("0.0.0.0:9123".to_owned())
        );
        for refused in ["0.0.0.0", "0.0.0.0:80", "[::]:80"] {
            let err = listen(&["--listen", refused]).expect_err("every interface is refused");
            assert!(err.contains("--every-interface"), "{err}");
        }
        assert!(listen(&["--every-interface", "--listen", "127.0.0.1"]).is_err());
    }

    #[test]
    fn it_reads_its_flags_and_refuses_any_other() {
        assert_eq!(
            arguments(&["--data", "/var/lib/notes", "--every-interface"]),
            Arguments {
                data: Some(PathBuf::from("/var/lib/notes")),
                every_interface: true,
                ..Arguments::default()
            }
        );
        assert!(arguments(&["--help"]).help);
        for refused in [
            &["--port", "1"][..],
            &["--data"],
            &["--every-interface=yes"],
        ] {
            assert!(parse(refused.iter().map(|argument| (*argument).to_owned())).is_err());
        }
    }
}
