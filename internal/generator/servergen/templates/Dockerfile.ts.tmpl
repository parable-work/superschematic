ARG RUST_VERSION={{ .RustVersion }}
ARG BUN_VERSION={{ .BunVersion }}

FROM rust:${RUST_VERSION}-trixie AS addon
WORKDIR /superscalar
COPY {{ .Docker.ScalarWorkspace }}/Cargo.toml {{ .Docker.ScalarWorkspace }}/Cargo.lock ./
COPY {{ .Docker.ScalarWorkspace }}/crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --locked --release -p superscalar-napi \
    && case "$(uname -m)" in \
      x86_64) triple=linux-x64-gnu ;; \
      aarch64) triple=linux-arm64-gnu ;; \
      *) echo "superscalar builds no Node addon for linux/$(uname -m)" >&2; exit 1 ;; \
    esac \
    && mkdir /native \
    && cp target/release/libsuperscalar_napi.so "/native/superscalar-napi.$triple.node"
{{- with .Docker.Engine }}

FROM rust:${RUST_VERSION}-trixie AS engine
WORKDIR /src
COPY {{ .Workspace }} {{ .Workspace }}
{{- range .Crates }}
COPY {{ . }} {{ . }}
{{- end }}
{{- if .Project }}
COPY {{ .Project }} {{ .Project }}
{{- range .ProjectCrates }}
COPY {{ . }} {{ . }}
{{- end }}
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    { test -f {{ .Project }}/Cargo.lock || cp {{ .Workspace }}/Cargo.lock {{ .Project }}/Cargo.lock; } \
    && cargo build --release --manifest-path {{ .Project }}/napi/Cargo.toml \
    && mkdir /native \
    && cp {{ .Project }}/target/release/{{ .ProjectLib }} /native/{{ .Addon }}
{{- else }}
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --locked --release --manifest-path {{ .Workspace }}/Cargo.toml -p superschematic-engine-addon \
    && case "$(uname -m)" in \
      x86_64) triple=linux-x64-gnu ;; \
      aarch64) triple=linux-arm64-gnu ;; \
      *) echo "the engine builds no Node-API addon for linux/$(uname -m)" >&2; exit 1 ;; \
    esac \
    && mkdir /native \
    && cp {{ .Workspace }}/target/release/libsuperschematic_engine_addon.so "/native/superschematic-engine.$triple.node"
{{- end }}
{{- end }}

FROM oven/bun:${BUN_VERSION} AS build
WORKDIR /src
COPY . .
COPY --from=addon /native/ {{ .Docker.ScalarTypeScript }}/native/
RUN --mount=type=cache,target=/root/.bun/install/cache \
    cd {{ .Docker.ScalarTypeScript }} \
    && bun install --frozen-lockfile \
    && bunx tsc -p tsconfig.json \
    && bunx tsc -p tsconfig.esm.json \
    && bun scripts/fix-esm-extensions.mjs
RUN --mount=type=cache,target=/root/.bun/install/cache \
    cd {{ .Docker.HTTPRuntime }} \
    && bun install --frozen-lockfile \
    && ln -sfn {{ .Docker.ScalarLink }} node_modules/superscalar \
    && bunx tsc -p tsconfig.json
{{- with .Docker.Engine }}
{{- if not .Project }}
COPY --from=engine /native/ {{ .TypeScript }}/native/
{{- end }}
RUN cd {{ .TypeScript }} \
    && /src/{{ $.Docker.HTTPRuntime }}/node_modules/.bin/tsc -p tsconfig.server.json
{{- end }}
WORKDIR /src/{{ .Docker.Workspace }}
RUN --mount=type=cache,target=/root/.bun/install/cache \
    if [ -f bun.lock ]; then frozen=--frozen-lockfile; else frozen=; \
      echo "{{ .Docker.Workspace }}/bun.lock is not in the context: resolving the workspace afresh; commit it to pin these packages" >&2; fi \
    && bun install --production $frozen

FROM oven/bun:${BUN_VERSION}
{{- range .Docker.Runtime }}
COPY --from=build /src/{{ . }} /src/{{ . }}
{{- end }}
{{- with .Docker.Engine }}
{{- if .Project }}
COPY --from=engine /native/{{ .Addon }} {{ .AddonPath }}
ENV SUPERSCHEMATIC_ENGINE_ADDON={{ .AddonPath }}
{{- end }}
{{- end }}
WORKDIR /src/{{ .Docker.Context }}
USER bun
{{- if .Background }}
ENV NODE_ENV=production
{{- else }}
ENV PORT=8080 NODE_ENV=production
EXPOSE 8080
{{- end }}
ENTRYPOINT ["bun", "main.ts"]
