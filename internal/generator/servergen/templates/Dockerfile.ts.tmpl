ARG RUST_VERSION={{ .RustVersion }}
ARG BUN_VERSION={{ .BunVersion }}

FROM rust:${RUST_VERSION}-trixie AS addon
WORKDIR /superscalar
COPY {{ .Docker.ScalarWorkspace }}/Cargo.toml {{ .Docker.ScalarWorkspace }}/Cargo.lock ./
COPY {{ .Docker.ScalarWorkspace }}/crates ./crates
# The cargo registry's cache mount is locked: cargo locks its package cache
# in CARGO_HOME, outside the mount, so two stages that build at once would
# unpack one crate into it together.
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    cargo build --locked --release -p superscalar-napi \
    && case "$(uname -m)" in \
      x86_64) triple=linux-x64-gnu ;; \
      aarch64) triple=linux-arm64-gnu ;; \
      *) echo "superscalar builds no Node addon for linux/$(uname -m)" >&2; exit 1 ;; \
    esac \
    && mkdir /native \
    && cp target/release/libsuperscalar_napi.so "/native/superscalar-napi.$triple.node"
{{- with .Docker.Rules }}

FROM rust:${RUST_VERSION}-trixie AS rules
WORKDIR /src
COPY {{ .Workspace }} {{ .Workspace }}
{{- range .Crates }}
COPY {{ . }} {{ . }}
{{- end }}
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    rustup target add wasm32-unknown-unknown \
    && cargo build --locked --profile dist --target wasm32-unknown-unknown --manifest-path {{ .Workspace }}/Cargo.toml -p superschematic-rules-wasm \
    && mkdir /wasm \
    && cp {{ .Workspace }}/target/wasm32-unknown-unknown/dist/{{ .Module }} /wasm/
{{- end }}
{{- with .Docker.VersionGraph }}

FROM rust:${RUST_VERSION}-trixie AS versiongraph
WORKDIR /src
COPY {{ .Crate }} {{ .Crate }}
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    rustup target add wasm32-unknown-unknown \
    && cargo build --locked --release --target wasm32-unknown-unknown --manifest-path {{ .Crate }}/Cargo.toml \
    && mkdir /wasm \
    && cp {{ .Crate }}/target/wasm32-unknown-unknown/release/{{ .Module }} /wasm/
{{- end }}

FROM oven/bun:${BUN_VERSION} AS build
WORKDIR /src
COPY . .
COPY --from=addon /native/ {{ .Docker.ScalarTypeScript }}/native/
RUN --mount=type=cache,target=/root/.bun/install/cache \
    cd {{ .Docker.ScalarTypeScript }} \
    && bun install --frozen-lockfile \
    && bunx tsc -p tsconfig.json \
    && bunx tsc -p tsconfig.esm.json \
    && bun scripts/fix-esm-extensions.mjs
RUN --mount=type=cache,target=/root/.bun/install/cache \
    cd {{ .Docker.HTTPRuntime }} \
    && bun install --frozen-lockfile \
    && ln -sfn {{ .Docker.ScalarLink }} node_modules/superscalar \
    && bunx tsc -p tsconfig.json
{{- with .Docker.Rules }}
COPY --from=rules /wasm/{{ .Module }} {{ .TypeScript }}/dist/
RUN --mount=type=cache,target=/root/.bun/install/cache \
    cd {{ .TypeScript }} \
    && bun install --frozen-lockfile \
    && bunx tsc -p tsconfig.json
{{- end }}
{{- with .Docker.VersionGraph }}
COPY --from=versiongraph /wasm/{{ .Module }} {{ .TypeScript }}/dist/
RUN --mount=type=cache,target=/root/.bun/install/cache \
    cd {{ .TypeScript }} \
    && bun install --frozen-lockfile \
    && bunx tsc -p tsconfig.json
{{- end }}
WORKDIR /src/{{ .Docker.Workspace }}
RUN --mount=type=cache,target=/root/.bun/install/cache \
    if [ -f bun.lock ]; then frozen=--frozen-lockfile; else frozen=; \
      echo "{{ .Docker.Workspace }}/bun.lock is not in the context: resolving the workspace afresh; commit it to pin these packages" >&2; fi \
    && bun install --production $frozen

FROM oven/bun:${BUN_VERSION}
{{- if and .Docker.Image .Docker.Image.Packages }}
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
{{- range .Docker.Image.Packages }}
      {{ . }} \
{{- end }}
    && rm -rf /var/lib/apt/lists/*
{{- end }}
{{- range .Docker.Runtime }}
COPY --from=build /src/{{ . }} /src/{{ . }}
{{- end }}
WORKDIR /src/{{ .Docker.Context }}
USER bun
{{- if .Background }}
ENV NODE_ENV=production
{{- else }}
ENV PORT=8080 NODE_ENV=production
EXPOSE 8080
{{- end }}
ENTRYPOINT ["bun", "main.ts"]
