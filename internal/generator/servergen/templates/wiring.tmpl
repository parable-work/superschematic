{{- /*
The wiring a server's main.go and a job's share (docs/stack-model.md,
sections 8.1 and 8.7): the named templates below read each API's config,
connect one pool per database, build one SDK client per API called, open
one handle per bucket (D54) and one store per memory store (D75), and fill an API's Deps. Both entrypoints execute them, so a job builds Deps
exactly as a server does.
*/ -}}

{{- define "imports" }}
{{- if .Databases }}
	"github.com/jackc/pgx/v5/pgxpool"
{{- end }}
{{- if anyIdentity .APIs }}
	"github.com/jackc/pgx/v5/stdlib"
	"{{ .Naming.HTTPRuntimeGoModule }}/identity"
{{- end }}
{{- if .Clients }}
	"{{ .Naming.HTTPRuntimeGoModule }}/serviceauth"
{{- end }}
{{- if or .Databases .Clients }}
	"{{ .Naming.HTTPRuntimeGoModule }}/stackconfig"
{{- end }}
	"{{ .Naming.HTTPRuntimeGoModule }}/telemetry"
{{- if .Worker }}
	"{{ .Naming.HTTPRuntimeGoModule }}/worker"
{{- end }}
	"go.uber.org/zap"
{{ range .APIs }}
	{{ .Package }} "{{ .Module }}"
	{{ .Impl }} "{{ .Import }}"
{{- end }}
{{- range .Databases }}
	{{ .Package }} "{{ .Module }}"
{{- if .TypesModule }}
	{{ .Types }} "{{ .TypesModule }}"
{{- end }}
{{- end }}
{{- range .Clients }}
	{{ .Package }} "{{ .Module }}"
{{- end }}
{{- end }}

{{- define "telemetry" }}

	// Trace export, on when the environment names an OTLP endpoint (D67).
	stopTelemetry, err := telemetry.Start(ctx, telemetry.Defaults{Service: {{ quote .Name }}, Stack: {{ quote .Stack }}, Kind: {{ quote .Kind }}, Logger: logger})
	if err != nil {
		return fmt.Errorf("telemetry: %w", err)
	}
	defer stopTelemetry()
{{- end }}

{{- define "connections" }}
{{- range .APIs }}
{{- if .Config }}

	{{ .Var }}Config, err := {{ .Package }}.LoadEnvConfig()
	if err != nil {
		return fmt.Errorf("configuration of {{ .Service }}: %w", err)
	}
{{- end }}
{{- end }}
{{- if .Databases }}

	// One pool per database, shared by every API on it. A pool connects when
	// it is first used, so the {{ .Kind }} starts while its database is not up yet
{{- if .Background }}.
{{- else }}
	// and /readyz reports it.
{{- end }}
{{- range .Databases }}
	{{ .Var }}Pool, err := connect(ctx, {{ quote .Field }}, {{ .From }})
	if err != nil {
		return fmt.Errorf("database {{ .Service }}: %w", err)
	}
	defer {{ .Var }}Pool.Close()
	{{ .Var }}, err := {{ .Package }}.ConnectWithPool({{ .Var }}Pool)
	if err != nil {
		return fmt.Errorf("database {{ .Service }}: %w", err)
	}
{{- if .Identity }}
	// The identity store of the user model in {{ .Service }} (D50), over the
	// same pool, for every API that authenticates its users against it.
	{{ .Var }}SQL := stdlib.OpenDBFromPool({{ .Var }}Pool)
	defer {{ .Var }}SQL.Close()
	{{ .Var }}IdentityStore, err := identity.NewSQLStore({{ .Var }}SQL, identity.Postgres, []byte({{ .Types }}.IdentityDescriptor))
	if err != nil {
		return fmt.Errorf("identity store of {{ .Service }}: %w", err)
	}
{{- end }}
{{- if .Engine }}
	// The engine of {{ .Service }}, an engine database (D58), opened on the same
	// database in the background, as the pool connects when first used
{{- if $.Background }}: the
	// {{ $.Kind }} deploys nothing, which the servers do.
{{- else }}, so
	// /readyz reports it until it opens and deploys the database's engine
	// document.
{{- end }}
	{{ .Engine.Var }}, err := openEngine(ctx, logger, {{ quote .Service }}, {{ quote .Field }}, {{ .From }}, {{ .Types }}.EngineDocument, {{ .Engine.PolicyLiteral }}, {{ .Engine.RetentionLiteral }}, nil, {{ if $.Background }}nil{{ else }}deployEngine{{ end }})
	if err != nil {
		return fmt.Errorf("engine of {{ .Service }}: %w", err)
	}
	defer {{ .Engine.Var }}.Close()
{{- end }}
{{- end }}
{{- end }}
{{- if .Loopback }}

	// The server's own credential for its calls between the APIs it
	// serves, which reach it on loopback: a key only this process holds,
	// which each client of such an API signs with and each API with a
	// service clause accepts (docs/stack-model.md, section 9.9).
	{{ .Loopback.Var }}, err := serviceauth.NewLoopback({{ quote .Name }}, []string{ {{- range $i, $api := .Loopback.Serves }}{{ if $i }}, {{ end }}{{ quote $api }}{{ end -}} })
	if err != nil {
		return fmt.Errorf("loopback key: %w", err)
	}
{{- end }}
{{- if .Clients }}

	// One client per API called, shared by every API that calls it.
{{- range .Clients }}
	{{ .Var }}, err := {{ .Constructor }}({{ .From }}{{ if .Loopback }}, {{ $.Loopback.Var }}{{ end }})
	if err != nil {
		return fmt.Errorf("client of {{ .Service }}: %w", err)
	}
{{- end }}
{{- end }}
{{- if .Buckets }}

	// One handle per bucket, shared by every API that lists it (buckets.go).
	defer closeBuckets()
{{- range .Buckets }}
	{{ .Var }}, err := openBucket(ctx, {{ quote .Field }}, {{ .From }})
	if err != nil {
		return fmt.Errorf("bucket {{ .Service }}: %w", err)
	}
{{- end }}
{{- end }}
{{- if .MemoryStores }}

	// One store per memory store, shared by every API that lists it
	// (memorystores.go, D75). Opening never waits for the server: a store
	// that is down reconnects in the background, and one whose field is
	// unset, or whose connection it cannot use, is disabled, so every call refuses at once and the
	// APIs take their paths without it.{{ if not .Background }} /readyz never waits for a store.{{ end }}
{{- range .MemoryStores }}
	{{ .Var }} := openMemoryStore(ctx, logger, {{ quote .Service }}, {{ quote .Field }}, {{ .From }})
	defer {{ .Var }}.Close()
{{- end }}
{{- end }}
{{- end }}

{{- define "deps" }}
	{{ .Var }}Logger := logger.With(zap.String("api", {{ quote .Service }}))
	{{ .Var }}Deps := {{ .Package }}.Deps{
{{- if .Config }}
		Config: *{{ .Var }}Config,
{{- end }}
{{- if .Database }}
		DB: {{ .Database.Var }},
{{- end }}
{{- range .Calls }}
		{{ .Field }}: {{ .Client.Var }},
{{- end }}
{{- range .Buckets }}
		{{ .Field }}: {{ .Bucket.Var }},
{{- end }}
{{- range .MemoryStores }}
		{{ .Field }}: {{ .Store.Var }},
{{- end }}
{{- if .Engine }}
		Engine: {{ .Engine.Var }}.Background,
{{- end }}
		Logger: {{ .Var }}Logger,
	}
{{- end }}

{{- define "functions" }}
{{- if .Databases }}

{{ if .CloudSQL -}}
// connect builds the pool of the database field named field, which the
// environment sets as field_URL, a connection string, or as a Cloud SQL
// connector configuration, which connectCloudSQL connects (cloudsql.go).
// The pool connects when it is first used.
{{ else -}}
// connect builds the pool of the database field named field, which the
// environment sets as field_URL, a connection string. The pool connects
// when it is first used. No environment places a database of the {{ .Kind }}
// on Cloud SQL, so it does not link the Cloud SQL connector, and a Cloud
// SQL connector configuration is refused.
{{ end -}}
func connect(ctx context.Context, field string, db stackconfig.Database) (*pgxpool.Pool, error) {
	if db.CloudSQL != nil {
{{- if .CloudSQL }}
		return connectCloudSQL(ctx, field, *db.CloudSQL)
{{- else }}
		return nil, fmt.Errorf("%s is a Cloud SQL connector configuration, which {{ .Kind }} {{ .Name }} does not link: no environment of stack {{ .Stack }} placed its databases on Cloud SQL when it was built; set %s_URL, or build the stack again", field, field)
{{- end }}
	}
	pool, err := pgxpool.New(ctx, db.URL)
	if err != nil {
		return nil, fmt.Errorf("%s_URL: %w", field, err)
	}
	return pool, nil
}
{{- end }}
{{- range .Clients }}

// {{ .Constructor }} builds the client of {{ .Service }}, which the {{ $.Kind }} calls
// at endpoint, the field its edge derives. The client sends the service
// credential the edge's connector chose, and forwards the end user of the
// request on each call's context (docs/stack-model.md, sections 9.4 and
// 9.6){{ if $.Background }}: a {{ $.Kind }} serves no request, so it forwards none{{ end }}.
// With trace export on, each call is a client span that carries its trace
// context (D67).
{{- if .Loopback }}
// {{ .Service }} is an API the server serves itself, which no connector gives a
// credential, so to a loopback endpoint without one the client sends the
// server's loopback credential (section 9.9).
{{- end }}
func {{ .Constructor }}(endpoint stackconfig.Service{{ if .Loopback }}, {{ $.Loopback.Var }} *serviceauth.Loopback{{ end }}) (*{{ .Package }}.{{ .Type }}, error) {
	cfg := {{ .Package }}.SDKConfig{
		BaseURL:   endpoint.URL,
		Auth:      &{{ .Package }}.AuthConfig{GetToken: serviceauth.ForwardedToken},
		Transport: telemetry.Transport(nil),
	}
	token, headers, err := serviceCredential(endpoint)
	if err != nil {
		return nil, err
	}
{{- if .Loopback }}
	if token == nil {
		token, headers = {{ $.Loopback.Var }}.CredentialFor(endpoint.URL)
	}
{{- end }}
	if token != nil {
		cfg.ServiceCredential = &{{ .Package }}.ServiceCredentialConfig{Token: token, Headers: headers}
	}
	return {{ .Package }}.New(cfg)
}
{{- end }}
{{- if .Clients }}

// serviceCredential is the source of the service credential a client
// built for an edge sends, which the edge's connector names in the
// endpoint, and the headers that carry it: none without one (section 9.6).
func serviceCredential(endpoint stackconfig.Service) (serviceauth.TokenSource, []string, error) {
	c := endpoint.Credential
	if c == nil {
		return nil, nil, nil
	}
	switch c.Source {
	case stackconfig.SourceGoogleIDToken:
		return serviceauth.GoogleIDToken(c.Audience), c.HeaderNames(), nil
	case stackconfig.SourceTokenFile:
		return serviceauth.TokenFile(c.TokenFile), c.HeaderNames(), nil
	case stackconfig.SourceSignedToken:
		token, err := serviceauth.SignedToken([]byte(c.Key), c.Issuer, c.Issuer, c.Audience)
		if err != nil {
			return nil, nil, err
		}
		return token, c.HeaderNames(), nil
	}
	return nil, nil, fmt.Errorf("service credential source %q is not one the runtime ships", c.Source)
}
{{- end }}
{{- end }}
