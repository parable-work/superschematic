/// The port $PORT names, or DEFAULT_PORT when it is unset.
fn listen_port() -> Result<u16, Failure> {
    match std::env::var("PORT") {
        Ok(value) if !value.is_empty() => value
            .parse()
            .map_err(|_| format!("PORT is {value:?}, which is no port").into()),
        Ok(_) | Err(std::env::VarError::NotPresent) => Ok(DEFAULT_PORT),
        Err(err) => Err(format!("PORT: {err}").into()),
    }
}
