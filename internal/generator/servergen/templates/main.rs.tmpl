/// SHUTDOWN_TIMEOUT to finish. A second signal ends the process at once.
async fn serve(
    port: u16,
    app: Router,
    readiness: Arc<Readiness>,
    stop_streams: watch::Sender<bool>,
) -> Result<(), Failure> {
{{ else -}}
/// Serves `app` on `port` until SIGTERM or SIGINT. Then it answers /readyz
/// 503, stops taking connections and gives the requests in flight
/// SHUTDOWN_TIMEOUT to finish. A second signal ends the process at once.
async fn serve(port: u16, app: Router, readiness: Arc<Readiness>) -> Result<(), Failure> {
{{ end }}    let mut signals = Signals::new()?;
    let listener = tokio::net::TcpListener::bind(SocketAddr::from(([0, 0, 0, 0], port)))
        .await
        .map_err(|err| format!("listen on :{port}: {err}"))?;
    let addr = listener.local_addr()?;
    tracing::info!(addr = %format_args!(":{}", addr.port()), "listening");
    let (stop, stopped) = tokio::sync::oneshot::channel::<()>();
    let mut server = tokio::spawn(async move {
        axum::serve(
            listener,
            app.into_make_service_with_connect_info::<SocketAddr>(),
        )
        .with_graceful_shutdown(async {
            let _ = stopped.await;
        })
        .await
    });
    let name = tokio::select! {
        served = &mut server => return Err(format!("serve on :{port}: {}", stopped_early(served)).into()),
        (name, _) = signals.next() => name,
    };
    readiness.draining.store(true, Ordering::SeqCst);
    tracing::info!(signal = name, "shutting down");
{{- if .MountsEngines }}
    stop_streams.send_replace(true);
{{- end }}
    let _ = stop.send(());
    tokio::select! {
        served = &mut server => {
            served??;
            tracing::info!("stopped");
            Ok(())
        }
        () = tokio::time::sleep(SHUTDOWN_TIMEOUT) => Err(format!(
            "requests were still in flight {} s after the signal",
            SHUTDOWN_TIMEOUT.as_secs()
        )
        .into()),
        (_, status) = signals.next() => std::process::exit(i32::from(status)),
    }
}

/// Why the server stopped serving before a signal asked it to.
fn stopped_early(served: Result<std::io::Result<()>, tokio::task::JoinError>) -> String {
    match served {
        Ok(Ok(())) => "the server stopped".to_string(),
        Ok(Err(err)) => err.to_string(),
        Err(err) => err.to_string(),
    }
}
