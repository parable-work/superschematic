/// Builds the client of {{ .Service }}. The server calls it at `endpoint`, the
/// field its edge derives, and the client sends the service credential the
/// edge's connector chose (docs/stack-model.md, section 9.6). The end user
/// travels per call: an implementation passes
/// `RequestOptions::forward(ctx.bearer_token())` with each call it makes
/// for a request.
fn {{ .Constructor }}(endpoint: &Service) -> Result<{{ .Alias }}::{{ .Client }}, Failure> {
    let service_credential = match &endpoint.credential {
        Some(credential) => Some({{ .Alias }}::ServiceCredential {
            token: stackconfig::credential_source(credential)
                .map_err(|err| format!("client of {{ .Service }}: {err}"))?,
            headers: credential.header_names(),
        }),
        None => None,
    };
    {{ .Alias }}::{{ .Client }}::new({{ .Alias }}::ClientConfig {
        base_url: endpoint.url.clone(),
        service_credential,
        ..Default::default()
    })
    .map_err(|err| format!("client of {{ .Service }}: {err}").into())
}
{{- end }}
{{- if .Dispatches }}

/// Hands a request to the router of the first API whose operations take
/// its method and path, a preflight by the method it asks for. The build
/// refused two APIs that register one, so only the routes every API's
/// router registers go to the first: its OpenAPI document and its docs. A
/// request no API takes goes to the first API's router too, which answers
/// it 404 or 405.
fn dispatch(apis: Vec<(&'static [OperationInfo], Router)>) -> Router {
    let apis: Arc<[(&'static [OperationInfo], Router)]> = apis.into();
    Router::new().fallback(move |request: Request| {
        let apis = Arc::clone(&apis);
        async move {
            let asked = request
                .headers()
                .get(axum::http::header::ACCESS_CONTROL_REQUEST_METHOD)
                .and_then(|method| method.to_str().ok());
            let method = match asked {
                Some(asked) if cors::is_preflight(request.method(), request.headers()) => asked,
                _ => request.method().as_str(),
            };
            let path = request.uri().path();
            let router = apis
                .iter()
                .find(|(operations, _)| cors::match_operations(operations, method, path))
                .map_or(&apis[0].1, |(_, router)| router)
                .clone();
            match router.oneshot(request).await {
                Ok(response) => response,
                Err(never) => match never {},
            }
        }
    })
}
{{- end }}

/// Answers while the process runs.
async fn healthz() -> Json<serde_json::Value> {
    Json(json!({ "status": "ok" }))
}

/// Answers 503 while the server drains{{ if .Databases }} or a database does not answer a ping
/// within READINESS_TIMEOUT{{ end }}, and 200 otherwise.
async fn readyz(State(readiness): State<Arc<Readiness>>) -> Response {
    if readiness.draining.load(Ordering::SeqCst) {
        return (
            StatusCode::SERVICE_UNAVAILABLE,
            Json(json!({ "status": "draining" })),
        )
            .into_response();
    }
{{- if .Databases }}
    let mut unavailable = Vec::new();
    for dependency in &readiness.dependencies {
        let failure =
            match tokio::time::timeout(READINESS_TIMEOUT, postgres::ping(&dependency.pool)).await {
                Ok(Ok(())) => continue,
                Ok(Err(err)) => err.to_string(),
                Err(_) => format!("no answer within {} s", READINESS_TIMEOUT.as_secs()),
            };
        tracing::warn!(dependency = dependency.name, error = %failure, "not ready");
        unavailable.push(dependency.name);
    }
    if !unavailable.is_empty() {
        let body = json!({ "status": "unavailable", "unavailable": unavailable });
        return (StatusCode::SERVICE_UNAVAILABLE, Json(body)).into_response();
    }
{{- end }}
    Json(json!({ "status": "ready" })).into_response()
}

/// SIGTERM and SIGINT, which stop the server.
struct Signals {
    terminate: Signal,
    interrupt: Signal,
}

impl Signals {
    fn new() -> Result<Signals, Failure> {
        Ok(Signals {
            terminate: signal(SignalKind::terminate())?,
            interrupt: signal(SignalKind::interrupt())?,
        })
    }

    /// The next signal's name, and the status a process it ends at once
    /// exits with: 128 and its number.
    async fn next(&mut self) -> (&'static str, u8) {
        tokio::select! {
            _ = self.terminate.recv() => ("SIGTERM", 143),
            _ = self.interrupt.recv() => ("SIGINT", 130),
        }
    }
}

/// Serves `app` on `port` until SIGTERM or SIGINT. Then it answers /readyz
/// 503, stops taking connections and gives the requests in flight
/// SHUTDOWN_TIMEOUT to finish. A second signal ends the process at once.
async fn serve(port: u16, app: Router, readiness: Arc<Readiness>) -> Result<(), Failure> {
    let mut signals = Signals::new()?;
    let listener = tokio::net::TcpListener::bind(SocketAddr::from(([0, 0, 0, 0], port)))
        .await
        .map_err(|err| format!("listen on :{port}: {err}"))?;
    let addr = listener.local_addr()?;
    tracing::info!(addr = %format_args!(":{}", addr.port()), "listening");
    let (stop, stopped) = tokio::sync::oneshot::channel::<()>();
    let mut server = tokio::spawn(async move {
        axum::serve(
            listener,
            app.into_make_service_with_connect_info::<SocketAddr>(),
        )
        .with_graceful_shutdown(async {
            let _ = stopped.await;
        })
        .await
    });
    let name = tokio::select! {
        served = &mut server => return Err(format!("serve on :{port}: {}", stopped_early(served)).into()),
        (name, _) = signals.next() => name,
    };
    readiness.draining.store(true, Ordering::SeqCst);
    tracing::info!(signal = name, "shutting down");
    let _ = stop.send(());
    tokio::select! {
        served = &mut server => {
            served??;
            tracing::info!("stopped");
            Ok(())
        }
        () = tokio::time::sleep(SHUTDOWN_TIMEOUT) => Err(format!(
            "requests were still in flight {} s after the signal",
            SHUTDOWN_TIMEOUT.as_secs()
        )
        .into()),
        (_, status) = signals.next() => std::process::exit(i32::from(status)),
    }
}

/// Why the server stopped serving before a signal asked it to.
fn stopped_early(served: Result<std::io::Result<()>, tokio::task::JoinError>) -> String {
    match served {
        Ok(Ok(())) => "the server stopped".to_string(),
        Ok(Err(err)) => err.to_string(),
        Err(err) => err.to_string(),
    }
}
