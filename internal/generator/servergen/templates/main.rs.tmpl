/// Hands a request to the router of the first API whose operations take
/// its method and path, a preflight by the method it asks for. The build
/// refused two APIs that register one, so only the routes every API's
/// router registers go to the first: its OpenAPI document and its docs. A
/// request no API takes goes to the first API's router too, which answers
/// it 404 or 405.
fn dispatch(apis: Vec<(&'static [OperationInfo], Router)>) -> Router {
    let apis: Arc<[(&'static [OperationInfo], Router)]> = apis.into();
    Router::new().fallback(move |request: Request| {
        let apis = Arc::clone(&apis);
        async move {
            let asked = request
                .headers()
                .get(axum::http::header::ACCESS_CONTROL_REQUEST_METHOD)
                .and_then(|method| method.to_str().ok());
            let method = match asked {
                Some(asked) if cors::is_preflight(request.method(), request.headers()) => asked,
                _ => request.method().as_str(),
            };
            let path = request.uri().path();
            let router = apis
                .iter()
                .find(|(operations, _)| cors::match_operations(operations, method, path))
                .map_or(&apis[0].1, |(_, router)| router)
                .clone();
            match router.oneshot(request).await {
                Ok(response) => response,
                Err(never) => match never {},
            }
        }
    })
}
