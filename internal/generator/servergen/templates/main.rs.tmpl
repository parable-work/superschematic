/// Answers while the process runs.
async fn healthz() -> Json<serde_json::Value> {
    Json(json!({ "status": "ok" }))
}

/// Answers 503 while the server drains{{ if .Databases }} or a database does not answer a ping
/// within READINESS_TIMEOUT{{ end }}{{ if .Engines }}, or an engine is not open or ready within it{{ end }}, and 200 otherwise.
async fn readyz(State(readiness): State<Arc<Readiness>>) -> Response {
    if readiness.draining.load(Ordering::SeqCst) {
        return (
            StatusCode::SERVICE_UNAVAILABLE,
            Json(json!({ "status": "draining" })),
        )
            .into_response();
    }
{{- if .Databases }}
    let mut unavailable = Vec::new();
    for dependency in &readiness.dependencies {
        let failure =
            match tokio::time::timeout(READINESS_TIMEOUT, postgres::ping(&dependency.pool)).await {
                Ok(Ok(())) => continue,
                Ok(Err(err)) => err.to_string(),
                Err(_) => format!("no answer within {} s", READINESS_TIMEOUT.as_secs()),
            };
        tracing::warn!(dependency = dependency.name, error = %failure, "not ready");
        unavailable.push(dependency.name);
    }
{{- if .Engines }}
    for dependency in &readiness.engines {
        let ready = tokio::time::timeout(READINESS_TIMEOUT, dependency.engine.ready());
        let failure = match ready.await {
            Ok(Ok(())) => continue,
            Ok(Err(err)) => err,
            Err(_) => format!("no answer within {} s", READINESS_TIMEOUT.as_secs()),
        };
        tracing::warn!(dependency = dependency.name, error = %failure, "not ready");
        unavailable.push(dependency.name);
    }
{{- end }}
    if !unavailable.is_empty() {
        let body = json!({ "status": "unavailable", "unavailable": unavailable });
        return (StatusCode::SERVICE_UNAVAILABLE, Json(body)).into_response();
    }
{{- end }}
    Json(json!({ "status": "ready" })).into_response()
}

/// SIGTERM and SIGINT, which stop the server.
struct Signals {
    terminate: Signal,
    interrupt: Signal,
}

impl Signals {
    fn new() -> Result<Signals, Failure> {
        Ok(Signals {
            terminate: signal(SignalKind::terminate())?,
            interrupt: signal(SignalKind::interrupt())?,
        })
    }

    /// The next signal's name, and the status a process it ends at once
    /// exits with: 128 and its number.
    async fn next(&mut self) -> (&'static str, u8) {
        tokio::select! {
            _ = self.terminate.recv() => ("SIGTERM", 143),
            _ = self.interrupt.recv() => ("SIGINT", 130),
        }
    }
}

