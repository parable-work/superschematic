/// The app, which its log and its failures name: its @app class and its
/// API.
const APP: &str = {{ rustString .App.Name }};
const API: &str = {{ rustString $api.Service }};

/// The kind of deployable each line of the log names.
const KIND: &str = "app";

/// The port the app listens on when $PORT is unset.
const DEFAULT_PORT: u16 = 8080;

/// Why the app could not start, or stopped: a message that names what
/// failed.
type Failure = Box<dyn std::error::Error + Send + Sync>;

#[tokio::main]
async fn main() -> ExitCode {
    // The log and, when the environment names an OTLP endpoint, trace export
    // (D67), which flushes the spans still buffered as main returns.
    let installed = telemetry::start(Defaults {
        stack: {{ rustString .Stack }},
        kind: KIND,
        name: {{ rustString .Name }},
    });
    let _telemetry = match installed {
        Ok(telemetry) => telemetry,
        Err(err) => {
            eprintln!("{{ .Name }}: install the logger: {err}");
            return ExitCode::FAILURE;
        }
    };
    match run().await {
        Ok(()) => ExitCode::SUCCESS,
        Err(err) => {
            tracing::error!(error = %err, "app stopped");
            ExitCode::FAILURE
        }
    }
}

/// Builds the app's parts from the environment, and serves the app until
/// its `serve` returns.
async fn run() -> Result<(), Failure> {
    let port = listen_port()?;
{{- if $api.Config }}
{{ rustLetCall $api.Config "configure" "?" (rustString $api.Service) (printf "%s::config::%s()" $api.Alias $api.ConfigLoader) }}
{{- end }}
{{- if .Databases }}

    // One pool per database. A pool connects when it is first used, so the
    // app starts while its database is not up yet.
{{- range .Databases }}
{{ rustLetCall .Var "connect" "?" (rustString .Service) (rustString .Field) (printf "&%s" .From) }}
{{- end }}
{{- range .Databases }}
{{- if .Store }}

    // The identity store of the user model in {{ .Service }} (D50), over the
    // same pool.
    let {{ .Store }}: Arc<dyn Store> = Arc::new(
        {{ .StoreAPI }}::identity::store(PostgresPool::new({{ .Var }}.clone()))
            .map_err(|err| format!("identity store of {{ .Service }}: {err}"))?,
    );
{{- end }}
{{- end }}
{{- end }}
{{- range .Engines }}

    // The engine of {{ .Service }}, an engine database (D58), opened on the
    // same database in the background, which deploys nothing: it opens once
    // the API's server has deployed the engine document this app was built
    // with.
{{ $.OpenLet . }}
{{- end }}
{{- if .Clients }}

    // One client per API called.
{{- range .Clients }}
{{ .ClientLet }}
{{- end }}
{{- end }}
{{- if .Buckets }}

    // One bucket per Bucket service, on GCS or on the emulator its
    // connection names (D54). Opening makes no request.
{{- range .Buckets }}
{{ rustLetCall .Var "open_bucket" "?" (rustString .Service) (rustString .Field) (printf "&%s" .From) }}
{{- end }}
{{- end }}

    // {{ $api.Service }}: its implementation, built from its Deps.
    let {{ $api.Deps }} = {{ $api.Alias }}::Deps {
{{- if $api.Config }}
        config: {{ $api.Config }}.clone(),
{{- end }}
{{- if $api.Database }}
        db: {{ $api.Database.Var }}.clone(),
{{- end }}
{{- with $api.Engine }}
        engine: {{ .Var }}.clone(),
{{- end }}
{{- range $api.Calls }}
        {{ .Field }}: {{ .Client.Var }}.clone(),
{{- end }}
{{- range $api.Buckets }}
        {{ .Field }}: Arc::clone(&{{ .Bucket.Var }}),
{{- end }}
        span: logging::api_span({{ rustString $api.Service }}),
    };
{{ rustLet $api.Handlers (printf "%s::create(%s.clone())" $api.ImplAlias $api.Deps) ".await" (printf "map_err(|err| format!(\"implementation of %s: {err}\"))?" $api.Service) }}
{{- if $api.Identity }}
    // The identity runtime authenticates its callers, with the config its
    // identity config field holds.
    let {{ $api.Identity }} = {{ $api.Alias }}::identity::service(
        Arc::clone(&{{ $api.Database.Store }}),
        {{ $api.Config }}.{{ $api.IdentityField }}.clone(),
    )
    .map_err(|err| format!("identity of {{ $api.Service }}: {err}"))?;
{{- end }}
{{- if $api.ServiceAuthenticator }}
    // It verifies a calling service's credential against its callers field
    // (section 9.2).
{{ $api.ServiceAuthenticatorLet $.Loopback }}
{{- end }}
{{ $api.ImplementationsLet }}
{{- if $api.Webhooks }}
    // A router of the API panics without a verifier for each webhook
    // provider.
    {{ $api.Implementations }}
        .validate_implementations()
        .map_err(|err| format!("implementation of {{ $api.Service }}: {err}"))?;
{{- end }}
{{- with .App.Engine }}

    // The app's program calls the engine in-process, so the app serves once
    // the engine has opened on the document it was built with: until then
    // it does not listen.
{{ rustLetChain $.App.Opened .Var "wait()" "await" (printf "map_err(|err| format!(\"the engine of %s: {err}\"))?" .Service) }}
{{- end }}

    let parts = {{ $api.Alias }}::apps::{{ .App.Parts }} {
        deps: {{ $api.Deps }},
        implementations: {{ $api.Implementations }},
{{- if .App.Engine }}
        engine: {{ .App.Opened }},
{{- end }}
        addr: SocketAddr::from(([0, 0, 0, 0], port)),
    };
    tracing::info!(app = APP, api = API, addr = %parts.addr, "app starting");
    let served = {{ .App.Alias }}::serve(parts).await;
{{- range .Engines }}
    // The engine closes once the app stops serving, off the runtime.
    {{ .Var }}.shutdown().await;
{{- end }}
    if let Err(err) = served {
        return Err(format!("app {APP} of {API}: {err}").into());
    }
    tracing::info!("stopped");
    Ok(())
}

/// The port $PORT names, or DEFAULT_PORT when it is unset.
fn listen_port() -> Result<u16, Failure> {
    match std::env::var("PORT") {
        Ok(value) if !value.is_empty() => value
            .parse()
            .map_err(|_| format!("PORT is {value:?}, which is no port").into()),
        Ok(_) | Err(std::env::VarError::NotPresent) => Ok(DEFAULT_PORT),
        Err(err) => Err(format!("PORT: {err}").into()),
    }
}
