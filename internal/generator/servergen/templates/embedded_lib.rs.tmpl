/// Whether `path` is `base` or a path under it.
fn under(path: &str, base: &str) -> bool {
    path.strip_prefix(base)
        .is_some_and(|rest| rest.is_empty() || rest.starts_with('/'))
}

/// `request` with `base` taken off its path, the query kept, as the API
/// under `base` reads it.
fn inner(request: Request<Bytes>, base: &str) -> Request<Bytes> {
    let (mut parts, body) = request.into_parts();
    let path = parts.uri.path().strip_prefix(base).unwrap_or("/");
    let path = if path.is_empty() { "/" } else { path };
    let target = match parts.uri.query() {
        Some(query) => format!("{path}?{query}"),
        None => path.to_owned(),
    };
    if let Ok(uri) = target.parse::<Uri>() {
        parts.uri = uri;
    }
    Request::from_parts(parts, body)
}

/// A whole response of `status` holding `body`.
fn answer(status: StatusCode, content_type: &'static str, body: &'static [u8]) -> Response<Bytes> {
    let mut response = Response::new(Bytes::from_static(body));
    *response.status_mut() = status;
    response
        .headers_mut()
        .insert(CONTENT_TYPE, HeaderValue::from_static(content_type));
    response
}

/// The answer to a request for an API the binary has let go of.
fn closed(api: &str) -> Response<Bytes> {
    tracing::warn!(api, "a request after the binary closed");
    answer(
        StatusCode::SERVICE_UNAVAILABLE,
        "text/plain; charset=utf-8",
        b"the binary is closed\n",
    )
}

/// Answers a request that is no API's from the site's files (D55): the
/// file its path names, `index.html` for a directory, the site's config
/// at [`SITE_CONFIG_PATH`], the fallback for a path that names no file,
/// and 404 without one. A file's ETag is its digest, so a browser that
/// holds it is answered 304.
fn site(request: &Request<Bytes>) -> Response<Bytes> {
    let head = request.method() == Method::HEAD;
    if request.method() != Method::GET && !head {
        return answer(
            StatusCode::METHOD_NOT_ALLOWED,
            "text/plain; charset=utf-8",
            b"the site answers GET and HEAD\n",
        );
    }
    let path = request.uri().path();
    if path == SITE_CONFIG_PATH && !SITE_APIS.is_empty() {
        return site_config(request, head);
    }
    let name = path.trim_matches('/');
    let index = format!("{name}/index.html");
    let found = site_file(if name.is_empty() { "index.html" } else { name })
        .or_else(|| site_file(&index))
        .or_else(|| SITE_FALLBACK.and_then(site_file));
    let Some(file) = found else {
        return answer(
            StatusCode::NOT_FOUND,
            "text/plain; charset=utf-8",
            b"not found\n",
        );
    };
    let unchanged = request
        .headers()
        .get(IF_NONE_MATCH)
        .and_then(|value| value.to_str().ok())
        .is_some_and(|held| held.split(',').any(|tag| tag.trim() == file.etag));
    let status = if unchanged {
        StatusCode::NOT_MODIFIED
    } else {
        StatusCode::OK
    };
    let body = if head || unchanged {
        &[][..]
    } else {
        file.body
    };
    let mut response = answer(status, file.content_type, body);
    let headers = response.headers_mut();
    headers.insert(ETAG, HeaderValue::from_static(file.etag));
    // A browser asks again each time, and is answered 304 while it holds
    // the file the binary carries.
    headers.insert(CACHE_CONTROL, HeaderValue::from_static("no-cache"));
    response
}

/// The site's file at `path`, when the binary carries one.
fn site_file(path: &str) -> Option<&'static SiteFile> {
    carried::SITE.iter().find(|file| file.path == path)
}

/// The site's config: each API its page calls, at the API's path on the
/// origin the request named, so the page reaches it wherever the binary
/// listens.
fn site_config(request: &Request<Bytes>, head: bool) -> Response<Bytes> {
    let named = request
        .headers()
        .get(HOST)
        .and_then(|value| value.to_str().ok());
    let asked = request.uri().authority().map(|asked| asked.as_str());
    let host = named.or(asked).unwrap_or("127.0.0.1");
    let apis: serde_json::Map<String, serde_json::Value> = SITE_APIS
        .iter()
        .map(|(api, path)| {
            let url = format!("http://{host}{path}");
            ((*api).to_owned(), serde_json::json!({ "url": url }))
        })
        .collect();
    let mut body = serde_json::json!({ "apis": apis }).to_string();
    body.push('\n');
    if head {
        body.clear();
    }
    let mut response = Response::new(Bytes::from(body));
    let headers = response.headers_mut();
    headers.insert(CONTENT_TYPE, HeaderValue::from_static("application/json"));
    headers.insert(CACHE_CONTROL, HeaderValue::from_static("no-store"));
    response
}
