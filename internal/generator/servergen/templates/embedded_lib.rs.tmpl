/// Takes the file of `service` under `data` to the model the plans the
/// binary carries for it end at, and creates it when it is missing.
{{- if not .Stores }}
#[allow(dead_code)]
{{- end }}
fn migrate_file(data: &Path, service: &str, file: &str) -> Result<(), Failure> {
    let carried = carried::DATABASES
        .iter()
        .find(|database| database.service == service)
        .filter(|database| !database.plans.is_empty())
        .ok_or_else(|| {
            format!(
                "database {service}: this binary carries no plan of it, so it cannot make or \
                 migrate its file; build the binary with `superschematic stack build {ENVIRONMENT}`"
            )
        })?;
    let path = data.join(file);
    let mut log = |line: &str| tracing::info!(database = service, "{line}");
    let started = migrate::start(
        &path,
        carried.plans,
        migrate::StartOptions {
            adoption: carried.adoption.as_ref().map(|adoption| migrate::Adoption {
                model: adoption.model,
                check: adoption.check,
            }),
            wal: true,
            log: Some(&mut log),
        },
    )
    .map_err(|err| format!("database {service}, at {}: {err}", path.display()))?;
    tracing::info!(
        database = service,
        model = %started.model,
        plans = started.plans.len(),
        adopted = started.adopted,
        release = carried::RELEASE,
        "migrated"
    );
    Ok(())
}

