/// Opens, in the background, the engine of the engine database `service`
/// on the database the field named `field` holds, `database`, with
/// `document`, its ENGINE_DOCUMENT, the access policy `policy`, as JSON,
/// and the event log's `retention`, as JSON, none when the log keeps every
/// event, which only a started runner prunes, while it holds the runner's
/// lock: a connection string as it is, or a Cloud SQL instance over the
/// socket Cloud Run mounts for it, an access token from the metadata server
/// as each new connection's password.
{{- if .Runner }} Once it opens, it starts the engine's
/// runner, acting as RUNNER.
{{- else if not .Background }} Once it opens, it deploys the document
/// before it reports the engine ready.
{{- end }} Each attempt that fails is logged
/// with the wait before the next.
pub fn open(
    service: &'static str,
    field: &str,
    database: &Database,
    document: &str,
    policy: &str,
    retention: Option<&str>,
) -> Result<Background, Failure> {
    let document = Arc::new(Document::parse(service, document)?);
    let connection = postgres::sync_connection(database)
        .map_err(|err| format!("the engine of {service}, from {field}: {err}"))?;
    let connection = Arc::new(connection);
    let policy: Value = serde_json::from_str(policy)
        .map_err(|err| format!("the access policy of the engine of {service}: {err}"))?;
    let mut config = json!({
        "postgres": { "url": connection.url },
        "policy": policy,
        "namespaces": { "names": [document.namespace] },
        "metaSchema": document.meta_schema,
        "tools": document.tools,
{{- if .Runner }}
        "runner": { "principal": { "subject": RUNNER, "permissions": PERMISSIONS } },
{{- end }}
    });
    if let Some(retention) = retention {
        config["retention"] = serde_json::from_str(retention).map_err(|err| {
            format!("the event log's retention of the engine of {service}: {err}")
        })?;
    }
    let options = move || -> superschematic_engine::Result<EngineOptions> {
        let mut options = EngineOptions::from_json(&config)?;
        options.behaviors = {{ .EngineBehaviors }};
        if connection.asks_password() {
            if let Storage::Postgres {
                options: postgres, ..
            } = &mut options.storage
            {
                let asking = Arc::clone(&connection);
                postgres.password = Some(PasswordProvider::new(move || {
                    asking
                        .password()
                        .unwrap_or_else(|| Err("no password to ask for".to_owned()))
                }));
            }
        }
        Ok(options)
    };
    let namespace = document.namespace.clone();
    let background = BackgroundOptions::default()
        .on_error(move |err, retry| {
            let retry_ms = u64::try_from(retry.as_millis()).unwrap_or(u64::MAX);
            tracing::warn!(engine = service, error = %err, retry_ms, "engine not open");
        })
        .on_open(move |engine| {
            let dialect = format!("{:?}", engine.dialect());
            tracing::info!(engine = service, namespace = %namespace, dialect, "engine open");
{{- if .Runner }}
        })
        .setup(move |engine| start_runner(service, engine));
{{- else if .Background }}
        });
{{- else }}
        })
        .setup(move |engine| deploy(service, engine, &document));
{{- end }}
    Ok(Background::open(options, background))
}
