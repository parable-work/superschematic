{{- end }}
{{- if .EngineIdentity }} the end user whose session `users` authenticates, with
/// their roles' permissions; a request with no session has none, so a
/// verified service stands in for one, and any other refusal of the session
/// is answered as the identity runtime answers it, 401 unauthorized or 403
/// cross_origin.
{{- else }} no end user, since the API authenticates its own.
{{- end }}
pub struct Callers {
{{- if .EngineIdentity }}
    pub users: Option<Arc<Identity>>,
{{- end }}
{{- if .EngineServiceAuth }}
    pub services: Option<Arc<dyn ServiceAuthenticator>>,
{{- end }}
}

impl superschematic_engine::axum::Callers for Callers {
{{- if .EngineRefuses }}
    fn caller<'a>(&'a self, request: &'a Parts) -> CallerFuture<'a> {
        Box::pin(async move {
            let mut caller = Caller::default();
{{- if .EngineServiceAuth }}
            if let Some(services) = &self.services {
                match services.authenticate(request).await {
                    Ok(Some(service)) => {
                        caller.service = Some(ServiceCaller {
                            deployable: service.deployable,
                            serves: service.serves,
                            subject: service.subject,
                        });
                    }
                    Ok(None) => {}
                    Err(refused) => return refusal(refused),
                }
            }
{{- end }}
{{- if .EngineIdentity }}
            if let Some(users) = &self.users {
                match users.authenticate(request).await {
                    Ok(Some(user)) => caller.principal = Some(principal(&user)),
                    Ok(None) => {}
                    Err(refused) => return refusal(refused),
                }
            }
{{- end }}
            caller
        })
    }
{{- else }}
    fn caller<'a>(&'a self, _request: &'a Parts) -> CallerFuture<'a> {
        Box::pin(std::future::ready(Caller::default()))
    }
{{- end }}
}
{{- if .EngineRefuses }}

/// A refusal of the request's credentials, which the engine answers in its
/// place: the runtime's status, code and message.
fn refusal(refused: ApiError) -> Caller {
    Caller {
        refused: Some(Refusal {
            status: refused.status.as_u16(),
            code: refused.code,
            detail: Some(refused.message),
        }),
        ..Caller::default()
    }
}
{{- end }}
{{- if .EngineIdentity }}

/// The engine's principal of the end user the identity runtime
/// authenticated: their id, their roles' permissions, and the claims the
/// runtime's principal carries (sessionId, login, name, transport, roles).
fn principal(user: &IdentityPrincipal) -> Principal {
    let runtime = user.to_principal();
    Principal::new(runtime.subject, runtime.permissions).with_claims(runtime.claims)
}
