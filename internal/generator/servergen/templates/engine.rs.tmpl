/// The routes of the engine `engine` at `mount`, its event stream's and its
/// MCP endpoint's among them, which answer 503 unavailable until it opens:
/// each request's caller is the one `callers` establishes{{ if .EngineIdentity }}, a preflight
/// from an origin the identity config trusts is answered with its CORS{{ end }},
/// and every event stream ends when `streams` moves to true, as the server
/// shuts down.
pub fn routes(
    engine: &Background,
    mount: &str,
    callers: Callers,
    streams: &watch::Receiver<bool>,
) -> Result<Router, Failure> {
{{- if .EngineIdentity }}
    let trusted = callers.users.as_ref().map(|users| users.cors());
{{- end }}
    let options = Options::new(mount)
        .callers(callers)
        .done(streams.clone())
        .timeout(ENGINE_TIMEOUT);
    let routes = background_router(engine.clone(), options)
        .map_err(|err| format!("the engine's routes at {mount}: {err}"))?;
{{- if .EngineIdentity }}
    Ok(match trusted {
        Some(cors) => routes.layer(cors),
        None => routes,
    })
{{- else }}
    Ok(routes)
{{- end }}
}
{{- if .EngineSiteCORS }}

/// The site CORS of the engine's routes at `mount`, for the origins of the
/// sites that call the API that mounts them, with the methods the routes
/// take (D55).
pub fn site_cors(sites: &Cors, mount: &str) -> cors::Api {
    let routes = superschematic_engine::api::ROUTES
        .iter()
        .map(|route| (route.method, format!("{mount}{}", route.path)));
    let mut methods: Vec<String> = Vec::new();
    for route in &superschematic_engine::api::ROUTES {
        if !methods.iter().any(|method| method == route.method) {
            methods.push(route.method.to_owned());
        }
    }
    let policy = cors::Policy {
        origins: sites.origins.clone(),
        methods,
    };
    cors::Api::with_routes(policy, routes)
}
{{- end }}

/// Who a request to an engine's routes is, as the routes of the API that
/// mounts them establish it:
{{- if .EngineServiceAuth }} the calling service, which `services`
