{
  "kind": "DB",
  "name": "desk-db",
  "description": "The app fixture's database (D78): a support desk whose customers and agents are tables, and whose members sign in through the user model's tables (D50).",
  "scalars": {
    "Contact.Email": {
      "name": "Contact.Email",
      "languagePrimitive": "string"
    },
    "Identity.Name": {
      "name": "Identity.Name",
      "languagePrimitive": "string"
    },
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string"
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "languagePrimitive": "string"
    }
  },
  "enums": {
    "CustomerTier": {
      "name": "CustomerTier",
      "description": "How much a customer pays; only the Customer table uses it.",
      "values": [
        {
          "name": "Free",
          "serializedAs": "free"
        },
        {
          "name": "Paid",
          "serializedAs": "paid"
        }
      ]
    }
  },
  "types": {
    "Address": {
      "name": "Address",
      "description": "A postal address, stored as JSON in a customer's row.",
      "role": "DBTable",
      "jsonField": true,
      "fields": [
        {
          "name": "line1",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "city",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "country",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "validateMinLength": 2,
          "validateMaxLength": 2
        }
      ]
    },
    "Customer": {
      "name": "Customer",
      "description": "A customer: a table.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "unique": true,
          "autoGenerated": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "Identity.Name"
          },
          "required": true
        },
        {
          "name": "email",
          "typeRef": {
            "name": "Contact.Email"
          },
          "required": true,
          "unique": true
        },
        {
          "name": "tier",
          "typeRef": {
            "name": "CustomerTier"
          },
          "required": true,
          "default": "free"
        },
        {
          "name": "billingAddress",
          "typeRef": {
            "name": "Address"
          }
        },
        {
          "name": "createdAt",
          "typeRef": {
            "name": "Temporal.DateTime"
          },
          "required": true
        }
      ]
    },
    "Agent": {
      "name": "Agent",
      "description": "A support agent: a table, with its manager a relation to another agent.",
      "role": "DBTable",
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "unique": true,
          "autoGenerated": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "Identity.Name"
          },
          "required": true
        },
        {
          "name": "manager",
          "typeRef": {
            "name": "Agent"
          }
        }
      ]
    },
    "Member": {
      "name": "Member",
      "description": "A member of the desk who signs in with their email: the user model (D50).",
      "role": "DBTable",
      "user": {
        "login": "email",
        "name": "displayName"
      },
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "email",
          "typeRef": {
            "name": "Contact.Email"
          },
          "required": true,
          "unique": true
        },
        {
          "name": "displayName",
          "typeRef": {
            "name": "Identity.Name"
          },
          "required": true
        }
      ]
    },
    "MemberRole": {
      "name": "MemberRole",
      "description": "A named set of permissions members are granted.",
      "role": "DBTable",
      "userRole": {},
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "name",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "unique": true
        },
        {
          "name": "permissions",
          "typeRef": {
            "name": "string",
            "isArray": true
          },
          "required": true
        }
      ]
    }
  }
}
