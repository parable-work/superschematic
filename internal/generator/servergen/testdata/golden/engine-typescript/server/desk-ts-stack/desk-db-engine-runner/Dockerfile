ARG RUST_VERSION=1.99.0
ARG BUN_VERSION=1.4.2

FROM rust:${RUST_VERSION}-trixie AS addon
WORKDIR /superscalar
COPY third_party/superscalar/Cargo.toml third_party/superscalar/Cargo.lock ./
COPY third_party/superscalar/crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --locked --release -p superscalar-napi \
    && case "$(uname -m)" in \
      x86_64) triple=linux-x64-gnu ;; \
      aarch64) triple=linux-arm64-gnu ;; \
      *) echo "superscalar builds no Node addon for linux/$(uname -m)" >&2; exit 1 ;; \
    esac \
    && mkdir /native \
    && cp target/release/libsuperscalar_napi.so "/native/superscalar-napi.$triple.node"

FROM rust:${RUST_VERSION}-trixie AS engine
WORKDIR /src
COPY runtime/engine/rust runtime/engine/rust
COPY runtime/engine-workqueue/rust runtime/engine-workqueue/rust
COPY runtime/engine-commerce/rust runtime/engine-commerce/rust
COPY runtime/schema/rust-ir runtime/schema/rust-ir
COPY runtime/schema/rust runtime/schema/rust
COPY runtime/versiongraph/rust-engine runtime/versiongraph/rust-engine
COPY runtime/versiongraph/rust runtime/versiongraph/rust
COPY third_party/superscalar/Cargo.toml third_party/superscalar/Cargo.toml
COPY third_party/superscalar/crates third_party/superscalar/crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --locked --release --manifest-path runtime/engine/rust/Cargo.toml -p superschematic-engine-addon \
    && case "$(uname -m)" in \
      x86_64) triple=linux-x64-gnu ;; \
      aarch64) triple=linux-arm64-gnu ;; \
      *) echo "the engine builds no Node-API addon for linux/$(uname -m)" >&2; exit 1 ;; \
    esac \
    && mkdir /native \
    && cp runtime/engine/rust/target/release/libsuperschematic_engine_addon.so "/native/superschematic-engine.$triple.node"

FROM oven/bun:${BUN_VERSION} AS build
WORKDIR /src
COPY . .
COPY --from=addon /native/ third_party/superscalar/bindings/typescript/native/
RUN --mount=type=cache,target=/root/.bun/install/cache \
    cd third_party/superscalar/bindings/typescript \
    && bun install --frozen-lockfile \
    && bunx tsc -p tsconfig.json \
    && bunx tsc -p tsconfig.esm.json \
    && bun scripts/fix-esm-extensions.mjs
RUN --mount=type=cache,target=/root/.bun/install/cache \
    cd runtime/http/typescript \
    && bun install --frozen-lockfile \
    && ln -sfn ../../../../third_party/superscalar/bindings/typescript node_modules/superscalar \
    && bunx tsc -p tsconfig.json
COPY --from=engine /native/ runtime/engine/typescript/native/
RUN cd runtime/engine/typescript \
    && /src/runtime/http/typescript/node_modules/.bin/tsc -p tsconfig.server.json
WORKDIR /src/schemas/dist
RUN --mount=type=cache,target=/root/.bun/install/cache \
    if [ -f bun.lock ]; then frozen=--frozen-lockfile; else frozen=; \
      echo "schemas/dist/bun.lock is not in the context: resolving the workspace afresh; commit it to pin these packages" >&2; fi \
    && bun install --production $frozen

FROM oven/bun:${BUN_VERSION}
COPY --from=build /src/schemas/dist /src/schemas/dist
WORKDIR /src/schemas/dist/server/desk-ts-stack/desk-db-engine-runner
USER bun
ENV NODE_ENV=production
ENTRYPOINT ["bun", "main.ts"]
