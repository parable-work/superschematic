# The build stage links the binary against Debian's glibc, and the image runs
# it on distroless cc, which holds the glibc and libgcc it needs and nothing
# else, as a non-root user.

ARG GO_VERSION=1.27.3
ARG RUST_VERSION=1.99.0

FROM rust:${RUST_VERSION}-trixie AS superscalar
WORKDIR /superscalar
COPY third_party/superscalar/Cargo.toml third_party/superscalar/Cargo.lock ./
COPY third_party/superscalar/crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --locked --release -p superscalar-ffi \
    && cp target/release/libsuperscalar_ffi.a /libsuperscalar_ffi.a

