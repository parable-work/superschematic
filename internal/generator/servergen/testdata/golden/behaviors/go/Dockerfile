# Code generated by superschematic. DO NOT EDIT.
#
# The image of server workflow of stack workflow-stack (docs/stack-model.md,
# section 8.2). The build context is the repository root, the parent of the
# schemas root, or the directory the naming file's [paths] build_context
# names. Build the stack's services first (superschematic build-all), so
# that every module the server's go.mod replaces is on disk, then run, from
# the build context:
#
#   docker build -f schemas/dist/server/workflow-stack/workflow/Dockerfile .
#
# Dockerfile.dockerignore beside this file cuts the context down to the
# directories the build reads; BuildKit, Docker's default builder, reads it.
#
# The generated code links superscalar's static archive through cgo (D3 in
# docs/DECISIONS.md), so the server cannot build with CGO_ENABLED=0. The
# superscalar stage builds the archive for the image's platform from the
# checkout the naming file's [paths] scalar_go names, with the Rust release
# that tools.env pins for the host's archives.
# The rules stage does the same for the behaviors' core's archive (D103),
# which the ORM of a database whose tables' fields are behaviors links: the
# staticlib of the rules-wasm crate, from the engine's Cargo workspace,
# with the crates it reaches by path at their places in the checkout.
# The build stage links the binary against Debian's glibc, and the image runs
# it on distroless cc, which holds the glibc and libgcc it needs and nothing
# else, as a non-root user.

ARG GO_VERSION=1.27.3
ARG RUST_VERSION=1.99.0

FROM rust:${RUST_VERSION}-trixie AS superscalar
WORKDIR /superscalar
COPY third_party/superscalar/Cargo.toml third_party/superscalar/Cargo.lock ./
COPY third_party/superscalar/crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --locked --release -p superscalar-ffi \
    && cp target/release/libsuperscalar_ffi.a /libsuperscalar_ffi.a

FROM rust:${RUST_VERSION}-trixie AS rules
WORKDIR /src
COPY runtime/engine/rust runtime/engine/rust
COPY runtime/engine-workqueue/rust runtime/engine-workqueue/rust
COPY runtime/engine-commerce/rust runtime/engine-commerce/rust
COPY runtime/schema/rust-ir runtime/schema/rust-ir
COPY runtime/schema/rust runtime/schema/rust
COPY runtime/versiongraph/rust-engine runtime/versiongraph/rust-engine
COPY runtime/versiongraph/rust runtime/versiongraph/rust
COPY third_party/superscalar/Cargo.toml third_party/superscalar/Cargo.toml
COPY third_party/superscalar/crates third_party/superscalar/crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --locked --release --manifest-path runtime/engine/rust/rules-wasm/Cargo.toml \
    && cp runtime/engine/rust/target/release/libsuperschematic_rules_wasm.a /libsuperschematic_rules.a

FROM golang:${GO_VERSION}-trixie AS build
ENV GOTOOLCHAIN=local CGO_ENABLED=1
WORKDIR /src
COPY . .
COPY --from=superscalar /libsuperscalar_ffi.a /archives/
COPY --from=rules /libsuperschematic_rules.a /archives/
RUN lib="third_party/superscalar/go/lib/linux_$(go env GOARCH)" \
    && mkdir -p "$lib" && cp /archives/libsuperscalar_ffi.a "$lib/"
RUN lib="runtime/rules/go/lib/linux_$(go env GOARCH)" \
    && mkdir -p "$lib" && cp /archives/libsuperschematic_rules.a "$lib/"
WORKDIR /src/schemas/dist/server/workflow-stack/workflow
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -mod=mod -trimpath -o /out/server .

FROM gcr.io/distroless/cc-debian13:nonroot
COPY --from=build /out/server /server
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/server"]
