# Code generated by superschematic. DO NOT EDIT.
#
# The image of server shop-api of stack shop-stack (docs/stack-model.md,
# section 8.2). The build context is the repository root, the parent of the
# schemas root, or the directory the naming file's [paths] build_context
# names. Build the stack's services first (superschematic build-all), so
# that every module the server's go.mod replaces is on disk, then run, from
# the build context:
#
#   docker build -f schemas/dist/server/shop-stack/shop-api/Dockerfile .
#
# Dockerfile.dockerignore beside this file cuts the context down to the
# directories the build reads; BuildKit, Docker's default builder, reads it.
#
# The generated code links superscalar's static archive, and the version
# graph's, through cgo (D3 in docs/DECISIONS.md), so the server cannot build
# with CGO_ENABLED=0, and no module the module proxy serves carries them.
# superschematic 1.2.3, which wrote this file, ships both for each
# platform beside its binaries, built with one Rust release so that they
# link into one binary. The build stage downloads the ones for the image's
# platform from SUPERSCHEMATIC_RELEASE, the release's page unless a build
# argument names a mirror, checks them against the digests below and
# points cgo's linker at them.
# The build stage links the binary against Debian's glibc, and the image runs
# it on distroless cc, which holds the glibc and libgcc it needs and nothing
# else, as a non-root user.

ARG GO_VERSION=1.26.4

FROM golang:${GO_VERSION}-trixie AS build
ENV GOTOOLCHAIN=local CGO_ENABLED=1
ARG SUPERSCHEMATIC_RELEASE=https://github.com/parable-work/superschematic/releases/download/v1.2.3
RUN case "$(go env GOARCH)" in \
      amd64) archive=superschematic-archives_1.2.3_linux-x64.tar.gz sum=4444444444444444444444444444444444444444444444444444444444444444 ;; \
      arm64) archive=superschematic-archives_1.2.3_linux-arm64.tar.gz sum=3333333333333333333333333333333333333333333333333333333333333333 ;; \
      *) echo "superschematic 1.2.3 ships no static archives for linux/$(go env GOARCH)" >&2; exit 1 ;; \
    esac \
    && curl -fsSL -o /tmp/archives.tar.gz "$SUPERSCHEMATIC_RELEASE/$archive" \
    && echo "$sum  /tmp/archives.tar.gz" | sha256sum --check - \
    && mkdir /archives \
    && tar -xzf /tmp/archives.tar.gz -C /archives --strip-components=1 \
    && rm /tmp/archives.tar.gz
ENV CGO_LDFLAGS=-L/archives/lib
WORKDIR /src
COPY . .
WORKDIR /src/schemas/dist/server/shop-stack/shop-api
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -mod=mod -trimpath -o /out/server .

FROM gcr.io/distroless/cc-debian13:nonroot
COPY --from=build /out/server /server
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/server"]
