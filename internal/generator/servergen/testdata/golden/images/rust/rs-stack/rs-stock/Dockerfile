# The image of server rs-stock of stack rs-stack, a Rust server (docs/stack-model.md,
# sections 8.2 and 8.6). The build context is the repository root, the
# parent of the schemas root, or the directory the naming file's [paths]
# build_context names. Build the stack's services first (superschematic
# build-all), which writes every crate of the output root's Cargo
# workspace and brings its lockfile, schemas/dist/Cargo.lock, up to date,
# and commit the lockfile; then run, from the build context:
#
#   docker build -f schemas/dist/server/rs-stack/rs-stock/Dockerfile .
#
# Dockerfile.dockerignore beside this file cuts the context down to what the
# image reads: the workspace's root and lockfile, the manifest and sources
# of every generated crate a member of the workspace reaches by path, the
# mirrors of the implementations under schemas/dist/impl, which the build
# copies there (D65), and the checkouts of the HTTP runtime, the schema
# runtime and superscalar the crates depend on: no implementation's own
# directory. BuildKit, Docker's default builder, reads it.
#
# The build stage builds the server with the Rust release tools.env pins,
# frozen to the lockfile: cargo build --release --locked fails when the
# lockfile does not match the crates the build wrote, and the stage fails
# first when the context holds none. A deploy's context gives every file one
# fixed time, and Cargo takes a path crate whose files are no newer than
# its last build as built, so the stage touches the context's files first:
# the target cache every Rust image's build shares keeps the registry's
# crates compiled, and the generated crates, the mirrors and the runtimes
# are compiled from this context. The image runs the binary on distroless
# cc, which holds the glibc, libgcc and OpenSSL it links and nothing else,
# as a non-root user.
#
# The stack adds Debian packages to the image (D144), and distroless has no
# apt-get to install one with, so the image runs the binary on the slim
# image of the Debian release the build stage links it against, with what
# distroless cc held beside glibc, the CA certificates, OpenSSL and the
# time zones, as the same non-root user:
#
#   poppler-utils
#
# The stack extends the image with a Dockerfile of the project's (D144),
# which the context holds, with the directory beside it. A deploy builds
# this file, then that one with the build argument BASE naming the image
# this one built, and deploys the result:
#
#   docker build -f docker/stock.Dockerfile --build-arg BASE=<the image this file built> .

ARG RUST_VERSION=1.99.0

FROM rust:${RUST_VERSION}-trixie AS build
WORKDIR /src
COPY . .
WORKDIR /src/schemas/dist/server/rs-stack/rs-stock
# The cargo registry's cache mount is locked: cargo locks its package cache
# in CARGO_HOME, outside the mount, so two stages that build at once would
# unpack one crate into it together.
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/target \
    if [ ! -f /src/schemas/dist/Cargo.lock ]; then \
      echo "schemas/dist/Cargo.lock is not in the context: build every service (superschematic build-all), which writes it, and commit it" >&2; exit 1; fi \
    && find /src -type f -exec touch {} + \
    && cargo build --release --locked --target-dir /target \
    && mkdir /out && cp /target/release/rs-stock /out/rs-stock

FROM debian:trixie-slim
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      openssl \
      poppler-utils \
      tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 nonroot \
    && useradd --uid 65532 --gid 65532 --create-home nonroot
COPY --from=build /out/rs-stock /rs-stock
USER nonroot
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/rs-stock"]
