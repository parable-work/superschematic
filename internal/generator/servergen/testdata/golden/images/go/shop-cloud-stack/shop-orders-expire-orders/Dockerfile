ARG GO_VERSION=1.27.3
ARG RUST_VERSION=1.99.0

FROM rust:${RUST_VERSION}-trixie AS superscalar
WORKDIR /superscalar
COPY third_party/superscalar/Cargo.toml third_party/superscalar/Cargo.lock ./
COPY third_party/superscalar/crates ./crates
# The cargo registry's cache mount is locked: cargo locks its package cache
# in CARGO_HOME, outside the mount, so two stages that build at once would
# unpack one crate into it together.
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    cargo build --locked --release -p superscalar-ffi \
    && cp target/release/libsuperscalar_ffi.a /libsuperscalar_ffi.a

FROM golang:${GO_VERSION}-trixie AS build
ENV GOTOOLCHAIN=local CGO_ENABLED=1
WORKDIR /src
COPY . .
COPY --from=superscalar /libsuperscalar_ffi.a /archives/
RUN lib="third_party/superscalar/go/lib/linux_$(go env GOARCH)" \
    && mkdir -p "$lib" && cp /archives/libsuperscalar_ffi.a "$lib/"
WORKDIR /src/schemas/dist/server/shop-cloud-stack/shop-orders-expire-orders
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -mod=mod -trimpath -o /out/job .

FROM debian:trixie-slim
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      openssl \
      poppler-utils \
      tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 nonroot \
    && useradd --uid 65532 --gid 65532 --create-home nonroot
COPY --from=build /out/job /job
USER nonroot
WORKDIR /home/nonroot
ENTRYPOINT ["/job"]
