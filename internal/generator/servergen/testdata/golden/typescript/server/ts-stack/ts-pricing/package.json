{
  "name": "@schemas/ts-stack-ts-pricing-server",
  "version": "0.0.0",
  "description": "Server ts-pricing of stack ts-stack, which superschematic writes on every build of the stack. DO NOT EDIT.",
  "private": true,
  "type": "module",
  "main": "main.ts",
  "scripts": {
    "start": "bun main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@schemas/ts-pricing-api": "workspace:*",
    "@schemas/ts-pricing-implementation": "workspace:*",
    "@superschematic/http-runtime": "*",
    "hono": "4.13.8"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "typescript": "5.9.3"
  }
}
