# The image of server ts-pricing of stack ts-cloud-stack, a TypeScript server that
# Bun runs (docs/stack-model.md, sections 8.2 and 8.6). The build context is
# the repository root, the parent of the schemas root, or the directory the
# naming file's [paths] build_context names. Build the stack's services
# first (superschematic build-all), so that every package of the output
# root's Bun workspace is on disk beside its lockfile, which bun install in
# schemas/dist writes, as stack dev runs it, and the project commits;
# then run, from the build context:
#
#   docker build -f schemas/dist/server/ts-cloud-stack/ts-pricing/Dockerfile .
#
# Dockerfile.dockerignore beside this file cuts the context down to what the
# image reads: every workspace package the server imports, whole, the
# manifest of every other one, the checkouts of superscalar and the HTTP
# runtime the workspace's root overrides their packages with, and the
# superscalar crates. BuildKit, Docker's default builder, reads it.
#
# The generated packages validate scalars through superscalar's Node addon,
# which no published package ships yet. The addon stage builds it for the
# image's platform from the superscalar checkout the naming file's [paths]
# scalar_typescript names, with the Rust release tools.env pins, against
# the glibc of the Debian release the Bun image runs on. The build stage puts
# it where superscalar's binding looks for it, builds the binding's and the
# HTTP runtime's dist/, which a checkout does not hold and which their
# packages export, and installs the workspace without its development
# packages: frozen to the lockfile, which fails when the lockfile does not
# match the packages the build wrote. A context without the lockfile, as in
# a project that has not committed it, resolves afresh and says so: two
# images of one commit may then differ. The generated CI's check refuses a
# missing or stale lockfile before any deploy. The image runs main.ts on the
# Bun release tools.env pins, as a non-root user.

ARG RUST_VERSION=1.99.0
ARG BUN_VERSION=1.4.0

FROM rust:${RUST_VERSION}-trixie AS addon
WORKDIR /superscalar
COPY third_party/superscalar/Cargo.toml third_party/superscalar/Cargo.lock ./
COPY third_party/superscalar/crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --locked --release -p superscalar-napi \
    && case "$(uname -m)" in \
      x86_64) triple=linux-x64-gnu ;; \
      aarch64) triple=linux-arm64-gnu ;; \
      *) echo "superscalar builds no Node addon for linux/$(uname -m)" >&2; exit 1 ;; \
    esac \
    && mkdir /native \
    && cp target/release/libsuperscalar_napi.so "/native/superscalar-napi.$triple.node"

FROM oven/bun:${BUN_VERSION} AS build
WORKDIR /src
COPY . .
COPY --from=addon /native/ third_party/superscalar/bindings/typescript/native/
RUN --mount=type=cache,target=/root/.bun/install/cache \
    cd third_party/superscalar/bindings/typescript \
    && bun install --frozen-lockfile \
    && bunx tsc -p tsconfig.json \
    && bunx tsc -p tsconfig.esm.json \
    && bun scripts/fix-esm-extensions.mjs
RUN --mount=type=cache,target=/root/.bun/install/cache \
    cd runtime/http/typescript \
    && bun install --frozen-lockfile \
    && ln -sfn ../../../../third_party/superscalar/bindings/typescript node_modules/superscalar \
    && bunx tsc -p tsconfig.json
WORKDIR /src/schemas/dist
RUN --mount=type=cache,target=/root/.bun/install/cache \
    if [ -f bun.lock ]; then frozen=--frozen-lockfile; else frozen=; \
      echo "schemas/dist/bun.lock is not in the context: resolving the workspace afresh; commit it to pin these packages" >&2; fi \
    && bun install --production $frozen

FROM oven/bun:${BUN_VERSION}
COPY --from=build /src/schemas/dist /src/schemas/dist
COPY --from=build /src/typescript/ts-pricing /src/typescript/ts-pricing
WORKDIR /src/schemas/dist/server/ts-cloud-stack/ts-pricing
USER bun
ENV PORT=8080 NODE_ENV=production
EXPOSE 8080
ENTRYPOINT ["bun", "main.ts"]
