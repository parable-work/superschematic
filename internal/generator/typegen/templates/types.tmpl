// To{{.OutputName}} converts the input type to its matching output type.
func (in *{{.InputName}}) To{{.OutputName}}() *{{.OutputName}} {
	if in == nil {
		return nil
	}
	out := &{{.OutputName}}{}
{{- range .Fields}}
{{- if .UsesWrapper}}
	if in.{{.GoName}}.IsSet() && !in.{{.GoName}}.IsNull() {
{{- if .IsPaired}}
{{- if .IsArrayOfArrays}}
		converted := make([][]{{.PairedTypeName}}, len(in.{{.GoName}}.Value))
		for i, inner := range in.{{.GoName}}.Value {
			if inner == nil {
				continue
			}
			converted[i] = make([]{{.PairedTypeName}}, len(inner))
			for j, v := range inner {
				if c := v.To{{.PairedTypeName}}(); c != nil {
					converted[i][j] = *c
				}
			}
		}
		out.{{.GoName}} = converted
{{- else if .IsArray}}
		converted := make([]{{.PairedTypeName}}, len(in.{{.GoName}}.Value))
		for i, v := range in.{{.GoName}}.Value {
			if c := v.To{{.PairedTypeName}}(); c != nil {
				converted[i] = *c
			}
		}
		out.{{.GoName}} = converted
{{- else if .IsMap}}
		converted := make({{.GoType}}, len(in.{{.GoName}}.Value))
		for key, v := range in.{{.GoName}}.Value {
{{- template "pairedMapEntry" .}}
		}
		out.{{.GoName}} = converted
{{- else}}
		out.{{.GoName}} = in.{{.GoName}}.Value.To{{.PairedTypeName}}()
{{- end}}
{{- else if and .IsScalar (hasPrefix .GoType "*")}}
		out.{{.GoName}} = &in.{{.GoName}}.Value
{{- else}}
		out.{{.GoName}} = in.{{.GoName}}.Value
{{- end}}
	}
{{- else if .IsPaired}}
{{- if .IsArrayOfArrays}}
	if len(in.{{.GoName}}) > 0 {
		converted := make([][]{{.PairedTypeName}}, len(in.{{.GoName}}))
		for i, inner := range in.{{.GoName}} {
			if inner == nil {
				continue
			}
			converted[i] = make([]{{.PairedTypeName}}, len(inner))
			for j, v := range inner {
				if c := v.To{{.PairedTypeName}}(); c != nil {
					converted[i][j] = *c
				}
			}
		}
		out.{{.GoName}} = converted
	}
{{- else if .IsArray}}
	if len(in.{{.GoName}}) > 0 {
		converted := make([]{{.PairedTypeName}}, len(in.{{.GoName}}))
		for i, v := range in.{{.GoName}} {
			if c := v.To{{.PairedTypeName}}(); c != nil {
				converted[i] = *c
			}
		}
		out.{{.GoName}} = converted
	}
{{- else if .IsMap}}
	if in.{{.GoName}} != nil {
		converted := make({{.GoType}}, len(in.{{.GoName}}))
		for key, v := range in.{{.GoName}} {
{{- template "pairedMapEntry" .}}
		}
		out.{{.GoName}} = converted
	}
{{- else}}
	if c := in.{{.GoName}}.To{{.PairedTypeName}}(); c != nil {
		out.{{.GoName}} = *c
	}
{{- end}}
{{- else}}
	out.{{.GoName}} = in.{{.GoName}}
{{- end}}
{{- end}}
	return out
}
