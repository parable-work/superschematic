# The implementation of the {{ .SchemaName }} API (D57).
#
# superschematic wrote this crate once, as a scaffold, because it was
# missing, and never writes it again: it is yours, and so is its name. Each
# build of a stack copies it into the output root's impl/{{ .SchemaName }}, with
# its path dependencies re-based there, and the stack's server entrypoint
# depends on that copy and calls its `create`.
[package]
name = "{{ .Crate }}"
version = "0.1.0"
edition = "2021"
rust-version = "1.99.0"
publish = false

# The generated API crate, and the HTTP runtime it is built on.
[dependencies]
async-trait = "0.1.89"
{{- if .ManualEndpoints }}
axum = "0.8.9"
{{- end }}
{{- if .ChecksEndUsers }}
http = "1"
{{- end }}
{{ .CrateName }} = { path = "{{ .APIPath }}" }
{{ .RuntimeCrate }} = { path = "{{ .RuntimePath }}" }
{{- if .Definitions }}

# The definitions of the channels and keys of each memory store the API
# lists (D75).
{{- range .Definitions }}
{{ .Crate }} = { path = "{{ .Path }}" }
{{- end }}
{{- end }}

# Its own workspace, so no Cargo.toml above this directory claims it.
[workspace]
