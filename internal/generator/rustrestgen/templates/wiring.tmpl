/// The runtime parts of the API's database, as the implementation's `Wire`
/// shaped them.
#[derive(Clone)]
pub struct Wired {
    /// The database's tables, which each part runs over.
    pub tables: Tables,
{{- if $w.Notifier }}
    pub notifier: Notifier,
{{- end }}
{{- if $w.Agents }}
    pub agents: Agents,
{{- end }}
{{- if $w.Inbound }}
    pub inbound: Inbound,
{{- end }}
{{- if $w.Search }}
    pub search: SearchOptions,
{{- end }}
{{- if $w.Calendar }}
    pub calendar: CalendarOptions,
{{- end }}
{{- if .WiringAuthenticates }}
    /// The implementation's `Wire`, which `handlers` asks for the
    /// authenticator; a wiring that wraps none has no use for it.
    wire: Arc<dyn Wire>,
{{- end }}
}

impl Wired {
{{- if or $w.Agents $w.Notifier }}
    /// Builds the parts over `deps`, each handed to `wire` in turn: the
    /// dispatcher first, whose reply actions and queue the notifier takes,
    /// then the notifier, which the inbound path takes, then the inbound
    /// path, which takes the dispatcher's send approval; the dispatcher is
    /// given the notifier and the inbound path last.
{{- else }}
    /// Builds the parts over `deps`, each handed to `wire`.
{{- end }}
    pub fn new(deps: &WiringDeps, wire: Arc<dyn Wire>) -> Result<Self, BoxError> {
        let tables = {{ databaseTypesModule }}::orm::postgres::tables(deps.db.clone()){{ if .TableFieldKeys }}
            .with_keys(crate::tables::field_keys(&deps.config)?){{ end }};
{{- if $w.Agents }}
        let requests = QueueDefinition::parse({{ databaseTypesModule }}::queues::{{ $w.RequestsConst }})?;
        let agents = Agents::new(tables.clone(), requests.clone(), &wire.agent_endpoint())?{{ if .Providers }}
            .with_providers(Arc::clone(&deps.providers)){{ end }};
        let agents = wire.agents(agents)?;
{{- end }}
{{- if $w.Notifier }}
        let dispatch = QueueDefinition::parse({{ databaseTypesModule }}::queues::{{ $w.DispatchConst }})?;
{{- if $w.Agents }}
{{- if .Providers }}
        let mut notifier = Notifier::new(tables.clone(), dispatch)?
            .with_providers(Arc::clone(&deps.providers))
            .with_agents(requests);
{{- else }}
        let mut notifier = Notifier::new(tables.clone(), dispatch)?.with_agents(requests);
{{- end }}
        // An approval's request is decided by a reply of approve or deny.
        for (verb, action) in agents.reply_actions() {
            notifier = notifier.with_reply("approval.requested", verb, action);
        }
{{- else }}
        let notifier = Notifier::new(tables.clone(), dispatch)?{{ if .Providers }}
            .with_providers(Arc::clone(&deps.providers)){{ end }};
{{- end }}
        let notifier = wire.notifier(notifier)?;
{{- end }}
{{- if $w.Inbound }}
        let runs = QueueDefinition::parse({{ databaseTypesModule }}::queues::{{ $w.RunRequestsConst }})?;
        let inbound = Inbound::new(tables.clone(), notifier.clone(), runs)?{{ if .Providers }}
            .with_providers(Arc::clone(&deps.providers)){{ end }}{{ if $w.Agents }}
            .with_approval(agents.send_approval()){{ end }};
        let inbound = wire.inbound(inbound)?;
{{- end }}
{{- if $w.Agents }}
{{- if $w.Notifier }}
        agents.set_notifier(notifier.clone());
{{- end }}
{{- if $w.Inbound }}
        agents.set_inbound(inbound.clone());
{{- end }}
{{- end }}
{{- if not (or $w.Agents $w.Notifier $w.Inbound $w.Search $w.Calendar .WiringAuthenticates) }}
        // No part asks `wire` for anything, nor does `handlers`.
        let _ = wire;
{{- end }}
        Ok(Self {
            tables,
{{- if $w.Notifier }}
            notifier,
{{- end }}
{{- if $w.Agents }}
            agents,
{{- end }}
{{- if $w.Inbound }}
            inbound,
{{- end }}
{{- if $w.Search }}
            search: wire.search(),
{{- end }}
{{- if $w.Calendar }}
            calendar: wire.calendar(),
{{- end }}
{{- if .WiringAuthenticates }}
            wire,
{{- end }}
        })
    }
{{- if .WiringAuthenticates }}

    /// `handlers` with its authenticator wrapped as `Wire::authenticator`
    /// answers: by default inside the grants' authenticator, so a request
    /// whose bearer is a grant's token runs as the grant's holder (D156),
    /// and inside the access log, which records each call, as the database
    /// has either.
    pub fn handlers(&self, handlers: Handlers) -> Result<Handlers, BoxError> {
        let implementation = handlers.authenticator;
{{- if $w.Grants }}
        let grants = GrantAuthenticator::new(self.tables.clone())?;
        let wired: Arc<dyn Authenticator> =
            Arc::new(grants.with_inner(Arc::clone(&implementation)));
{{- else }}
        let wired = Arc::clone(&implementation);
{{- end }}
{{- if $w.AccessLog }}
        let wired: Arc<dyn Authenticator> = match access_log_of(&self.tables)? {
            Some(log) => Arc::new(Logged::new(wired, Arc::new(log))),
            None => wired,
        };
{{- end }}
        Ok(Handlers {
            authenticator: self.wire.authenticator(wired, implementation),
{{- if gt (len .HandlersFields) 1 }}
            ..handlers
{{- end }}
        })
    }
{{- end }}

    /// The parts' routes, a router the server merges beside the API's,
    /// which establish their callers as `implementations`' routes do.
    pub fn routes(&self, implementations: &Implementations) -> Router {
{{- if eq .RoutesAuthenticator "None" }}
        let _ = implementations;
        let authenticator: Option<Arc<dyn Authenticator>> = None;
{{- else }}
        let authenticator: Option<Arc<dyn Authenticator>> =
            {{ .RoutesAuthenticator }};
{{- end }}
        let router = Router::new();
{{- if $w.Agents }}
        // The agent routes a run's sandbox instance calls, and with a caller
        // an approval's approve and deny.
        let router = router.merge(self.agents.routes(authenticator.clone()));
{{- end }}
{{- if $w.Notifier }}
        // The inbox, with a caller, and the relays' routes.
        let router = router.merge(self.notifier.routes(NotifierRoutes {
            authenticator: authenticator.clone(),
{{- if $w.Inbound }}
            inbound: Some(self.inbound.clone()),
{{- end }}
            ..NotifierRoutes::default()
        }));
{{- end }}
{{- if $w.Calendar }}
        // The calendar and its feeds, with a caller.
        let router = match &authenticator {
            Some(authenticator) => router.merge(calendar_routes(CalendarRoutes {
                options: self.calendar.clone(),
                ..CalendarRoutes::new(self.tables.clone(), Arc::clone(authenticator))
            })),
            None => router,
        };
{{- end }}
{{- if $w.Search }}
        // The search, with a caller.
        let router = match &authenticator {
            Some(authenticator) => router.merge(search_routes(SearchRoutes {
                options: self.search.clone(),
                ..SearchRoutes::new(self.tables.clone(), Arc::clone(authenticator))
            })),
            None => router,
        };
{{- end }}
        let _ = authenticator;
        router
    }
{{- if $w.Agents }}

    /// The call gate of the API's MCP endpoint (D183, D193): a call an agent
    /// run makes with its token is held to the run's autonomy.
    pub fn mcp_gate(&self) -> Arc<dyn CallGate> {
        self.agents.mcp_gate()
    }
{{- end }}
{{- if or $w.Search $w.Calendar }}

    /// The tools of the API's MCP endpoint beside its routes' (#617):
    /// {{ if $w.Calendar }}`calendar`{{ if $w.Search }} and {{ end }}{{ end }}{{ if $w.Search }}`search`{{ end }}, each run as the endpoint's caller.
    pub fn mcp_tools(&self) -> Vec<Arc<dyn EndpointTool>> {
{{- if and $w.Calendar $w.Search }}
        vec![
            Arc::new(CalendarTool {
                tables: self.tables.clone(),
                options: self.calendar.clone(),
            }),
            Arc::new(SearchTool {
                tables: self.tables.clone(),
                options: self.search.clone(),
            }),
        ]
{{- else if $w.Calendar }}
        vec![Arc::new(CalendarTool {
            tables: self.tables.clone(),
            options: self.calendar.clone(),
        })]
{{- else }}
        vec![Arc::new(SearchTool {
            tables: self.tables.clone(),
            options: self.search.clone(),
        })]
{{- end }}
    }
{{- end }}
{{- range .RuntimeWorkers }}
{{- if eq .Runtime "notifier" }}

    /// Runs the worker {{ .Name }} of the queue {{ .Queue }}: the notifier routes,
    /// delivers, escalates or batches each message (`Notifier::handle`), and
    /// a prune deletes the deliveries past their retention.
    pub async fn {{ .RunFunc }}(
        &self,
        options: Options,
        shutdown: Shutdown,
    ) -> Result<(), QueueError> {
        let notifier = self.notifier.clone();
        let handle = move |message| {
            let notifier = notifier.clone();
            async move { notifier.handle(message).await.map_err(BoxError::from) }
        };
        run_worker(self.notifier.worker_queue(), handle, options, shutdown).await
    }
{{- else if eq .Runtime "agents" }}

    /// Runs the worker {{ .Name }} of the queue {{ .Queue }}: the agent
    /// dispatcher starts, watches or follows up each run (`Agents::handle`),
    /// and a prune deletes the transcripts past their retention.
    pub async fn {{ .RunFunc }}(
        &self,
        options: Options,
        shutdown: Shutdown,
    ) -> Result<(), QueueError> {
        let agents = self.agents.clone();
        let handle = move |message| {
            let agents = agents.clone();
            async move { agents.handle(message).await.map_err(BoxError::from) }
        };
        run_worker(self.agents.dispatch_queue(), handle, options, shutdown).await
    }
{{- else if eq .Runtime "runs" }}

    /// Runs the worker {{ .Name }} of the queue {{ .Queue }}: the agent
    /// dispatcher starts the run an inbound message asks for
    /// (`Agents::handle`).
    pub async fn {{ .RunFunc }}(
        &self,
        options: Options,
        shutdown: Shutdown,
    ) -> Result<(), QueueError> {
        let agents = self.agents.clone();
        let handle = move |message: RunRequest| {
            let agents = agents.clone();
            let request = AgentRunRequest::from(message);
            async move { agents.handle(request).await.map_err(BoxError::from) }
        };
        run_worker(self.inbound.run_queue(), handle, options, shutdown).await
    }
{{- else }}

    /// Runs the worker {{ .Name }} of the queue {{ .Queue }}: each row it names
    /// is indexed again, or its index row removed (`index_search`).
    pub async fn {{ .RunFunc }}(
        &self,
        options: Options,
        shutdown: Shutdown,
    ) -> Result<(), QueueError> {
        let definition = QueueDefinition::parse({{ databaseTypesModule }}::queues::{{ .QueueConst }})?;
        let queue = PostgresQueue::<SearchIndexing>::new(self.tables.pool().clone(), definition);
        let (tables, search) = (self.tables.clone(), self.search.clone());
        let handle = move |message: SearchIndexing| {
            let (tables, search) = (tables.clone(), search.clone());
            async move {
                let definition = tables.definition()?;
                let mut client = tables.pool().get().await?;
                index_search(&mut client, definition, &message, &search).await?;
                Ok::<(), BoxError>(())
            }
        };
        run_worker(queue, handle, options, shutdown).await
    }
{{- end }}
{{- end }}
