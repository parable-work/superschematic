/// The server's own agent routes, on the loopback address and $PORT, 8080
/// when unset: what a sandbox on the server's host reaches.
pub fn default_agent_endpoint() -> String {
    let port = std::env::var("PORT")
        .ok()
        .filter(|port| !port.is_empty())
        .unwrap_or_else(|| "8080".to_owned());
    format!("http://127.0.0.1:{port}/api/agents")
}
