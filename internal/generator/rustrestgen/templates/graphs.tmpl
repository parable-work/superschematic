    {{ $set.Fn }}_commit(graphs, root, &to_commit).await?;
    let actor = actor(principal.as_ref())?;
    let reverted = graphs.{{ $set.Field }}.revert(&actor, &row.id, body.version, &to_commit).await.map_err(refused)?;
    graph_routes::recode(commit_result(&reverted))
{{- else if eq $op "discard" }}
    let row = {{ $set.Fn }}_ref(graphs, principal.as_ref(), root, &args.{{ $g.RefField }}, true).await?;
    // A primary line is never discarded: the next branch would make it
    // again, empty.
    if row.parent_ref_id.is_none() {
        return Err(graph_routes::primary_not_discarded());
    }
    let actor = actor(principal.as_ref())?;
    graphs.{{ $set.Field }}.discard(&actor, &row.id, body.version).await.map_err(refused)?;
    Ok(true)
{{- else if eq $op "history" }}
    let row = {{ $set.Fn }}_ref(graphs, principal.as_ref(), root, &args.{{ $g.RefField }}, false).await?;
    let commits = graphs.{{ $set.Field }}.history(&row.id).await.map_err(refused)?;
    graph_routes::recode(Value::Array(commits.iter().map(commit_view).collect()))
{{- else if eq $op "compose" }}
    let row = {{ $set.Fn }}_ref(graphs, principal.as_ref(), root, &args.{{ $g.RefField }}, false).await?;
    let tree = graphs.{{ $set.Field }}.compose(&row.id).await.map_err(refused)?;
    graph_routes::recode({{ $set.Fn }}_tree(set, &tree))
{{- else if eq $op "release" }}
    let commit: types::IdentityUUID = parse("a commit", &body.commit)?;
    {{ $set.Fn }}_commit(graphs, root, &commit).await?;
    let actor = actor(principal.as_ref())?;
    let release = graphs.{{ $set.Field }}.release(&actor, root, &commit, body.version).await.map_err(refused)?;
    graph_routes::recode(release_view(&release))
{{- else if eq $op "released" }}
    let _ = &principal;
    let released = graphs.{{ $set.Field }}.released(root).await.map_err(refused)?;
    graph_routes::recode(json!({ "release": release_view(&released.release), "tree": {{ $set.Fn }}_tree(set, &released.tree) }))
{{- else if eq $op "materialize" }}
    let _ = &principal;
    {{ $set.Fn }}_commit(graphs, root, &args.{{ $g.CommitField }}).await?;
    let tree = graphs.{{ $set.Field }}.materialize(&args.{{ $g.CommitField }}).await.map_err(refused)?;
    graph_routes::recode({{ $set.Fn }}_tree(set, &tree))
{{- else if eq $op "diff" }}
    let _ = &principal;
    {{ $set.Fn }}_commit(graphs, root, &args.{{ $g.FromField }}).await?;
    {{ $set.Fn }}_commit(graphs, root, &args.{{ $g.ToField }}).await?;
    let changes = graphs.{{ $set.Field }}.diff(&args.{{ $g.FromField }}, &args.{{ $g.ToField }}).await.map_err(refused)?;
    let changes: Vec<Value> = changes
        .iter()
        .map(|change| {
            json!({
                "kind": value_of(&change.kind),
                "entityKey": value_of(&change.entity_key),
                "operation": value_of(&change.operation),
                "row": graph_routes::json_text(change.row.as_ref()),
            })
        })
        .collect();
    graph_routes::recode(Value::Array(changes))
{{- else if eq $op "entityHistory" }}
    let _ = &principal;
    if set.kind(&args.{{ $g.KindField }}).is_none() {
        return Err(graph_routes::not_found(format!("the {} graph has no kind {}", set.graph, args.{{ $g.KindField }})));
    }
    let kind: database_types::{{ $g.Graph }}EntityKind = parse("a kind", &args.{{ $g.KindField }})?;
    let changes = graphs.{{ $set.Field }}.entity_history(root, &kind, &args.{{ $g.KeyField }}).await.map_err(refused)?;
    let changes: Vec<Value> = changes
        .iter()
        .map(|change| json!({ "commit": commit_view(&change.commit), "operation": value_of(&change.operation) }))
        .collect();
    graph_routes::recode(Value::Array(changes))
{{- end }}
}
{{- end }}
