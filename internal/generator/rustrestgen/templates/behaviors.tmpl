/// result that does not read are logged and answered as the server's
/// internal error, as the Go and TypeScript servers answer them.
pub(crate) async fn run_operation<K, P, R>(
    behaviors: &Behaviors,
    ctx: &RequestContext,
    type_name: &str,
    key: &K,
    use_id: &str,
    operation: &str,
    params: &P,
) -> Result<R, ApiError>
where
    K: Serialize + ?Sized,
    P: Serialize + ?Sized,
    R: DeserializeOwned,
{
