/// An event a message of an event queue holds (D104): the use that emitted
/// it, its kind, its row's key in its wire form, and the event a Workers
/// method takes, `{ key, at, payload }`: the row's key, the time of the
/// command that emitted it in epoch milliseconds, and what it says.
struct EventMessage {
    use_id: String,
    kind: String,
    key: String,
    event: Value,
}

fn event_of<M: Serialize>(message: &M) -> Result<EventMessage, BoxError> {
    let Value::Object(mut fields) = serde_json::to_value(message)? else {
        return Err("an event's message is no object".into());
    };
    let mut text = |name: &str| -> Result<String, BoxError> {
        match fields.remove(name) {
            Some(Value::String(text)) => Ok(text),
            Some(other) if !other.is_null() => Ok(other.to_string()),
            _ => Err(format!("an event's message has no {name}").into()),
        }
    };
    let (use_id, kind) = (text("useId")?, text("kind")?);
    let row_key = fields
        .remove("rowKey")
        .filter(|key| !key.is_null())
        .ok_or("an event's message has no rowKey")?;
    let at = fields
        .remove("at")
        .filter(Value::is_number)
        .ok_or("an event's message has no at")?;
    let key = match &row_key {
        Value::String(key) => key.clone(),
        other => other.to_string(),
    };
    let mut event = Map::new();
    event.insert("key".to_owned(), row_key);
    event.insert("at".to_owned(), at);
    event.insert(
        "payload".to_owned(),
        fields.remove("payload").unwrap_or(Value::Null),
    );
    Ok(EventMessage {
        use_id,
        kind,
        key,
        event: Value::Object(event),
    })
}
{{- end }}
