[package]
name = "{{ .CrateName }}"
version = "0.1.0"
edition = "2021"
rust-version = "1.99.0"
{{- if .Identity }}

# The identity store's SQL client (D50): a service turns one on, or binds a
# client of its own (`runtime::identity::Client`).
[features]
identity-postgres = ["{{ .RuntimeCrate }}/identity-postgres"]
identity-sqlite = ["{{ .RuntimeCrate }}/identity-sqlite"]
{{- end }}

[dependencies]
async-trait = "0.1.89"
axum = { version = "0.8.9", features = ["json", "matched-path"] }
http = "1"
serde_json = "1.0.149"
tokio = { version = "1.52.2", features = ["macros", "rt-multi-thread"] }
{{- if .HasEnvConfig }}
dotenvy = "0.15"
{{- end }}
{{- if .Deps }}
tracing = { version = "{{ tracingVersion }}", default-features = false, features = ["std"] }
{{- end }}
{{ .RuntimeCrate }} = { path = "{{ .RuntimeDepPath }}"{{ with .RuntimeFeatures }}, features = [{{ range $i, $f := . }}{{ if $i }}, {{ end }}"{{ $f }}"{{ end }}]{{ end }} }
{{ .TypesCrate }} = { path = "{{ .TypesDepPath }}" }
{{- with .Identity }}
{{- if .ScalarDepPath }}
{{ .ScalarCrate }} = { path = "{{ .ScalarDepPath }}" }
{{- else }}
{{ .ScalarCrate }} = "0.1.0"
{{- end }}
{{- end }}
{{- range .DependencyCrates }}
{{ .Name }} = { path = "{{ .Path }}" }
{{- end }}
{{- with .Deps }}
{{- range .Calls }}
{{ .Crate }} = { path = "{{ .Path }}" }
{{- end }}
{{- end }}
