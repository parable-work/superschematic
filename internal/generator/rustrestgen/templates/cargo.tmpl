[package]
name = "{{ .CrateName }}"
version = "0.1.0"
edition = "2021"
rust-version = "1.99.0"

[dependencies]
async-trait = "0.1.89"
axum = { version = "0.8.9", features = ["json", "matched-path"] }
http = "1"
serde_json = "1.0.149"
tokio = { version = "1.52.2", features = ["macros", "rt-multi-thread"] }
{{- if .HasEnvConfig }}
dotenvy = "0.15"
{{- end }}
{{ .RuntimeCrate }} = { path = "{{ .RuntimeDepPath }}" }
{{ .TypesCrate }} = { path = "{{ .TypesDepPath }}" }
{{- range .DependencyCrates }}
{{ .Name }} = { path = "{{ .Path }}" }
{{- end }}
