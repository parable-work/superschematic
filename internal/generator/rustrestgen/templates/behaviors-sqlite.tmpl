/// The caller's preconditions an input presents, taken out of it (D16,
/// D104): its `preconditions` member's entries by use id, a null one left
/// out, as the Go and TypeScript servers read them; none for an input
/// without the member.
fn presented(input: &mut Value) -> Map<String, Value> {
    match input
        .as_object_mut()
        .and_then(|input| input.remove("preconditions"))
    {
        Some(Value::Object(entries)) => entries
            .into_iter()
            .filter(|(_, entry)| !entry.is_null())
            .collect(),
        _ => Map::new(),
    }
}
