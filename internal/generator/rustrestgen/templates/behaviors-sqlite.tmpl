/// The time a drain was given, in epoch milliseconds, as the core reads a
/// command's time.
fn millis(now: SystemTime) -> i64 {
    match now.duration_since(UNIX_EPOCH) {
        Ok(since) => i64::try_from(since.as_millis()).unwrap_or(i64::MAX),
        Err(_) => 0,
    }
}

/// What a command of a drain runs with (D116): the core, the layout, and
/// as its clock the time the drain was given, so the worker reads no clock
/// of its own.
fn host_at(now: SystemTime) -> Host<'static> {
    let at = millis(now);
    Host::new(core(), layout()).with_clock(move || at)
}
