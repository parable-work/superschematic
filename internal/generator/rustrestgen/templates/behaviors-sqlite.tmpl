/// What an event handler of the API's Workers runs in (D104, D116): the
/// transaction of {{ .BehaviorDatabase }}'s SQLite file its event's message is spent
/// in, which commits with what the handler writes once it returns `Ok`, and
/// the caller of the behavior worker that claimed it, as which `operation`
/// runs a behavior operation in that transaction. The transaction holds the
/// file's one writer, so a handler writes through `with` alone: a write
/// through the API's `Deps.db` waits for it, and for nothing.
pub struct EventRun<'a> {
    unit: Unit<'a>,
    caller: Caller,
    now: SystemTime,
}

impl EventRun<'_> {
    /// Runs `work` on the transaction's connection, for the handler's own
    /// statements, which commit with the event's completion.
    pub fn with<T>(&self, work: impl FnOnce(&Connection) -> T) -> T {
        self.unit.with(work)
    }

    /// The caller the worker's commands run as.
    pub fn caller(&self) -> &Caller {
        &self.caller
    }

    /// Runs `operation` of the use `use_id` on the row of `type_name` whose
    /// key is `key`, with `params`, in the transaction, as the worker, and
    /// returns its result: the adapter's `run_operation` with the module's
    /// core and layout, at the time the drain was given. The key goes to the
    /// core in its wire form, its JSON string. A refusal leaves the
    /// transaction going on, nothing of the operation written.
    pub fn operation<K, P, R>(
        &self,
        type_name: &str,
        key: &K,
        use_id: &str,
        operation: &str,
        params: &P,
    ) -> Result<R, Error>
    where
        K: Serialize + ?Sized,
        P: Serialize + ?Sized,
        R: DeserializeOwned,
    {
        let key = match serde_json::to_value(key).map_err(unconverted)? {
            Value::String(key) => key,
            other => other.to_string(),
        };
        let params = serde_json::to_value(params).map_err(unconverted)?;
        let host = host_at(self.now);
        let result = self.unit.with(|connection| {
            sqlite::run_operation(
                &host,
                connection,
                type_name,
                &key,
                use_id,
                operation,
                params,
                self.caller.clone(),
            )
        })?;
        serde_json::from_value(result).map_err(unconverted)
    }
}

/// A key, params or a result of an event handler's operation that does not
/// convert to or from JSON, refused as the adapter refuses a defect.
fn unconverted(err: serde_json::Error) -> Error {
    Error::from(Refusal::internal(format!(
        "rules: a behavior operation's value does not convert: {err}"
    )))
}
