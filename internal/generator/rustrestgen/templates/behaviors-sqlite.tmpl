/// The caller the core runs an operation as (D103): the route's principal
/// with the permissions it holds, each once; else a calling service
/// standing in for an end user, which holds none (D37); else no one.
fn caller(ctx: &RequestContext) -> Caller {
    if let Some(principal) = &ctx.principal {
        let mut permissions: Vec<&str> = Vec::new();
        for permission in &principal.permissions {
            if !permissions.contains(&permission.as_str()) {
                permissions.push(permission);
            }
        }
        return Caller::new(principal.subject.clone(), permissions);
    }
    if let Some(service) = &ctx.service_caller {
        return Caller::standing_in(service.deployable.clone());
    }
    Caller::new("", Vec::<String>::new())
}

/// Why an operation did not run: the core's refusal or the adapter's
/// failure, or the file's, whose writer another write held past the busy
/// timeout.
enum Failure {
    Rules(Error),
    File(orm::Error),
}

impl From<orm::Error> for Failure {
    fn from(err: orm::Error) -> Self {
        Failure::File(err)
    }
}

/// Runs `operation` of the use `use_id` on the row of `type_name` whose key
/// is `key`, with `params`, in a transaction of the file's writing
/// connection, as the request's caller, and returns its result once the
/// transaction commits. The key goes to the core in its wire form, its JSON
/// string. A refusal of the core or the adapter rolls the transaction back
/// and is the problem of its status, code, message and details; a writer
/// held past the busy timeout is a 503 the caller may try again (D58); a
/// refusal of status 500 or of no error status, any other failure of the
/// database, and a result that does not read are logged and answered as the
/// server's internal error, as the Go and TypeScript servers answer them.
pub(crate) async fn run_operation<K, P, R>(
    behaviors: &Behaviors,
    ctx: &RequestContext,
    type_name: &str,
    key: &K,
    use_id: &str,
    operation: &str,
    params: &P,
) -> Result<R, ApiError>
where
    K: Serialize + ?Sized,
    P: Serialize + ?Sized,
    R: DeserializeOwned,
{
    let key = match serde_json::to_value(key).map_err(internal)? {
        Value::String(key) => key,
        other => other.to_string(),
    };
    let params = serde_json::to_value(params).map_err(internal)?;
    let caller = caller(ctx);
    let (type_name, use_id, operation) = (
        type_name.to_owned(),
        use_id.to_owned(),
        operation.to_owned(),
    );
    let ran = behaviors
        .db
        .write_async(move |connection| {
            let host = Host::new(core(), layout());
            sqlite::run_operation(
                &host, connection, &type_name, &key, &use_id, &operation, params, caller,
            )
            .map_err(Failure::Rules)
        })
        .await;
    answer(ran)
}
