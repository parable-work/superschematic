/// What an operation came to, as its route answers it: its result, read as
/// the route's type, the problem of a refusal, a busy file's 503, or the
/// server's internal error.
fn answer<R: DeserializeOwned>(ran: Result<Value, Failure>) -> Result<R, ApiError> {
    match ran {
        Ok(result) => serde_json::from_value(result).map_err(internal),
        Err(Failure::Rules(Error::Refused(refusal))) if is_problem(refusal.status) => {
            Err(problem(*refusal))
        }
        Err(Failure::Rules(err)) => Err(internal(err)),
        Err(Failure::File(err @ orm::Error::Busy(_))) => Err(err.into()),
        Err(Failure::File(err)) => Err(internal(err)),
    }
}

/// Whether a refusal of `status` is answered as its problem: an error
/// status, 400 to 599, other than 500, which is the server's own.
fn is_problem(status: u16) -> bool {
    (400..=599).contains(&status) && status != 500
}

/// The problem of a refusal: its status, code, message and details.
fn problem(refusal: Refusal) -> ApiError {
    let Refusal {
        code,
        status,
        message,
        details,
        ..
    } = refusal;
    let status = StatusCode::from_u16(status).unwrap_or(StatusCode::INTERNAL_SERVER_ERROR);
    let error = ApiError::new(status, code.as_str(), message);
    match details {
        Some(details) => error.with_details(Value::Object(*details)),
        None => error,
    }
}

/// Logs `err` and answers the server's internal error, with none of its
/// text.
fn internal(err: impl std::fmt::Display) -> ApiError {
    tracing::error!(error = %err, "behavior operation failed");
    ApiError::internal("An unexpected error occurred")
}
