{
  "components": {
    "schemas": {
      "BasketInput": {
        "description": "Request body: the lines of a basket to place.",
        "properties": {
          "lines": {
            "items": {
              "$ref": "#/components/schemas/BasketLine"
            },
            "maxItems": 5,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "lines"
        ],
        "type": "object"
      },
      "BasketLine": {
        "description": "One line of a basket: an item and how many of it.",
        "properties": {
          "itemId": {
            "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
            "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
            "type": "string"
          },
          "quantity": {
            "format": "double",
            "maximum": 9,
            "minimum": 1,
            "type": "number"
          }
        },
        "required": [
          "itemId",
          "quantity"
        ],
        "type": "object"
      },
      "BasketView": {
        "description": "A placed basket.",
        "properties": {
          "id": {
            "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
            "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
            "type": "string"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/BasketLine"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "lines"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ItemView": {
        "description": "An item of the catalog.",
        "properties": {
          "id": {
            "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
            "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
            "type": "string"
          },
          "inStock": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "sku": {
            "description": "A URL friendly version of a string",
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "sku",
          "inStock"
        ],
        "type": "object"
      },
      "ResponseLinks": {
        "properties": {
          "first": {
            "nullable": true,
            "type": "string"
          },
          "last": {
            "nullable": true,
            "type": "string"
          },
          "next": {
            "nullable": true,
            "type": "string"
          },
          "prev": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "ResponseMeta": {
        "properties": {
          "requestId": {
            "description": "Unique identifier for the request",
            "type": "string"
          },
          "totalCount": {
            "description": "Total count of items for paginated responses",
            "nullable": true,
            "type": "integer"
          }
        },
        "required": [
          "requestId"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "REST API generated from the fixture-paged-api schema",
    "title": "Fixture-Paged-Api API",
    "version": "__OPENAPI_VERSION__"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/baskets": {
      "post": {
        "description": "Place a basket.",
        "operationId": "CatalogPlaceBasketHandler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BasketInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/BasketView"
                    },
                    "links": {
                      "$ref": "#/components/schemas/ResponseLinks"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/ResponseMeta"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "placeBasket",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/items": {
      "get": {
        "description": "The items, two to a page unless the caller asks for up to five, by\ntheir ids or their stock.",
        "operationId": "CatalogListItemsHandler",
        "parameters": [
          {
            "explode": false,
            "in": "query",
            "name": "ids",
            "required": false,
            "schema": {
              "items": {
                "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
                "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
                "type": "string"
              },
              "maxItems": 5,
              "type": "array"
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "inStock",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "The `next` of the previous page; absent for the first page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            }
          },
          {
            "description": "The most items the page holds: 1 to 5, 2 when absent.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 2,
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "properties": {
                        "items": {
                          "items": {
                            "$ref": "#/components/schemas/ItemView"
                          },
                          "type": "array"
                        },
                        "next": {
                          "description": "The cursor of the next page, to send as cursor; null after the last page.",
                          "nullable": true,
                          "type": "string"
                        }
                      },
                      "required": [
                        "items",
                        "next"
                      ],
                      "type": "object"
                    },
                    "links": {
                      "$ref": "#/components/schemas/ResponseLinks"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/ResponseMeta"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "listItems",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/items/{itemId}": {
      "get": {
        "description": "One item.",
        "operationId": "CatalogGetItemHandler",
        "parameters": [
          {
            "description": "itemId parameter",
            "in": "path",
            "name": "itemId",
            "required": true,
            "schema": {
              "description": "UUID v4 with automatic base62 encoding for client-facing APIs",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ItemView"
                    },
                    "links": {
                      "$ref": "#/components/schemas/ResponseLinks"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/ResponseMeta"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "getItem",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/tags": {
      "get": {
        "description": "The tags items carry: a page of a primitive, with the default limits.",
        "operationId": "CatalogListTagsHandler",
        "parameters": [
          {
            "description": "The `next` of the previous page; absent for the first page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            }
          },
          {
            "description": "The most items the page holds: 1 to 100, 20 when absent.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "properties": {
                        "items": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "next": {
                          "description": "The cursor of the next page, to send as cursor; null after the last page.",
                          "nullable": true,
                          "type": "string"
                        }
                      },
                      "required": [
                        "items",
                        "next"
                      ],
                      "type": "object"
                    },
                    "links": {
                      "$ref": "#/components/schemas/ResponseLinks"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/ResponseMeta"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "listTags",
        "tags": [
          "catalog"
        ]
      }
    }
  },
