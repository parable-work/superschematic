// FilterOp variants must match filterparse.ValidOperators in
// utils/psgen/http-runtime/go/filterparse/parse.go. Adding an operator
// requires updating (1) filterparse (Go), (2) the TypeScript SDK's
// types.tmpl FilterParam union, (3) this enum, (4) the test assertions
// in sdkgen_test.go + rustsdkgen_test.go that enumerate the operator set.
/// The comparison operator for a bracket-notation filter.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum FilterOp {
    Eq,
    In,
    Contains,
    Neq,
    Gt,
    Gte,
    Lt,
    Lte,
}

impl FilterOp {
    fn as_str(&self) -> &'static str {
        match self {
            FilterOp::Eq => "eq",
            FilterOp::In => "in",
            FilterOp::Contains => "contains",
            FilterOp::Neq => "neq",
            FilterOp::Gt => "gt",
            FilterOp::Gte => "gte",
            FilterOp::Lt => "lt",
            FilterOp::Lte => "lte",
        }
    }
}

/// A single filter value for bracket-notation query parameters.
///
/// Use `Simple` for `filter[field]=value` (defaults to equality).
/// Use `WithOp` for `filter[field][op]=value`.
///
/// **Multi-value wire contract**: `value` is always a single `String`. For
/// multi-value operators (`FilterOp::In`), the caller must join values with
/// a comma. The server reads only the first query-string value and splits
/// on "," — emitting repeated keys would silently drop values.
///
/// For `FilterOp::Contains` backed by SQL `LIKE`, escape `%` and `_` in
/// the value before calling to avoid unintended pattern matches.
///
/// # Example
/// ```ignore
/// let mut filters = HashMap::new();
/// filters.insert(
///     "country".to_string(),
///     FilterValue::WithOp { op: FilterOp::In, value: "US,Canada".to_string() },
/// );
/// ```
#[derive(Debug, Clone)]
pub enum FilterValue {
    Simple(String),
    WithOp { op: FilterOp, value: String },
}

/// Serializes a `HashMap<String, FilterValue>` into bracket-notation query param pairs.
pub fn filters_to_query_params(filters: &std::collections::HashMap<String, FilterValue>) -> Vec<(String, String)> {
    let mut params = Vec::with_capacity(filters.len());
    for (field, filter) in filters {
        match filter {
            FilterValue::Simple(value) => {
                params.push((format!("filter[{}]", field), value.clone()));
            }
            FilterValue::WithOp { op, value } => {
                params.push((format!("filter[{}][{}]", field, op.as_str()), value.clone()));
            }
        }
    }
    params
}
