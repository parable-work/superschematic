{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "{{.SDKStructName}} Tool Definitions",
  "description": "LLM tool calling bindings for {{.SchemaName}} API",
  "tools": [
{{- range $i, $tool := .Tools}}
{{- if $i}},{{end}}
    {
      "name": "{{$tool.Name}}",
      "description": "{{escapeJSON $tool.Description}}",
      "namespace": "{{$tool.Namespace}}",
      "methodName": "{{$tool.MethodName}}",
      "httpMethod": "{{$tool.HTTPMethod}}",
      "httpPath": "{{$tool.HTTPPath}}",
      "requiresAuth": {{$tool.RequiresAuth}},
      "isScoped": {{$tool.IsScopedNS}},
      "parameters": {
        "type": "object",
        "properties": {
{{- $first := true}}
{{- range $propName, $prop := $tool.Parameters.Properties}}
{{- if not $first}},{{end}}
{{- $first = false}}
          "{{$propName}}": {
            "type": "{{$prop.Type}}"
{{- if $prop.Format}},
            "format": "{{$prop.Format}}"
{{- end}}
{{- if $prop.Description}},
            "description": "{{escapeJSON $prop.Description}}"
{{- end}}
{{- if $prop.Pattern}},
            "pattern": "{{escapeJSON $prop.Pattern}}"
{{- end}}
{{- if $prop.Enum}},
            "enum": [{{range $j, $e := $prop.Enum}}{{if $j}}, {{end}}"{{escapeJSON $e}}"{{end}}]
{{- end}}
{{- if $prop.MinLength}},
            "minLength": {{$prop.MinLength}}
{{- end}}
{{- if $prop.MaxLength}},
            "maxLength": {{$prop.MaxLength}}
{{- end}}
{{- if $prop.Minimum}},
            "minimum": {{$prop.Minimum}}
{{- end}}
{{- if $prop.Maximum}},
            "maximum": {{$prop.Maximum}}
{{- end}}
          }
{{- end}}
        }
{{- if $tool.Parameters.Required}},
        "required": [{{range $j, $r := $tool.Parameters.Required}}{{if $j}}, {{end}}"{{$r}}"{{end}}]
{{- end}}
      },
      "returns": {
        "type": "{{$tool.Returns.Type}}"
{{- if $tool.Returns.Description}},
        "description": "{{escapeJSON $tool.Returns.Description}}"
{{- end}}
{{- if $tool.Returns.Items}},
        "items": {
          "type": "{{$tool.Returns.Items.Type}}"
{{- if $tool.Returns.Items.Description}},
          "description": "{{escapeJSON $tool.Returns.Items.Description}}"
{{- end}}
        }
{{- end}}
      }
    }
{{- end}}
  ]
}

