    {
      "name": "task.approvals.signOff",
      "operationId": "TaskApprovalsSignOffHandler",
      "title": "Task approvals: sign off",
      "mcp": {
        "hidden": false,
        "name": "Task approvals: sign off",
        "handle": "task_approvals_sign_off",
        "description": "Signs off on the instance for a gated state, as the caller. Needs the permission of one of the gate's requirements, and is refused unless it counts toward one of them now: for the instance's creator unless the requirement allows it, for a caller the requirement does not count, excludes or whose proof falls short, while the instance is in the state, and for a caller whose sign-off for the state is not yet consumed.",
        "invocationPolicy": "auto",
        "annotations": {"readOnlyHint":false,"destructiveHint":true,"idempotentHint":false},
        "_meta": {"superschematic/operation-guidance":{"useWhen":"","doNotUseWhen":"","success":"","errors":[]}}
      },
      "capability": "task.approvals.sign-off",
      "lifecycle": "active",
      "visibility": "public",
      "audience": "",
      "guidance": {"useWhen":"","doNotUseWhen":"","success":"","errors":[]},
      "replay": null,
      "description": "Signs off on the instance for a gated state, as the caller. Needs the permission of one of the gate's requirements, and is refused unless it counts toward one of them now: for the instance's creator unless the requirement allows it, for a caller the requirement does not count, excludes or whose proof falls short, while the instance is in the state, and for a caller whose sign-off for the state is not yet consumed.",
      "namespace": "task",
      "methodName": "approvals.sign_off",
      "httpMethod": "POST",
      "httpPath": "/api/task/{id}/approvals/sign-off",
      "requiresAuth": true,
      "requiredPermissions": [],
      "isScoped": false,
      "bindingStatus": "ready",
      "inputSchemaDigest": "sha256:a602806881a156d61b785c475791e546265373c51094e161c885e99f2ba7b9d1",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"description":"The key of the Task row the operation runs on.","pattern":"^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$","type":"string","x-superschematic-scalar":"Identity.UUID"},
          "note": {"description":"Why, for the others.","maxLength":10000,"type":["string","null"]},
          "state": {"description":"The gated state to sign off for.","enum":["done","proving"],"type":"string"},
          "version": {"description":"The row's version the signer read, the version a write through the core is held to. Needed on a pinned gate; on any gate, one that is not the row's version is vetoed stale before anything else is checked. A table's alone: an engine type refuses it.","maximum":9007199254740991,"minimum":1,"type":["integer","null"],"x-superschematic-scalar":"Generic.Int64"}
        },
        "required": ["id", "state"]
      },
      "returns": {
        "type": "object",
        "description": "TaskApprovalsSignOffResult object"
      }
    },
