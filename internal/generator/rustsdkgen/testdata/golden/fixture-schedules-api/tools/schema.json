    {
      "name": "problem.schedules.reportRun",
      "operationId": "ProblemSchedulesReportRunHandler",
      "title": "Problem schedules: report run",
      "mcp": {
        "hidden": false,
        "name": "Problem schedules: report run",
        "handle": "problem_schedules_report_run",
        "description": "Records the outcome of a schedule's latest run, one of the config's outcomes. The config's retry outcome tries the run again afterMs on, as its next attempt, unless the next regular run comes first; another outcome cancels a retry armed for it. A report of an older run, of a replaced schedule's latest run, or of an attempt other than the latest, or a repeat of the outcome recorded, is answered unchanged.",
        "invocationPolicy": "auto",
        "_meta": {"superschematic/operation-guidance":{"useWhen":"","doNotUseWhen":"","success":"","errors":[]}}
      },
      "capability": "problem.schedules.report-run",
      "lifecycle": "active",
      "visibility": "public",
      "audience": "",
      "guidance": {"useWhen":"","doNotUseWhen":"","success":"","errors":[]},
      "replay": null,
      "description": "Records the outcome of a schedule's latest run, one of the config's outcomes. The config's retry outcome tries the run again afterMs on, as its next attempt, unless the next regular run comes first; another outcome cancels a retry armed for it. A report of an older run, of a replaced schedule's latest run, or of an attempt other than the latest, or a repeat of the outcome recorded, is answered unchanged.",
      "namespace": "problem",
      "methodName": "schedules.report_run",
      "httpMethod": "POST",
      "httpPath": "/api/problem/{id}/schedules/report-run",
      "requiresAuth": true,
      "requiredPermissions": [],
      "isScoped": false,
      "bindingStatus": "ready",
      "inputSchemaDigest": "sha256:d5011b7e316721ca89a6f273f7685fc5d49e1426497babde76e1a75534cc655a",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "attempt": {"description":"Signed 64-bit integer; range bounded by JavaScript's safe-integer ceiling.","maximum":9007199254740991,"minimum":1,"type":["integer","null"],"x-superschematic-scalar":"Generic.Int64"},
          "id": {"description":"id parameter","pattern":"^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$","type":"string","x-superschematic-scalar":"Identity.UUID"},
          "name": {"description":"A string value","minLength":1,"type":"string"},
