    {
      "name": "problem.schedules.setSchedule",
      "operationId": "ProblemSchedulesSetScheduleHandler",
      "title": "Problem schedules: set schedule",
      "mcp": {
        "hidden": false,
        "name": "Problem schedules: set schedule",
        "handle": "problem_schedules_set_schedule",
        "description": "Sets a schedule of the row by its name: exactly one of after, every and cron, of a kind the config's kinds take, within minMs and maxMs, a cron line read in timeZone. A live schedule of the name is replaced and its runs start again; one with the same kind, spec and time zone is answered unchanged. A new name needs room under max, and a row in a state endOn names takes none.",
        "invocationPolicy": "auto",
        "_meta": {"superschematic/operation-guidance":{"useWhen":"","doNotUseWhen":"","success":"","errors":[]}}
      },
      "capability": "problem.schedules.set-schedule",
      "lifecycle": "active",
      "visibility": "public",
      "audience": "",
      "guidance": {"useWhen":"","doNotUseWhen":"","success":"","errors":[]},
      "replay": null,
      "description": "Sets a schedule of the row by its name: exactly one of after, every and cron, of a kind the config's kinds take, within minMs and maxMs, a cron line read in timeZone. A live schedule of the name is replaced and its runs start again; one with the same kind, spec and time zone is answered unchanged. A new name needs room under max, and a row in a state endOn names takes none.",
      "namespace": "problem",
      "methodName": "schedules.set_schedule",
      "httpMethod": "POST",
      "httpPath": "/api/problem/{id}/schedules/set-schedule",
      "requiresAuth": true,
      "requiredPermissions": [],
      "isScoped": false,
      "bindingStatus": "ready",
      "inputSchemaDigest": "sha256:f6c4ec4020e6b835d383486c31d1568ac9ffced7c48c9c15c2063264ae378e69",
      "parameters": {
        "type": "object",
