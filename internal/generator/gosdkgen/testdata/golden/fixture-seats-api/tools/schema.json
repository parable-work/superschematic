          "state": {"description":"A SandboxObservedState value","enum":["pending","starting","running","stopping","stopped","failed","unreachable"],"type":"string"}
        },
        "required": ["at", "id", "state"]
      },
      "returns": {
        "type": "object",
        "description": "SandboxObservedObserveResult object"
      }
    },
