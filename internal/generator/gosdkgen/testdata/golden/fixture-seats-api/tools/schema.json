      "namespace": "sandbox",
      "methodName": "observed.observe",
      "httpMethod": "POST",
      "httpPath": "/api/sandbox/{id}/observed/observe",
      "requiresAuth": true,
      "requiredPermissions": [],
      "isScoped": false,
      "bindingStatus": "ready",
