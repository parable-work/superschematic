      "name": "sandbox.observed.observe",
      "operationId": "SandboxObservedObserveHandler",
      "title": "Sandbox observed: observe",
      "mcp": {
        "hidden": false,
        "name": "Sandbox observed: observe",
        "handle": "sandbox_observed_observe",
        "description": "Records the state the provider reports, when at is newer than the last observation's, and moves the Workflow there along the fewest transitions its config allows, each as the caller, so every guard and permission holds each step; a step refused stops there and records drift. An observation no newer is answered unchanged. Needs observePermission.",
        "invocationPolicy": "auto",
        "_meta": {"superschematic/operation-guidance":{"useWhen":"","doNotUseWhen":"","success":"","errors":[]}}
      },
      "capability": "sandbox.observed.observe",
