module {{.ModulePath}}

go 1.27.3

require {{.TypesModule}} v0.0.0
{{- range .IndirectModules}}
require {{.}} v0.0.0 // indirect
{{- end}}
{{- if .HasFilteredEndpoints}}
require {{ .Naming.HTTPRuntimeGoModule }} {{ .Pins.Version .Naming.HTTPRuntimeGoModule "v0.0.0" }}
{{- end}}

{{- if .TypesReplacePath}}
replace {{.TypesModule}} => {{.TypesReplacePath}}
{{- end}}
{{- range .RuntimeReplaces}}
replace {{.Module}} => {{.RelPath}}
{{- end}}
{{- range .TypeModuleReplaces}}
replace {{.Module}} => {{.RelPath}}
{{- end}}
{{- if .Pins}}

// The release of superschematic that generated this module pins the
// runtime modules it reaches, which the module proxy serves, whatever
// version the modules it requires ask for.
replace (
{{- range .Pins.List}}
	{{.Module}} => {{.Module}} {{.Version}}
{{- end}}
)
{{- end}}
