{
  "tools": [
{{- range $i, $tool := .VisibleTools}}
{{- if $i}},{{end}}
    {
      "name": "{{$tool.Name}}",
      "description": "{{escapeJSON $tool.Description}}",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
{{- range $.Keys.Parameters}}
        "{{escapeJSON .Key}}": {{jsonValue .Value}},
{{- end}}
        "properties": {
{{- $props := $tool.Parameters.Properties}}
{{- range $i, $propName := sortedKeys $props}}
{{- $prop := index $props $propName}}
{{- if $i}},{{end}}
          "{{$propName}}": {{schemaJSON $prop}}
{{- end}}
        }
{{- if $tool.Parameters.Required}},
        "required": [{{range $j, $r := $tool.Parameters.Required}}{{if $j}}, {{end}}"{{$r}}"{{end}}]
{{- end}}
      }
    }
{{- end}}
  ]
}
