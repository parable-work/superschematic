package namespaces

import (
	"context"
{{- if .NeedsFmt}}
	"fmt"
{{- end}}
{{- if .NeedsIter}}
	"iter"
{{- end}}
{{- if .NeedsStrings}}
	"strings"
{{- end}}
{{- if .NeedsURL}}
	"net/url"
{{- end}}
{{- if .NeedsRegexp}}
	"regexp"
{{- end}}
{{- if or .NeedsRuntime .NeedsTypes .NeedsFilterparse}}

{{ if .NeedsFilterparse }}	"{{ .SDK.Naming.HTTPRuntimeGoModule }}/filterparse"
{{ end -}}
{{ if .NeedsRuntime }}	"{{.SDK.ModulePath}}/runtime"
{{ end -}}
{{ if .NeedsTypes }}	types "{{.SDK.TypesModule}}"
{{ end -}}
{{- end}}
)

// {{.Namespace.StructName}} contains API methods for the {{.Namespace.Name}} namespace.
{{- if .Namespace.Endpoints}}
//
// Endpoints:
{{- range .Namespace.Endpoints}}
// - {{.MethodName}}: {{docLine .Description (printf "%s endpoint." .MethodName)}}{{if .RequiresAuth}} Requires authentication.{{end}}
{{- end}}
{{- end}}
type {{.Namespace.StructName}} struct {
	client jsonClient
	{{- if .Namespace.IsScopedNS}}
	{{.Namespace.ScopeFieldName}} string
	{{- end}}
}

// New{{.Namespace.StructName}} creates a {{.Namespace.StructName}}.
{{- if .Namespace.IsScopedNS}}
// The {{.Namespace.ScopeFieldName}} parameter scopes every request the namespace makes.
{{- end}}
func New{{.Namespace.StructName}}(
	client jsonClient,
	{{- if .Namespace.IsScopedNS}}
	{{.Namespace.ScopeFieldName}} string,
	{{- end}}
) *{{.Namespace.StructName}} {
	return &{{.Namespace.StructName}}{
		client: client,
		{{- if .Namespace.IsScopedNS}}
		{{.Namespace.ScopeFieldName}}: {{.Namespace.ScopeFieldName}},
		{{- end}}
	}
}

{{- range .Namespace.Endpoints}}
{{- if .HasScalarArgs}}
type {{.ScalarInputStructName}} struct {
	{{- range .ScalarArgs}}
	{{- if or .IsArray .IsMap}}
	{{- if not .Required}}
	{{.GoName}} {{.GoType}} `json:"{{.Name}},omitzero"`
	{{- else}}
	{{.GoName}} {{.GoType}} `json:"{{.Name}}"`
	{{- end}}
	{{- else if .Pointer}}
	{{.GoName}} *{{.GoType}} `json:"{{.Name}},omitempty"`
	{{- else}}
	{{.GoName}} {{.GoType}} `json:"{{.Name}}"`
	{{- end}}
	{{- end}}
}

{{- end}}
{{- if .HasQueryParams}}
type {{.QueryStructName}} struct {
	{{- range .QueryParams}}
	{{- if .IsArray}}
	{{- if not .Required}}
	{{.GoName}} {{.GoType}} `json:"{{.Name}},omitzero"`
	{{- else}}
	{{.GoName}} {{.GoType}} `json:"{{.Name}}"`
	{{- end}}
	{{- else if .Pointer}}
	{{.GoName}} *{{.GoType}} `json:"{{.Name}},omitempty"`
	{{- else}}
	{{.GoName}} {{.GoType}} `json:"{{.Name}}"`
	{{- end}}
	{{- end}}
}

{{- end}}
{{- if .HasFileUpload}}
type {{.FilesStructName}} struct {
	{{- range .FileUploadFields}}
	{{.GoName}} runtime.UploadFile
	{{- end}}
}

{{- end}}
{{$endpoint := .}}
// {{.MethodName}} {{docLine .Description (printf "calls the %s %s endpoint." .HTTPMethod .PathFormat)}}
{{- if .RequiresAuth}}
// Requires authentication.
{{- end}}
{{- if .Page}}
//
// It returns one page of the list (D60): page.Cursor is the Next of the
// page before, "" for the first page, and page.Limit the most items the
// page holds, 1 to {{.Page.MaxLimit}}, or 0 for {{.Page.DefaultLimit}}. {{.AllMethodName}} yields every item.
{{- end}}
func (n *{{$.Namespace.StructName}}) {{.MethodName}}(
	{{- template "parameters" .}}
) ({{.OutputGoType}}, error) {
	{{- if .PathArgs}}
	path := fmt.Sprintf("{{.PathFormat}}", {{range $i, $arg := .PathArgs}}{{if $i}}, {{end}}pathSegment({{$arg}}){{end}})
	{{- else}}
	path := "{{.PathFormat}}"
	{{- end}}

	{{- if .HasQueryParams}}
	{{- if hasQueryParamValidation .QueryParams}}
	queryParamValidationErrors := types.NewValidationErrors()
	{{- range .QueryParams}}
	{{- if and .IsArray .Required}}
	if query == nil || len(query.{{.GoName}}) == 0 {
		queryParamValidationErrors.AddFieldError("{{.Name}}", "required", "required field")
	}
	{{- end}}
	{{- end}}
	{{- if hasQueryParamValidationWhenSet .QueryParams}}
	if query != nil {
		{{- range .QueryParams}}
		{{- if .IsArray}}
		{{- if .ValidatesWhenSet}}
		// {{.Name}} is sent as one comma-separated value, and an empty list
		// is left out. Each item is checked at {{.Name}}[i].
		{{- end}}
		{{- if .ChecksListMin}}
		if n := len(query.{{.GoName}}); n > 0 && n < {{.ValidateListMin}} {
			queryParamValidationErrors.AddFieldError("{{.Name}}", "listMin", "must contain at least {{.ValidateListMin}} items")
		}
		{{- end}}
		{{- if .ValidateListMax}}
		if len(query.{{.GoName}}) > {{.ValidateListMax}} {
			queryParamValidationErrors.AddFieldError("{{.Name}}", "listMax", "must contain at most {{.ValidateListMax}} items")
		}
		{{- end}}
		{{- if .ChecksItems}}
		for i, item := range query.{{.GoName}} {
			itemPath := fmt.Sprintf("{{.Name}}[%d]", i)
			{{- if .ItemIsText}}
			itemText := fmt.Sprint(item)
			{{- if .HasItemRules}}
			if !checkQueryListItem(queryParamValidationErrors, itemPath, itemText) {
				continue
			}
			{{- else}}
			checkQueryListItem(queryParamValidationErrors, itemPath, itemText)
			{{- end}}
			{{- end}}
			{{- if .HasItemRules}}
			{{- $next := "if"}}
			{{- if .ItemIsText}}
			{{- if .ValidateMinLength}}
			{{$next}} len([]rune(itemText)) < {{.ValidateMinLength}} {
				queryParamValidationErrors.AddFieldError(itemPath, "minLength", "must be at least {{.ValidateMinLength}} characters")
			{{- $next = "} else if"}}
			{{- end}}
			{{- if .ValidateMaxLength}}
			{{$next}} len([]rune(itemText)) > {{.ValidateMaxLength}} {
				queryParamValidationErrors.AddFieldError(itemPath, "maxLength", "must be at most {{.ValidateMaxLength}} characters")
			{{- $next = "} else if"}}
			{{- end}}
			{{- if .ValidatePattern}}
			{{$next}} matched, err := regexp.MatchString("{{escapeGoString .ValidatePattern}}", itemText); err != nil || !matched {
				queryParamValidationErrors.AddFieldError(itemPath, "pattern", "invalid format")
			{{- $next = "} else if"}}
			{{- end}}
			{{- else}}
			{{- if .ValidateMin}}
			{{$next}} item < {{.ValidateMin}} {
				queryParamValidationErrors.AddFieldError(itemPath, "min", "must be at least {{.ValidateMin}}")
			{{- $next = "} else if"}}
			{{- end}}
			{{- if .ValidateMax}}
			{{$next}} item > {{.ValidateMax}} {
				queryParamValidationErrors.AddFieldError(itemPath, "max", "must be at most {{.ValidateMax}}")
			{{- $next = "} else if"}}
			{{- end}}
			{{- end}}
			{{- if .IsGoPrimitive}}
			}
			{{- else if eq $next "if"}}
			validateListElement(queryParamValidationErrors, itemPath, &item)
			{{- else}}
			} else {
				validateListElement(queryParamValidationErrors, itemPath, &item)
			}
			{{- end}}
			{{- end}}
		}
		{{- end}}
		{{- else if .ValidatesWhenSet}}
		{{- if .Pointer}}
		if query.{{.GoName}} != nil {
			queryParamValue := *query.{{.GoName}}
			queryParamFieldErrors := []types.ValidationError{}
			{{- if .ValidateMin}}
			if queryParamValue < {{.ValidateMin}} {
				queryParamFieldErrors = append(queryParamFieldErrors, types.ValidationError{Validator: "min", Message: "{{.Name}} must be at least {{.ValidateMin}}"})
			}
			{{- end}}
			{{- if .ValidateMax}}
			if queryParamValue > {{.ValidateMax}} {
				queryParamFieldErrors = append(queryParamFieldErrors, types.ValidationError{Validator: "max", Message: "{{.Name}} must be at most {{.ValidateMax}}"})
			}
			{{- end}}
			{{- if .ValidateMinLength}}
			if len([]rune(queryParamValue)) < {{.ValidateMinLength}} {
				queryParamFieldErrors = append(queryParamFieldErrors, types.ValidationError{Validator: "minLength", Message: "{{.Name}} must be at least {{.ValidateMinLength}} characters"})
			}
			{{- end}}
			{{- if .ValidateMaxLength}}
			if len([]rune(queryParamValue)) > {{.ValidateMaxLength}} {
				queryParamFieldErrors = append(queryParamFieldErrors, types.ValidationError{Validator: "maxLength", Message: "{{.Name}} must be at most {{.ValidateMaxLength}} characters"})
			}
			{{- end}}
			{{- if .ValidatePattern}}
			queryParamMatchesPattern, queryParamPatternErr := regexp.MatchString("{{escapeGoString .ValidatePattern}}", queryParamValue)
			if queryParamPatternErr != nil || !queryParamMatchesPattern {
				queryParamFieldErrors = append(queryParamFieldErrors, types.ValidationError{Validator: "pattern", Message: "{{.Name}} has an invalid format"})
			}
			{{- end}}
			if len(queryParamFieldErrors) > 0 {
				queryParamValidationErrors.SetFieldErrors("{{.Name}}", queryParamFieldErrors)
			}
		}
		{{- else}}
		queryParamValue := query.{{.GoName}}
		queryParamFieldErrors := []types.ValidationError{}
		{{- if .ValidateMin}}
		if queryParamValue < {{.ValidateMin}} {
			queryParamFieldErrors = append(queryParamFieldErrors, types.ValidationError{Validator: "min", Message: "{{.Name}} must be at least {{.ValidateMin}}"})
		}
		{{- end}}
		{{- if .ValidateMax}}
		if queryParamValue > {{.ValidateMax}} {
			queryParamFieldErrors = append(queryParamFieldErrors, types.ValidationError{Validator: "max", Message: "{{.Name}} must be at most {{.ValidateMax}}"})
		}
		{{- end}}
		{{- if .ValidateMinLength}}
		if len([]rune(queryParamValue)) < {{.ValidateMinLength}} {
			queryParamFieldErrors = append(queryParamFieldErrors, types.ValidationError{Validator: "minLength", Message: "{{.Name}} must be at least {{.ValidateMinLength}} characters"})
		}
		{{- end}}
		{{- if .ValidateMaxLength}}
		if len([]rune(queryParamValue)) > {{.ValidateMaxLength}} {
			queryParamFieldErrors = append(queryParamFieldErrors, types.ValidationError{Validator: "maxLength", Message: "{{.Name}} must be at most {{.ValidateMaxLength}} characters"})
		}
		{{- end}}
		{{- if .ValidatePattern}}
		queryParamMatchesPattern, queryParamPatternErr := regexp.MatchString("{{escapeGoString .ValidatePattern}}", queryParamValue)
		if queryParamPatternErr != nil || !queryParamMatchesPattern {
			queryParamFieldErrors = append(queryParamFieldErrors, types.ValidationError{Validator: "pattern", Message: "{{.Name}} has an invalid format"})
		}
		{{- end}}
		if len(queryParamFieldErrors) > 0 {
			queryParamValidationErrors.SetFieldErrors("{{.Name}}", queryParamFieldErrors)
		}
		{{- end}}
		{{- end}}
		{{- end}}
	}
	{{- end}}
	if queryParamValidationErrors.HasErrors() {
		var zero {{.OutputGoType}}
		return zero, NewValidationError(queryParamValidationErrors)
	}
	{{- end}}
	{{- end}}

	{{- if .Page}}
	if pageErrors := pageLimitErrors(page.Limit, {{.Page.MaxLimit}}); pageErrors.HasErrors() {
		var zero {{.OutputGoType}}
		return zero, NewValidationError(pageErrors)
	}
	{{- end}}

	{{- if or .HasQueryParams .Filterable .Page}}
	{{- if .Page}}
	queryValues := url.Values{}
	{{- else}}
	var queryValues url.Values
	{{- end}}
	{{- if .HasQueryParams}}
	if query != nil {
		{{- if not .Page}}
		queryValues = url.Values{}
		{{- end}}
		{{- range .QueryParams}}
		{{- if .IsArray}}
		runtime.AddQueryList(queryValues, "{{.Name}}", query.{{.GoName}})
		{{- else if .Pointer}}
		if query.{{.GoName}} != nil {
			runtime.AddQueryParam(queryValues, "{{.Name}}", *query.{{.GoName}})
		}
		{{- else}}
		runtime.AddQueryParam(queryValues, "{{.Name}}", query.{{.GoName}})
		{{- end}}
		{{- end}}
	}
	{{- end}}
	{{- if .Filterable}}
	// Delegate to filterparse.Serialize so the wire contract lives in one
	// place (the runtime package). Merge into any existing query params.
	if serialized := filterparse.Serialize(filters); len(serialized) > 0 {
		if queryValues == nil {
			queryValues = url.Values{}
		}
		for k, v := range serialized {
			queryValues[k] = v
		}
	}
	{{- end}}
	{{- if .Page}}
	runtime.AddPageRequest(queryValues, page)
	{{- end}}
	{{- end}}

	{{- if or .HasInput .HasScalarArgs}}
	validationErrors := types.NewValidationErrors()
	{{- if .HasInput}}
	appendInputValidationErrors(validationErrors, any(&input))
	{{- end}}
	{{- if .HasScalarArgs}}
	{{- range .ScalarArgs}}
	{{- if and .UnionWrapper (not .IsMap) (not .IsArrayOfArrays)}}
	// {{.Name}} holds a union: {{if .IsArray}}each element{{else}}its value{{end}} is validated as the member it
	// holds, through {{.UnionWrapper}}, its errors nested under {{if .IsArray}}{{.Name}}[i]{{else}}{{.Name}}{{end}}, as
	// the route reports them.
	{{- if .IsArray}}
	{{- if .Required}}
	if input.{{.GoName}} == nil {
		validationErrors.AddFieldError("{{.Name}}", "required", "required field")
	}
	{{- end}}
	for i, item := range input.{{.GoName}} {
		appendUnionValidationErrors(validationErrors, fmt.Sprintf("{{.Name}}[%d]", i), item == nil, {{.UnionWrapper}}{Value: item})
	}
	{{- else if .Pointer}}
	if input.{{.GoName}} != nil {
		appendUnionValidationErrors(validationErrors, "{{.Name}}", *input.{{.GoName}} == nil, {{.UnionWrapper}}{Value: *input.{{.GoName}}})
	}
	{{- else}}
	appendUnionValidationErrors(validationErrors, "{{.Name}}", input.{{.GoName}} == nil, {{.UnionWrapper}}{Value: input.{{.GoName}}})
	{{- end}}
	{{- else if .IsMap}}
	// {{.Name}} is a map, sent as a JSON object; {} is a value.
	{{- if .IsArray}}
	// A list value is never nil, reported at {{.Name}}[key].
	{{- end}}
	{{- if not .IsGoPrimitive}}
	// Each {{if .IsArray}}element{{else}}value{{end}} runs its own validation, reported at {{.Name}}[key]{{if .IsArray}}[i]{{end}}.
	{{- end}}
	{{- if .Required}}
	if input.{{.GoName}} == nil {
		validationErrors.AddFieldError("{{.Name}}", "required", "required field")
	}
	{{- end}}
	{{- if .ValidatesMapValues}}
	for key, value := range input.{{.GoName}} {
		{{- if .IsArray}}
		if value == nil {
			validationErrors.AddFieldError(fmt.Sprintf("{{.Name}}[%s]", key), "required", "required field")
			continue
		}
		{{- if not .IsGoPrimitive}}
		for i := range value {
			validateListElement(validationErrors, fmt.Sprintf("{{.Name}}[%s][%d]", key, i), {{elementRef . "value[i]"}})
		}
		{{- end}}
		{{- else}}
		validateListElement(validationErrors, fmt.Sprintf("{{.Name}}[%s]", key), {{elementRef . "value"}})
		{{- end}}
	}
	{{- end}}
	{{- else if .IsArrayOfArrays}}
	// {{.Name}} is an array of arrays: an inner list is never nil, reported
	// at {{.Name}}[i]; an empty one is valid.
	{{- if not .IsGoPrimitive}} Each element runs its own validation,
	// reported at {{.Name}}[i][j].
	{{- end}}
	{{- if .Required}}
	if input.{{.GoName}} == nil {
		validationErrors.AddFieldError("{{.Name}}", "required", "required field")
	}
	{{- end}}
	for i, row := range input.{{.GoName}} {
		if row == nil {
			validationErrors.AddFieldError(fmt.Sprintf("{{.Name}}[%d]", i), "required", "required field")
			{{- if not .IsGoPrimitive}}
			continue
			{{- end}}
		}
		{{- if not .IsGoPrimitive}}
		for j := range row {
			validateListElement(validationErrors, fmt.Sprintf("{{.Name}}[%d][%d]", i, j), {{elementRef . "row[j]"}})
		}
		{{- end}}
	}
	{{- else if .IsArray}}
	{{- if .Required}}
	if len(input.{{.GoName}}) == 0 {
		validationErrors.SetFieldErrors("{{.Name}}", []types.ValidationError{{"{"}}{Validator: "required", Message: "{{.Name}} is required"}{{"}"}})
	}
	{{- end}}
	for _, elem := range input.{{.GoName}} {
		appendRequiredScalarValidationErrors(validationErrors, "{{.Name}}", any(elem))
	}
	{{- else if .Pointer}}
	if input.{{.GoName}} != nil {
		appendScalarValidationErrors(validationErrors, "{{.Name}}", any(*input.{{.GoName}}))
	}
	{{- else if .Required}}
	appendRequiredScalarValidationErrors(validationErrors, "{{.Name}}", any(input.{{.GoName}}))
	{{- else}}
	appendScalarValidationErrors(validationErrors, "{{.Name}}", any(input.{{.GoName}}))
	{{- end}}
	{{- end}}
	{{- end}}
	if validationErrors.HasErrors() {
		var zero {{.OutputGoType}}
		return zero, NewValidationError(validationErrors)
	}
	{{- end}}

	var requestBody any
	{{- if .HasFileUpload}}
	payloadData, err := runtime.StripFieldsForMultipart(input, []string{
		{{- range .FileUploadFields}}
		"{{.Name}}",
		{{- end}}
	})
	if err != nil {
		var zero {{.OutputGoType}}
		return zero, err
	}

	filesMap := map[string]runtime.UploadFile{}
	{{- range .FileUploadFields}}
	{{- if .Required}}
	if len(files.{{.GoName}}.Reader) == 0 {
		var zero {{$endpoint.OutputGoType}}
		return zero, fmt.Errorf("{{.Name}} file is required")
	}
	{{- end}}
	if len(files.{{.GoName}}.Reader) > 0 {
		filesMap["{{.Name}}"] = files.{{.GoName}}
	}
	{{- end}}

	requestBody = runtime.MultipartBody{
		JSONData: payloadData,
		Files:    filesMap,
	}
	{{- else if .HasEncryptedBody}}
	// The envelope carries the request body itself, the JSON an
	// unencrypted request would send.
	{{- if or .HasInput .HasScalarArgs}}
	var payloadToEncrypt any = input
	{{- else}}
	var payloadToEncrypt any = map[string]any{}
	{{- end}}
	var publicEncryptionKey *runtime.PublicEncryptionKey
	if options != nil {
		publicEncryptionKey = options.PublicEncryptionKey
	}
	encryptedPayload, err := n.client.EncryptRequestPayload(payloadToEncrypt, publicEncryptionKey)
	if err != nil {
		var zero {{.OutputGoType}}
		return zero, err
	}
	requestBody = encryptedPayload
	{{- else if or .HasInput .HasScalarArgs}}
	{{- if and (not .HasInput) (eq .HTTPMethod "GET") .HasScalarArgs}}
	// GET endpoints: scalar args go as query parameters, not request body.
	{{- if not (or .HasQueryParams .Page)}}
	queryValues := url.Values{}
	{{- end}}
	{{- range .ScalarArgs}}
	{{- if .IsArray}}
	// comma-separated format for array query params
	if len(input.{{.GoName}}) > 0 {
		strs := make([]string, len(input.{{.GoName}}))
		for i, v := range input.{{.GoName}} {
			strs[i] = fmt.Sprintf("%v", v)
		}
		queryValues.Set("{{.Name}}", strings.Join(strs, ","))
	}
	{{- else if .Pointer}}
	if input.{{.GoName}} != nil {
		runtime.AddQueryParam(queryValues, "{{.Name}}", *input.{{.GoName}})
	}
	{{- else}}
	runtime.AddQueryParam(queryValues, "{{.Name}}", input.{{.GoName}})
	{{- end}}
	{{- end}}
	{{- else}}
	requestBody = input
	{{- end}}
	{{- end}}


	{{- if .IsUnionOutput}}
	var out {{.OutputUnionWrapperGoType}}
	{{- else}}
	var out {{.OutputGoType}}
	{{- end}}
	if err := n.client.DoJSON(
		ctx,
		"{{.HTTPMethod}}",
		path,
		{{- if or .HasQueryParams (and (not .HasInput) (eq .HTTPMethod "GET") .HasScalarArgs) .Filterable .Page}}
		queryValues,
		{{- else}}
		nil,
		{{- end}}
		requestBody,
		&out,
	); err != nil {
		var zero {{.OutputGoType}}
		return zero, err
	}

	{{- if and .IsUnionOutput .Page}}
	items := make([]{{.ItemGoType}}, len(out.Items))
	for i, item := range out.Items {
		if item.Value == nil {
			var zero {{.OutputGoType}}
			return zero, fmt.Errorf("decode {{.MethodName}} response: item %d: {{.OutputType}} union value is nil", i)
		}
		items[i] = item.Value
	}
	return {{.OutputGoType}}{Items: items, Next: out.Next}, nil
	{{- else if and .IsUnionOutput .OutputIsMap}}
	if out == nil {
		return nil, nil
	}
	values := make({{.OutputGoType}}, len(out))
	{{- if eq .OutputArrayDepth 1}}
	for key, list := range out {
		items := make([]{{.OutputUnionGoType}}, len(list))
		for i, item := range list {
			if item.Value == nil {
				var zero {{.OutputGoType}}
				return zero, fmt.Errorf("decode {{.MethodName}} response: item [%q][%d]: {{.OutputType}} union value is nil", key, i)
			}
			items[i] = item.Value
		}
		values[key] = items
	}
	{{- else}}
	for key, item := range out {
		if item.Value == nil {
			var zero {{.OutputGoType}}
			return zero, fmt.Errorf("decode {{.MethodName}} response: item [%q]: {{.OutputType}} union value is nil", key)
		}
		values[key] = item.Value
	}
	{{- end}}
	return values, nil
	{{- else if and .IsUnionOutput (eq .OutputArrayDepth 2)}}
	if out == nil {
		return nil, nil
	}
	rows := make({{.OutputGoType}}, len(out))
	for i, row := range out {
		rows[i] = make([]{{.OutputUnionGoType}}, len(row))
		for j, item := range row {
			if item.Value == nil {
				var zero {{.OutputGoType}}
				return zero, fmt.Errorf("decode {{.MethodName}} response: item [%d][%d]: {{.OutputType}} union value is nil", i, j)
			}
			rows[i][j] = item.Value
		}
	}
	return rows, nil
	{{- else if and .IsUnionOutput (eq .OutputArrayDepth 1)}}
	if out == nil {
		return nil, nil
	}
	items := make({{.OutputGoType}}, len(out))
	for i, item := range out {
		if item.Value == nil {
			var zero {{.OutputGoType}}
			return zero, fmt.Errorf("decode {{.MethodName}} response: item %d: {{.OutputType}} union value is nil", i)
		}
		items[i] = item.Value
	}
	return items, nil
	{{- else if .IsUnionOutput}}
	{{- if .OutputNullable}}
	if out == nil {
		return nil, nil
	}
	{{- end}}
	if out.Value == nil {
		var zero {{.OutputGoType}}
		return zero, fmt.Errorf("decode {{.MethodName}} response: {{.OutputType}} union value is nil")
	}
	return out.Value, nil
	{{- else}}
	return out, nil
	{{- end}}
}
{{- if .Page}}

// {{.AllMethodName}} yields the items of every page of {{.MethodName}} in turn (D60),
// asking for each page with the Next of the page before, from page.Cursor
// ("" for the first page) with page.Limit items a page. It asks for a page
// only when the loop has taken every item of the one before, and stops
// after the page whose Next is nil. An error ends the iteration: the one a
// page failed with, or one for a page whose Next is the cursor it was
// asked with.
func (n *{{$.Namespace.StructName}}) {{.AllMethodName}}(
	{{- template "parameters" .}}
) iter.Seq2[{{.ItemGoType}}, error] {
	return runtime.AllItems("{{.Page.Operation}}", page, func(page runtime.PageRequest) (runtime.Page[{{.ItemGoType}}], error) {
		return n.{{.MethodName}}(ctx
			{{- range .PathParams}}, {{.GoName}}{{end}}
			{{- if or .HasInput .HasScalarArgs}}, input{{end}}
			{{- if .HasFileUpload}}, files{{end}}
			{{- if .HasQueryParams}}, query{{end}}
			{{- if .Filterable}}, filters{{end}}, page)
	})
}
{{- end}}

{{- end}}

{{- define "parameters"}}
	ctx context.Context,
	{{- range .PathParams}}
	{{.GoName}} {{.GoType}},
	{{- end}}
	{{- if .HasInput}}
	input {{.InputType}},
	{{- else if .HasScalarArgs}}
	input {{.ScalarInputStructName}},
	{{- end}}
	{{- if .HasFileUpload}}
	files {{.FilesStructName}},
	{{- end}}
	{{- if .HasQueryParams}}
	query *{{.QueryStructName}},
	{{- end}}
	{{- if .Filterable}}
	filters []filterparse.Filter,
	{{- end}}
	{{- if .HasEncryptedBody}}
	options *runtime.EncryptedRequestOptions,
	{{- end}}
	{{- if .Page}}
	page runtime.PageRequest,
	{{- end}}
{{- end}}
