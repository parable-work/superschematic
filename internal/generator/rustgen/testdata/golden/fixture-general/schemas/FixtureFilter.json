{
  "name": "fixture-general",
  "kind": "General",
  "rootType": "FixtureFilter",
  "scalars": {
    "Generic.Int64": {
      "name": "Generic.Int64",
      "description": "Signed 64-bit integer; range bounded by JavaScript's safe-integer ceiling.",
      "languagePrimitive": "number",
      "primitive": "Int",
      "typeMappings": {
        "go": "GenericInt64",
        "json_schema": "integer",
        "python": "int",
        "rust": "i64",
        "sql": "BIGINT",
        "typescript": "number"
      },
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "hasCustomParse": true
    },
    "Identity.Name": {
      "name": "Identity.Name",
      "description": "An objects name",
      "languagePrimitive": "string",
      "primitive": "String",
      "typeMappings": {
        "go": "IdentityName",
        "json_schema": "string",
        "python": "str",
        "rust": "String",
        "sql": "VARCHAR(80)",
        "typescript": "string"
      },
      "maxLength": 80,
      "minLength": 2
    }
  },
  "types": {
    "FixtureFilter": {
      "name": "FixtureFilter",
      "owner": "src/config.schema.ts",
      "comment": "JSON-persisted filter: exercises optional-list constraint gating.\nAbsent/null must skip listMin; an explicit [] must fail it (decode must\nnot normalize an absent optional list into an empty non-nil slice).",
      "role": "EmbeddedStruct",
      "fields": [
        {
          "name": "kind",
          "typeRef": {
            "name": "string"
          },
          "required": true,
          "validateMaxLength": 32
        },
        {
          "name": "values",
          "typeRef": {
            "name": "string",
            "isArray": true
          },
          "validateMaxLength": 64,
          "validateListMin": 1,
          "validateListMax": 10
        },
        {
          "name": "minCents",
          "comment": "Scalars with rules of their own, checked after the scalar's.",
          "typeRef": {
            "name": "Generic.Int64"
          },
          "required": true,
          "validateMin": 0
        },
        {
          "name": "labels",
          "typeRef": {
            "name": "Identity.Name",
            "isArray": true
          },
          "validateMaxLength": 16
        }
      ],
      "jsonField": true
    }
  }
}
