  {
    "name": "problem.statusTransition",
    "inputSchemaDigest": "sha256:e4f4e90a714196b3d4feb413e6eaf7cac64a3aa4edb659ffdd18c99f1f973e94",
    "parameters": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "from": {
          "description": "The state the caller read the instance in. An instance in another state refuses the move as the veto stale, before anything else is checked, so a retry that finds its move made is stale with the state it moved to. A table's alone: an engine type refuses it.",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "open",
            "working",
            "done",
            "dropped",
            null
          ]
        },
        "id": {
          "x-superschematic-scalar": "Identity.UUID",
          "type": "string",
          "description": "The key of the Problem row the operation runs on.",
          "pattern": "^([0-9A-Za-z]{1,22}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        },
        "to": {
          "type": "string",
          "description": "The state to move to.",
          "enum": [
            "open",
            "working",
            "done",
            "dropped"
          ]
        }
      },
      "required": [
        "id",
        "to"
      ]
    },
    "returns": {
      "type": "object",
      "description": "ProblemStatusTransitionResult object"
    }
  }
