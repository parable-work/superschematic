          "operations": [
            {
              "name": "transition",
              "writes": true
            }
          ]
        }
      ],
      "spec": {
        "name": "Checkout",
        "uses": [
          {
            "behavior": "Holds",
            "config": {
              "commitOn": [
                "placed"
              ],
              "holds": {
                "lines": {
                  "each": {
                    "field": "lines",
                    "target": "inventoryId"
                  },
                  "quantity": {
                    "field": "quantity"
                  },
                  "schema": "Inventory"
                },
                "wrap": {
                  "link": "wrap",
                  "quantity": 1
                }
              },
              "releaseOn": [
                "expired",
                "cancelled"
              ],
              "returnOn": [
                "returned"
              ],
              "takeOn": [
                "held"
              ]
            },
            "anchor": "type"
          },
          {
            "behavior": "Workflow",
            "config": {
              "initial": "cart",
              "states": [
                "cart",
                "held",
                "placed",
                "expired",
                "cancelled",
                "returned"
              ],
              "transitions": [
                {
                  "from": "cart",
                  "to": "held"
                },
                {
                  "from": "held",
                  "to": "placed"
                },
                {
                  "from": "held",
                  "to": "expired"
                },
                {
                  "from": "held",
                  "to": "cancelled"
                },
                {
                  "from": "cart",
                  "to": "cancelled"
                },
                {
                  "from": "placed",
                  "to": "returned"
                }
              ]
            },
            "anchor": {
              "field": "status"
            }
          }
        ],
        "fields": [
          {
            "name": "title",
            "type": "string"
          },
          {
            "name": "lines",
            "type": "Line"
          },
          {
            "name": "wrapId",
            "type": "Identity.UUID",
            "relation": {
              "name": "wrap",
              "type": "Inventory"
            }
          }
        ]
      }
    },
