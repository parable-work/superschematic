      "spec": {
        "name": "Order",
        "uses": [
          {
            "behavior": "Payments",
            "config": {
              "amount": {
                "field": "totalCents"
              },
              "currency": "GBP",
              "record": {
                "permission": "payments.record"
              },
              "refunds": {
                "permission": "payments.refund"
              },
              "require": {
                "placed": "paid"
              },
              "voidOn": [
                "cancelled"
              ]
            },
            "anchor": "type"
          },
          {
            "behavior": "Workflow",
            "config": {
              "initial": "cart",
              "states": [
                "cart",
                "held",
                "placed",
                "cancelled"
              ],
              "transitions": [
                {
                  "from": "cart",
                  "to": "held"
                },
                {
                  "from": "held",
                  "to": "placed"
                },
                {
                  "from": "cart",
                  "to": "cancelled"
                },
                {
                  "from": "held",
                  "to": "cancelled"
                }
              ]
            },
            "anchor": {
              "field": "status"
            }
          }
        ],
        "fields": [
          {
            "name": "title",
            "type": "string"
          },
          {
            "name": "totalCents",
            "type": "Generic.Int64"
          }
        ]
