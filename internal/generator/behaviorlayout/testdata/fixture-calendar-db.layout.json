        "name": "Booking",
        "uses": [
          {
            "behavior": "Holds",
            "config": {
              "commitOn": [
                "booked"
              ],
              "holds": {
                "slot": {
                  "interval": {
                    "end": "slotEnd",
                    "start": "slotStart"
                  },
                  "link": "desk"
