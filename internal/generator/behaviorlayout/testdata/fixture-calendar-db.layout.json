              },
              "releaseOn": [
                "expired",
                "cancelled"
              ],
              "takeOn": [
                "held"
              ]
            },
            "anchor": "type"
          },
          {
            "behavior": "Workflow",
            "config": {
              "initial": "draft",
              "states": [
                "draft",
                "held",
                "booked",
                "expired",
                "cancelled"
              ],
              "transitions": [
                {
                  "from": "draft",
                  "to": "held"
                },
                {
                  "from": "held",
                  "to": "booked"
                },
                {
                  "from": "held",
                  "to": "expired"
                },
                {
                  "from": "held",
                  "to": "cancelled"
                },
                {
                  "from": "draft",
                  "to": "cancelled"
                }
              ]
            },
            "anchor": {
              "field": "status"
            }
          }
        ],
