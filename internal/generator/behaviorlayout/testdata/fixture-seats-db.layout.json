{
  "types": {
    "Problem": {
      "type": "Problem",
      "table": "problem",
      "key": {
        "field": "id",
        "column": "id",
        "type": "Identity.UUID"
      },
      "version": "_version",
      "own": [
        {
          "field": "title",
          "column": "title",
          "type": "string"
        },
        {
          "field": "agent",
          "column": "agent",
          "type": "Identity.UUID"
        }
      ],
      "uses": [
        {
          "id": "Seats",
          "behavior": "Seats",
          "member": "seats",
          "fields": [],
          "operations": [
            {
              "name": "takeSeat",
              "writes": true
            },
            {
              "name": "leaveSeat",
              "writes": true
            },
            {
              "name": "listSeats",
              "writes": false
            }
          ],
          "tables": [
            {
              "name": "occupants",
              "table": "problem_seats_occupants",
              "row": "problem_id",
              "key": {
                "name": "number",
                "field": "number",
                "column": "number",
                "type": "string"
              },
              "fields": [
                {
                  "name": "seat",
                  "field": "seat",
                  "column": "seat",
                  "type": "string"
                },
                {
                  "name": "subject",
                  "field": "subject",
                  "column": "subject",
                  "type": "string"
                },
                {
                  "name": "seatedAt",
                  "field": "seatedAt",
                  "column": "seated_at",
                  "type": "Temporal.DateTime",
                  "convert": "epochMillis"
                },
                {
                  "name": "seatedBy",
                  "field": "seatedBy",
                  "column": "seated_by",
                  "type": "string"
                }
              ]
            }
          ]
        },
        {
          "id": "StateRules",
          "behavior": "StateRules",
          "member": "staterules",
          "fields": [],
          "operations": []
        },
        {
          "id": "status",
          "behavior": "Workflow",
          "anchor": "status",
          "member": "status",
          "fields": [
            {
              "name": "status",
              "field": "status",
              "column": "status",
              "type": "string",
              "value": true
            },
            {
              "name": "enteredAt",
              "field": "statusEnteredAt",
              "column": "status_entered_at",
              "type": "Temporal.DateTime",
              "convert": "epochMillis"
            }
          ],
          "operations": [
            {
              "name": "transition",
              "writes": true
            }
          ]
        }
      ],
      "spec": {
        "name": "Problem",
        "uses": [
          {
            "behavior": "Seats",
            "config": {
              "seats": {
                "accountable": {
                  "assign": "problems.assign",
                  "max": 1,
                  "onFull": "displace",
                  "take": "problems.own"
                },
                "handles": {
                  "assign": "problems.release",
                  "max": 5
                },
                "responsible": {
                  "assign": "problems.assign",
                  "fromField": "agent",
                  "take": "problems.work"
                }
              }
            },
            "anchor": "type"
          },
          {
            "behavior": "StateRules",
            "config": {
              "states": {
                "review": {
                  "by": [
                    "seat:accountable"
                  ],
                  "frozen": [
                    "title"
                  ]
                }
              }
            },
            "anchor": "type"
          },
          {
            "behavior": "Workflow",
            "config": {
              "overridePermission": "problems.override",
              "states": [
                "open",
                "working",
                "review",
                "done"
              ],
              "transitions": [
                {
                  "by": [
                    "seat:responsible"
                  ],
                  "from": "open",
                  "to": "working"
                },
                {
                  "by": [
                    "seat:responsible"
                  ],
                  "from": "working",
                  "to": "review"
                },
                {
                  "by": [
                    "seat:accountable"
                  ],
                  "from": "review",
                  "to": "done"
                },
                {
                  "by": [
                    "seat:accountable"
                  ],
                  "from": "review",
                  "to": "working"
                }
              ]
            },
            "anchor": {
              "field": "status"
            }
          }
        ],
        "fields": [
          {
            "name": "title",
            "type": "string"
          },
          {
            "name": "agent",
            "type": "Identity.UUID"
          }
        ]
      }
    },
    "Sandbox": {
      "type": "Sandbox",
      "table": "sandbox",
      "key": {
        "field": "id",
        "column": "id",
        "type": "Identity.UUID"
      },
      "version": "_version",
      "own": [
        {
          "field": "name",
          "column": "name",
          "type": "string"
        }
      ],
      "uses": [
        {
          "id": "status",
          "behavior": "Workflow",
          "anchor": "status",
          "member": "status",
          "fields": [
            {
              "name": "status",
              "field": "status",
              "column": "status",
              "type": "string",
              "value": true
            },
            {
              "name": "enteredAt",
              "field": "statusEnteredAt",
              "column": "status_entered_at",
              "type": "Temporal.DateTime",
              "convert": "epochMillis"
            }
          ],
          "operations": [
            {
              "name": "transition",
              "writes": true
            }
          ]
        },
        {
          "id": "observed",
          "behavior": "Reconcile",
          "anchor": "observed",
          "member": "observed",
          "fields": [
            {
              "name": "observed",
              "field": "observed",
              "column": "observed",
              "type": "string",
              "value": true
            },
            {
              "name": "observedAt",
              "field": "observedObservedAt",
              "column": "observed_observed_at",
              "type": "Temporal.DateTime",
              "convert": "epochMillis"
            },
            {
              "name": "drift",
              "field": "observedDrift",
              "column": "observed_drift",
              "type": "Generic.JSON"
            },
            {
              "name": "reconciledAt",
              "field": "observedReconciledAt",
              "column": "observed_reconciled_at",
              "type": "Temporal.DateTime",
              "convert": "epochMillis"
            }
          ],
          "operations": [
            {
              "name": "observe",
              "writes": true
            }
          ]
        }
      ],
      "deadlines": {
        "queue": "SandboxDeadline",
        "table": "sandbox_deadline_queue",
        "rowKey": "row_key",
        "use": "use_id",
        "name": "name",
        "at": "at",
        "payload": "payload"
      },
      "spec": {
        "name": "Sandbox",
        "uses": [
          {
            "behavior": "Workflow",
            "config": {
              "states": [
                "pending",
                "starting",
                "running",
                "stopping",
                "stopped",
                "failed",
                "unreachable"
              ],
              "transitions": [
                {
                  "from": "pending",
                  "to": "starting"
                },
                {
                  "from": "starting",
                  "to": "running"
                },
                {
                  "from": "running",
                  "permission": "sandboxes.stop",
                  "to": "stopping"
                },
                {
                  "from": "stopping",
                  "to": "stopped"
                },
                {
                  "from": "stopped",
                  "to": "starting"
                },
                {
                  "from": "pending",
                  "to": "failed"
                },
                {
                  "from": "starting",
                  "to": "failed"
                },
                {
                  "from": "running",
                  "to": "failed"
                },
                {
                  "from": "stopping",
                  "to": "failed"
                },
                {
                  "from": "pending",
                  "to": "unreachable"
                },
                {
                  "from": "starting",
                  "to": "unreachable"
                },
                {
                  "from": "running",
                  "to": "unreachable"
                },
                {
                  "from": "stopping",
                  "to": "unreachable"
                },
                {
                  "from": "stopped",
                  "to": "unreachable"
                },
                {
                  "from": "unreachable",
                  "to": "pending"
                },
                {
                  "from": "unreachable",
                  "to": "starting"
                },
                {
                  "from": "unreachable",
                  "to": "running"
                },
                {
                  "from": "unreachable",
                  "to": "stopping"
                },
                {
                  "from": "unreachable",
                  "to": "stopped"
                },
                {
                  "from": "unreachable",
                  "to": "failed"
                }
              ]
            },
            "anchor": {
              "field": "status"
            }
          },
          {
            "behavior": "Reconcile",
            "config": {
              "observePermission": "sandboxes.observe",
              "staleAfterMs": 300000,
              "status": "status",
              "unreachable": "unreachable"
            },
            "anchor": {
              "field": "observed"
            }
          }
        ],
        "fields": [
          {
            "name": "name",
            "type": "string"
          }
        ]
      }
    }
  }
}
