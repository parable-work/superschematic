      "spec": {
        "name": "Ticket",
        "uses": [
          {
            "behavior": "Derived",
            "config": {
              "fields": {
                "category": {
                  "from": [
                    "subject",
                    "body"
                  ],
                  "instruction": "Classify the request.",
                  "model": "standard"
                },
                "priority": {
                  "from": [
                    "subject",
                    "body"
                  ],
                  "instruction": "How urgent is this? low, normal or high.",
                  "model": "standard",
                  "states": [
                    "new",
                    "triage"
                  ]
                }
              },
              "maxAttempts": 2,
              "permission": "tickets.derive"
            },
            "anchor": "type"
          },
          {
            "behavior": "Provenance",
            "config": {
              "fields": [
                "subject",
                "body",
                "category",
                "priority"
              ],
              "gates": {
                "assigned": {
                  "reviewed": [
                    "category",
                    "priority"
                  ]
                }
              },
              "review": {
                "below": 0.8,
                "permission": "tickets.review",
                "sources": [
                  "Derived"
                ]
              }
            },
            "anchor": "type"
          },
          {
            "behavior": "Workflow",
            "config": {
              "states": [
                "new",
                "triage",
                "assigned"
              ],
              "transitions": [
                {
                  "from": "new",
                  "to": "triage"
                },
                {
                  "from": "new",
                  "to": "assigned"
                },
                {
                  "from": "triage",
                  "to": "assigned"
                }
              ]
            },
            "anchor": {
              "field": "status"
            }
          }
        ],
        "fields": [
          {
            "name": "subject",
            "type": "string"
          },
          {
            "name": "body",
            "type": "string"
          },
          {
            "name": "category",
            "type": "Category",
            "schema": {
              "description": "A Category value",
              "enum": [
                "billing",
                "bug",
                "other",
                null
              ],
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "priority",
            "type": "string",
            "schema": {
              "description": "A string value",
              "type": [
                "string",
                "null"
              ]
            }
          }
        ]
