      "spec": {
        "name": "Job",
        "uses": [
          {
            "behavior": "Lease",
            "config": {
              "escalate": {
                "from": [
                  "running"
                ],
                "transition": "failed"
              },
              "maxExpiries": 3,
              "onExpiry": {
                "from": [
                  "running"
                ],
                "transition": "queued"
              },
              "overridePermission": "jobs.override",
              "requireToken": true
            },
            "anchor": "type"
          },
          {
            "behavior": "Retries",
            "config": {
              "classes": {
                "build": {
                  "attempts": 1
                },
                "rejected": "terminal",
                "timeout": {
                  "attempts": 5,
                  "backoff": {
                    "firstMs": 60000,
                    "maxMs": 600000
                  }
                }
              },
              "exhaustedState": "failed",
              "giveUpAfterMs": 1800000,
              "keyField": "revision",
              "retryInto": [
                "running"
              ],
              "then": {
                "from": [
                  "waiting"
                ],
                "transition": "queued"
              },
              "totalAttempts": 6,
              "window": {
                "attempts": 4,
                "ms": 3600000
              }
            },
            "anchor": "type"
          },
          {
            "behavior": "Workflow",
            "config": {
              "states": [
                "queued",
                "running",
                "waiting",
                "done",
                "failed"
              ],
              "transitions": [
                {
                  "from": "queued",
                  "to": "running"
                },
                {
                  "from": "running",
                  "to": "waiting"
                },
                {
                  "from": "waiting",
                  "to": "queued"
                },
                {
                  "from": "running",
                  "to": "queued"
                },
                {
                  "from": "running",
                  "to": "done"
                },
                {
                  "from": "queued",
                  "to": "failed"
                },
                {
                  "from": "running",
                  "to": "failed"
                },
                {
                  "from": "waiting",
                  "to": "failed"
                },
                {
                  "from": "failed",
                  "to": "queued"
                }
              ]
            },
            "anchor": {
              "field": "status"
            }
          }
        ],
        "fields": [
          {
            "name": "title",
            "type": "string"
          },
          {
            "name": "revision",
            "type": "Generic.Int64"
          }
        ]
      }
