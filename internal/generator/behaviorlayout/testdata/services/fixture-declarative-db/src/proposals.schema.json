{
  "name": "fixture-declarative-db",
  "kind": "DB",
  "description": "Two tables that implement test.Votes, a declarative behavior (D103 step 5) whose declaration states its rules, beside a Workflow field each.",
  "scalars": {
    "Identity.UUID": {
      "name": "Identity.UUID",
      "languagePrimitive": "string"
    },
    "Temporal.DateTime": {
      "name": "Temporal.DateTime",
      "languagePrimitive": "string"
    },
    "Generic.Int64": {
      "name": "Generic.Int64",
      "languagePrimitive": "number"
    }
  },
  "types": {
    "Proposal": {
      "name": "Proposal",
      "comment": "A proposal its voters score.",
      "role": "DBTable",
      "optimistic": true,
      "behaviors": [
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "states": [
              "open",
              "accepted",
              "closed"
            ],
            "transitions": [
              {
                "from": "open",
                "to": "accepted"
              },
              {
                "from": "open",
                "to": "closed"
              }
            ]
          }
        },
        {
          "name": "test.Votes",
          "implements": true,
          "config": {
            "maxScore": 5,
            "quorum": 2
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "owner",
          "typeRef": {
            "name": "string"
          }
        }
      ]
    },
    "Motion": {
      "name": "Motion",
      "comment": "A motion its members score.",
      "role": "DBTable",
      "optimistic": true,
      "behaviors": [
        {
          "name": "Workflow",
          "field": "status",
          "config": {
            "states": [
              "open",
              "accepted",
              "closed"
            ],
            "transitions": [
              {
                "from": "open",
                "to": "accepted"
              },
              {
                "from": "open",
                "to": "closed"
              }
            ]
          }
        },
        {
          "name": "test.Votes",
          "implements": true,
          "config": {
            "maxScore": 5,
            "quorum": 2
          }
        }
      ],
      "fields": [
        {
          "name": "id",
          "typeRef": {
            "name": "Identity.UUID"
          },
          "required": true,
          "key": true,
          "autoGenerated": true
        },
        {
          "name": "title",
          "typeRef": {
            "name": "string"
          },
          "required": true
        },
        {
          "name": "owner",
          "typeRef": {
            "name": "string"
          }
        }
      ]
    }
  }
}
