# Single source of truth for the toolchain pins. Workflows load this file with
#   grep -E '^[A-Za-z_][A-Za-z0-9_]*=' tools.env >> "$GITHUB_ENV"
# so the versions live in exactly one place; bump them here, never inline in a
# workflow. KEY=VALUE, no quotes/spaces (GitHub Actions $GITHUB_ENV format).
#
# GO_VERSION is also the GOTOOLCHAIN pin (go$GO_VERSION) and the `go` directive
# of every go.mod in this repository.
GO_VERSION=1.26.4
GOLANGCI_LINT_VERSION=2.11.4
NODE_VERSION=24
# BUN_VERSION is also the oven/bun image a generated TypeScript server's
# Dockerfile runs it on (internal/generator/servergen's BunVersion).
BUN_VERSION=1.4.2
PYTHON_VERSION=3.12
UV_VERSION=0.12.9
# The Rust toolchain builds the runtime crates, the generated crates and
# both static archives Go binaries link, superscalar's ffi archive and the
# version graph's: scripts/superscalar-dep.sh and
# scripts/versiongraph-archive.sh build with it, overriding the toolchain
# superscalar's checkout pins, since archives two Rust releases built do not
# link into one binary. Every other Rust build uses it too: the Makefile
# exports it as RUSTUP_TOOLCHAIN, and runtime/versiongraph/typescript's
# scripts/build-wasm.mjs reads it, unless RUSTUP_TOOLCHAIN is already set.
RUST_VERSION=1.99.0
# The Postgres major version the go job's database tests run against
# (postgres:<version>-alpine).
POSTGRES_VERSION=16
# The pulumi CLI the go job installs: extensions/pulumi drives it through the
# Automation API, and its integration test runs it against a file:// backend.
# Keep it at the version of the Pulumi Go SDK that extensions/pulumi/go.mod
# and cmd/superschematic/go.mod require.
PULUMI_VERSION=3.259.0
