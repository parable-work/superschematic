# The one version every package in this repository carries: the npm packages
# under packages/, ir/typescript, runtime/schema/typescript,
# runtime/http/typescript, runtime/versiongraph/typescript and
# runtime/engine/typescript, the PyPI distribution under
# runtime/schema/python, the crates under
# runtime/http/rust and runtime/versiongraph/rust, and the inter-module
# requires in the Go go.mod files (the Go modules themselves are versioned by
# tags: vX.Y.Z, ir/vX.Y.Z, runtime/schema/go/vX.Y.Z, runtime/http/go/vX.Y.Z,
# runtime/versiongraph/go/vX.Y.Z).
#
# scripts/bump_version.py is the only thing that writes this file and the
# sites it lists; `bump_version.py check` fails when any site disagrees with
# it. 0.0.0 means unreleased. See CONTRIBUTING.md, "Releases".
VERSION=0.0.0
