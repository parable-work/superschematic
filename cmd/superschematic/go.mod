// The distribution builds against the checkout it lives in, as the other
// modules do (D1): the core, the IR and the official extensions it links.
// A release requires each at the tag and keeps these for local builds.
replace github.com/parable-work/superschematic => ../..

replace github.com/parable-work/superschematic/ir => ../../ir

replace github.com/parable-work/superschematic/extensions/cloudflare => ../../extensions/cloudflare

replace github.com/parable-work/superschematic/extensions/gcp => ../../extensions/gcp

replace github.com/parable-work/superschematic/extensions/pulumi => ../../extensions/pulumi

// replace directives do not propagate across modules, so the core's pins
// are repeated here. Keep them equal to the root go.mod.
replace github.com/microsoft/typescript-go => github.com/parable-work/typescript-go v0.0.0-20260701192534-c5de5679073f
