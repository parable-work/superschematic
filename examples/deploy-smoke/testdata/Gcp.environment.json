        {
          "name": "smoke-api",
          "kind": "API"
        }
      ],
      "language": "TYPESCRIPT",
      "artifact": "image",
      "worker": {
        "api": "smoke-api",
        "name": "DrainLineItems",
        "queue": "DrainLineItem",
        "database": "smoke-db",
        "instances": 1,
        "concurrency": 2,
        "graceSeconds": 8
      },
      "resourceName": "smoke-api-drain-line-items",
      "bindings": [
        {
          "field": "SMOKE_DB_DATABASE",
          "source": "derived",
          "value": {
            "cloudSql": {
              "database": {
                "$output": {
