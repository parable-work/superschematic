{
  "version": 1,
  "stack": "smoke-stack",
  "environment": "Gcp",
  "target": "gcp",
  "provisioner": "pulumi",
  "values": {
    "project": "superschematic-smoke",
    "region": "us-central1"
  },
  "deployables": [
    {
      "name": "smoke-api",
      "kind": "server",
      "platform": "gcp.cloudrun",
      "services": [
        {
          "name": "smoke-api",
          "kind": "API"
        }
      ],
      "language": "TYPESCRIPT",
      "artifact": "image",
      "origins": [
        "smoke-web"
      ],
      "resourceName": "smoke-api",
      "address": {
        "$output": {
          "resource": "smoke-api.service",
          "name": "uri"
        }
      },
      "bindings": [
        {
          "field": "SMOKE_DB_DATABASE",
          "source": "derived",
          "value": {
            "cloudSql": {
              "database": {
                "$output": {
                  "resource": "smoke-db.database.smoke-db",
                  "name": "name"
                }
              },
              "instance": {
                "$output": {
                  "resource": "smoke-db.instance",
                  "name": "connectionName"
                }
              },
              "user": "smoke-api@superschematic-smoke.iam"
            }
          },
          "edge": "sql:smoke-api->smoke-db"
        }
      ]
    },
    {
      "name": "smoke-api-drain-line-items",
