{
  "version": 1,
  "stack": "shop-stack",
  "environment": "Dev",
  "target": "local",
  "provisioner": "local",
  "deployables": [
    {
      "name": "shop-api",
      "kind": "server",
      "platform": "local.process",
      "services": [
        {
          "name": "shop-api",
          "kind": "API"
        }
      ],
      "buckets": [
        {
          "name": "shop-media",
          "kind": "Bucket"
        }
      ],
      "language": "GO",
      "exposed": true,
      "resourceName": "shop-api",
      "address": "http://127.0.0.1:22424",
      "publicAddress": "http://127.0.0.1:22424",
      "bindings": [
        {
          "field": "SHOP_API_CORS",
          "source": "derived",
          "value": {
            "origins": [
              "http://127.0.0.1:22638"
            ]
          },
          "corsOf": "shop-api",
          "edges": [
            "site:shop-web->shop-api"
          ]
        },
        {
          "field": "SHOP_API_IDENTITY",
          "source": "literal",
          "value": "{\"cookie\":{\"secure\":false}}",
          "default": true,
          "identityOf": "shop-api"
        },
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "url": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
          },
          "edge": "sql:shop-api->shop-db"
        },
        {
          "field": "SHOP_MEDIA_BUCKET",
          "source": "derived",
          "value": {
            "endpoint": "http://127.0.0.1:25259",
            "name": "shop-media"
          },
          "edge": "bucket:shop-api->shop-media"
        }
      ]
    },
    {
      "name": "shop-db",
      "kind": "database",
      "platform": "local.postgres",
      "services": [
        {
          "name": "shop-db",
          "kind": "DB"
        }
      ],
      "dialect": "postgres",
      "resourceName": "shop-db",
      "address": "127.0.0.1:32259"
    },
    {
      "name": "shop-media",
      "kind": "bucket",
      "platform": "local.gcs",
      "services": [
        {
          "name": "shop-media",
          "kind": "Bucket"
        }
      ],
      "resourceName": "shop-media",
      "address": "http://127.0.0.1:25259"
    },
    {
      "name": "shop-orders",
      "kind": "server",
      "platform": "local.process",
      "services": [
        {
          "name": "shop-orders",
          "kind": "API"
        }
      ],
      "calls": [
        {
          "name": "shop-stock",
          "kind": "API"
        }
      ],
      "language": "GO",
      "exposed": true,
      "resourceName": "shop-orders",
      "address": "http://127.0.0.1:21753",
      "publicAddress": "http://127.0.0.1:21753",
      "bindings": [
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "url": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
          },
          "edge": "sql:shop-orders->shop-db"
        },
        {
          "field": "SHOP_ORDERS_IDENTITY",
          "source": "literal",
          "value": "{\"cookie\":{\"secure\":false}}",
          "default": true,
          "identityOf": "shop-orders"
        },
        {
          "field": "SHOP_STOCK_SERVICE",
          "source": "derived",
          "value": {
            "credential": {
              "audience": "shop-stock",
              "issuer": "shop-orders",
              "key": {
                "$output": {
                  "resource": "shop-orders.calls.shop-stock.key",
                  "name": "privateJwk"
                }
              },
              "source": "signed-token"
            },
            "url": "http://127.0.0.1:21382"
          },
          "edge": "http:shop-orders->shop-stock"
        }
      ]
    },
    {
      "name": "shop-orders-fulfil-orders",
      "kind": "worker",
      "platform": "local.worker",
      "services": [
        {
          "name": "shop-orders",
          "kind": "API"
        }
      ],
      "calls": [
        {
          "name": "shop-stock",
          "kind": "API"
        }
      ],
      "language": "GO",
      "worker": {
        "api": "shop-orders",
        "name": "FulfilOrders",
        "queue": "OrderPlaced",
        "database": "shop-db",
        "instances": 1,
        "concurrency": 4,
        "graceSeconds": 8
      },
      "resourceName": "shop-orders-fulfil-orders",
      "bindings": [
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "url": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
          },
          "edge": "sql:shop-orders-fulfil-orders->shop-db"
        },
        {
          "field": "SHOP_STOCK_SERVICE",
          "source": "derived",
          "value": {
            "credential": {
              "audience": "shop-stock",
              "issuer": "shop-orders-fulfil-orders",
              "key": {
                "$output": {
                  "resource": "shop-orders-fulfil-orders.calls.shop-stock.key",
                  "name": "privateJwk"
                }
              },
              "source": "signed-token"
            },
            "url": "http://127.0.0.1:21382"
          },
          "edge": "http:shop-orders-fulfil-orders->shop-stock"
        }
      ]
    },
    {
      "name": "shop-orders-ship-orders",
      "kind": "job",
      "platform": "local.job",
      "services": [
        {
          "name": "shop-orders",
          "kind": "API"
        }
      ],
      "calls": [
        {
          "name": "shop-stock",
          "kind": "API"
        }
      ],
      "language": "GO",
      "job": {
        "api": "shop-orders",
        "name": "ShipOrders",
        "schedule": "* * * * *",
        "timeZone": "UTC",
        "timeoutSeconds": 300,
        "retries": 1
      },
      "resourceName": "shop-orders-ship-orders",
      "bindings": [
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "url": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
          },
          "edge": "sql:shop-orders-ship-orders->shop-db"
        },
        {
          "field": "SHOP_STOCK_SERVICE",
          "source": "derived",
          "value": {
            "credential": {
              "audience": "shop-stock",
              "issuer": "shop-orders-ship-orders",
              "key": {
                "$output": {
                  "resource": "shop-orders-ship-orders.calls.shop-stock.key",
                  "name": "privateJwk"
                }
              },
              "source": "signed-token"
            },
            "url": "http://127.0.0.1:21382"
          },
          "edge": "http:shop-orders-ship-orders->shop-stock"
        }
      ]
    },
    {
      "name": "shop-stock",
      "kind": "server",
      "platform": "local.process",
      "services": [
        {
          "name": "shop-stock",
          "kind": "API"
        }
      ],
      "language": "RUST",
      "exposed": true,
      "resourceName": "shop-stock",
      "address": "http://127.0.0.1:21382",
      "publicAddress": "http://127.0.0.1:21382",
      "bindings": [
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "url": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
          },
          "edge": "sql:shop-stock->shop-db"
        },
        {
          "field": "SHOP_STOCK_CALLERS",
          "source": "derived",
          "value": {
            "issuers": [
              {
                "algorithms": [
                  "EdDSA"
                ],
                "audience": "shop-stock",
                "callers": [
                  {
                    "deployable": "shop-orders",
                    "serves": [
                      "shop-orders"
                    ],
                    "subject": "shop-orders"
                  }
                ],
                "issuer": "shop-orders",
                "keys": [
                  {
                    "jwk": {
                      "$output": {
                        "resource": "shop-orders.calls.shop-stock.key",
                        "name": "publicJwk"
                      }
                    }
                  }
                ],
                "maxLifetimeSeconds": 300
              },
              {
                "algorithms": [
                  "EdDSA"
                ],
                "audience": "shop-stock",
                "callers": [
                  {
                    "deployable": "shop-orders-fulfil-orders",
                    "serves": [
                      "shop-orders"
                    ],
                    "subject": "shop-orders-fulfil-orders"
                  }
                ],
                "issuer": "shop-orders-fulfil-orders",
                "keys": [
                  {
                    "jwk": {
                      "$output": {
                        "resource": "shop-orders-fulfil-orders.calls.shop-stock.key",
                        "name": "publicJwk"
                      }
                    }
                  }
                ],
                "maxLifetimeSeconds": 300
              },
              {
                "algorithms": [
                  "EdDSA"
                ],
                "audience": "shop-stock",
                "callers": [
                  {
                    "deployable": "shop-orders-ship-orders",
                    "serves": [
                      "shop-orders"
                    ],
                    "subject": "shop-orders-ship-orders"
                  }
                ],
                "issuer": "shop-orders-ship-orders",
                "keys": [
                  {
                    "jwk": {
                      "$output": {
                        "resource": "shop-orders-ship-orders.calls.shop-stock.key",
                        "name": "publicJwk"
                      }
                    }
                  }
                ],
                "maxLifetimeSeconds": 300
              }
            ]
          },
          "callersOf": "shop-stock",
          "edges": [
            "http:shop-orders->shop-stock",
            "http:shop-orders-fulfil-orders->shop-stock",
            "http:shop-orders-ship-orders->shop-stock"
          ]
        },
        {
          "field": "SHOP_STOCK_IDENTITY",
          "source": "literal",
          "value": "{\"cookie\":{\"secure\":false}}",
          "default": true,
          "identityOf": "shop-stock"
        }
      ]
    },
    {
      "name": "shop-storefront",
      "kind": "server",
      "platform": "local.process",
      "services": [
        {
          "name": "shop-storefront",
          "kind": "API"
        }
      ],
      "language": "TYPESCRIPT",
      "exposed": true,
      "resourceName": "shop-storefront",
      "address": "http://127.0.0.1:22420",
      "publicAddress": "http://127.0.0.1:22420"
    },
    {
      "name": "shop-web",
      "kind": "site",
      "platform": "local.site",
      "services": [
        {
          "name": "shop-web",
          "kind": "Site"
        }
      ],
      "calls": [
        {
          "name": "shop-api",
          "kind": "API"
        }
      ],
      "site": {
        "dir": "web/shop-web",
        "build": "build",
        "output": "dist",
        "fallback": "index.html"
      },
      "exposed": true,
      "resourceName": "shop-web",
      "address": "http://127.0.0.1:22638",
      "publicAddress": "http://127.0.0.1:22638",
      "bindings": [
        {
          "field": "shop-api",
          "source": "derived",
          "value": {
            "url": "http://127.0.0.1:22424"
          },
          "edge": "site:shop-web->shop-api"
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "bucket:shop-api->shop-media",
      "kind": "bucket",
      "from": "shop-api",
      "to": "shop-media",
      "service": {
        "name": "shop-media",
        "kind": "Bucket"
      },
      "connector": "local.process-gcs",
      "field": "SHOP_MEDIA_BUCKET"
    },
    {
      "id": "http:shop-orders->shop-stock",
      "kind": "http",
      "from": "shop-orders",
      "to": "shop-stock",
      "service": {
        "name": "shop-stock",
        "kind": "API"
      },
      "connector": "local.process-process",
      "field": "SHOP_STOCK_SERVICE"
    },
    {
      "id": "http:shop-orders-fulfil-orders->shop-stock",
      "kind": "http",
      "from": "shop-orders-fulfil-orders",
      "to": "shop-stock",
      "service": {
        "name": "shop-stock",
        "kind": "API"
      },
      "connector": "local.worker-process",
      "field": "SHOP_STOCK_SERVICE"
    },
    {
      "id": "http:shop-orders-ship-orders->shop-stock",
      "kind": "http",
      "from": "shop-orders-ship-orders",
      "to": "shop-stock",
      "service": {
        "name": "shop-stock",
        "kind": "API"
      },
      "connector": "local.job-process",
      "field": "SHOP_STOCK_SERVICE"
    },
    {
      "id": "site:shop-web->shop-api",
      "kind": "site",
      "from": "shop-web",
      "to": "shop-api",
      "service": {
        "name": "shop-api",
        "kind": "API"
      },
      "connector": "local.site-process",
      "field": "shop-api"
    },
    {
      "id": "sql:shop-api->shop-db",
      "kind": "sql",
      "from": "shop-api",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "local.process-postgres",
      "field": "SHOP_DB_DATABASE"
    },
    {
      "id": "sql:shop-orders->shop-db",
      "kind": "sql",
      "from": "shop-orders",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "local.process-postgres",
      "field": "SHOP_DB_DATABASE"
    },
    {
      "id": "sql:shop-orders-fulfil-orders->shop-db",
      "kind": "sql",
      "from": "shop-orders-fulfil-orders",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "local.worker-postgres",
      "field": "SHOP_DB_DATABASE"
    },
    {
      "id": "sql:shop-orders-ship-orders->shop-db",
      "kind": "sql",
      "from": "shop-orders-ship-orders",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "local.job-postgres",
      "field": "SHOP_DB_DATABASE"
    },
    {
      "id": "sql:shop-stock->shop-db",
      "kind": "sql",
      "from": "shop-stock",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "local.process-postgres",
      "field": "SHOP_DB_DATABASE"
    }
  ],
  "resources": {
    "resources": [
      {
        "id": "postgres.container",
        "type": "local:docker/container:Container",
        "properties": {
          "env": [
            {
              "name": "POSTGRES_HOST_AUTH_METHOD",
              "value": "trust"
            }
          ],
          "image": "postgres:16-alpine",
          "labels": {
            "superschematic.environment": "Dev",
            "superschematic.stack": "shop-stack"
          },
          "name": "superschematic-shop-stack-dev-postgres",
          "ports": [
            {
              "containerPort": 5432,
              "host": "127.0.0.1",
              "hostPort": 32259
            }
          ],
          "readiness": {
            "exec": [
              "pg_isready",
              "--host",
              "127.0.0.1",
              "--port",
              "5432",
              "--username",
              "postgres",
              "--quiet"
            ]
          }
        },
        "phase": "infrastructure",
        "owners": [
          "shop-db"
        ]
      },
      {
        "id": "shop-api.process",
        "type": "local:process/process:Process",
        "properties": {
          "env": [
            {
              "name": "SHOP_API_CORS_ORIGINS",
              "value": "http://127.0.0.1:22638"
            },
            {
              "name": "SHOP_API_IDENTITY",
              "value": "{\"cookie\":{\"secure\":false}}"
            },
            {
              "name": "SHOP_DB_DATABASE_URL",
              "value": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
            },
            {
              "name": "SHOP_MEDIA_BUCKET_ENDPOINT",
              "value": "http://127.0.0.1:25259"
            },
            {
              "name": "SHOP_MEDIA_BUCKET_NAME",
              "value": "shop-media"
            }
          ],
          "language": "go",
          "module": "server/shop-stack/shop-api",
          "name": "shop-api",
          "port": 22424,
          "readiness": "/readyz"
        },
        "phase": "rollout",
        "owners": [
          "shop-api"
        ]
      },
      {
        "id": "shop-db.database.shop-db",
        "type": "local:postgres/database:Database",
        "properties": {
          "container": {
            "$output": {
              "resource": "postgres.container",
              "name": "name"
            }
          },
          "name": "shop_db",
          "service": "shop-db",
          "url": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
        },
        "dependsOn": [
          "postgres.container"
        ],
        "phase": "infrastructure",
        "owners": [
          "shop-db"
        ]
      },
      {
        "id": "shop-media.bucket",
        "type": "local:storage/bucket:Bucket",
        "properties": {
          "container": {
            "$output": {
              "resource": "storage.container",
              "name": "name"
            }
          },
          "endpoint": "http://127.0.0.1:25259",
          "name": "shop-media",
          "service": "shop-media"
        },
        "dependsOn": [
          "storage.container"
        ],
        "phase": "infrastructure",
        "owners": [
          "shop-media"
        ]
      },
      {
        "id": "shop-orders-fulfil-orders.calls.shop-stock.key",
        "type": "local:serviceauth/keyPair:KeyPair",
        "properties": {
          "algorithm": "Ed25519",
          "callee": "shop-stock",
          "caller": "shop-orders-fulfil-orders"
        },
        "phase": "infrastructure",
        "owners": [
          "http:shop-orders-fulfil-orders->shop-stock"
        ]
      },
      {
        "id": "shop-orders-fulfil-orders.process",
        "type": "local:process/process:Process",
        "properties": {
          "env": [
            {
              "name": "SHOP_DB_DATABASE_URL",
              "value": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
            },
            {
              "name": "SHOP_STOCK_SERVICE_CREDENTIAL_AUDIENCE",
              "value": "shop-stock"
            },
            {
              "name": "SHOP_STOCK_SERVICE_CREDENTIAL_ISSUER",
              "value": "shop-orders-fulfil-orders"
            },
            {
              "name": "SHOP_STOCK_SERVICE_CREDENTIAL_KEY",
              "value": {
                "$output": {
                  "resource": "shop-orders-fulfil-orders.calls.shop-stock.key",
                  "name": "privateJwk"
                }
              }
            },
            {
              "name": "SHOP_STOCK_SERVICE_CREDENTIAL_SOURCE",
              "value": "signed-token"
            },
            {
              "name": "SHOP_STOCK_SERVICE_URL",
              "value": "http://127.0.0.1:21382"
            },
            {
              "name": "WORKER_CONCURRENCY",
              "value": "4"
            }
          ],
          "kind": "worker",
          "language": "go",
          "module": "server/shop-stack/shop-orders-fulfil-orders",
          "name": "shop-orders-fulfil-orders",
          "readiness": "started"
        },
        "dependsOn": [
          "shop-orders-fulfil-orders.calls.shop-stock.key"
        ],
        "phase": "rollout",
        "owners": [
          "shop-orders-fulfil-orders"
        ]
      },
      {
        "id": "shop-orders-ship-orders.calls.shop-stock.key",
        "type": "local:serviceauth/keyPair:KeyPair",
        "properties": {
          "algorithm": "Ed25519",
          "callee": "shop-stock",
          "caller": "shop-orders-ship-orders"
        },
        "phase": "infrastructure",
        "owners": [
          "http:shop-orders-ship-orders->shop-stock"
        ]
      },
      {
        "id": "shop-orders-ship-orders.job",
        "type": "local:process/job:Job",
        "properties": {
          "api": "shop-orders",
          "env": [
            {
              "name": "SHOP_DB_DATABASE_URL",
              "value": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
            },
            {
              "name": "SHOP_STOCK_SERVICE_CREDENTIAL_AUDIENCE",
              "value": "shop-stock"
            },
            {
              "name": "SHOP_STOCK_SERVICE_CREDENTIAL_ISSUER",
              "value": "shop-orders-ship-orders"
            },
            {
              "name": "SHOP_STOCK_SERVICE_CREDENTIAL_KEY",
              "value": {
                "$output": {
                  "resource": "shop-orders-ship-orders.calls.shop-stock.key",
                  "name": "privateJwk"
                }
              }
            },
            {
              "name": "SHOP_STOCK_SERVICE_CREDENTIAL_SOURCE",
              "value": "signed-token"
            },
            {
              "name": "SHOP_STOCK_SERVICE_URL",
              "value": "http://127.0.0.1:21382"
            }
          ],
          "job": "ShipOrders",
          "language": "go",
          "module": "server/shop-stack/shop-orders-ship-orders",
          "name": "shop-orders-ship-orders",
          "retries": 1,
          "schedule": "* * * * *",
          "timeZone": "UTC",
          "timeoutSeconds": 300
        },
        "dependsOn": [
          "shop-orders-ship-orders.calls.shop-stock.key"
        ],
        "phase": "rollout",
        "owners": [
          "shop-orders-ship-orders"
        ]
      },
      {
        "id": "shop-orders.calls.shop-stock.key",
        "type": "local:serviceauth/keyPair:KeyPair",
        "properties": {
          "algorithm": "Ed25519",
          "callee": "shop-stock",
          "caller": "shop-orders"
        },
        "phase": "infrastructure",
        "owners": [
          "http:shop-orders->shop-stock"
        ]
      },
      {
        "id": "shop-orders.process",
        "type": "local:process/process:Process",
        "properties": {
          "env": [
            {
              "name": "SHOP_DB_DATABASE_URL",
              "value": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
            },
            {
              "name": "SHOP_ORDERS_IDENTITY",
              "value": "{\"cookie\":{\"secure\":false}}"
            },
            {
              "name": "SHOP_STOCK_SERVICE_CREDENTIAL_AUDIENCE",
              "value": "shop-stock"
            },
            {
              "name": "SHOP_STOCK_SERVICE_CREDENTIAL_ISSUER",
              "value": "shop-orders"
            },
            {
              "name": "SHOP_STOCK_SERVICE_CREDENTIAL_KEY",
              "value": {
                "$output": {
                  "resource": "shop-orders.calls.shop-stock.key",
