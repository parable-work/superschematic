{
  "version": 1,
  "stack": "shop-stack",
  "environment": "Dev",
  "target": "local",
  "provisioner": "local",
  "deployables": [
    {
      "name": "shop-api",
      "kind": "server",
      "platform": "local.process",
      "services": [
        {
          "name": "shop-api",
          "kind": "API"
        }
      ],
      "buckets": [
        {
          "name": "shop-media",
          "kind": "Bucket"
        }
      ],
      "language": "GO",
      "exposed": true,
      "resourceName": "shop-api",
      "address": "http://127.0.0.1:22424",
      "publicAddress": "http://127.0.0.1:22424",
      "bindings": [
        {
          "field": "SHOP_API_CORS",
          "source": "derived",
          "value": {
            "origins": [
              "http://127.0.0.1:22638"
            ]
          },
          "corsOf": "shop-api",
          "edges": [
            "site:shop-web->shop-api"
          ]
        },
        {
          "field": "SHOP_API_IDENTITY",
          "source": "literal",
          "value": "{\"cookie\":{\"secure\":false}}",
          "default": true,
          "identityOf": "shop-api"
        },
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "url": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
          },
          "edge": "sql:shop-api->shop-db"
        },
        {
          "field": "SHOP_MEDIA_BUCKET",
          "source": "derived",
          "value": {
            "endpoint": "http://127.0.0.1:25259",
            "name": "shop-media"
          },
          "edge": "bucket:shop-api->shop-media"
        }
      ]
    },
    {
      "name": "shop-db",
      "kind": "database",
      "platform": "local.postgres",
      "services": [
        {
          "name": "shop-db",
          "kind": "DB"
        }
      ],
      "dialect": "postgres",
      "resourceName": "shop-db",
      "address": "127.0.0.1:32259"
    },
    {
      "name": "shop-media",
      "kind": "bucket",
      "platform": "local.gcs",
      "services": [
        {
          "name": "shop-media",
          "kind": "Bucket"
        }
      ],
      "resourceName": "shop-media",
      "address": "http://127.0.0.1:25259"
    },
    {
      "name": "shop-orders",
      "kind": "server",
      "platform": "local.process",
      "services": [
        {
          "name": "shop-orders",
          "kind": "API"
        }
      ],
      "language": "GO",
      "exposed": true,
      "resourceName": "shop-orders",
      "address": "http://127.0.0.1:21753",
      "publicAddress": "http://127.0.0.1:21753",
      "bindings": [
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "url": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
          },
          "edge": "sql:shop-orders->shop-db"
        },
        {
          "field": "SHOP_ORDERS_IDENTITY",
          "source": "literal",
          "value": "{\"cookie\":{\"secure\":false}}",
          "default": true,
          "identityOf": "shop-orders"
        }
      ]
    },
    {
      "name": "shop-orders-fulfil-orders",
      "kind": "worker",
      "platform": "local.worker",
      "services": [
        {
          "name": "shop-orders",
          "kind": "API"
        }
      ],
      "language": "GO",
      "worker": {
        "api": "shop-orders",
        "name": "FulfilOrders",
        "queue": "OrderPlaced",
        "database": "shop-db",
        "instances": 1,
        "concurrency": 4,
        "graceSeconds": 8
      },
      "resourceName": "shop-orders-fulfil-orders",
      "bindings": [
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "url": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
          },
          "edge": "sql:shop-orders-fulfil-orders->shop-db"
        }
      ]
    },
    {
      "name": "shop-orders-ship-orders",
      "kind": "job",
      "platform": "local.job",
      "services": [
        {
          "name": "shop-orders",
          "kind": "API"
        }
      ],
      "language": "GO",
      "job": {
        "api": "shop-orders",
        "name": "ShipOrders",
        "schedule": "* * * * *",
        "timeZone": "UTC",
        "timeoutSeconds": 300,
        "retries": 1
      },
      "resourceName": "shop-orders-ship-orders",
      "bindings": [
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "url": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
          },
          "edge": "sql:shop-orders-ship-orders->shop-db"
        }
      ]
    },
    {
      "name": "shop-storefront",
      "kind": "server",
      "platform": "local.process",
      "services": [
        {
          "name": "shop-storefront",
          "kind": "API"
        }
      ],
      "language": "TYPESCRIPT",
      "exposed": true,
      "resourceName": "shop-storefront",
      "address": "http://127.0.0.1:22420",
      "publicAddress": "http://127.0.0.1:22420"
    },
    {
      "name": "shop-web",
      "kind": "site",
      "platform": "local.site",
      "services": [
        {
          "name": "shop-web",
          "kind": "Site"
        }
      ],
      "calls": [
        {
          "name": "shop-api",
          "kind": "API"
        }
      ],
      "site": {
        "dir": "web/shop-web",
        "build": "build",
        "output": "dist",
        "fallback": "index.html"
      },
      "exposed": true,
      "resourceName": "shop-web",
      "address": "http://127.0.0.1:22638",
      "publicAddress": "http://127.0.0.1:22638",
      "bindings": [
        {
          "field": "shop-api",
          "source": "derived",
          "value": {
            "url": "http://127.0.0.1:22424"
          },
          "edge": "site:shop-web->shop-api"
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "bucket:shop-api->shop-media",
      "kind": "bucket",
      "from": "shop-api",
      "to": "shop-media",
      "service": {
        "name": "shop-media",
        "kind": "Bucket"
      },
      "connector": "local.process-gcs",
      "field": "SHOP_MEDIA_BUCKET"
    },
    {
      "id": "site:shop-web->shop-api",
      "kind": "site",
      "from": "shop-web",
      "to": "shop-api",
      "service": {
        "name": "shop-api",
        "kind": "API"
      },
      "connector": "local.site-process",
      "field": "shop-api"
    },
    {
      "id": "sql:shop-api->shop-db",
      "kind": "sql",
      "from": "shop-api",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "local.process-postgres",
      "field": "SHOP_DB_DATABASE"
    },
    {
      "id": "sql:shop-orders->shop-db",
      "kind": "sql",
      "from": "shop-orders",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "local.process-postgres",
      "field": "SHOP_DB_DATABASE"
    },
    {
      "id": "sql:shop-orders-fulfil-orders->shop-db",
      "kind": "sql",
      "from": "shop-orders-fulfil-orders",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "local.worker-postgres",
      "field": "SHOP_DB_DATABASE"
    },
    {
      "id": "sql:shop-orders-ship-orders->shop-db",
      "kind": "sql",
      "from": "shop-orders-ship-orders",
      "to": "shop-db",
      "service": {
        "name": "shop-db",
        "kind": "DB"
      },
      "connector": "local.job-postgres",
      "field": "SHOP_DB_DATABASE"
    }
  ],
  "resources": {
    "resources": [
      {
        "id": "postgres.container",
        "type": "local:docker/container:Container",
        "properties": {
          "env": [
            {
              "name": "POSTGRES_HOST_AUTH_METHOD",
              "value": "trust"
            }
          ],
          "image": "postgres:16-alpine",
          "labels": {
            "superschematic.environment": "Dev",
            "superschematic.stack": "shop-stack"
          },
          "name": "superschematic-shop-stack-dev-postgres",
          "ports": [
            {
              "containerPort": 5432,
              "host": "127.0.0.1",
              "hostPort": 32259
            }
          ],
          "readiness": {
            "exec": [
              "pg_isready",
              "--host",
              "127.0.0.1",
              "--port",
              "5432",
              "--username",
              "postgres",
              "--quiet"
            ]
          }
        },
        "phase": "infrastructure",
        "owners": [
          "shop-db"
        ]
      },
      {
        "id": "shop-api.process",
        "type": "local:process/process:Process",
        "properties": {
          "env": [
            {
              "name": "SHOP_API_CORS_ORIGINS",
              "value": "http://127.0.0.1:22638"
            },
            {
              "name": "SHOP_API_IDENTITY",
              "value": "{\"cookie\":{\"secure\":false}}"
            },
            {
              "name": "SHOP_DB_DATABASE_URL",
              "value": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
            },
            {
              "name": "SHOP_MEDIA_BUCKET_ENDPOINT",
              "value": "http://127.0.0.1:25259"
            },
            {
              "name": "SHOP_MEDIA_BUCKET_NAME",
              "value": "shop-media"
            }
          ],
          "language": "go",
          "module": "server/shop-stack/shop-api",
          "name": "shop-api",
          "port": 22424,
          "readiness": "/readyz"
        },
        "phase": "rollout",
        "owners": [
          "shop-api"
        ]
      },
      {
        "id": "shop-db.database.shop-db",
        "type": "local:postgres/database:Database",
        "properties": {
          "container": {
            "$output": {
              "resource": "postgres.container",
              "name": "name"
            }
          },
          "name": "shop_db",
          "service": "shop-db",
          "url": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
        },
        "dependsOn": [
          "postgres.container"
        ],
        "phase": "infrastructure",
        "owners": [
          "shop-db"
        ]
      },
      {
        "id": "shop-media.bucket",
        "type": "local:storage/bucket:Bucket",
        "properties": {
          "container": {
            "$output": {
              "resource": "storage.container",
              "name": "name"
            }
          },
          "endpoint": "http://127.0.0.1:25259",
          "name": "shop-media",
          "service": "shop-media"
        },
        "dependsOn": [
          "storage.container"
        ],
        "phase": "infrastructure",
        "owners": [
          "shop-media"
        ]
      },
      {
        "id": "shop-orders-fulfil-orders.process",
        "type": "local:process/process:Process",
        "properties": {
          "env": [
            {
              "name": "SHOP_DB_DATABASE_URL",
              "value": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
            },
            {
              "name": "WORKER_CONCURRENCY",
              "value": "4"
            }
          ],
          "kind": "worker",
          "language": "go",
          "module": "server/shop-stack/shop-orders-fulfil-orders",
          "name": "shop-orders-fulfil-orders",
          "readiness": "started"
        },
        "phase": "rollout",
        "owners": [
          "shop-orders-fulfil-orders"
        ]
      },
      {
        "id": "shop-orders-ship-orders.job",
        "type": "local:process/job:Job",
        "properties": {
          "api": "shop-orders",
          "env": [
            {
              "name": "SHOP_DB_DATABASE_URL",
              "value": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
            }
          ],
          "job": "ShipOrders",
          "language": "go",
          "module": "server/shop-stack/shop-orders-ship-orders",
          "name": "shop-orders-ship-orders",
          "retries": 1,
          "schedule": "* * * * *",
          "timeZone": "UTC",
          "timeoutSeconds": 300
        },
        "phase": "rollout",
        "owners": [
          "shop-orders-ship-orders"
        ]
      },
      {
        "id": "shop-orders.process",
        "type": "local:process/process:Process",
        "properties": {
          "env": [
            {
              "name": "SHOP_DB_DATABASE_URL",
              "value": "postgres://postgres@127.0.0.1:32259/shop_db?sslmode=disable"
            },
            {
              "name": "SHOP_ORDERS_IDENTITY",
              "value": "{\"cookie\":{\"secure\":false}}"
            }
          ],
          "language": "go",
          "module": "server/shop-stack/shop-orders",
          "name": "shop-orders",
          "port": 21753,
          "readiness": "/readyz"
        },
        "phase": "rollout",
        "owners": [
          "shop-orders"
        ]
      },
      {
        "id": "shop-storefront.process",
        "type": "local:process/process:Process",
        "properties": {
          "language": "typescript",
          "module": "server/shop-stack/shop-storefront",
          "name": "shop-storefront",
          "port": 22420,
          "readiness": "/readyz"
        },
        "phase": "rollout",
        "owners": [
          "shop-storefront"
        ]
      },
      {
        "id": "shop-web.site",
        "type": "local:site/site:Site",
        "properties": {
          "build": "build",
          "config": {
            "apis": {
              "shop-api": {
                "url": "http://127.0.0.1:22424"
              }
            }
          },
          "dir": "web/shop-web",
          "fallback": "index.html",
          "name": "shop-web",
          "output": "dist",
          "port": 22638
        },
        "phase": "rollout",
        "owners": [
          "shop-web"
        ]
      },
      {
        "id": "storage.container",
        "type": "local:docker/container:Container",
        "properties": {
          "args": [
            "-scheme",
            "http",
            "-host",
            "0.0.0.0",
            "-port",
            "4443",
            "-backend",
            "filesystem",
            "-filesystem-root",
            "/storage",
            "-public-host",
            "127.0.0.1:25259",
            "-external-url",
            "http://127.0.0.1:25259"
          ],
          "image": "fsouza/fake-gcs-server:1.56.1",
          "labels": {
            "superschematic.environment": "Dev",
            "superschematic.stack": "shop-stack"
          },
          "name": "superschematic-shop-stack-dev-storage",
          "ports": [
            {
              "containerPort": 4443,
              "host": "127.0.0.1",
              "hostPort": 25259
            }
          ],
          "readiness": {
            "http": "/storage/v1/b"
          }
        },
        "phase": "infrastructure",
        "owners": [
          "shop-media"
        ]
      }
    ]
  },
  "deployOrder": [
    {
      "step": "infrastructure",
      "resources": [
        "postgres.container",
        "shop-db.database.shop-db",
        "shop-media.bucket",
        "storage.container"
      ]
    },
    {
      "step": "migrate",
      "migration": "expand",
      "deployables": [
        "shop-db"
      ]
    },
    {
      "step": "rollout",
      "wave": 1,
      "deployables": [
        "shop-api",
        "shop-orders",
        "shop-orders-fulfil-orders",
        "shop-orders-ship-orders",
        "shop-storefront"
      ],
      "resources": [
        "shop-api.process",
        "shop-orders-fulfil-orders.process",
        "shop-orders-ship-orders.job",
        "shop-orders.process",
        "shop-storefront.process"
      ]
    },
    {
      "step": "rollout",
      "wave": 2,
      "deployables": [
        "shop-web"
      ],
      "resources": [
        "shop-web.site"
      ]
    },
    {
      "step": "migrate",
      "migration": "contract",
      "deployables": [
        "shop-db"
      ]
    }
  ]
}
