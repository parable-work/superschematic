{
  "name": "@acme/shop-web-site",
  "version": "0.0.0",
  "description": "The shop's static site, which lists shop-api's products from the browser.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && bun build ./index.html --outdir=dist --public-path=/ --minify",
    "dev": "bun --port=${PORT:-3000} ./index.html",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@acme/shop-api-sdk": "workspace:*",
    "@acme/shop-api-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
