+// Perishable is @perishable's argument: how long a field's values keep.
+type Perishable struct {
+	Days int `json:"days"`
+}
+
 // fieldExt is the acme slot on a field: the codec both the decorators and
 // the generators go through. Each field decorator is one member, so adding
 // another means a member here and nothing outside this package.
 type fieldExt struct {
-	Shelf   *Shelf `json:"shelf,omitempty"`
-	FeedKey bool   `json:"feedKey,omitempty"`
+	Shelf      *Shelf      `json:"shelf,omitempty"`
+	FeedKey    bool        `json:"feedKey,omitempty"`
+	Perishable *Perishable `json:"perishable,omitempty"`
 }
 
 // ShelfArgs is @shelf's argument schema. Both frontends validate every use
@@ -36,9 +42,34 @@ var ShelfArgs = json.RawMessage(`{
 	}
 }`)
 
+// PerishableArgs is @perishable's argument schema.
+var PerishableArgs = json.RawMessage(`{
+	"type": "object",
+	"required": ["days"],
+	"additionalProperties": false,
+	"properties": {"days": {"type": "integer", "minimum": 1}}
+}`)
+
 // registerDecorator adds acme's field decorators from @acme/schema. Each
 // is only allowed in Catalog schemas.
 func registerDecorator(r *registry.Registry) error {
+	if err := r.RegisterDecorator(registry.DecoratorSpec{
+		Name:      "perishable",
+		Extension: Name,
+		Packages:  []string{Package},
+		Target:    registry.TargetField,
+		Kinds:     []string{Kind},
+		Args:      PerishableArgs,
+		Apply: func(n registry.Node, args []any, _ registry.Site) error {
+			var p Perishable
+			if err := registry.DecodeArgs(args, &p); err != nil {
+				return err
+			}
+			return ir.UpdateExtension(n.Field, Name, func(f *fieldExt) { f.Perishable = &p })
+		},
+	}); err != nil {
+		return err
+	}
 	if err := r.RegisterDecorator(registry.DecoratorSpec{
 		Name:      "shelf",
 		Extension: Name,
@@ -91,3 +122,12 @@ func IsFeedKey(fd *ir.FieldDef) (bool, error) {
 	}
 	return f.FeedKey, nil
 }
+
+// PerishableOf returns the shelf life declared on fd, if any.
+func PerishableOf(fd *ir.FieldDef) (*Perishable, bool, error) {
+	f, ok, err := ir.GetExtension[fieldExt](fd, Name)
+	if err != nil || !ok || f.Perishable == nil {
+		return nil, false, err
+	}
+	return f.Perishable, true, nil
+}
