          ],
          "now": 1004000,
          "error": {
            "class": "OperationParamsError",
            "code": "invalid_argument",
            "message": "operation rate of behavior acme.Rating: /stars: must be integer",
            "details": {
              "issues": [
                {
                  "path": "/stars",
                  "message": "must be integer"
                }
              ]
            }
          }
        },
        {
          "engine": "e1",
          "call": "instances.invoke",
          "principal": "cy",
          "args": [
            "Product",
            "p1",
            "rate",
            {
              "stars": 3
            }
          ],
          "now": 1005000,
          "expect": {
            "ratingCount": 3,
            "ratingAverage": 3.3333333333333335
          }
        },
        {
          "engine": "e1",
          "call": "instances.invoke",
          "principal": "dee",
          "args": [
            "Product",
            "p1",
            "ratingSummary",
            {}
          ],
          "now": 1006000,
          "expect": {
            "ratingCount": 3,
            "ratingAverage": 3.3333333333333335
          }
        },
        {
          "engine": "e1",
          "call": "instances.get",
          "principal": "admin",
          "args": [
            "Product",
            "p1"
          ],
          "expect": {
            "namespace": "default",
            "schema": "Product",
            "id": "p1",
            "data": {
              "title": "Desk lamp"
            },
            "behaviors": {
              "acme.Rating": {
                "ratingCount": 3,
                "ratingAverage": 3.3333333333333335
              }
            }
          }
        }
      ]
