{
  "version": 1,
  "stack": "shop-stack",
  "environment": "Production",
  "target": "fake",
  "provisioner": "fake",
  "values": {
    "production": true,
    "project": "acme-prod",
    "region": "us-east1"
  },
  "domain": "acme.dev",
  "dns": {
    "platform": "fake.dns",
    "records": [
      {
        "name": "shop-api.acme.dev",
        "type": "CNAME",
        "value": {
          "$output": {
            "resource": "shop-api.route",
            "name": "target"
          }
        },
        "deployable": "shop-api"
      },
      {
        "name": "shop-web.acme.dev",
        "type": "CNAME",
        "value": {
          "$output": {
            "resource": "shop-web.route",
            "name": "target"
          }
        },
        "deployable": "shop-web"
      }
    ]
  },
  "deployables": [
    {
      "name": "Orders",
      "kind": "server",
      "declared": true,
      "platform": "fake.run",
      "services": [
        {
          "name": "shop-orders",
          "kind": "API"
        }
      ],
      "calls": [
        {
          "name": "shop-api",
          "kind": "API"
        }
      ],
      "language": "GO",
      "resourceName": "orders",
      "address": {
        "$output": {
          "resource": "Orders.service",
          "name": "url"
        }
      },
      "bindings": [
        {
          "field": "FULFILLMENT_REGION",
          "source": "literal",
          "value": "us"
        },
        {
          "field": "MAX_LINE_ITEMS",
          "source": "literal",
          "value": "50",
          "default": true
        },
        {
          "field": "SHOP_API_SERVICE",
          "source": "derived",
          "value": {
            "credential": {
              "audience": "shop-api",
              "source": "google-id-token"
            },
            "url": {
              "$output": {
                "resource": "shop-api.service",
                "name": "url"
              }
            }
          },
          "edge": "http:Orders->shop-api"
        },
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "cloudSql": {
              "database": {
                "$output": {
                  "resource": "shop-db.database.shop-db",
                  "name": "name"
                }
              },
              "instance": {
                "$output": {
                  "resource": "shop-db.instance",
                  "name": "connectionName"
                }
              },
              "user": {
                "$output": {
                  "resource": "Orders.account",
                  "name": "email"
                }
              }
            }
          },
          "edge": "sql:Orders->shop-db"
        },
        {
          "field": "STRIPE_KEY",
          "source": "secret",
          "secret": "PaymentsSecrets.STRIPE_KEY"
        }
      ]
    },
    {
      "name": "shop-api",
      "kind": "server",
      "platform": "fake.run",
      "services": [
        {
          "name": "shop-api",
          "kind": "API"
        }
      ],
      "buckets": [
        {
          "name": "shop-media",
          "kind": "Bucket"
        }
      ],
      "language": "GO",
      "exposed": true,
      "settings": {
        "minInstances": 1
      },
      "resourceName": "shop-api",
      "address": {
        "$output": {
          "resource": "shop-api.service",
          "name": "url"
        }
      },
      "publicAddress": "https://shop-api.acme.dev",
      "bindings": [
        {
          "field": "LOG_LEVEL",
          "source": "literal",
          "value": "warn"
        },
        {
          "field": "SHOP_API_CORS",
          "source": "derived",
          "value": {
            "origins": [
              "https://shop-web.acme.dev"
            ]
          },
          "corsOf": "shop-api",
          "edges": [
            "site:shop-web->shop-api"
          ]
        },
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "cloudSql": {
              "database": {
                "$output": {
                  "resource": "shop-db.database.shop-db",
                  "name": "name"
                }
              },
              "instance": {
                "$output": {
                  "resource": "shop-db.instance",
                  "name": "connectionName"
                }
              },
              "user": {
                "$output": {
                  "resource": "shop-api.account",
                  "name": "email"
                }
              }
            }
          },
          "edge": "sql:shop-api->shop-db"
        },
        {
          "field": "SHOP_MEDIA_BUCKET",
          "source": "derived",
          "value": {
            "name": {
              "$output": {
                "resource": "shop-media.bucket",
                "name": "name"
              }
            }
          },
          "edge": "bucket:shop-api->shop-media"
        },
        {
          "field": "STRIPE_KEY",
          "source": "secret",
          "secret": "PaymentsSecrets.STRIPE_KEY"
        }
      ]
    },
    {
      "name": "shop-db",
      "kind": "database",
      "platform": "fake.sql",
      "services": [
        {
          "name": "shop-db",
          "kind": "DB"
        }
      ],
      "dialect": "postgres",
      "settings": {
        "highAvailability": true,
        "tier": "large"
      },
      "resourceName": "shop-db",
      "address": {
        "$output": {
          "resource": "shop-db.instance",
          "name": "connectionName"
        }
      }
    },
    {
      "name": "shop-media",
      "kind": "bucket",
      "platform": "fake.storage",
      "services": [
        {
          "name": "shop-media",
          "kind": "Bucket"
        }
      ],
      "settings": {
        "versioning": true
      },
      "resourceName": "acme-prod-shop-stack-shop-media",
      "address": {
        "$output": {
          "resource": "shop-media.bucket",
          "name": "name"
        }
      }
    },
    {
      "name": "shop-orders-ship-orders",
      "kind": "job",
      "platform": "fake.job",
      "services": [
        {
          "name": "shop-orders",
          "kind": "API"
        }
      ],
      "calls": [
        {
          "name": "shop-api",
          "kind": "API"
        }
      ],
      "language": "GO",
      "job": {
        "api": "shop-orders",
        "name": "ShipOrders",
        "schedule": "*/15 * * * *",
        "timeZone": "UTC",
        "timeoutSeconds": 300,
        "retries": 1
      },
      "settings": {
        "cpu": "2"
      },
      "resourceName": "shop-orders-ship-orders",
      "bindings": [
        {
          "field": "FULFILLMENT_REGION",
          "source": "literal",
          "value": "us"
        },
        {
          "field": "MAX_LINE_ITEMS",
          "source": "literal",
          "value": "50",
          "default": true
        },
        {
          "field": "SHOP_API_SERVICE",
          "source": "derived",
          "value": {
            "credential": {
              "audience": "shop-api",
              "source": "google-id-token"
            },
            "url": {
              "$output": {
                "resource": "shop-api.service",
                "name": "url"
              }
            }
          },
          "edge": "http:shop-orders-ship-orders->shop-api"
        },
        {
          "field": "SHOP_DB_DATABASE",
          "source": "derived",
          "value": {
            "cloudSql": {
              "database": {
                "$output": {
                  "resource": "shop-db.database.shop-db",
                  "name": "name"
                }
              },
              "instance": {
                "$output": {
                  "resource": "shop-db.instance",
                  "name": "connectionName"
                }
              },
              "user": {
                "$output": {
                  "resource": "shop-orders-ship-orders.account",
                  "name": "email"
                }
              }
            }
          },
          "edge": "sql:shop-orders-ship-orders->shop-db"
        },
        {
          "field": "STRIPE_KEY",
          "source": "secret",
          "secret": "PaymentsSecrets.STRIPE_KEY"
        }
      ]
    },
    {
      "name": "shop-web",
      "kind": "site",
      "platform": "fake.site",
      "services": [
        {
          "name": "shop-web",
          "kind": "Site"
        }
      ],
      "calls": [
        {
          "name": "shop-api",
          "kind": "API"
        }
      ],
      "site": {
        "dir": "web/shop-web",
        "build": "build",
        "output": "dist",
        "fallback": "index.html"
      },
      "exposed": true,
      "resourceName": "shop-web",
      "publicAddress": "https://shop-web.acme.dev",
      "bindings": [
        {
          "field": "shop-api",
          "source": "derived",
          "value": {
            "url": "https://shop-api.acme.dev"
          },
          "edge": "site:shop-web->shop-api"
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "bucket:shop-api->shop-media",
